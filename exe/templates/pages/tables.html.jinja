<section id="tables">
    <h2>Tables & Preformatted</h2>
    <table>
        <caption>Sample Table</caption>
        <colgroup>
            <col span="1" />
            <col span="1" />
        </colgroup>
        <thead>
            <tr>
                <th>Name</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Foo</td>
                <td>Bar</td>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2">Footer text</td>
            </tr>
        </tfoot>
    </table>
    <pre>
Line 1 of code
Line 2 of code
  </pre>
</section>
