{% extends "base.html.jinja" %}

{% block title %}Design System Index{% endblock %}

{% block content %}
<article class="index" style="padding: var(--space-xl); max-width: 100ch; margin: auto;">

    <br>

    <header style="margin-bottom: var(--space-lg);">
        <h1>Stylescape Index</h1>
        <br>
        <p class="lead">Explore components, layout utilities, tokens, and design primitives used throughout the system.
        </p>

        <input type="search" placeholder="🔍 Search components..." class="search-input"
            oninput="filterSections(this.value)"
            style="margin-top: var(--space-md); width: 100%; padding: var(--space-sm);" />
    </header>


    <br>

    <section data-group="everything">
        <h2>00. Everything</h2>
        <ul>
            <li><a href="everything.html">Every HTML-element at once</a></li>
        </ul>
    </section>

    <br>

    <section data-group="components">
        <h2>01. Components</h2>
        <ul>
            <li><a href="buttons.html">Buttons</a> <small>– Primary, Secondary, Icon</small></li>
            <li><a href="pages/components/forms.html">Forms</a> <small>– Inputs, Checkboxes, Radios</small></li>
            <li><a href="tables.html">Tables</a> <small>...</small></li>
            <li><a href="cards.html">Cards</a> <small>– Elevated, Image, Content</small></li>
            <li><a href="modals.html">Modals</a> <small>– Dialog, Slide, Overlay</small></li>
        </ul>
    </section>

    <br>

    <section data-group="elements">
        <h2>02. Elements</h2>
        <ul>
            <li><a href="typography.html">Typography</a> <small>– Headings, Paragraphs, Small Text</small></li>
            <li><a href="colors.html">Colors</a> <small>– Themes, Tokens, Contrast</small></li>
            <li><a href="icons.html">Icons</a> <small>– SVG, Sizes, Colors</small></li>
        </ul>
    </section>

    <br>

    <section data-group="layout">
        <h2>03. Layout & Utilities</h2>
        <ul>
            <li><a href="grid.html">Grid</a> <small>– Responsive Columns, Gutters</small></li>
            <li><a href="spacing.html">Spacing</a> <small>– Margin, Padding, Gaps</small></li>
            <li><a href="visibility.html">Visibility</a> <small>– Show/Hide, Screen Sizes</small></li>
            <li><a href="ribbon.html">Ribbon</a> <small>– Fixed Containers for Tools</small></li>
        </ul>
    </section>

    <br>

    <section data-group="tokens">
        <h2>04. Tokens & Mixins</h2>
        <ul>
            <li><a href="tokens.html">Design Tokens</a> <small>– Color, Typography, Radii</small></li>
            <li><a href="states.html">States</a> <small>– Hover, Focus, Disabled</small></li>
            <li><a href="themes.html">Themes</a> <small>– Light, Dark, Custom</small></li>
        </ul>
    </section>

    <br>

    <section data-group="templates">
        <h2>05. Page Templates</h2>
        <ul>
            <li><a href="dashboard.html">Dashboard</a></li>
            <li><a href="profile.html">User Profile</a></li>
            <li><a href="form-wizard.html">Form Wizard</a></li>
        </ul>
    </section>

    <br>

</article>

<script>
    function filterSections(query) {
        const q = query.toLowerCase();
        document.querySelectorAll("section").forEach(section => {
            const text = section.textContent.toLowerCase();
            section.style.display = text.includes(q) ? "block" : "none";
        });
    }
</script>
{% endblock %}
