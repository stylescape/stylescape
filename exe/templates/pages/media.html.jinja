<!-- templates/includes/media.html.jinja -->
<section id="media">
    <h2>Media & Graphics</h2>
    <figure>
        <img src="/static/img/photo.jpg" alt="Figure" />
        <figcaption>Sample Figure</figcaption>
    </figure>
    <hr />
    <img src="/static/img/photo.jpg" alt="Mapped" usemap="#map1" />
    <map name="map1">
        <area shape="rect" coords="0,0,50,50" href="#" alt="Area" />
    </map>
    <audio controls src="/static/audio/sample.mp3"></audio>
    <video controls src="/static/video/sample.mp4"></video>
    <picture>
        <source srcset="/static/img/1x.jpg" media="(max-width: 600px)">
        <source srcset="/static/img/2x.jpg">
        <img src="/static/img/fallback.jpg" alt="Responsive image">
    </picture>
    <svg width="100" height="100">
        <circle cx="50" cy="50" r="40" />
    </svg>
    <canvas id="canvasExample"></canvas>
    <embed src="/static/docs/doc.pdf" type="application/pdf">
    <object data="/static/docs/doc.pdf" type="application/pdf"></object>
    <iframe src="https://example.com" width="300" height="150"></iframe>
    <video>
        <track kind="metadata" src="/static/subs.vtt">
    </video>
</section>
