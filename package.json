{
    "name": "stylescape",
    "description": "Stylescape is a visual identity framework developed by Scape Agency.",
    "version": "0.0.37",
    "config": {
        "version_short": "0.0"
    },
    "keywords": [
        "stylescape",
        "sass",
        "responsive",
        "front-end",
        "layout-engine",
        "framework",
        "web"
    ],
    "homepage": "https://www.scape.style/",
    "author": "Lars van Vianen",
    "contributors": [
        "Scape Agency"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/stylescape.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/stylescape/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "src/ts/index.ts",
    "sass": "src/scss/index.scss",
    "module": "dist/js/stylescape.js",
    "style": "dist/css/stylescape.css",
    "scripts": {
        "kist-build": "npx kist --config ./kist.yml",
        "kist-watch": "npx kist --config ./kist.yml --live",
        "start": "node dist/index.js",
        "format": "npx prettier --write .",
        "lint": "eslint 'src/**/*.ts' || true",
        "prettify": "prettier --write 'src/**/*.ts'",
        "build": "npm run kist-build",
        "build2": "npm run build-compile && npm run build-process",
        "build-compile": "tsc -p bin/tsconfig.json",
        "build-process": "node bin/js/index.js",
        "webpack-build": "npm run webpack-prod",
        "webpack-dev": "webpack --mode development --config webpack/webpack.config.js",
        "webpack-prod": "webpack --mode production --config webpack/webpack.config.js",
        "webpack-serve": "webpack serve --mode development --config webpack/webpack.config.js",
        "webpack-start": "webpack-dev-server --mode development --config webpack/webpack.config.js"
    },
    "dependencies": {
        "icon.gl": "^0.0.23",
        "move.gl": "^0.0.1",
        "page.gl": "^0.0.3",
        "unit.gl": "^0.1.2"
    },
    "devDependencies": {
        "@types/node": "^22.1.0",
        "@types/nunjucks": "^3.2.2",
        "@types/semver": "^7.5.6",
        "@types/webpack": "^5.28.1",
        "browser-sync": "^2.29.3",
        "browser-sync-webpack-plugin": "^2.3.0",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^12.0.2",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^7.0.0",
        "eslint": "^9.8.0",
        "eslint-config-prettier": "^10.0.1",
        "html-webpack-plugin": "^5.6.3",
        "kist": "^0.1.31",
        "mini-css-extract-plugin": "^2.9.2",
        "node-sass": "^9.0.0",
        "nunjucks": "^3.2.4",
        "nunjucks-html-loader": "^1.1.0",
        "path": "^0.12.7",
        "postcss": "^8.5.3",
        "postcss-loader": "^8.1.1",
        "postcss-preset-env": "^10.1.6",
        "prettier": "^3.0.2",
        "sass": "^1.86.3",
        "sass-loader": "^16.0.5",
        "style-loader": "^4.0.0",
        "stylelint-webpack-plugin": "^5.0.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "typescript": "^5.0.4",
        "webpack": "^5.99.6",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.1",
        "webpack-merge": "^6.0.1"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "sass": "./scss/index.scss",
            "typescript": "./ts/index.scss"
        }
    }
}
