{
    "name": "stylescape",
    "description": "Stylescape is a visual identity framework developed by Scape Agency.",
    "version": "0.1.33",
    "config": {
        "version_short": "0.1"
    },
    "keywords": [
        "stylescape",
        "sass",
        "responsive",
        "front-end",
        "layout-engine",
        "framework",
        "web"
    ],
    "homepage": "https://www.scape.style/",
    "author": "Lars van Vianen",
    "contributors": [
        "Scape Agency"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/stylescape.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/stylescape/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "src/ts/index.ts",
    "sass": "src/scss/index.scss",
    "module": "dist/js/stylescape.js",
    "style": "dist/css/stylescape.css",
    "scripts": {
        "build": "npx kist --config ./kist.pro.yml",
        "watch": "npx kist --config ./kist.dev.yml --live",
        "dev": "vite"
    },
    "dependencies": {
        "hue.gl": "^0.0.35",
        "icon.gl": "^0.0.31",
        "move.gl": "^0.0.1",
        "page.gl": "^0.0.3",
        "unit.gl": "^0.1.12"
    },
    "devDependencies": {
        "kist": "^0.1.40",
        "micromatch": "^4.0.8",
        "nunjucks": "^3.2.4",
        "sass": "^1.87.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3",
        "vite": "^6.3.5"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "sass": "./scss/index.scss",
            "typescript": "./ts/index.scss"
        }
    }
}
