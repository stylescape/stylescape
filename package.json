{
    "name": "stylescape",
    "description": "Stylescape is a visual identity framework developed by Scape Agency.",
    "version": "0.3.0",
    "config": {
        "version_short": "0.1"
    },
    "keywords": [
        "stylescape",
        "sass",
        "responsive",
        "front-end",
        "layout-engine",
        "framework",
        "web"
    ],
    "homepage": "https://www.scape.style/",
    "author": "Lars van Vianen",
    "contributors": [
        "Scape Agency"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/stylescape/stylescape"
    },
    "bugs": {
        "url": "https://github.com/stylescape/stylescape/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "dist/js/stylescape.js",
    "module": "dist/js/stylescape.js",
    "types": "dist/types/index.d.ts",
    "sass": "src/scss/index.scss",
    "style": "dist/css/stylescape.css",
    "scripts": {
        "dev": "vite",
        "build": "npx kist --config ./kist.pro.yml",
        "watch": "npx kist --config ./kist.dev.yml --live",
        "preview": "vite preview",
        "lint": "eslint . --ext .js,.ts",
        "lint:fix": "eslint . --ext .js,.ts --fix",
        "format": "prettier --write \"**/*.{js,ts,json,md,yml,yaml,scss,css,html,jinja}\"",
        "format:check": "prettier --check \"**/*.{js,ts,json,md,yml,yaml,scss,css,html,jinja}\"",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "hue.gl": "^0.0.36",
        "move.gl": "^0.0.1",
        "page.gl": "^0.0.3",
        "unit.gl": "^0.2.3"
    },
    "peerDependencies": {
        "icon.gl": "^0.0.35"
    },
    "peerDependenciesMeta": {
        "icon.gl": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@vitest/coverage-v8": "^4.0.17",
        "@vitest/ui": "^4.0.17",
        "eslint": "^9.34.0",
        "eslint-plugin-import": "^2.32.0",
        "jsdom": "^27.4.0",
        "kist": "0.1.58",
        "micromatch": "^4.0.8",
        "nunjucks": "^3.2.4",
        "sass": "^1.87.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.53.1",
        "vite": "^7.1.6",
        "vitest": "^4.0.17"
    },
    "overrides": {
        "tinyglobby": "0.2.15",
        "make-fetch-happen": "10.2.1",
        "tar": "^7.5.4"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/js/stylescape.js",
            "default": "./dist/js/stylescape.js"
        },
        "./animations/*": {
            "types": "./dist/types/animations/*.d.ts",
            "import": "./dist/js/esm/animations/*.js",
            "default": "./dist/js/esm/animations/*.js"
        },
        "./buttons/*": {
            "types": "./dist/types/buttons/*.d.ts",
            "import": "./dist/js/esm/buttons/*.js",
            "default": "./dist/js/esm/buttons/*.js"
        },
        "./content/*": {
            "types": "./dist/types/content/*.d.ts",
            "import": "./dist/js/esm/content/*.js",
            "default": "./dist/js/esm/content/*.js"
        },
        "./data/*": {
            "types": "./dist/types/data/*.d.ts",
            "import": "./dist/js/esm/data/*.js",
            "default": "./dist/js/esm/data/*.js"
        },
        "./elements/*": {
            "types": "./dist/types/elements/*.d.ts",
            "import": "./dist/js/esm/elements/*.js",
            "default": "./dist/js/esm/elements/*.js"
        },
        "./forms/*": {
            "types": "./dist/types/forms/*.d.ts",
            "import": "./dist/js/esm/forms/*.js",
            "default": "./dist/js/esm/forms/*.js"
        },
        "./init/*": {
            "types": "./dist/types/init/*.d.ts",
            "import": "./dist/js/esm/init/*.js",
            "default": "./dist/js/esm/init/*.js"
        },
        "./interface/*": {
            "types": "./dist/types/interface/*.d.ts",
            "import": "./dist/js/esm/interface/*.js",
            "default": "./dist/js/esm/interface/*.js"
        },
        "./media/*": {
            "types": "./dist/types/media/*.d.ts",
            "import": "./dist/js/esm/media/*.js",
            "default": "./dist/js/esm/media/*.js"
        },
        "./mouse/*": {
            "types": "./dist/types/mouse/*.d.ts",
            "import": "./dist/js/esm/mouse/*.js",
            "default": "./dist/js/esm/mouse/*.js"
        },
        "./scroll/*": {
            "types": "./dist/types/scroll/*.d.ts",
            "import": "./dist/js/esm/scroll/*.js",
            "default": "./dist/js/esm/scroll/*.js"
        },
        "./state/*": {
            "types": "./dist/types/state/*.d.ts",
            "import": "./dist/js/esm/state/*.js",
            "default": "./dist/js/esm/state/*.js"
        },
        "./storage/*": {
            "types": "./dist/types/storage/*.d.ts",
            "import": "./dist/js/esm/storage/*.js",
            "default": "./dist/js/esm/storage/*.js"
        },
        "./utilities/*": {
            "types": "./dist/types/utilities/*.d.ts",
            "import": "./dist/js/esm/utilities/*.js",
            "default": "./dist/js/esm/utilities/*.js"
        },
        "./css": {
            "default": "./dist/css/stylescape.css"
        },
        "./scss": {
            "default": "./src/scss/index.scss"
        },
        "./scss/icons": {
            "default": "./src/scss/icons.scss"
        },
        "./package.json": "./package.json"
    }
}
