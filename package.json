{
    "name": "stylescape",
    "description": "Stylescape is a visual identity framework developed by Scape Agency.",
    "version": "0.2.3",
    "config": {
        "version_short": "0.1"
    },
    "keywords": [
        "stylescape",
        "sass",
        "responsive",
        "front-end",
        "layout-engine",
        "framework",
        "web"
    ],
    "homepage": "https://www.scape.style/",
    "author": "Lars van Vianen",
    "contributors": [
        "Scape Agency"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/stylescape.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/stylescape/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "dist/js/stylescape.js",
    "module": "dist/js/stylescape.js",
    "types": "dist/types/index.d.ts",
    "sass": "src/scss/index.scss",
    "style": "dist/css/stylescape.css",
    "scripts": {
        "dev": "vite",
        "build": "npx kist --config ./kist.pro.yml",
        "watch": "npx kist --config ./kist.dev.yml --live",
        "preview": "vite preview",
        "lint": "eslint . --ext .js,.ts",
        "lint:fix": "eslint . --ext .js,.ts --fix",
        "format": "prettier --write \"**/*.{js,ts,json,md,yml,yaml,scss,css,html}\"",
        "format:check": "prettier --check \"**/*.{js,ts,json,md,yml,yaml,scss,css,html}\"",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "hue.gl": "^0.0.36",
        "move.gl": "^0.0.1",
        "page.gl": "^0.0.3",
        "unit.gl": "^0.1.12"
    },
    "peerDependencies": {
        "icon.gl": "^0.0.35"
    },
    "peerDependenciesMeta": {
        "icon.gl": {
            "optional": true
        }
    },
    "devDependencies": {
        "kist": "0.1.45",
        "micromatch": "^4.0.8",
        "nunjucks": "^3.2.4",
        "sass": "^1.87.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3",
        "vite": "^7.1.6"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/js/stylescape.js",
            "default": "./dist/js/stylescape.js"
        },
        "./css": {
            "default": "./dist/css/stylescape.css"
        },
        "./scss": {
            "default": "./src/scss/index.scss"
        },
        "./scss/icons": {
            "default": "./src/scss/icons.scss"
        },
        "./package.json": "./package.json"
    }
}
