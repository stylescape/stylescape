{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/exe/manage.py",
      "args": ["runserver", "0.0.0.0:8000", "--noreload"],
      "django": true,
      "autoReload": {
        "enable": true
      },
      "env": {
        "DJANGO_SETTINGS_MODULE": "${env:DJANGO_SETTINGS_MODULE}"
      },
      "cwd": "${workspaceFolder}/exe",
      "console": "integratedTerminal"
    },
    {
      "name": "Django: runserver (with reload)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/exe/manage.py",
      "args": ["runserver", "0.0.0.0:8000"],
      "django": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "${env:DJANGO_SETTINGS_MODULE}"
      },
      "cwd": "${workspaceFolder}/exe",
      "console": "integratedTerminal"
    },
    {
      "name": "Django: shell",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/exe/manage.py",
      "args": ["shell"],
      "django": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "${env:DJANGO_SETTINGS_MODULE}"
      },
      "cwd": "${workspaceFolder}/exe",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "env": {
        "DJANGO_SETTINGS_MODULE": "${env:DJANGO_SETTINGS_MODULE}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tst/", "-v"],
      "env": {
        "DJANGO_SETTINGS_MODULE": "${env:DJANGO_SETTINGS_MODULE}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
