{#-
    stylescape/auth/register.html.jinja
    ===========================================================================
    A sign-up view (UserCreationForm or similar). Context: form.
-#}
{%- extends "stylescape/auth/base_auth.html.jinja" -%}
{%- from "stylescape/macros/forms.html.jinja" import form as render_form with context -%}
{%- block auth_title %}{{ _("Create an account") }}{% endblock -%}
{%- block auth_body %}
{{ render_form(form, submit=_("Create account")) }}
{%- endblock -%}
{%- block auth_links %}
<li>{{ _("Already have an account?") }} <a href="{{ login_url | default(auth_url('login', '/accounts/login/'), true) }}">{{ _("Sign in") }}</a></li>
{%- endblock -%}
