{#-
    stylescape/auth/activation.html.jinja
    ===========================================================================
    Account activation result (e.g. django-registration activation). Context: activated (bool), activation_error (optional text).
-#}
{%- extends "stylescape/auth/base_auth.html.jinja" -%}
{%- from "stylescape/macros/forms.html.jinja" import form as render_form with context -%}
{%- block auth_title %}{{ _("Account activated") if activated else _("Activation failed") }}{% endblock -%}
{%- block auth_lead %}
{%- if activated %}{{ _("Your account is ready. You can sign in now.") }}
{%- else %}{{ activation_error | default(_("This activation link is invalid or has expired."), true) }}{% endif %}
{%- endblock -%}
{%- block auth_body %}
{%- if activated %}
<span class="ss-c-auth__icon" aria-hidden="true">✓</span>
<a class="ss-c-button ss-c-button--primary" href="{{ login_url | default(auth_url('login', '/accounts/login/'), true) }}">{{ _("Sign in") }}</a>
{%- else %}
<span class="ss-c-auth__icon ss-c-auth__icon--error" aria-hidden="true">!</span>
{%- if register_url %}<a class="ss-c-button" href="{{ register_url }}">{{ _("Sign up again") }}</a>{% endif %}
{%- endif %}
{%- endblock -%}
