{#-
    stylescape/auth/login.html.jinja
    ===========================================================================
    Django LoginView (registration/login.html). Context: form, next.
-#}
{%- extends "stylescape/auth/base_auth.html.jinja" -%}
{%- from "stylescape/macros/forms.html.jinja" import form as render_form with context -%}
{%- block auth_title %}{{ _("Sign in") }}{% endblock -%}
{%- block auth_body %}
{%- call render_form(form, submit=_("Sign in")) %}{% if next %}<input type="hidden" name="next" value="{{ next }}" />{% endif %}{% endcall %}
{%- endblock -%}
{%- block auth_links %}
<li><a href="{{ password_reset_url | default(auth_url('password_reset', '/accounts/password_reset/'), true) }}">{{ _("Forgot your password?") }}</a></li>
{%- if register_url %}<li><a href="{{ register_url }}">{{ _("Create an account") }}</a></li>{% endif %}
{%- endblock -%}
