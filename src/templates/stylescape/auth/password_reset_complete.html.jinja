{#-
    stylescape/auth/password_reset_complete.html.jinja
    ===========================================================================
    PasswordResetCompleteView (registration/password_reset_complete.html).
-#}
{%- extends "stylescape/auth/base_auth.html.jinja" -%}
{%- from "stylescape/macros/forms.html.jinja" import form as render_form with context -%}
{%- block auth_title %}{{ _("Password changed") }}{% endblock -%}
{%- block auth_lead %}{{ _("Your new password is set. You can sign in now.") }}{% endblock -%}
{%- block auth_body %}
<span class="ss-c-auth__icon" aria-hidden="true">✓</span>
<a class="ss-c-button ss-c-button--primary" href="{{ login_url | default(auth_url('login', '/accounts/login/'), true) }}">{{ _("Sign in") }}</a>
{%- endblock -%}
