{#-
    stylescape/auth/password_reset_confirm.html.jinja
    ===========================================================================
    PasswordResetConfirmView (registration/password_reset_confirm.html). Context: validlink, form.
-#}
{%- extends "stylescape/auth/base_auth.html.jinja" -%}
{%- from "stylescape/macros/forms.html.jinja" import form as render_form with context -%}
{%- block auth_title %}{{ _("Choose a new password") if validlink else _("Link expired") }}{% endblock -%}
{%- block auth_lead %}{% if not validlink %}{{ _("This password reset link is invalid, possibly because it has already been used. Please request a new one.") }}{% endif %}{% endblock -%}
{%- block auth_body %}
{%- if validlink %}
{{ render_form(form, submit=_("Change my password")) }}
{%- else %}
<span class="ss-c-auth__icon ss-c-auth__icon--error" aria-hidden="true">!</span>
<a class="ss-c-button ss-c-button--primary" href="{{ password_reset_url | default(auth_url('password_reset', '/accounts/password_reset/'), true) }}">{{ _("Request a new link") }}</a>
{%- endif %}
{%- endblock -%}
