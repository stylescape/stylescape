{#-
    stylescape/auth/password_reset.html.jinja
    ===========================================================================
    PasswordResetView (registration/password_reset_form.html). Context: form.
-#}
{%- extends "stylescape/auth/base_auth.html.jinja" -%}
{%- from "stylescape/macros/forms.html.jinja" import form as render_form with context -%}
{%- block auth_title %}{{ _("Reset your password") }}{% endblock -%}
{%- block auth_lead %}{{ _("Enter your email address and we will send you a link to choose a new password.") }}{% endblock -%}
{%- block auth_body %}
{{ render_form(form, submit=_("Send reset link")) }}
{%- endblock -%}
{%- block auth_links %}
<li><a href="{{ login_url | default(auth_url('login', '/accounts/login/'), true) }}">{{ _("Back to sign in") }}</a></li>
{%- endblock -%}
