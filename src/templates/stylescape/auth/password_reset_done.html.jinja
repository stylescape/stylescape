{#-
    stylescape/auth/password_reset_done.html.jinja
    ===========================================================================
    PasswordResetDoneView (registration/password_reset_done.html).
-#}
{%- extends "stylescape/auth/base_auth.html.jinja" -%}
{%- from "stylescape/macros/forms.html.jinja" import form as render_form with context -%}
{%- block auth_title %}{{ _("Check your email") }}{% endblock -%}
{%- block auth_lead %}{{ _("If an account exists for that address, we have sent instructions for setting a new password. It may take a few minutes to arrive.") }}{% endblock -%}
{%- block auth_body %}<span class="ss-c-auth__icon" aria-hidden="true">✉</span>{% endblock -%}
{%- block auth_links %}
<li><a href="{{ login_url | default(auth_url('login', '/accounts/login/'), true) }}">{{ _("Back to sign in") }}</a></li>
{%- endblock -%}
