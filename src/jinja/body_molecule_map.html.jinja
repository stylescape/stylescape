{% extends "base.html.jinja" %} {% set title = "Map" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% set section_title = "Map Canvas" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>
            The map canvas takes up the full viewport. For demo purposes, the
            container is constrained.
        </p>
        {% set code_snippet %}
        <div
            id="map"
            style="
                width: 100%;
                height: 400px;
                background: #e0e0e0;
                position: relative;
            "
        >
            <div
                class="map_canvas"
                style="width: 100%; height: 100%; position: relative"
            >
                <!-- Map tiles would be rendered here by a mapping library -->
                <div
                    style="
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        height: 100%;
                        color: #666;
                    "
                >
                    Map Canvas Placeholder
                </div>
            </div>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Layer Controls" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div
            class="layer_control_base"
            style="padding: 16px; background: #f5f5f5; border-radius: 8px"
        >
            <h3>Base Layers</h3>
            <label>
                <span>
                    <input
                        type="radio"
                        name="base-layer"
                        value="streets"
                        checked
                    />
                    <span>Streets</span>
                </span>
            </label>
            <label>
                <span>
                    <input type="radio" name="base-layer" value="satellite" />
                    <span>Satellite</span>
                </span>
            </label>
            <label>
                <span>
                    <input type="radio" name="base-layer" value="terrain" />
                    <span>Terrain</span>
                </span>
            </label>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Overlay Controls" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div
            class="layer_control_overlay"
            style="padding: 16px; background: #f5f5f5; border-radius: 8px"
        >
            <h3>Overlays</h3>
            <label>
                <span>
                    <input type="checkbox" name="overlay" value="traffic" />
                    <span>Traffic</span>
                </span>
            </label>
            <label>
                <span>
                    <input type="checkbox" name="overlay" value="transit" />
                    <span>Transit</span>
                </span>
            </label>
            <label>
                <span>
                    <input type="checkbox" name="overlay" value="bike" />
                    <span>Bike Lanes</span>
                </span>
            </label>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>
</section>

{%- endblock %}
