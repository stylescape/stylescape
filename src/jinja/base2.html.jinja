<!DOCTYPE html>
<html lang="en" data-theme="light">

{% set rail_left = true %}
{% set rail_right = true %}


<head>
    <meta charset="UTF-8" />
    <title>{% block title %}Stylescape{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/stylescape.css" />
    <script type="module" src="/js/stylescape.js"></script>

    <style>
        * {
            font-variant-numeric: lining-nums tabular-nums;
            font-feature-settings: "lnum", "tnum";
        }
    </style>
    {% block head %}{% endblock %}
</head>

<body class="">

    <div class="frame_main">

        <div class="frame_main__area--top">
            {%- block ribbon_top -%}
            <header class="ribbon--top" id="" role="navigation">
                {%- include "includes/_ribbon_top.html.jinja" -%}
            </header>
            {%- endblock ribbon_top -%}
        </div>

        <div class="frame_main__area--middle_left">
            <aside class="ribbon--left ribbon--inverted" id="leftRibbon" role="navigation">
            </aside>
            {% if rail_left %}
            <div class="sidebar__left_switch" id="leftSwitch">
                <button class="sidebar__left_switch_button">
                    <span class="top_bar"></span>
                    <span class="bot_bar"></span>
                </button>
            </div>
            <aside class="rail--left rail--inverted" id="leftAside" role="navigation">
                <div class="rail--inside">
                    {% block rail_left_content %}Aside Left Menu
                                        {% include "includes/_aside_left_index.html.jinja" %}
{% endblock%}
                </div>
            </aside>
            {% endif%}
        </div>

        <div class="frame_main__area--middle_center ">
            <main class="main rail" role="main">
                <div class="main_content">
                {% block content %}{% endblock %}
                </div>
            </main>
        </div>

        <div class="frame_main__area--middle_right">
            <aside class="ribbon--right ribbon--inverted" id="rightRibbon" role="navigation">
                <nav class="layout__nav">
                    <ul class="layout__nav__list">
                        <li class="layout__nav__list__item">
                            <a href="/settings" class="layout__nav__list__item__text">Settings</a>
                        </li>
                        <li class="layout__nav__list__item">
                            <a href="/help" class="layout__nav__list__item__text">Help</a>
                        </li>
                    </ul>
                </nav>
            </aside>
            {% if rail_right %}
            <div class="rail_right_switch" id="rightSwitch">
                <button class="rail_right_switch_button">
                    <span class="top_bar"></span>
                    <span class="bot_bar"></span>
                </button>
            </div>
            <aside class="rail--right rail--inverted" id="rightAside" role="navigation">
                <div class="rail--inside">
                    {% block rail_right_content %}Aside Right Menu{% endblock%}
                </div>
            </aside>
            {% endif %}
        </div>

        <div class="frame_main__area--bottom">
            <footer class="ribbon--bottom ribbon--inverted" role="contentinfo">
                {% block footer %}
                <div class="ribbon__slot--horizontal_center">
                    <small>&copy; 2025 SC∆PE AGENCY</small>
                </div>
                {% endblock %}
            </footer>
        </div>

    </div>

    <aside class="">
        {% include "includes/_utility_guides.html.jinja" %}
    </aside>

</body>
<script>
    function filterSections(query) {
        const q = query.toLowerCase();
        document.querySelectorAll(".demo__section, .demo__subsection").forEach(section => {
            section.style.display = section.textContent.toLowerCase().includes(q) ? "block" : "none";
        });
    }
</script>

</html>
