{% extends "base.html.jinja" %}

{% set title = "Cards" %}

{%- block title %}{{ title }}{%- endblock %}

{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>


    {% set section_title = "Card Default" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="card">
            <div class="card--header">Header</div>
            <div class="card--body">Body</div>
            <div class="card--footer">Footer</div>
        </div>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Card Hover" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="card hover">
            <div class="card--header">Header</div>
            <div class="card--body">Body<br></div>
            <div class="card--footer">Footer</div>
        </div>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
