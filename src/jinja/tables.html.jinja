    <colgroup span="2">
        <col>
        <col>
    </colgroup>
    <colgroup></colgroup>
    <thead>
        <tr>
            <th>Table Header 1</th>
            <th>Table Header 2</th>
            <th>Table Header 3</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <td>Table Footer 1</td>
            <td>Table Footer 2</td>
            <td>Table Footer 3</td>
        </tr>
    </tfoot>
    <tbody>
        <tr>
            <td>TD 1.1</td>
            <td>TD 1.2</td>
            <td>TD 1.3</td>
        </tr>
        <tr>
            <td>TD 2.1</td>
            <td>TD 2.2</td>
            <td>TD 2.3</td>
        </tr>
        <tr>
            <td>TD 3.1</td>
            <td>TD 3.2</td>
            <td>TD 3.3</td>
        </tr>
    </tbody>
</table>

<section id="tables">
    <h2>Tables & Preformatted</h2>
    <table>
        <caption>Sample Table</caption>
        <colgroup>
            <col span="1" />
            <col span="1" />
        </colgroup>
        <thead>
            <tr>
                <th>Name</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Foo</td>
                <td>Bar</td>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2">Footer text</td>
            </tr>
        </tfoot>
    </table>
    <pre>
Line 1 of code
Line 2 of code
  </pre>
</section>


