{% extends "base.html.jinja" %}

{% set title = "Details + Summary" %}

{%- block title %}{{ title }}{%- endblock %}

{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h3>{{ title }}</h3>
    </header>

<section class="demo__subsection">
    <h4>Details & Summary Component</h4>
    {% set code_snippet %}
<details class="details">
    <summary class="summary">Click to expand details</summary>
    <div class="details__content">
        <p>This is the hidden content that appears when the summary is clicked.</p>
        <p>You can add any elements here: text, links, or even nested components.</p>
    </div>
</details>
    {% endset %}
    {% set language="HTML" %}
    {%- include "includes/preview_box_code.html.jinja" %}
</section>


</section>

{%- endblock %}
