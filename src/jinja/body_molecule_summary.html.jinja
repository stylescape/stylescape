{% extends "base.html.jinja" %}

{% block title %}...{% endblock %}

{% block content %}


<section class="demo__section">
    <header class="demo__section__header">
        <h2>Details & Summary Component</h2>
    </header>

<section class="demo__subsection">
    <h4>Details & Summary Component</h4>
    {% set code_snippet %}
<details class="details">
    <summary class="summary">Click to expand details</summary>
