{% extends "base.html.jinja" %}
{% block title %}Label Demo{% endblock %}

{% block content %}
<section class="demo_section">
    <h1>Label Demo</h1>

    <div class="label_demo_group">
        <label class="label">Default Label</label>
        <input type="text" class="input box--size_06" placeholder="Input with default label">
    </div>

    <div class="label_demo_group">
        <label class="label label--muted">Muted Label</label>
        <input type="text" class="input box--size_06" placeholder="Muted label style">
    </div>

    <div class="label_demo_group">
        <label class="label label--accent">Accent Label</label>
        <input type="text" class="input box--size_06" placeholder="Accent label style">
    </div>

    <div class="label_demo_group">
        <label class="label label--small">Small Label</label>
        <input type="text" class="input box--size_06" placeholder="Smaller font label">
    </div>

    <div class="label_demo_group">
        <span class="label label--standalone">Standalone Label</span>
    </div>
</section>
{% endblock %}
