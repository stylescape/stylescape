{% extends "base.html.jinja" %}
{% block title %}Label Demo{% endblock %}

{% block content %}
<section class="demo_section">
    <h1>Label Demo</h1>

    <div class="label_demo_group">
        <label class="label">Default Label</label>
        <input type="text" class="input" placeholder="Input with default label">
    </div>

    <div class="label_demo_group">
        <label class="label label--muted">Muted Label</label>
        <input type="text" class="input" placeholder="Muted label style">
    </div>

    <div class="label_demo_group">
        <label class="label label--accent">Accent Label</label>
        <input type="text" class="input " placeholder="Accent label style">
    </div>

    <div class="label_demo_group">
        <label class="label label--small">Small Label</label>
        <input type="text" class="input" placeholder="Smaller font label">
    </div>

    <div class="label_demo_group">
        <span class="label label--standalone">Standalone Label</span>
    </div>

    <h1>Input Size Variants</h1>

    <!-- Small Input -->
    <div class="label_demo_group">
        <label class="label">Small Input</label>
        <input type="text" class="input input--s" placeholder="Small size (s)" />
    </div>

    <!-- Medium (Default) Input -->
    <div class="label_demo_group">
        <label class="label">Medium Input (Default)</label>
        <input type="text" class="input input--m" placeholder="Medium size (m)" />
    </div>

    <!-- Large Input -->
    <div class="label_demo_group">
        <label class="label">Large Input</label>
        <input type="text" class="input input--l" placeholder="Large size (l)" />
    </div>

    <h2>Label Variations (Medium Inputs)</h2>

    <!-- Muted Label -->
    <div class="label_demo_group">
        <label class="label label--muted">Muted Label</label>
        <input type="text" class="input input--m" placeholder="Input with muted label" />
    </div>

    <!-- Accent Label -->
    <div class="label_demo_group">
        <label class="label label--accent">Accent Label</label>
        <input type="text" class="input input--m" placeholder="Input with accent label" />
    </div>

    <!-- Small Label Font -->
    <div class="label_demo_group">
        <label class="label label--small">Small Label</label>
        <input type="text" class="input input--m" placeholder="Input with small-label style" />
    </div>

    <!-- Standalone Label -->
    <div class="label_demo_group">
        <span class="label label--standalone">Standalone Label</span>
    </div>
</section>
{% endblock %}
