{% extends "base.html.jinja" %}
{%- block title %}Width Utilities{%- endblock %}
{%- block content %}

{# ============================================================================
   Percentage Widths
   ============================================================================ #}
<section class="demo__section" data-label="Percentage Widths" data-level="1">
    <header class="demo__section__header">
        <h3>Percentage Widths</h3>
        <p>Width utilities based on percentage values.</p>
    </header>

    <section class="demo__subsection">
        <h4>Common Percentages</h4>
        {% set code_snippet %}
<div class="w--100 bg--fill_02 p--02 mb--02">100% width</div>
<div class="w--75 bg--fill_02 p--02 mb--02">75% width</div>
<div class="w--50 bg--fill_02 p--02 mb--02">50% width</div>
<div class="w--25 bg--fill_02 p--02 mb--02">25% width</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Auto Width</h4>
        {% set code_snippet %}
<div class="w--auto bg--fill_02 p--02 d--inline-block">Auto width (fits content)</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Viewport Widths
   ============================================================================ #}
<section class="demo__section" data-label="Viewport Widths" data-level="1">
    <header class="demo__section__header">
        <h3>Viewport Widths</h3>
        <p>Width utilities based on viewport dimensions.</p>
    </header>

    <section class="demo__subsection">
        <h4>Viewport Width Units</h4>
        {% set code_snippet %}
<div class="w--100vw bg--fill_02 p--02 mb--02">100vw - Full viewport width</div>
<div class="w--50vw bg--fill_02 p--02 mb--02">50vw - Half viewport width</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Fixed Widths
   ============================================================================ #}
<section class="demo__section" data-label="Fixed Widths" data-level="1">
    <header class="demo__section__header">
        <h3>Fixed Widths</h3>
        <p>Width utilities with fixed pixel values.</p>
    </header>

    <section class="demo__subsection">
        <h4>Pixel Widths</h4>
        {% set code_snippet %}
<div class="w--64 bg--fill_02 p--02 mb--02">64px</div>
<div class="w--128 bg--fill_02 p--02 mb--02">128px</div>
<div class="w--256 bg--fill_02 p--02 mb--02">256px</div>
<div class="w--512 bg--fill_02 p--02 mb--02">512px</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Min/Max Widths
   ============================================================================ #}
<section class="demo__section" data-label="Min/Max Widths" data-level="1">
    <header class="demo__section__header">
        <h3>Min/Max Widths</h3>
        <p>Constrain element widths with minimum and maximum values.</p>
    </header>

    <section class="demo__subsection">
        <h4>Maximum Width</h4>
        {% set code_snippet %}
<div class="max-w--sm bg--fill_02 p--02 mb--02">Max width small (320px)</div>
<div class="max-w--md bg--fill_02 p--02 mb--02">Max width medium (640px)</div>
<div class="max-w--lg bg--fill_02 p--02 mb--02">Max width large (960px)</div>
<div class="max-w--full bg--fill_02 p--02 mb--02">Max width full (100%)</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Minimum Width</h4>
        {% set code_snippet %}
<div class="d--inline-block min-w--100 bg--fill_02 p--02 mb--02">Min 100px</div>
<div class="d--inline-block min-w--200 bg--fill_02 p--02 mb--02">Min 200px</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Fit Content
   ============================================================================ #}
<section class="demo__section" data-label="Fit Content" data-level="1">
    <header class="demo__section__header">
        <h3>Fit Content</h3>
        <p>Width that fits the content with constraints.</p>
    </header>

    <section class="demo__subsection">
        <h4>Fit Content Width</h4>
        {% set code_snippet %}
<div class="w--fit bg--fill_02 p--02 mb--02">Width fits content</div>
<div class="w--min bg--fill_02 p--02 mb--02">Minimum content width</div>
<div class="w--max bg--fill_02 p--02 mb--02">Maximum content width</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
