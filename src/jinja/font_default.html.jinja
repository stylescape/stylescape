{% extends "base.html.jinja" %}

{% block title %}Font Demo{% endblock %}

{% block content %}

<div class="font-preview-controls">
    <label for="font-preview-input">Preview text:</label>
    <input id="font-preview-input" type="text" placeholder="The quick brown fox…" />
</div>

<div class="font-preview-grid">
    <div class="font-preview-box" data-default="Aa Bb Cc" style="font-family: serif">
        <span class="label">Serif</span>
        <div class="text">The quick brown fox jumps over the lazy dog. 0123456789
        </div>
    </div>
    <div class="font-preview-box" data-default="Aa Bb Cc" style="font-family: sans-serif">
        <span class="label">Sans-serif</span>
        <div class="text">The quick brown fox jumps over the lazy dog. 0123456789
        </div>
    </div>
    <div class="font-preview-box" data-default="Aa Bb Cc" style="font-family: monospace">
        <span class="label">Monospace</span>
        <div class="text">The quick brown fox jumps over the lazy dog. 0123456789
        </div>
    </div>
    <!-- Add more boxes as needed -->
</div>

<section class="font_default">
    <h2>.font_default</h2>
    <p>The quick brown fox jumps over the lazy dog. 0123456789</p>
</section>

<section class="font_sans">
    <h2>.font_sans</h2>
    <p>The quick brown fox jumps over the lazy dog. 0123456789</p>
</section>

<section class="font_serif">
    <h2>.font_serif</h2>
    <p>The quick brown fox jumps over the lazy dog. 0123456789</p>
</section>

<section class="font_slab">
    <h2>.font_slab</h2>
    <p>The quick brown fox jumps over the lazy dog. 0123456789</p>
</section>

<section class="font_mono">
    <h2>.font_mono</h2>
    <p>The quick brown fox jumps over the lazy dog. 0123456789</p>
</section>

{% endblock %}
