<!DOCTYPE html>
<html lang="en" data-theme="light">
    {% set rail_left = true %} {% set rail_right = true %}

    <head>
        <meta charset="UTF-8" />
        <title>{%- block title %}Stylescape{%- endblock %}</title>
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <link rel="stylesheet" href="/css/stylescape.css" />
        <script type="module" src="/js/stylescape.js"></script>

        <style>
            * {
                font-variant-numeric: lining-nums tabular-nums;
                font-feature-settings: "lnum", "tnum";
            }
        </style>
        {%- block head %}{%- endblock %}
    </head>

    <body class="">
        <div class="frame_main">
            <div class="frame_main__area--top">
                <header class="ss-c-ribbon--top" id="" role="navigation">
                    <div class="ss-c-ribbon__slot--horizontal_left">
                        <h1
                            id="ribbon__title"
                            class="ss-c-ribbon__slot--left ss-c-ribbon__title"
                            role="heading"
                            aria-level="1"
                        >
                            <div class="ss-c-ribbon__title__logo">
                                <a href="/" class="">
                                    <span class="i-text">+</span>
                                </a>
                            </div>
                            <div class="ss-c-ribbon__title__text">
                                <a href="/" class="">SCAPEFRAME</a>
                            </div>
                            <div class="ribbon__title__image">
                                <figure class="ss-c-figure">
                                    <img
                                        src="https://health-innovation-campus.com/wp-content/uploads/2024/11/Healthcare-Innovation-Campus-Boxmeer_Logo_Green-and-White.svg"
                                    />
                                </figure>
                            </div>
                        </h1>
                    </div>
                    <div class="ss-c-ribbon__slot--horizontal_center"></div>
                    <div class="ss-c-ribbon__slot--horizontal_right"></div>
                </header>
            </div>

            <div class="frame_main__area--middle_center">
                <main class="" role="main">
                    <div class="frame_app">
                        <div class="app__view">
                            <div class="aspect_ratio--16x9">
                                <figure
                                    class="ss-c-image__compare"
                                    id="imageCompare"
                                >
                                    <img
                                        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&amp;fit=crop&amp;w=1470&amp;q=80"
                                        class="ss-c-image__compare--image"
                                        alt="After Image"
                                    />
                                    <img
                                        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&amp;fit=crop&amp;w=1470&amp;q=80"
                                        class="ss-c-image__compare--overlay ss-c-image__compare--image"
                                        alt="Before Image"
                                    />
                                    <div
                                        class="ss-c-image__compare--slider"
                                        id="slider"
                                    >
                                        <span class="arrow--left"></span>
                                        <span class="arrow--right"></span>
                                    </div>
                                </figure>
                            </div>
                        </div>
                        <div class="ss-c-widget ss-c-widget--rounded">
                            <h2>Building Designing</h2>
                            <hr class="ss-c-divider" />
                            <p>
                                Step 1: Select the preferred variant for each
                                section you want to customize.
                            </p>
                            <p>
                                Step 2: Once you’re satisfied with your
                                selection, proceed to design or generate scapes
                                for your building.
                            </p>
                            <p>
                                Step 3: After completing your design, you can
                                compare your results with those of others.
                            </p>
                            <h2>Project Description</h2>
                            <hr class="ss-c-divider" />
                            <p>
                                Lorem ipsum dolor sit amet, consectetur
                                adipiscing elit. Vestibulum quis nunc augue.
                                Nunc vel nunc eget felis sodales iaculis quis
                                nec augue. Suspendisse at nunc odio. Nullam
                                laoreet interdum ipsum non laoreet. Ut quis
                                lorem porta, iaculis nibh quis, laoreet neque.
                                Pellentesque malesuada consequat metus et
                                porta. In eu est ut quam porta accumsan. Duis
                                imperdiet pulvinar massa. Maecenas in purus
                                eget est vehicula commodo. Cras a lorem non
                                magna sagittis fringilla id id urna. Aliquam
                                ultricies lorem at rhoncus sodales. Integer
                                faucibus, lorem ac sagittis consequat, massa
                                urna euismod lectus, et consectetur ligula
                                felis sed felis. Donec dictum, tellus vitae
                                ultrices posuere.
                            </p>
                        </div>
                    </div>
                </main>
            </div>

            {#
            <div class="frame_main__area--bottom">
                {%- block ribbon_bottom -%} {%- include
                "includes/_ribbon_bottom.html.jinja" -%} {%- endblock
                ribbon_bottom -%}
            </div>
            #}
        </div>

        <aside class="">
            {%- include "includes/utilities/_utility_guides.html.jinja" %}
        </aside>
    </body>
    <script>
        function filterSections(query) {
            const q = query.toLowerCase();
            document
                .querySelectorAll(".ss-c-demo__section, .ss-c-demo__subsection")
                .forEach((section) => {
                    section.style.display =
                        section.textContent.toLowerCase().includes(q) ?
                            "block"
                        :   "none";
                });
        }
    </script>
</html>
