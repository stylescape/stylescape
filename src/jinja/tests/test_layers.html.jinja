<div class="ss-c-layer-controls">
    <button onclick="toggleLayer('guides')">Toggle guides</button>
    <button onclick="toggleLayer('modal')">Toggle modal</button>
    <button onclick="toggleLayer('interface')">Toggle interface</button>
    <button onclick="toggleLayer('content')">Toggle content</button>
    <button onclick="toggleLayer('canvas')">Toggle canvas</button>
</div>

<div class="ss-c-layer-demo">
    <div class="ss-c-layer-box ss-c-z-guides" id="layer-guides">
        guides
        <br />
        <small>z(guides)</small>
    </div>
    <div class="ss-c-layer-box ss-c-z-modal" id="layer-modal">
        modal
        <br />
        <small>z(modal)</small>
    </div>
    <div class="ss-c-layer-box ss-c-z-interface" id="layer-interface">
        interface
        <br />
        <small>z(interface)</small>
    </div>
    <div class="ss-c-layer-box ss-c-z-content" id="layer-content">
        content
        <br />
        <small>z(content)</small>
    </div>
    <div class="ss-c-layer-box ss-c-z-canvas" id="layer-canvas">
        canvas
        <br />
        <small>z(canvas)</small>
    </div>
</div>

<script>
    function toggleLayer(id) {
        const el = document.getElementById("layer-" + id);
        el.classList.toggle("hidden");
    }
</script>

<i class="ss-c-i i_badge_country_fill_nl"></i>

