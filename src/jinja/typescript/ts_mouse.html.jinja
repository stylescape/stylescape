            <p style="margin: 0; opacity: 0.6">or click to browse</p>
            <input type="file" multiple style="display: none" />
        </div>

        <!-- Active drop state -->
        <div
            style="
                margin-top: 16px;
                padding: 48px;
                border: 2px dashed var(--ss-color-accent);
                border-radius: var(--ss-radius-xl);
