{% extends "../base.html.jinja" %} {% set title = "Button Handlers" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<style>
    /* Demo-only visuals for the bare `appearance: none` toggle inputs:
       a visible track outline, a knob and a checked state. */
    input[data-ss="toggle"] {
        border: 2px solid var(--ss-color-text-muted);
    }
    input[data-ss="toggle"]::before {
        content: "";
        position: absolute;
        top: 2px;
        left: 2px;
        height: calc(100% - 4px);
        aspect-ratio: 1;
        border-radius: 50%;
        background: var(--ss-color-text-muted);
    }
    input[data-ss="toggle"]:checked {
        background: var(--ss-color-accent) !important;
        border-color: var(--ss-color-accent);
    }
    input[data-ss="toggle"]:checked::before {
        left: auto;
        right: 2px;
        background: var(--ss-color-on-accent);
    }
</style>

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            JavaScript button interaction components with loading states,
            ripple effects, and toggles.
        </p>
    </header>

    {# Button Handler #} {% set section_title = "Button Handler" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>
            Manages button click events with loading states and ripple effects.
        </p>
        {% set code_snippet %}
        <!-- Button with loading state -->
        <button
            data-ss="button"
            data-ss-button-loading="true"
            style="
                padding: 12px 24px;
                background: var(--ss-color-accent);
                color: var(--ss-color-on-accent);
                border: none;
                border-radius: var(--ss-radius-lg);
                cursor: pointer;
                position: relative;
                min-width: 140px;
            "
        >
            <span class="ss-c-button__text">Submit</span>
            <span
                class="ss-c-button__loader"
                style="
                    display: none;
                    position: absolute;
                    inset: 0;
                    background: inherit;
                    border-radius: inherit;
                    align-items: center;
                    justify-content: center;
                "
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    style="animation: spin 1s linear infinite"
                >
                    <circle cx="12" cy="12" r="10" stroke-opacity="0.25" />
                    <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round" />
                </svg>
            </span>
        </button>

        <!-- Button with ripple effect -->
        <button
            data-ss="button"
            data-ss-button-ripple="true"
            style="
                padding: 12px 24px;
                background: var(--ss-color-accent);
                color: var(--ss-color-on-accent);
                border: none;
                border-radius: var(--ss-radius-lg);
                cursor: pointer;
                overflow: hidden;
                position: relative;
            "
        >
            Click for Ripple
        </button>

        <!-- Combined loading and ripple -->
        <button
            data-ss="button"
            data-ss-button-loading="true"
            data-ss-button-ripple="true"
            style="
                padding: 14px 32px;
                background: var(--ss-color-accent);
                color: var(--ss-color-on-accent);
                border: none;
                border-radius: var(--ss-radius-3xl);
                cursor: pointer;
                overflow: hidden;
                position: relative;
                font-weight: 600;
            "
        >
            <span class="ss-c-button__text">Save Changes</span>
            <span class="ss-c-button__loader" style="display: none">Saving...</span>
        </button>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Toggle Switch Manager #} {% set section_title = "Toggle Switch Manager"
    %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>
            Manages toggle switches with optional state persistence via
            localStorage.
        </p>
        {% set code_snippet %}
        <!-- Basic toggle -->
        <label
            style="
                display: flex;
                align-items: center;
                gap: 12px;
                cursor: pointer;
            "
        >
            <input
                type="checkbox"
                data-ss="toggle"
                style="
                    width: 48px;
                    height: 24px;
                    appearance: none;
                    background: var(--ss-color-surface-alt);
                    border-radius: var(--ss-radius-lg);
                    position: relative;
                    cursor: pointer;
                    transition: background 0.2s;
                "
            />
            <span>Enable notifications</span>
        </label>

        <!-- Toggle with persistence -->
        <label
            style="
                display: flex;
                align-items: center;
                gap: 12px;
                cursor: pointer;
                margin-top: 16px;
            "
        >
            <input
                type="checkbox"
                data-ss="toggle"
                data-ss-toggle-persist="true"
                data-ss-toggle-storage-key="dark-mode"
                id="darkModeToggle"
                style="
                    width: 48px;
                    height: 24px;
                    appearance: none;
                    background: var(--ss-color-surface-alt);
                    border-radius: var(--ss-radius-lg);
                    position: relative;
                    cursor: pointer;
                "
            />
            <span>Dark Mode (persisted)</span>
        </label>

        <!-- Toggle with custom styling -->
        <div
            style="
                margin-top: 24px;
                padding: 20px;
                background: var(--ss-color-surface-alt);
                border-radius: var(--ss-radius-lg);
            "
        >
            <div
                style="
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                "
            >
                <div>
                    <label for="auto-save-toggle" style="font-weight: 700">Auto-save</label>
                    <p id="auto-save-desc" style="margin: 4px 0 0; font-size: 14px; opacity: 0.7">
                        Automatically save your work
                    </p>
                </div>
                <input
                    type="checkbox"
                    data-ss="toggle"
                    data-ss-toggle-persist="true"
                    data-ss-toggle-storage-key="auto-save"
                    id="auto-save-toggle"
                    aria-describedby="auto-save-desc"
                    checked
                    style="
                        width: 52px;
                        height: 28px;
                        appearance: none;
                        background: var(--ss-color-accent);
                        border-radius: var(--ss-radius-xl);
                        position: relative;
                        cursor: pointer;
                    "
                />
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Button States #} {% set section_title = "Button States" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Different button states managed by the handler.</p>
        {% set code_snippet %}
        <div style="display: flex; flex-wrap: wrap; gap: 16px">
            <!-- Default state -->
            <button
                data-ss="button"
                style="
                    padding: 12px 24px;
                    background: var(--ss-color-accent);
                    color: var(--ss-color-on-accent);
                    border: none;
                    border-radius: var(--ss-radius-lg);
                    cursor: pointer;
                "
            >
                Default
            </button>

            <!-- Hover state (CSS) -->
            <button
                data-ss="button"
                data-ss-button-ripple="true"
                style="
                    padding: 12px 24px;
                    background: var(--ss-color-accent);
                    color: var(--ss-color-on-accent);
                    border: none;
                    border-radius: var(--ss-radius-lg);
                    cursor: pointer;
                "
            >
                Hover Me
            </button>

            <!-- Loading state -->
            <button
                data-ss="button"
                data-ss-button-loading="true"
                class="is-loading"
                disabled
                aria-label="Processing"
                style="
                    position: relative;
                    padding: 12px 24px;
                    background: var(--ss-color-accent);
                    color: var(--ss-color-on-accent);
                    border: none;
                    border-radius: var(--ss-radius-lg);
                    cursor: not-allowed;
                    opacity: 0.7;
                "
            >
                <span class="ss-c-button__text" style="visibility: hidden">
                    Processing
                </span>
                <span
                    class="ss-c-button__loader"
                    style="
                        position: absolute;
                        inset: 0;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    "
                >
                    <span
                        style="
                            width: 16px;
                            height: 16px;
                            border: 2px solid transparent;
                            border-top-color: currentColor;
                            border-radius: 50%;
                            animation: spin 0.8s linear infinite;
                        "
                    ></span>
                </span>
            </button>

            <!-- Disabled state -->
            <button
                data-ss="button"
                disabled
                style="
                    padding: 12px 24px;
                    background: var(--ss-color-surface-alt);
                    color: var(--ss-color-text-muted);
                    border: none;
                    border-radius: var(--ss-radius-lg);
                    cursor: not-allowed;
                "
            >
                Disabled
            </button>

            <!-- Success state -->
            <button
                data-ss="button"
                class="is-success"
                style="
                    padding: 12px 24px;
                    background: var(--ss-color-success);
                    color: var(--ss-color-on-success);
                    border: none;
                    border-radius: var(--ss-radius-lg);
                    cursor: pointer;
                "
            >
                ✓ Success
            </button>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# JavaScript API #} {% set section_title = "JavaScript API" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Programmatic control of button handlers.</p>
        {% set code_snippet %}
        <script>
            // ButtonHandler - Loading states
            import { ButtonHandler } from "stylescape";

            const button = new ButtonHandler(element, {
                loading: true,
                ripple: true,
                onClick: async () => {
                    // Async operation
                    await saveData();
                },
            });

            button.setLoading(true); // Show loading
            button.setLoading(false); // Hide loading
            button.disable(); // Disable button
            button.enable(); // Enable button

            // ToggleSwitchManager - Persistence
            import { ToggleSwitchManager } from "stylescape";

            const toggle = new ToggleSwitchManager(checkbox, {
                persist: true,
                storageKey: "my-setting",
                onChange: (checked) => {
                    console.log("Toggle state:", checked);
                },
            });

            toggle.getState(); // Get current state
            toggle.setState(true); // Set state programmatically
            toggle.toggle(); // Toggle state
        </script>
        {% endset %} {% set language="JavaScript" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock %}
