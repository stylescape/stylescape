{% extends "base.html.jinja" %} {% set title = "Object | Margin" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {# -----------------------------------------------------------------------
    #} {# Margin All (tokens) #} {#
    ----------------------------------------------------------------------- #}
    {% set section_title = "Margin All" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set sizes = ["xs","sm","md","lg","xl"] %} {% set code_snippet %}
        <div class="">
            {% for s in sizes %}
            <div class="demo__box margin--{{ s }}">
                <code>.margin--{{ s }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>

    {# -----------------------------------------------------------------------
    #} {# Margin Sides (tokens) #} {#
    ----------------------------------------------------------------------- #}
    {% set section_title = "Margin Sides" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set sides = ["top","right","bottom","left"] %} {% set code_snippet
        %}
        <div class="">
            {% for side in sides %}
            <div class="demo__box margin--md_{{ side }}">
                <code>.margin--md_{{ side }}</code>
            </div>
            <div class="demo__box margin--xl_{{ side }}">
                <code>.margin--xl_{{ side }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>

    {# -----------------------------------------------------------------------
    #} {# Margin Axes (tokens) #} {#
    ----------------------------------------------------------------------- #}
    {% set section_title = "Margin Axes" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set axes = ["vertical","horizontal"] %} {% set code_snippet %}
        <div class="">
            {% for axis in axes %}
            <div class="demo__box margin--sm_{{ axis }}">
                <code>.margin--sm_{{ axis }}</code>
            </div>
            <div class="demo__box margin--md_{{ axis }}">
                <code>.margin--md_{{ axis }}</code>
            </div>
            <div class="demo__box margin--xl_{{ axis }}">
                <code>.margin--xl_{{ axis }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>

    {# -----------------------------------------------------------------------
    #} {# Mixed Examples (tokens) #} {#
    ----------------------------------------------------------------------- #}
    {% set section_title = "Mixed Examples" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set code_snippet %}
        <div class="demo__stack">
            <div class="demo__box margin--md">
                <code>.margin--md</code>
            </div>
            <div class="demo__box margin--md_vertical">
                <code>.margin--md_vertical</code>
            </div>
            <div class="demo__box margin--sm_horizontal">
                <code>.margin--sm_horizontal</code>
            </div>
            <div class="demo__box margin--lg_left">
                <code>.margin--lg_left</code>
            </div>
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>

    {# =======================================================================
    #} {# NEW: Numeric Margin (1–1000) #} {#
    ======================================================================= #}
    {% set section_title = "Numeric Margin (q: 1–1000)" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {# sample set for display #} {% set nums = [1, 4, 8, 12, 16, 24, 32,
        48, 64] %} {# All #} {% set sub_title = "All Sides" %}
        <h4>{{ sub_title }}</h4>
        {% set code_snippet %}
        <div class="">
            {% for n in nums %}
            <div class="demo__box margin--{{ n }}">
                <code>.margin--{{ n }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %} {# Sides #} {% set sub_title
        = "Sides" %}
        <h4>{{ sub_title }}</h4>
        {% set code_snippet %}
        <div class="">
            {% for side in ["top","right","bottom","left"] %}
            <div class="demo__box margin--24_{{ side }}">
                <code>.margin--24_{{ side }}</code>
            </div>
            <div class="demo__box margin--48_{{ side }}">
                <code>.margin--48_{{ side }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %} {# Axes #} {% set sub_title =
        "Axes" %}
        <h4>{{ sub_title }}</h4>
        {% set code_snippet %}
        <div class="">
            {% for axis in ["vertical","horizontal"] %}
            <div class="demo__box margin--12_{{ axis }}">
                <code>.margin--12_{{ axis }}</code>
            </div>
            <div class="demo__box margin--32_{{ axis }}">
                <code>.margin--32_{{ axis }}</code>
            </div>
            <div class="demo__box margin--64_{{ axis }}">
                <code>.margin--64_{{ axis }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
