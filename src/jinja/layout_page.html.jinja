<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Layout Page Default</title>
    <link rel="stylesheet" href="style.css" />
    <style>
        /* Optional preview styles */
        .header,
        .main,
        .footer {
            padding: q(16);
            color: white;
            font-weight: bold;
            text-align: center;
        }

        .header {
            background: var(--color_primary, #007aff);
        }

        .main {
            background: var(--color_surface_2, #f3f3f3);
            color: black;
        }

        .footer {
            background: var(--color_dark, #1e1e1e);
        }
    </style>
</head>

<body class="layout-page-default">

    <header class="header">
        Header Area
    </header>

    <main class="main">
        Main Content Area
        <p>This area can later become a grid with asides, sections, and articles.</p>
    </main>

    <footer class="footer">
        Footer Area
    </footer>

</body>

</html>
