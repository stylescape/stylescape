{% extends "base.html.jinja" %}

{% set title = "Alerts" %}

{%- block title %}{{ title }}{%- endblock %}

{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    <section class="demo__subsection">

        <div class="alert alert-primary">
            <strong>Primary Alert:</strong> This is a standard alert.
        </div>

        <div class="alert alert-success">
            <strong>Success!</strong> Your action was completed successfully.
        </div>

        <div class="alert alert-warning">
            <strong>Warning!</strong> Please double-check your settings.
        </div>

        <div class="alert alert-danger">
            <strong>Error:</strong> Something went wrong.
        </div>

        <div class="alert alert-info">
            <strong>Note:</strong> This alert includes a <a href="#" class="alert-link">link</a>.
        </div>

        <div class="alert alert-dismissible alert-secondary">
            <strong>Dismissible Alert:</strong> Click the close button to hide.
            <button type="button" class="btn-close" onclick="this.parentElement.remove();" aria-label="Close">&times;</button>
        </div>

    </section>
</section>

{%- endblock content %}
