{% extends "base.html.jinja" %}
{%- block title %}Shadow Utilities{%- endblock %}
{%- block content %}

{# ============================================================================
   Box Shadows
   ============================================================================ #}
<section class="demo__section" data-label="Box Shadows" data-level="1">
    <header class="demo__section__header">
        <h3>Box Shadows</h3>
        <p>Add depth to elements with box shadow utilities.</p>
    </header>

    <section class="demo__subsection">
        <h4>Shadow Sizes</h4>
        {% set code_snippet %}
<div class="shadow--none bg--fill_01 p--04 mb--04">No shadow</div>
<div class="shadow--sm bg--fill_01 p--04 mb--04">Small shadow</div>
<div class="shadow--md bg--fill_01 p--04 mb--04">Medium shadow</div>
<div class="shadow--lg bg--fill_01 p--04 mb--04">Large shadow</div>
<div class="shadow--xl bg--fill_01 p--04 mb--04">Extra large shadow</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Elevation Shadows
   ============================================================================ #}
<section class="demo__section" data-label="Elevation" data-level="1">
    <header class="demo__section__header">
        <h3>Elevation Shadows</h3>
        <p>Material design style elevation levels.</p>
    </header>

    <section class="demo__subsection">
        <h4>Elevation Levels</h4>
        {% set code_snippet %}
<div class="elevation--01 bg--fill_01 p--04 mb--04">Elevation 1 (cards)</div>
<div class="elevation--02 bg--fill_01 p--04 mb--04">Elevation 2 (raised cards)</div>
<div class="elevation--03 bg--fill_01 p--04 mb--04">Elevation 3 (drawers)</div>
<div class="elevation--04 bg--fill_01 p--04 mb--04">Elevation 4 (dialogs)</div>
<div class="elevation--05 bg--fill_01 p--04 mb--04">Elevation 5 (modals)</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Directional Shadows
   ============================================================================ #}
<section class="demo__section" data-label="Directional Shadows" data-level="1">
    <header class="demo__section__header">
        <h3>Directional Shadows</h3>
        <p>Shadows that appear to come from a specific direction.</p>
    </header>

    <section class="demo__subsection">
        <h4>Direction Variations</h4>
        {% set code_snippet %}
<div class="shadow--top bg--fill_01 p--04 mb--04">Shadow from top</div>
<div class="shadow--bottom bg--fill_01 p--04 mb--04">Shadow from bottom</div>
<div class="shadow--left bg--fill_01 p--04 mb--04">Shadow from left</div>
<div class="shadow--right bg--fill_01 p--04 mb--04">Shadow from right</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Inset Shadows
   ============================================================================ #}
<section class="demo__section" data-label="Inset Shadows" data-level="1">
    <header class="demo__section__header">
        <h3>Inset Shadows</h3>
        <p>Inner shadows for pressed or inset effects.</p>
    </header>

    <section class="demo__subsection">
        <h4>Inset Variations</h4>
        {% set code_snippet %}
<div class="shadow--inset bg--fill_01 p--04 mb--04">Inset shadow (pressed effect)</div>
<div class="shadow--inset-sm bg--fill_01 p--04 mb--04">Small inset shadow</div>
<div class="shadow--inset-lg bg--fill_01 p--04 mb--04">Large inset shadow</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Colored Shadows
   ============================================================================ #}
<section class="demo__section" data-label="Colored Shadows" data-level="1">
    <header class="demo__section__header">
        <h3>Colored Shadows</h3>
        <p>Shadows with semantic or custom colors.</p>
    </header>

    <section class="demo__subsection">
        <h4>Semantic Shadow Colors</h4>
        {% set code_snippet %}
<div class="shadow--primary bg--fill_01 p--04 mb--04">Primary colored shadow</div>
<div class="shadow--success bg--fill_01 p--04 mb--04">Success colored shadow</div>
<div class="shadow--warning bg--fill_01 p--04 mb--04">Warning colored shadow</div>
<div class="shadow--danger bg--fill_01 p--04 mb--04">Danger colored shadow</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Text Shadows
   ============================================================================ #}
<section class="demo__section" data-label="Text Shadows" data-level="1">
    <header class="demo__section__header">
        <h3>Text Shadows</h3>
        <p>Shadow effects applied to text.</p>
    </header>

    <section class="demo__subsection">
        <h4>Text Shadow Examples</h4>
        {% set code_snippet %}
<p class="text-shadow--sm fs--03">Small text shadow</p>
<p class="text-shadow--md fs--03">Medium text shadow</p>
<p class="text-shadow--lg fs--03">Large text shadow</p>
<p class="text-shadow--glow fs--03">Glowing text shadow</p>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
