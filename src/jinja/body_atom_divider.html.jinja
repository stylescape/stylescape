{% extends "base.html.jinja" %}
{% block title %}Divider Atom Demo{% endblock %}

{% block content %}
<section>
    <h1>Divider Demo</h1>

    <p>Above the standard divider</p>
    <hr class="divider" />
    <p>Below the standard divider</p>

    <h2>Variants</h2>

    <p>Thin:</p>
    <hr class="divider divider--thin" />

    <p>Thick:</p>
    <hr class="divider divider--thick" />

    <p>Dotted:</p>
    <hr class="divider divider--dotted" />

    <p>Vertical (inline):</p>
    <div style="display: flex; align-items: center; gap: 1rem;">
        <span>Left</span>
        <span class="divider--vertical"></span>
        <span>Right</span>
    </div>

</section>
{% endblock %}
