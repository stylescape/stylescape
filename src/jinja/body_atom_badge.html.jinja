{% extends "base.html.jinja" %}

{% set title = "Badge" %}

{%- block title %}{{ title }}{%- endblock %}

{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>
    
    <p>Documentation and examples for badges.</p>


    {% set section_title = "Default Badge" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
<p>I am a <span class="badge">Default</span> Badge.</p>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Square Badges" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
<p>
    <span class="badge">Default</span>
    <span class="badge badge--info badge--squared">Info</span>
    <span class="badge badge--success badge--squared">Success</span>
    <span class="badge badge--warning badge--squared">Warning</span>
    <span class="badge badge--error badge--squared">Error</span>
</p>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>



    {% set section_title = "Rounded Badges" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
<p>
    <span class="badge badge--rounded">Default</span>
    <span class="badge badge--info badge--rounded">Info</span>
    <span class="badge badge--success badge--rounded">Success</span>
    <span class="badge badge--warning badge--rounded">Warning</span>
    <span class="badge badge--error badge--rounded">Error</span>
</p>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>


    {% set section_title = "Pill Badges" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
<p>
    <span class="badge badge--pill">Default</span>
    <span class="badge badge--info badge--pill">Info</span>
    <span class="badge badge--success badge--pill">Success</span>
    <span class="badge badge--warning badge--pill">Warning</span>
    <span class="badge badge--error badge--pill">Error</span>
</p>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>


    {% set section_title = "Badge Sizes" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
<p><span class="badge">Paragraph</span></p>
<h1><span class="badge">Header 1</span></h1>
<h2><span class="badge">Header 2</span></h2>
<h3><span class="badge">Header 3</span></h3>
<h4><span class="badge">Header 4</span></h4>
<h5><span class="badge">Header 5</span></h5>
<h6><span class="badge">Header 6</span></h6>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>


</section>
{%- endblock %}
