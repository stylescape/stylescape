{% extends "base.html.jinja" %}
{%- block title %}Border Utilities{%- endblock %}
{%- block content %}

{# ============================================================================
   Border Styles
   ============================================================================ #}
<section class="demo__section" data-label="Border Styles" data-level="1">
    <header class="demo__section__header">
        <h3>Border Styles</h3>
        <p>Different border line styles.</p>
    </header>

    <section class="demo__subsection">
        <h4>Style Variations</h4>
        {% set code_snippet %}
<div class="border--solid p--04 mb--02">Solid border</div>
<div class="border--dashed p--04 mb--02">Dashed border</div>
<div class="border--dotted p--04 mb--02">Dotted border</div>
<div class="border--double p--04 mb--02">Double border</div>
<div class="border--none p--04 mb--02 bg--fill_02">No border</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Border Widths
   ============================================================================ #}
<section class="demo__section" data-label="Border Widths" data-level="1">
    <header class="demo__section__header">
        <h3>Border Widths</h3>
        <p>Control border thickness with width utilities.</p>
    </header>

    <section class="demo__subsection">
        <h4>Width Variations</h4>
        {% set code_snippet %}
<div class="border--solid border--w--01 p--04 mb--02">Border width 1px</div>
<div class="border--solid border--w--02 p--04 mb--02">Border width 2px</div>
<div class="border--solid border--w--03 p--04 mb--02">Border width 3px</div>
<div class="border--solid border--w--04 p--04 mb--02">Border width 4px</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Border Sides
   ============================================================================ #}
<section class="demo__section" data-label="Border Sides" data-level="1">
    <header class="demo__section__header">
        <h3>Border Sides</h3>
        <p>Apply borders to specific sides of an element.</p>
    </header>

    <section class="demo__subsection">
        <h4>Individual Sides</h4>
        {% set code_snippet %}
<div class="border--top p--04 mb--02">Border top only</div>
<div class="border--right p--04 mb--02">Border right only</div>
<div class="border--bottom p--04 mb--02">Border bottom only</div>
<div class="border--left p--04 mb--02">Border left only</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Axis Borders</h4>
        {% set code_snippet %}
<div class="border--x p--04 mb--02">Border left and right (x-axis)</div>
<div class="border--y p--04 mb--02">Border top and bottom (y-axis)</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Border Radius
   ============================================================================ #}
<section class="demo__section" data-label="Border Radius" data-level="1">
    <header class="demo__section__header">
        <h3>Border Radius</h3>
        <p>Round the corners of elements.</p>
    </header>

    <section class="demo__subsection">
        <h4>Radius Sizes</h4>
        {% set code_snippet %}
<div class="border--solid rounded--00 p--04 mb--02 d--inline-block">No radius (sharp)</div>
<div class="border--solid rounded--01 p--04 mb--02 d--inline-block">Small radius</div>
<div class="border--solid rounded--02 p--04 mb--02 d--inline-block">Medium radius</div>
<div class="border--solid rounded--03 p--04 mb--02 d--inline-block">Large radius</div>
<div class="border--solid rounded--full p--04 mb--02 d--inline-block">Full radius (pill)</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Corner-Specific Radius</h4>
        {% set code_snippet %}
<div class="border--solid rounded--top p--04 mb--02">Rounded top corners</div>
<div class="border--solid rounded--bottom p--04 mb--02">Rounded bottom corners</div>
<div class="border--solid rounded--left p--04 mb--02">Rounded left corners</div>
<div class="border--solid rounded--right p--04 mb--02">Rounded right corners</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Circle</h4>
        {% set code_snippet %}
<div class="border--solid rounded--circle w--64 h--64 d--flex align-items--center justify-content--center">
    Circle
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Border Colors
   ============================================================================ #}
<section class="demo__section" data-label="Border Colors" data-level="1">
    <header class="demo__section__header">
        <h3>Border Colors</h3>
        <p>Apply semantic and custom colors to borders.</p>
    </header>

    <section class="demo__subsection">
        <h4>Semantic Colors</h4>
        {% set code_snippet %}
<div class="border--solid border--primary p--04 mb--02">Primary border color</div>
<div class="border--solid border--secondary p--04 mb--02">Secondary border color</div>
<div class="border--solid border--success p--04 mb--02">Success border color</div>
<div class="border--solid border--warning p--04 mb--02">Warning border color</div>
<div class="border--solid border--danger p--04 mb--02">Danger border color</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
