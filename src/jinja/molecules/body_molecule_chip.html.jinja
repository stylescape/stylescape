{% extends "../base.html.jinja" %} {% set title = "Chips" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
        <p>Compact elements for tags, categories, filters, and selections.</p>
    </header>

    {# Basic Chips #} {% set section_title = "Basic Chips" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span class="chip">Basic Chip</span>
            <span class="chip">Design</span>
            <span class="chip">Development</span>
            <span class="chip">Marketing</span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Chips with Avatar #} {% set section_title = "Chips with Avatar" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span
                class="chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                <img
                    src="https://via.placeholder.com/24"
                    alt="User"
                    style="width: 24px; height: 24px; border-radius: 50%"
                />
                John Doe
            </span>
            <span
                class="chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                <img
                    src="https://via.placeholder.com/24"
                    alt="User"
                    style="width: 24px; height: 24px; border-radius: 50%"
                />
                Jane Smith
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Dismissible Chips #} {% set section_title = "Dismissible Chips" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span
                class="chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                JavaScript
                <button
                    class="chip__close"
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 14px;
                        opacity: 0.7;
                    "
                >
                    &times;
                </button>
            </span>
            <span
                class="chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                TypeScript
                <button
                    class="chip__close"
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 14px;
                        opacity: 0.7;
                    "
                >
                    &times;
                </button>
            </span>
            <span
                class="chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                Python
                <button
                    class="chip__close"
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 14px;
                        opacity: 0.7;
                    "
                >
                    &times;
                </button>
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Colored Chips #} {% set section_title = "Colored Chips" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span
                class="chip"
                style="background: var(--color_state_info); color: white"
            >
                Info
            </span>
            <span
                class="chip"
                style="background: var(--color_state_success); color: white"
            >
                Success
            </span>
            <span class="chip" style="background: var(--color_state_warning)">
                Warning
            </span>
            <span
                class="chip"
                style="background: var(--color_state_error); color: white"
            >
                Error
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Outlined Chips #} {% set section_title = "Outlined Chips" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span
                class="chip"
                style="
                    background: transparent;
                    border: 1px solid var(--color_line_primary);
                "
            >
                Outlined
            </span>
            <span
                class="chip"
                style="
                    background: transparent;
                    border: 1px solid var(--color_state_info);
                    color: var(--color_state_info);
                "
            >
                Info
            </span>
            <span
                class="chip"
                style="
                    background: transparent;
                    border: 1px solid var(--color_state_success);
                    color: var(--color_state_success);
                "
            >
                Success
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Chips Input #} {% set section_title = "Chips Input Field" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div
            class="chips-input"
            style="
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                padding: 8px 12px;
                border: 1px solid var(--color_line_secondary);
                border-radius: 8px;
                min-height: 48px;
                align-items: center;
            "
        >
            <span
                class="chip"
                style="
                    display: inline-flex;
                    align-items: center;
                    gap: 4px;
                    font-size: 13px;
                "
            >
                Tag 1
                <button
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 12px;
                    "
                >
                    &times;
                </button>
            </span>
            <span
                class="chip"
                style="
                    display: inline-flex;
                    align-items: center;
                    gap: 4px;
                    font-size: 13px;
                "
            >
                Tag 2
                <button
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 12px;
                    "
                >
                    &times;
                </button>
            </span>
            <input
                type="text"
                placeholder="Add tag..."
                style="
                    border: none;
                    outline: none;
                    flex: 1;
                    min-width: 100px;
                    background: transparent;
                "
            />
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
