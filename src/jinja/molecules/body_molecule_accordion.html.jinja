{% extends "../base.html.jinja" %} {%- block title %}Accordion{%- endblock %} {%-
block content %} {#
============================================================================
Basic Accordion
============================================================================ #}
<section class="demo__section" data-label="Basic Accordion" data-level="1">
    <header class="demo__section__header">
        <h3>Basic Accordion</h3>
        <p>Expandable content panels using native HTML details element.</p>
    </header>

    <section class="demo__subsection">
        <h4>Single Accordion</h4>
        {% set code_snippet %}
        <details class="accordion">
            <summary class="accordion__header">
                <span class="accordion__title">Accordion Title</span>
                <span class="accordion__icon"></span>
            </summary>
            <div class="accordion__content">
                <p>
                    This is the accordion content. It can contain any HTML
                    elements including text, images, lists, and more.
                </p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Initially Open</h4>
        {% set code_snippet %}
        <details class="accordion" open>
            <summary class="accordion__header">
                <span class="accordion__title">
                    This accordion starts open
                </span>
                <span class="accordion__icon"></span>
            </summary>
            <div class="accordion__content">
                <p>
                    Use the "open" attribute on the details element to have it
                    expanded by default.
                </p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Accordion Group
============================================================================ #}
<section class="demo__section" data-label="Accordion Group" data-level="1">
    <header class="demo__section__header">
        <h3>Accordion Group</h3>
        <p>Multiple accordions grouped together.</p>
    </header>

    <section class="demo__subsection">
        <h4>Stacked Accordions</h4>
        {% set code_snippet %}
        <div class="accordion_group">
            <details class="accordion">
                <summary class="accordion__header">
                    <span class="accordion__title">What is Stylescape?</span>
                    <span class="accordion__icon"></span>
                </summary>
                <div class="accordion__content">
                    <p>
                        Stylescape is a visual identity framework that provides
                        a comprehensive design system for building consistent
                        user interfaces.
                    </p>
                </div>
            </details>

            <details class="accordion">
                <summary class="accordion__header">
                    <span class="accordion__title">How do I get started?</span>
                    <span class="accordion__icon"></span>
                </summary>
                <div class="accordion__content">
                    <p>
                        Install Stylescape via npm and import the styles into
                        your project. Check the documentation for detailed
                        setup instructions.
                    </p>
                </div>
            </details>

            <details class="accordion">
                <summary class="accordion__header">
                    <span class="accordion__title">Is it customizable?</span>
                    <span class="accordion__icon"></span>
                </summary>
                <div class="accordion__content">
                    <p>
                        Yes! Stylescape uses CSS custom properties that can be
                        easily customized to match your brand colors,
                        typography, and spacing.
                    </p>
                </div>
            </details>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Exclusive Accordion (name attribute)</h4>
        <p>
            Using the same name attribute creates an exclusive group where only
            one can be open.
        </p>
        {% set code_snippet %}
        <div class="accordion_group">
            <details class="accordion" name="faq-group" open>
                <summary class="accordion__header">
                    <span class="accordion__title">First Question</span>
                    <span class="accordion__icon"></span>
                </summary>
                <div class="accordion__content">
                    <p>
                        Only one accordion in this group can be open at a time.
                    </p>
                </div>
            </details>

            <details class="accordion" name="faq-group">
                <summary class="accordion__header">
                    <span class="accordion__title">Second Question</span>
                    <span class="accordion__icon"></span>
                </summary>
                <div class="accordion__content">
                    <p>Opening this will automatically close the other.</p>
                </div>
            </details>

            <details class="accordion" name="faq-group">
                <summary class="accordion__header">
                    <span class="accordion__title">Third Question</span>
                    <span class="accordion__icon"></span>
                </summary>
                <div class="accordion__content">
                    <p>This behavior uses the native HTML "name" attribute.</p>
                </div>
            </details>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Accordion Variants
============================================================================ #}
<section class="demo__section" data-label="Accordion Variants" data-level="1">
    <header class="demo__section__header">
        <h3>Accordion Variants</h3>
        <p>Different visual styles for accordions.</p>
    </header>

    <section class="demo__subsection">
        <h4>Bordered Accordion</h4>
        {% set code_snippet %}
        <details class="accordion accordion--bordered">
            <summary class="accordion__header">
                <span class="accordion__title">Bordered Style</span>
                <span class="accordion__icon"></span>
            </summary>
            <div class="accordion__content">
                <p>This accordion has a visible border around it.</p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Filled Accordion</h4>
        {% set code_snippet %}
        <details class="accordion accordion--filled">
            <summary class="accordion__header">
                <span class="accordion__title">Filled Background</span>
                <span class="accordion__icon"></span>
            </summary>
            <div class="accordion__content">
                <p>This accordion has a filled background color.</p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Flush Accordion</h4>
        {% set code_snippet %}
        <div class="accordion_group accordion_group--flush">
            <details class="accordion">
                <summary class="accordion__header">
                    <span class="accordion__title">Flush Item One</span>
                    <span class="accordion__icon"></span>
                </summary>
                <div class="accordion__content">
                    <p>
                        No outer borders or rounded corners for a cleaner look.
                    </p>
                </div>
            </details>

            <details class="accordion">
                <summary class="accordion__header">
                    <span class="accordion__title">Flush Item Two</span>
                    <span class="accordion__icon"></span>
                </summary>
                <div class="accordion__content">
                    <p>
                        Works well when embedded in cards or other containers.
                    </p>
                </div>
            </details>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Rich Content
============================================================================ #}
<section class="demo__section" data-label="Rich Content" data-level="1">
    <header class="demo__section__header">
        <h3>Rich Content</h3>
        <p>Accordions with various content types.</p>
    </header>

    <section class="demo__subsection">
        <h4>Mixed Content</h4>
        {% set code_snippet %}
        <details class="accordion">
            <summary class="accordion__header">
                <span class="accordion__title">
                    Accordion with Rich Content
                </span>
                <span class="accordion__icon"></span>
            </summary>
            <div class="accordion__content">
                <h4>Section Heading</h4>
                <p>Paragraph content explaining the section.</p>
                <ul>
                    <li>List item one</li>
                    <li>List item two</li>
                    <li>List item three</li>
                </ul>
                <button class="button button--primary">Action Button</button>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
