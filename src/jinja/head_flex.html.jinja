{% extends "base.html.jinja" %} {% set title = "Grids" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% set section_title = "Flex Row" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set code_snippet %}
        <div class="flex--row" style="gap: 1rem">
            <div class="demo-box">Item 1</div>
            <div class="demo-box">Item 2</div>
            <div class="demo-box">Item 3</div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Flex Column" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set code_snippet %}
        <div class="flex--col" style="gap: 1rem">
            <div class="demo-box">Item A</div>
            <div class="demo-box">Item B</div>
            <div class="demo-box">Item C</div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Flex Wrap" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set code_snippet %}
        <div class="flex--row flex--wrap" style="gap: 1rem">
            <div class="demo-box" style="width: 30%">Box 1</div>
            <div class="demo-box" style="width: 30%">Box 2</div>
            <div class="demo-box" style="width: 30%">Box 3</div>
            <div class="demo-box" style="width: 30%">Box 4</div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Align Self" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set code_snippet %}
        <div
            class="flex--row"
            style="height: 120px; align-items: stretch; gap: 1rem"
        >
            <div class="demo-box align_self--start">start</div>
            <div class="demo-box align_self--center">center</div>
            <div class="demo-box align_self--end">end</div>
            <div class="demo-box align_self--stretch">stretch</div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Flex Row Reverse" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set code_snippet %}
        <div class="flex--row--reverse" style="gap: 1rem">
            <div class="demo-box">First</div>
            <div class="demo-box">Second</div>
            <div class="demo-box">Third</div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Flex Column Reverse" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set code_snippet %}
        <div class="flex--col--reverse" style="gap: 1rem">
            <div class="demo-box">Bottom</div>
            <div class="demo-box">Middle</div>
            <div class="demo-box">Top</div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>
</section>
{%- endblock content %}
