    {% set section_title = "Input States" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <!-- Default -->
        <div class="field-group">
            <label for="default" class="label">Default</label>
            <input
                id="default"
                type="text"
                class="input"
                placeholder="Default"
            />
        </div>

        <!-- Focus -->
        <div class="field-group">
            <label for="focus" class="label">Focus</label>
            <input
                id="focus"
                type="text"
                class="input"
                placeholder="Focus me"
            />
        </div>

        <!-- Disabled -->
        <div class="field-group">
            <label for="disabled" class="label">Disabled</label>
            <input
                id="disabled"
                type="text"
                class="input"
                disabled
                placeholder="Can't type"
            />
        </div>

        <!-- Success -->
        <div class="field-group">
            <label for="success" class="label">Success</label>
            <input
                id="success"
                type="text"
                class="input is_success"
                placeholder="Valid input"
            />
        </div>

        <!-- Warning -->
        <div class="field-group">
            <label for="warning" class="label">Warning</label>
            <input
                id="warning"
                type="text"
                class="input is_warning"
                placeholder="Might need attention"
            />
        </div>

        <!-- Error -->
        <div class="field-group">
            <label for="error" class="label">Error</label>
            <input
                id="error"
                type="text"
                class="input is_error"
                placeholder="Incorrect input"
            />
        </div>

        <!-- Info -->
        <div class="field-group">
            <label for="info" class="label">Info</label>
            <input
                id="info"
                type="text"
                class="input is_info"
                placeholder="Helpful context"
            />
        </div>

        <!-- Focus-visible test -->
        <div class="field-group">
            <label for="focus-visible" class="label">
                Focus-visible (keyboard tab)
            </label>
            <input
                id="focus-visible"
                type="text"
                class="input"
                placeholder="Tab into me"
            />
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

