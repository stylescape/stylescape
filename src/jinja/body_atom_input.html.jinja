{% extends "base.html.jinja" %}

{% set title = "Input Elements" %}

{%- block title %}{{ title }}{%- endblock %}

{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>


    {% set section_title = "Table Size SM" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
    
        {% set code_snippet %}
            <div class="">
                <span>
                    Paragraph text to describe the form and its purpose. This section can include instructions or any other relevant
                    information for the user.
                </span>
                <label for="input_text" class="label">Text Input</label>
                <input type="text" id="input_text" class="input" placeholder="Enter text" />
                <span>
                    Paragraph text to describe the form and its purpose. This section can include instructions or any other relevant
                    information for the user.
                </span>
            </div>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Table Size SM" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
    
        {% set code_snippet %}
<div class="form-section">
    <p class="form-description">
        Please fill out the following fields to update your contact information. All fields marked with * are required.
    </p>

    <label for="full_name" class="label">Full Name *</label>
    <input type="text" id="full_name" class="input input--straight" placeholder="e.g. Jane Doe" required />

    <label for="email" class="label">Email Address *</label>
    <input type="email" id="email" class="input input--straight" placeholder="e.g. jane@example.com" required />

    <label for="organization" class="label">Organization</label>
    <input type="text" id="organization" class="input input--straight" placeholder="e.g. Scape Agency" />

    <p class="form-note">
        Your information is used only for internal purposes and will not be shared with third parties.
    </p>
</div>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>




    <section class="demo__subsection">

        <form class="">

            <div class="">
            Paragraph text to describe the form and its purpose. This section can include instructions or any other relevant information for the user.
                <label for="input_text" class="label">Text Input</label>
                <input type="text" id="input_text" class="input" placeholder="Enter text" />
            Paragraph text to describe the form and its purpose. This section can include instructions or any other relevant
            information for the user.
            </div>

            <div class="form_group">
                <label for="input_email" class="label">Email</label>
                <input type="email" id="input_email" class="input" placeholder="your@email.com" />
            </div>

            <div class="form_group">
                <label for="input_password" class="label">Password</label>
                <input type="password" id="input_password" class="input" />
            </div>

            <div class="form_group">
                <label for="input_select" class="label">Select</label>
                <select id="input_select" class="input">
                    <option value="">Choose</option>
                    <option value="1">Option One</option>
                    <option value="2">Option Two</option>
                </select>
            </div>

            <div class="form_group">
                <label class="label">Checkbox</label>
                <label>
                    <input type="checkbox" />
                    Subscribe to newsletter
                </label>
            </div>

            <div class="form_group">
                <label class="label">Radio</label>
                <label><input type="radio" name="radio" class="input_radio" checked /> Option A</label>
                <label><input type="radio" name="radio" class="input_radio" /> Option B</label>
            </div>

            <div class="form_group">
                <label for="input_textarea" class="label">Textarea</label>
                <textarea id="input_textarea" class="input"></textarea>
            </div>

            <div class="form_group">
                <button type="submit" class="button button--md button--solid">Submit</button>
            </div>

        </form>
    </section>
</section>
{%- endblock %}
