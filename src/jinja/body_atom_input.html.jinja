{% extends "base.html.jinja" %} {% set title = "Input Elements" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% set section_title = "Inline Input" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="">
            <label>Default Inline:</label>
            <span>I am</span>
            <label for="input_text_name" class="label label--hidden">
                Name
            </label>
            <input
                type="text"
                id="input_text_name"
                class="input input--base--inline"
                placeholder="Name"
            />
            <span>and I live in</span>
            <label for="input_text_place" class="label label--hidden">
                Place
            </label>
            <input
                type="text"
                id="input_text_place"
                class="input input--base--inline"
                placeholder="Place"
            />
        </div>
        <div class="">
            <label>Straight Inline:</label>
            <span>I am</span>
            <label for="input_text_name" class="label label--hidden">
                Name
            </label>
            <input
                type="text"
                id="input_text_name"
                class="input input--base--inline input--style--straight"
                placeholder="Name"
            />
            <span>and I live in</span>
            <label for="input_text_place" class="label label--hidden">
                Place
            </label>
            <input
                type="text"
                id="input_text_place"
                class="input input--base--inline input--style--straight"
                placeholder="Place"
            />
        </div>
        <div class="">
            <label>Rounded Inline:</label>
            <span>I am</span>
            <label for="input_text_name" class="label label--hidden">
                Name
            </label>
            <input
                type="text"
                id="input_text_name"
                class="input input--base--inline input--style--rounded"
                placeholder="Name"
            />
            <span>and I live in</span>
            <label for="input_text_place" class="label label--hidden">
                Place
            </label>
            <input
                type="text"
                id="input_text_place"
                class="input input--base--inline input--style--rounded"
                placeholder="Place"
            />
        </div>
        <div class="">
            <label>Underline Inline:</label>
            <span>I am</span>
            <label for="input_text_name" class="label label--hidden">
                Name
            </label>
            <input
                type="text"
                id="input_text_name"
                class="input input--base--inline input--style--underline"
                placeholder="Name"
            />
            <span>and I live in</span>
            <label for="input_text_place" class="label label--hidden">
                Place
            </label>
            <input
                type="text"
                id="input_text_place"
                class="input input--base--inline input--style--underline"
                placeholder="Place"
            />
        </div>
        <div class="">
            <label>Filled Inline:</label>
            <span>I am</span>
            <label for="input_text_name" class="label label--hidden">
                Name
            </label>
            <input
                type="text"
                id="input_text_name"
                class="input input--base--inline input--style--filled"
                placeholder="Name"
            />
            <span>and I live in</span>
            <label for="input_text_place" class="label label--hidden">
                Place
            </label>
            <input
                type="text"
                id="input_text_place"
                class="input input--base--inline input--style--filled"
                placeholder="Place"
            />
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

