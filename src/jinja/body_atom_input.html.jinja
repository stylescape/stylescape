    {% set section_title = "Default Form Column ()" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}

        <form class="form--col">
            <label for="name">Name</label>
            <input
                type="text"
                id="name"
                class="input"
                placeholder="Your full name"
            />
            <label for="email">Email</label>
            <input
                type="email"
                id="email"
                class="input"
                placeholder="you@example.com"
            />
            <label for="bio">Bio</label>
            <textarea
                id="bio"
                class="input"
                rows="4"
                placeholder="Tell us something..."
            ></textarea>
            <button type="submit" class="button button--solid">Submit</button>
            <button type="reset" class="button button--solid">Reset</button>
        </form>

        {% endset %} {% set language="HTML" %} {%- include
