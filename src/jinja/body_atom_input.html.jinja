{% set section_title = "Login Form" %}
<section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
    <h3>{{ section_title }}</h3>
    {% set code_snippet %}

    <form
        class="form--col"
        method="post"
        action="/authentication/login/"
    >
            
        <div class="form__field">

            <input 
                type="text"
                name="username"
                id="id_username"
                class="form__field__input"
                minlength="3"
                maxlength="30"
                placeholder="Username"
                required
                aria-labelledby="id_username_label"
                aria-describedby="id_username_help id_username_error"
            />
            <label
                
                for="id_username"
                title="Please provide a username."
                id="id_username_label"
                class="form__field__label">
                
                Username
            </label>
            <span
                id="id_username_help"
                class="form__field__help"
            >
                Please provide a username.
            </span>
            <span
                id="id_username_error"
                class="form__field__error"
                aria-live="polite"
            >
                Required. 30 characters or fewer. Letters and digits.
            </span>
        </div>

        <div class="form__field">

            <input 
                type="password"
                name="password"
                id="id_password"
                class=""
                minlength="3"
                maxlength="30"
                placeholder="Password"
                required
                aria-labelledby="id_username_label"
                aria-describedby="id_password_help id_password_error"
            />
            <label for="id_password" id="id_password_label" class="">
                Password
            </label>
            <p
                id="id_password_help"
                class="form__field__help"
            >
                Required. 8 characters or more.
            </p>
            <div
                id="id_password_error"
                class="form__field__error"
                aria-live="polite"
            >
                Required. 8 characters or more.
            </div>
        </div>
    
        <div class="form__field">
            <label for="id_remember_me" class="">
                Remember Me
            </label>
            <input 
                type="checkbox"
                name="remember_me"
                id="id_remember_me"
                class=""
            />
            <p
                id="id_remember_me_help"
                class="form__field__help"
            >
                Keep me logged in for 30 days.
            </p>
            <div
                id="id_remember_me_error"
                class="form__field__error"
                aria-live="polite"
            >
                Keep me logged in for 30 days.
            </div>
        </div>

        <button type="button" class="toggle-password" data-password-toggle="id_password" aria-pressed="false">
            👁 Toggle
        </button>

        <button type="submit" class="button button--solid">
            Login
        </button>
    
    
        <div class="form_field_info">
            <label class="form_field_label" for="id_password">
                Password
    
            </label>
            <small class="form_field_help">
    
            </small>
            <span class="form_field_errors">
            </span>
        </div>
    
        <div class="form_field_input">
            <input type="password" name="password" placeholder="Password" autocomplete="current-password"
                class="form-control form_field" id="id_password" required="">
        </div>
    
    
    
    
    
    
    
    
        <button type="button" class="toggle-password" data-password-toggle="id_password" aria-pressed="false">
            👁 Toggle
        </button>
    
    
        <input class="form_label" id="id_remember_me" type="checkbox" style="width:1em">
    
    
        <button class="account_form_button" type="submit">
            Login
        </button>
    
    
    
    <p><span class="req">*</span> - Required field</p>

    </form>

{% endset %}
{% set language="HTML" %}
{%- include "includes/preview_box_code.html.jinja" %}
</section>



</section>
