{% extends "base.html.jinja" %}

{% set title = "Character Styles" %}

{%- block title %}{{ title }}{%- endblock %}

{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

<section class="demo__section">

    <div class="font-preview-controls">
        <label for="font-preview-input">Preview text:</label>
        <input id="font-preview-input" type="text" placeholder="The quick brown fox…" />
    </div>

</section>


<section class="demo__section">

    <header class="demo__section__header">
        <h3>Hyperlink Character Styles</h3>
    </header>

    {% set fonts = [
    { label: ".character--hyperlink--clean", class: "character--hyperlink--clean" },
    { label: ".character--hyperlink--base", class: "character--hyperlink--base" },
    { label: ".character--hyperlink--normal", class: "character--hyperlink--normal" },
    { label: ".character--hyperlink--line", class: "character--hyperlink--line" },
    { label: ".character--hyperlink--line_alt", class: "character--hyperlink--line_alt" }
    ] %}

    {% for font in fonts %}
    {% set label = font.label %}
    {% set class = font.class %}
    <div class="demo__subsection">
        {%- include "includes/preview_box_font.html.jinja" %}
    </div>
    {% endfor %}

</section>


<section class="demo__section">

    <header class="demo__section__header">
        <h3>Lined Character Styles</h3>
    </header>

    {% set fonts = [
    { label: ".character--line", class: "character--line" },
    { label: ".character--line--under", class: "character--line--under" },
    { label: ".character--line--over", class: "character--line--over" },
    { label: ".character--line--through", class: "character--line--through" },
    { label: ".character--line_alt", class: "character--line_alt" },
    { label: ".character--line--under_alt", class: "character--line--under_alt" },
    { label: ".character--line--over_alt", class: "character--line--over_alt" },
    { label: ".character--line--through_alt", class: "character--line--through_alt" }
    ] %}

    {% for font in fonts %}
    {% set label = font.label %}
    {% set class = font.class %}
    <div class="demo__subsection">
        {%- include "includes/preview_box_font.html.jinja" %}
    </div>
    {% endfor %}

</section>

{%- endblock %}
