{% extends "base.html.jinja" %} {% set title = "Video" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% set section_title = "Basic Video Player" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="video-player">
            <div class="video-player__wrapper">
                <video controls poster="https://picsum.photos/800/450">
                    <source src="#" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Video with Thumbnail" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="video-player">
            <div class="video-player__wrapper">
                <div class="video-player__image">
                    <img src="https://picsum.photos/800/450" alt="Video thumbnail">
                </div>
            </div>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Vertical Video (9:16)" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="video-player" data-vertical-orientation="true" style="max-width: 300px;">
            <div class="video-player__wrapper">
                <video controls poster="https://picsum.photos/450/800">
                    <source src="#" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Video Player Container" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="video-player">
            <div class="video-player__wrapper">
                <div class="fave-player-container">
                    <div class="theoplayer-container" style="width: 100%; height: 100%; background: #000; display: flex; justify-content: center; align-items: center; color: #fff;">
                        Video Player Placeholder
                    </div>
                </div>
            </div>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

</section>

{%- endblock %}
