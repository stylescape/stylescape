{% extends "base.html.jinja" %} {%- block title %}Button Group{%- endblock %}
{%- block content %} {#
============================================================================
Basic Button Group
============================================================================ #}
<section class="demo__section" data-label="Basic Button Group" data-level="1">
    <header class="demo__section__header">
        <h3>Basic Button Group</h3>
        <p>Group related buttons together in a horizontal row.</p>
    </header>

    <section class="demo__subsection">
        <h4>Simple Button Group</h4>
        {% set code_snippet %}
        <div class="button_group" role="group" aria-label="Basic button group">
            <button class="button">Left</button>
            <button class="button">Middle</button>
            <button class="button">Right</button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>With Links</h4>
        {% set code_snippet %}
        <div class="button_group" role="group" aria-label="Navigation group">
            <a href="#" class="button">Previous</a>
            <a href="#" class="button">Current</a>
            <a href="#" class="button">Next</a>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Button Group Variants
============================================================================ #}
<section class="demo__section" data-label="Variants" data-level="1">
    <header class="demo__section__header">
        <h3>Button Group Variants</h3>
        <p>Different visual styles for button groups.</p>
    </header>

    <section class="demo__subsection">
        <h4>Primary Group</h4>
        {% set code_snippet %}
        <div class="button_group" role="group" aria-label="Primary group">
            <button class="button button--primary">One</button>
            <button class="button button--primary">Two</button>
            <button class="button button--primary">Three</button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Outline Group</h4>
        {% set code_snippet %}
        <div class="button_group" role="group" aria-label="Outline group">
            <button class="button button--outline">One</button>
            <button class="button button--outline">Two</button>
            <button class="button button--outline">Three</button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Mixed Variants</h4>
        {% set code_snippet %}
        <div class="button_group" role="group" aria-label="Mixed group">
            <button class="button button--success">Approve</button>
            <button class="button button--warning">Review</button>
            <button class="button button--danger">Reject</button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Vertical Button Group
============================================================================ #}
<section class="demo__section" data-label="Vertical Group" data-level="1">
    <header class="demo__section__header">
        <h3>Vertical Button Group</h3>
        <p>Stack buttons vertically instead of horizontally.</p>
    </header>

    <section class="demo__subsection">
        <h4>Basic Vertical</h4>
        {% set code_snippet %}
        <div
            class="button_group button_group--vertical"
            role="group"
            aria-label="Vertical group"
        >
            <button class="button">Top</button>
            <button class="button">Middle</button>
            <button class="button">Bottom</button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Vertical Menu Style</h4>
        {% set code_snippet %}
        <div
            class="button_group button_group--vertical"
            role="group"
            aria-label="Menu"
        >
            <button class="button button--outline">Dashboard</button>
            <button class="button button--outline">Settings</button>
            <button class="button button--outline">Profile</button>
            <button class="button button--outline">Logout</button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Button Group Sizes
============================================================================ #}
<section class="demo__section" data-label="Sizes" data-level="1">
    <header class="demo__section__header">
        <h3>Button Group Sizes</h3>
        <p>Button groups in different sizes.</p>
    </header>

    <section class="demo__subsection">
        <h4>Size Variations</h4>
        {% set code_snippet %}
        <div class="button_group mb--02" role="group" aria-label="Small group">
            <button class="button button--sm">Small</button>
            <button class="button button--sm">Small</button>
            <button class="button button--sm">Small</button>
        </div>

        <div
            class="button_group mb--02"
            role="group"
            aria-label="Default group"
        >
            <button class="button">Default</button>
            <button class="button">Default</button>
            <button class="button">Default</button>
        </div>

        <div class="button_group" role="group" aria-label="Large group">
            <button class="button button--lg">Large</button>
            <button class="button button--lg">Large</button>
            <button class="button button--lg">Large</button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Split Button
============================================================================ #}
<section class="demo__section" data-label="Split Button" data-level="1">
    <header class="demo__section__header">
        <h3>Split Button</h3>
        <p>Button with a dropdown toggle for additional actions.</p>
    </header>

    <section class="demo__subsection">
        <h4>Split Button Dropdown</h4>
        {% set code_snippet %}
        <div class="button_group" role="group" aria-label="Split button">
            <button class="button button--primary">Save</button>
            <button
                class="button button--primary button--icon"
                aria-label="More options"
            >
                ▼
            </button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Toggle Button Group
============================================================================ #}
<section class="demo__section" data-label="Toggle Group" data-level="1">
    <header class="demo__section__header">
        <h3>Toggle Button Group</h3>
        <p>Button group for selecting options.</p>
    </header>

    <section class="demo__subsection">
        <h4>Single Selection</h4>
        {% set code_snippet %}
        <div
            class="button_group button_group--toggle"
            role="group"
            aria-label="View mode"
        >
            <button class="button button--active" aria-pressed="true">
                List
            </button>
            <button class="button" aria-pressed="false">Grid</button>
            <button class="button" aria-pressed="false">Table</button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Multiple Selection</h4>
        {% set code_snippet %}
        <div
            class="button_group button_group--toggle"
            role="group"
            aria-label="Text formatting"
        >
            <button class="button button--active" aria-pressed="true">
                <strong>B</strong>
            </button>
            <button class="button" aria-pressed="false"><em>I</em></button>
            <button class="button button--active" aria-pressed="true">
                <u>U</u>
            </button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Toolbar
============================================================================ #}
<section class="demo__section" data-label="Toolbar" data-level="1">
    <header class="demo__section__header">
        <h3>Toolbar</h3>
        <p>Multiple button groups combined into a toolbar.</p>
    </header>

    <section class="demo__subsection">
        <h4>Editor Toolbar</h4>
        {% set code_snippet %}
        <div class="toolbar" role="toolbar" aria-label="Editor toolbar">
            <div
                class="button_group"
                role="group"
                aria-label="File operations"
            >
                <button class="button">New</button>
                <button class="button">Open</button>
                <button class="button">Save</button>
            </div>
            <div
                class="button_group"
                role="group"
                aria-label="Edit operations"
            >
                <button class="button">Cut</button>
                <button class="button">Copy</button>
                <button class="button">Paste</button>
            </div>
            <div class="button_group" role="group" aria-label="Format">
                <button class="button"><strong>B</strong></button>
                <button class="button"><em>I</em></button>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
