{% extends "base.html.jinja" %}

{% set title = "Tooltip" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h3>{{ title }}</h3>
    </header>




    {# ----------------------------------------------------------------------------
    Tooltip Top
    ---------------------------------------------------------------------------- #}

    <section class="demo__subsection">
        <h4>Tooltip Top</h4>
        {% set code_snippet %}
        <div class="tooltip tooltip--top" tooltip-data="Tooltip on top">
            Hover me (Top)
        </div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview_box_code.html.jinja" %}
    </section>

    {# ----------------------------------------------------------------------------
    Tooltip Right
    ---------------------------------------------------------------------------- #}

    <section class="demo__subsection">
        <h4>Tooltip Right</h4>
        {% set code_snippet %}
