                    data-editable="settings">

                    <div class="image__container " data-image-variation="image"
                        data-breakpoints="{&quot;image--eq-extra-small&quot;: 115, &quot;image--eq-small&quot;: 300, &quot;image--show-credits&quot;: 525}">
                        <picture class="image__picture"><img
