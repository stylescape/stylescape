{% extends "../base.html.jinja" %}
{% set title = "Labels" %}
{%- block title %}{{ title }}{%- endblock %}
{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
        <p>Label components for form elements and content annotation.</p>
    </header>

    <!-- ================================================================== -->
    <!-- Native Labels -->
    <!-- ================================================================== -->

    {% set section_title = "Native Labels" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>The <code>&lt;label&gt;</code> element styled with base label styles.</p>

        {% set code_snippet %}
<label for="demo-input-1">Default Label</label>
<input type="text" id="demo-input-1" class="input input--base" placeholder="Input field">
        {% endset %}
        {{ code_snippet | safe }}
        <details class="demo__code">
            <summary>View Code</summary>
            <pre><code>{{ code_snippet | e }}</code></pre>
        </details>
    </section>

    <!-- ================================================================== -->
    <!-- Label Sizes -->
    <!-- ================================================================== -->

    {% set section_title = "Label Sizes" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Labels come in three sizes: small, medium (default), and large.</p>

        {% set code_snippet %}
<div style="display: flex; flex-direction: column; gap: 24px;">
    <div>
        <label class="label label--sm" for="demo-sm">Small Label (.label--sm)</label>
        <input type="text" id="demo-sm" class="input input--base input--sm" placeholder="Small input">
    </div>

    <div>
        <label class="label label--md" for="demo-md">Medium Label (.label--md)</label>
        <input type="text" id="demo-md" class="input input--base input--md" placeholder="Medium input">
    </div>

    <div>
        <label class="label label--lg" for="demo-lg">Large Label (.label--lg)</label>
        <input type="text" id="demo-lg" class="input input--base input--lg" placeholder="Large input">
    </div>
</div>
        {% endset %}
        {{ code_snippet | safe }}
        <details class="demo__code">
            <summary>View Code</summary>
            <pre><code>{{ code_snippet | e }}</code></pre>
        </details>
    </section>

    <!-- ================================================================== -->
    <!-- Hidden Labels (Accessible) -->
    <!-- ================================================================== -->

    {% set section_title = "Hidden Labels (Screen Reader Only)" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Visually hidden labels that remain accessible to screen readers. Essential for accessibility when the input's purpose is clear visually but needs labeling for assistive technology.</p>

        {% set code_snippet %}
<div style="display: flex; gap: 12px; align-items: center;">
    <label class="label label--hidden" for="search-field">Search</label>
    <input type="search" id="search-field" class="input input--base" placeholder="Search...">
    <button class="button button--base button--primary">Search</button>
</div>
        {% endset %}
        {{ code_snippet | safe }}
        <details class="demo__code">
            <summary>View Code</summary>
            <pre><code>{{ code_snippet | e }}</code></pre>
        </details>
    </section>

    <!-- ================================================================== -->
    <!-- Label with Required Indicator -->
    <!-- ================================================================== -->

    {% set section_title = "Labels with Required Indicator" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Labels indicating required fields with an asterisk.</p>

        {% set code_snippet %}
<div style="display: flex; flex-direction: column; gap: 24px;">
    <div>
        <label class="label" for="required-field">
            Email Address <span style="color: var(--color_error);">*</span>
        </label>
        <input type="email" id="required-field" class="input input--base" placeholder="name@example.com" required>
    </div>

    <div>
        <label class="label" for="optional-field">
            Phone Number <span style="opacity: 0.6; font-weight: 400;">(optional)</span>
        </label>
        <input type="tel" id="optional-field" class="input input--base" placeholder="+1 (555) 000-0000">
    </div>
</div>
        {% endset %}
        {{ code_snippet | safe }}
        <details class="demo__code">
            <summary>View Code</summary>
            <pre><code>{{ code_snippet | e }}</code></pre>
        </details>
    </section>

    <!-- ================================================================== -->
    <!-- Form Labels -->
    <!-- ================================================================== -->

    {% set section_title = "Form Labels" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Labels styled specifically for form contexts using the <code>.form-label</code> class.</p>

        {% set code_snippet %}
<form style="display: flex; flex-direction: column; gap: 20px; max-width: 400px;">
    <div>
        <label class="form-label" for="form-name">Full Name</label>
        <input type="text" id="form-name" class="input input--base" placeholder="John Doe">
    </div>

    <div>
        <label class="form-label form-label--sm" for="form-email">Email (Small Label)</label>
        <input type="email" id="form-email" class="input input--base" placeholder="john@example.com">
    </div>

    <div>
        <label class="form-label form-label--lg" for="form-message">Message (Large Label)</label>
        <textarea id="form-message" class="input input--base" rows="3" placeholder="Your message..."></textarea>
    </div>
</form>
        {% endset %}
        {{ code_snippet | safe }}
        <details class="demo__code">
            <summary>View Code</summary>
            <pre><code>{{ code_snippet | e }}</code></pre>
        </details>
    </section>

    <!-- ================================================================== -->
    <!-- Labels with Various Input Types -->
    <!-- ================================================================== -->

    {% set section_title = "Labels with Various Input Types" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Labels paired with different input types.</p>

        {% set code_snippet %}
<div style="display: flex; flex-direction: column; gap: 24px; max-width: 400px;">
    <!-- Text Input -->
    <div>
        <label class="label" for="text-input">Text Input</label>
        <input type="text" id="text-input" class="input input--base" placeholder="Enter text">
    </div>

    <!-- Select -->
    <div>
        <label class="label" for="select-input">Select Dropdown</label>
        <select id="select-input" class="input input--base">
            <option value="">Choose an option</option>
            <option value="1">Option 1</option>
            <option value="2">Option 2</option>
            <option value="3">Option 3</option>
        </select>
    </div>

    <!-- Textarea -->
    <div>
        <label class="label" for="textarea-input">Textarea</label>
        <textarea id="textarea-input" class="input input--base" rows="3" placeholder="Enter longer text..."></textarea>
    </div>

    <!-- Checkbox -->
    <div style="display: flex; align-items: center; gap: 8px;">
        <input type="checkbox" id="checkbox-input" class="input--checkbox">
        <label for="checkbox-input">Checkbox Label</label>
    </div>

    <!-- Radio Group -->
    <fieldset style="border: none; padding: 0; margin: 0;">
        <legend class="label" style="margin-bottom: 8px;">Radio Group</legend>
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <input type="radio" id="radio-1" name="radio-group" class="input--radio">
                <label for="radio-1">Option A</label>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <input type="radio" id="radio-2" name="radio-group" class="input--radio">
                <label for="radio-2">Option B</label>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <input type="radio" id="radio-3" name="radio-group" class="input--radio">
                <label for="radio-3">Option C</label>
            </div>
        </div>
    </fieldset>
</div>
        {% endset %}
        {{ code_snippet | safe }}
        <details class="demo__code">
            <summary>View Code</summary>
            <pre><code>{{ code_snippet | e }}</code></pre>
        </details>
    </section>

    <!-- ================================================================== -->
    <!-- Inline Labels -->
    <!-- ================================================================== -->

    {% set section_title = "Inline Labels" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Labels displayed inline with their inputs.</p>

        {% set code_snippet %}
<div style="display: flex; flex-direction: column; gap: 16px;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <label for="inline-1" style="min-width: 100px;">Username</label>
        <input type="text" id="inline-1" class="input input--base input--base--inline" placeholder="Enter username">
    </div>

    <div style="display: flex; align-items: center; gap: 12px;">
        <label for="inline-2" style="min-width: 100px;">Password</label>
        <input type="password" id="inline-2" class="input input--base input--base--inline" placeholder="Enter password">
    </div>
</div>
        {% endset %}
        {{ code_snippet | safe }}
        <details class="demo__code">
            <summary>View Code</summary>
            <pre><code>{{ code_snippet | e }}</code></pre>
        </details>
    </section>

    <!-- ================================================================== -->
    <!-- CSS Classes Reference -->
    <!-- ================================================================== -->

    {% set section_title = "CSS Classes Reference" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>

        <table class="table table--bordered">
            <thead>
                <tr>
                    <th>Class</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>.label</code></td>
                    <td>Base label class with default styling</td>
                </tr>
                <tr>
                    <td><code>.label--sm</code></td>
                    <td>Small size label variant</td>
                </tr>
                <tr>
                    <td><code>.label--md</code></td>
                    <td>Medium size label variant (default)</td>
                </tr>
                <tr>
                    <td><code>.label--lg</code></td>
                    <td>Large size label variant</td>
                </tr>
                <tr>
                    <td><code>.label--hidden</code></td>
                    <td>Visually hidden but accessible to screen readers</td>
                </tr>
                <tr>
                    <td><code>.form-label</code></td>
                    <td>Label styled for form contexts</td>
                </tr>
                <tr>
                    <td><code>.form-label--sm</code></td>
                    <td>Small form label</td>
                </tr>
                <tr>
                    <td><code>.form-label--lg</code></td>
                    <td>Large form label</td>
                </tr>
            </tbody>
        </table>
    </section>

</section>

{%- endblock %}
