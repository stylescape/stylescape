{% extends "base.html.jinja" %}

{% set title = "Tables" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h3>{{ title }}</h3>
    </header>

{% set table_content %}
    <caption>This is a table caption, made with caption</caption>
    <colgroup></colgroup>
    <thead>
        <tr>
            <th>Table Header 1</th>
            <th>Table Header 2</th>
            <th>Table Header 3</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <td>Table Footer 1</td>
            <td>Table Footer 2</td>
            <td>Table Footer 3</td>
        </tr>
    </tfoot>
    <tbody>
        <tr>
            <td>TD 1.1</td>
            <td>TD 1.2</td>
            <td>TD 1.3</td>
        </tr>
        <tr>
            <td>TD 2.1</td>
            <td>TD 2.2</td>
            <td>TD 2.3</td>
        </tr>
        <tr>
            <td>TD 3.1</td>
            <td>TD 3.2</td>
            <td>TD 3.3</td>
        </tr>
    </tbody>
{% endset %}

{# ----------------------------------------------------------------------------
Table Default
---------------------------------------------------------------------------- #}

<section class="demo__subsection">
    <h4>Table Default</h4>
    {% set code_snippet %}
<table class="">
{{ table_content | safe }}</table>
    {% endset %}
    {% set language="HTML" %}
    {% include "includes/preview_box_code.html.jinja" %}
</section>

{# ----------------------------------------------------------------------------
Table Lined All
---------------------------------------------------------------------------- #}

<section class="demo__subsection">
    <h4>Table Lined All</h4>
    {% set code_snippet %}
