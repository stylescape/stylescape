{% extends "../base.html.jinja" %}
{% set title = "23-Layout" %}
{%- block title %}{{ title }} | StyleScape Architecture{%- endblock %}
{%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }} — Layout Primitives</h2>
        <p>Foundational layout patterns: containers, grids, flex utilities, and more.</p>
    </header>

    {% set section_title = "Container" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Centered max-width containers with responsive padding.</p>
        <div class="demo__preview">
            <div class="demo__preview__content" style="background: var(--ss-color-surface, #f8fafc);">
                <div class="ss-container" style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-4);">
                    <code>.ss-container</code> — Centered with max-width
                </div>
            </div>
        </div>
    </section>

    {% set section_title = "Grid System" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Flexible CSS Grid layouts.</p>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4);">
                <div style="display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--ss-space-2);">
                    {% for i in range(1, 13) %}
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-2); text-align: center; font-size: 0.75rem;">{{ i }}</div>
                    {% endfor %}
                </div>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ss-space-3); margin-top: var(--ss-space-4);">
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3); text-align: center;">1/3</div>
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3); text-align: center;">1/3</div>
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3); text-align: center;">1/3</div>
                </div>
            </div>
        </div>
    </section>

    {% set section_title = "Flexbox Utilities" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4);">
                <p><strong>Row (default):</strong></p>
                <div style="display: flex; gap: var(--ss-space-2); margin-bottom: var(--ss-space-4);">
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3);">Item 1</div>
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3);">Item 2</div>
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3);">Item 3</div>
                </div>
                <p><strong>Space Between:</strong></p>
                <div style="display: flex; justify-content: space-between; gap: var(--ss-space-2); margin-bottom: var(--ss-space-4);">
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3);">Left</div>
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3);">Right</div>
                </div>
                <p><strong>Center:</strong></p>
                <div style="display: flex; justify-content: center; align-items: center; gap: var(--ss-space-2); height: 80px; background: var(--ss-color-surface, #f8fafc);">
                    <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3);">Centered</div>
                </div>
            </div>
        </div>
    </section>

    {% set section_title = "Layout Classes" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <table class="ss-table">
            <thead>
                <tr>
                    <th>Class</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>.ss-container</code></td>
                    <td>Centered container with max-width</td>
                </tr>
                <tr>
                    <td><code>.ss-grid</code></td>
                    <td>CSS Grid container</td>
                </tr>
                <tr>
                    <td><code>.ss-flex</code></td>
                    <td>Flexbox container</td>
                </tr>
                <tr>
                    <td><code>.ss-stack</code></td>
                    <td>Vertical flex stack</td>
                </tr>
                <tr>
                    <td><code>.ss-cluster</code></td>
                    <td>Flexible wrapping cluster</td>
                </tr>
                <tr>
                    <td><code>.ss-sidebar</code></td>
                    <td>Sidebar layout pattern</td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

{%- endblock %}
