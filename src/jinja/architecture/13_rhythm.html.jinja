{% extends "../base.html.jinja" %}
{% set title = "13-Rhythm" %}
{%- block title %}{{ title }} | StyleScape Architecture{%- endblock %}
{%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }} — Vertical Rhythm</h2>
        <p>Establish consistent vertical spacing and baseline rhythm.</p>
    </header>

    {% set section_title = "Baseline Grid" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>All vertical spacing aligns to a baseline grid for visual harmony.</p>
        <div class="ss-c-demo__preview">
            <div class="ss-c-demo__preview__content" style="padding: var(--ss-space-4); background: repeating-linear-gradient(to bottom, transparent, transparent 7px, rgba(59, 130, 246, 0.1) 7px, rgba(59, 130, 246, 0.1) 8px);">
                <h2 style="margin-bottom: var(--ss-space-4);">Heading with Rhythm</h2>
                <p style="margin-bottom: var(--ss-space-4);">This paragraph follows the baseline grid. Notice how spacing maintains consistent rhythm throughout the content.</p>
                <p style="margin-bottom: var(--ss-space-4);">Another paragraph demonstrating vertical rhythm alignment.</p>
            </div>
        </div>
    </section>

    {% set section_title = "Line Height Scale" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Consistent line heights that maintain vertical rhythm.</p>
        <table class="ss-table">
            <thead>
                <tr>
                    <th>Token</th>
                    <th>Value</th>
                    <th>Use Case</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>--ss-leading-none</code></td>
                    <td>1</td>
                    <td>Single-line text</td>
                </tr>
                <tr>
                    <td><code>--ss-leading-tight</code></td>
                    <td>1.25</td>
                    <td>Headings</td>
                </tr>
                <tr>
                    <td><code>--ss-leading-normal</code></td>
                    <td>1.5</td>
                    <td>Body text</td>
                </tr>
                <tr>
                    <td><code>--ss-leading-relaxed</code></td>
                    <td>1.625</td>
                    <td>Long-form content</td>
                </tr>
                <tr>
                    <td><code>--ss-leading-loose</code></td>
                    <td>2</td>
                    <td>Large display text</td>
                </tr>
            </tbody>
        </table>
    </section>

    {% set section_title = "Vertical Spacing" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Flow spacing between block elements.</p>
        <div class="ss-c-demo__preview">
            <div class="ss-c-demo__preview__content" style="padding: var(--ss-space-4);">
                <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3); margin-bottom: var(--ss-space-2);">Space-2 gap below</div>
                <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3); margin-bottom: var(--ss-space-4);">Space-4 gap below</div>
                <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3); margin-bottom: var(--ss-space-6);">Space-6 gap below</div>
                <div style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-3);">Final element</div>
            </div>
        </div>
    </section>
</section>

{%- endblock %}
