{% extends "../base.html.jinja" %}
{% set title = "31-Modules" %}
{%- block title %}{{ title }} | StyleScape Architecture{%- endblock %}
{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }} — UI Components</h2>
        <p>Reusable component patterns: buttons, cards, forms, navigation, and more.</p>
    </header>

    {% set section_title = "Buttons" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4); display: flex; gap: var(--ss-space-3); flex-wrap: wrap; align-items: center;">
                <button class="ss-button ss-button--primary" style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-2) var(--ss-space-4); border: none; border-radius: var(--ss-radius-md, 0.375rem); cursor: pointer;">Primary</button>
                <button class="ss-button ss-button--secondary" style="background: var(--ss-color-secondary, #6366f1); color: white; padding: var(--ss-space-2) var(--ss-space-4); border: none; border-radius: var(--ss-radius-md, 0.375rem); cursor: pointer;">Secondary</button>
                <button class="ss-button ss-button--outline" style="background: transparent; color: var(--ss-color-primary, #3b82f6); padding: var(--ss-space-2) var(--ss-space-4); border: 2px solid var(--ss-color-primary, #3b82f6); border-radius: var(--ss-radius-md, 0.375rem); cursor: pointer;">Outline</button>
                <button class="ss-button ss-button--ghost" style="background: transparent; color: var(--ss-color-primary, #3b82f6); padding: var(--ss-space-2) var(--ss-space-4); border: none; border-radius: var(--ss-radius-md, 0.375rem); cursor: pointer;">Ghost</button>
            </div>
        </div>
    </section>

    {% set section_title = "Cards" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4); display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: var(--ss-space-4);">
                <article class="ss-card" style="background: white; border-radius: var(--ss-radius-lg, 0.5rem); box-shadow: var(--ss-shadow-md, 0 4px 6px rgba(0,0,0,0.1)); overflow: hidden;">
                    <div style="background: var(--ss-color-primary, #3b82f6); height: 100px;"></div>
                    <div style="padding: var(--ss-space-4);">
                        <h4 style="margin: 0 0 var(--ss-space-2);">Card Title</h4>
                        <p style="margin: 0; color: var(--ss-color-muted, #64748b);">Card description goes here with supporting text.</p>
                    </div>
                </article>
                <article class="ss-card ss-card--bordered" style="background: white; border: 1px solid var(--ss-color-border, #e2e8f0); border-radius: var(--ss-radius-lg, 0.5rem); overflow: hidden;">
                    <div style="padding: var(--ss-space-4);">
                        <h4 style="margin: 0 0 var(--ss-space-2);">Bordered Card</h4>
                        <p style="margin: 0; color: var(--ss-color-muted, #64748b);">A simpler card variant without shadow.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    {% set section_title = "Forms" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4); max-width: 400px;">
                <form class="ss-form" style="display: flex; flex-direction: column; gap: var(--ss-space-4);">
                    <div class="ss-form-group">
                        <label for="demo-name" style="display: block; margin-bottom: var(--ss-space-1); font-weight: 500;">Name</label>
                        <input type="text" id="demo-name" class="ss-input" placeholder="Enter your name" style="width: 100%; padding: var(--ss-space-2) var(--ss-space-3); border: 1px solid var(--ss-color-border, #e2e8f0); border-radius: var(--ss-radius-md, 0.375rem);">
                    </div>
                    <div class="ss-form-group">
                        <label for="demo-email" style="display: block; margin-bottom: var(--ss-space-1); font-weight: 500;">Email</label>
                        <input type="email" id="demo-email" class="ss-input" placeholder="Enter your email" style="width: 100%; padding: var(--ss-space-2) var(--ss-space-3); border: 1px solid var(--ss-color-border, #e2e8f0); border-radius: var(--ss-radius-md, 0.375rem);">
                    </div>
                    <button type="submit" style="background: var(--ss-color-primary, #3b82f6); color: white; padding: var(--ss-space-2) var(--ss-space-4); border: none; border-radius: var(--ss-radius-md, 0.375rem); cursor: pointer;">Submit</button>
                </form>
            </div>
        </div>
    </section>

    {% set section_title = "Alerts" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4); display: flex; flex-direction: column; gap: var(--ss-space-3);">
                <div class="ss-alert ss-alert--info" style="padding: var(--ss-space-3) var(--ss-space-4); border-radius: var(--ss-radius-md, 0.375rem); background: #dbeafe; border-left: 4px solid #3b82f6;">
                    <strong>Info:</strong> This is an informational message.
                </div>
                <div class="ss-alert ss-alert--success" style="padding: var(--ss-space-3) var(--ss-space-4); border-radius: var(--ss-radius-md, 0.375rem); background: #dcfce7; border-left: 4px solid #22c55e;">
                    <strong>Success:</strong> Your changes have been saved.
                </div>
                <div class="ss-alert ss-alert--warning" style="padding: var(--ss-space-3) var(--ss-space-4); border-radius: var(--ss-radius-md, 0.375rem); background: #fef9c3; border-left: 4px solid #eab308;">
                    <strong>Warning:</strong> Please review before continuing.
                </div>
                <div class="ss-alert ss-alert--error" style="padding: var(--ss-space-3) var(--ss-space-4); border-radius: var(--ss-radius-md, 0.375rem); background: #fee2e2; border-left: 4px solid #ef4444;">
                    <strong>Error:</strong> Something went wrong.
                </div>
            </div>
        </div>
    </section>

    {% set section_title = "Available Modules" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <table class="ss-table">
            <thead>
                <tr>
                    <th>Module</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>buttons</code></td>
                    <td>Button variants and states</td>
                </tr>
                <tr>
                    <td><code>cards</code></td>
                    <td>Card containers and layouts</td>
                </tr>
                <tr>
                    <td><code>forms</code></td>
                    <td>Form controls and validation</td>
                </tr>
                <tr>
                    <td><code>alerts</code></td>
                    <td>Alert and notification components</td>
                </tr>
                <tr>
                    <td><code>navigation</code></td>
                    <td>Nav, tabs, breadcrumbs</td>
                </tr>
                <tr>
                    <td><code>modals</code></td>
                    <td>Dialog and modal overlays</td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

{%- endblock %}
