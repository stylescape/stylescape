{% extends "../base.html.jinja" %}
{% set title = "12-Lexicon" %}
{%- block title %}{{ title }} | StyleScape Architecture{%- endblock %}
{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }} — Design Tokens</h2>
        <p>The vocabulary of your design system: colors, spacing, typography, and more.</p>
    </header>

    {% set section_title = "Color Tokens" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Semantic and primitive color tokens.</p>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4); display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: var(--ss-space-3);">
                <div style="background: var(--ss-color-primary, #3b82f6); padding: var(--ss-space-4); color: white; border-radius: var(--ss-radius-md);">Primary</div>
                <div style="background: var(--ss-color-secondary, #6366f1); padding: var(--ss-space-4); color: white; border-radius: var(--ss-radius-md);">Secondary</div>
                <div style="background: var(--ss-color-success, #22c55e); padding: var(--ss-space-4); color: white; border-radius: var(--ss-radius-md);">Success</div>
                <div style="background: var(--ss-color-warning, #eab308); padding: var(--ss-space-4); color: black; border-radius: var(--ss-radius-md);">Warning</div>
                <div style="background: var(--ss-color-danger, #ef4444); padding: var(--ss-space-4); color: white; border-radius: var(--ss-radius-md);">Danger</div>
                <div style="background: var(--ss-color-info, #06b6d4); padding: var(--ss-space-4); color: white; border-radius: var(--ss-radius-md);">Info</div>
            </div>
        </div>
    </section>

    {% set section_title = "Spacing Scale" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Consistent spacing tokens based on a modular scale.</p>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4);">
                {% for i in range(1, 9) %}
                <div style="display: flex; align-items: center; gap: var(--ss-space-3); margin-bottom: var(--ss-space-2);">
                    <code style="width: 100px;">--ss-space-{{ i }}</code>
                    <div style="height: 16px; background: var(--ss-color-primary, #3b82f6); width: calc({{ i }} * 8px);"></div>
                    <span>{{ i * 8 }}px</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {% set section_title = "Typography Scale" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Modular type scale for consistent sizing.</p>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4);">
                <div style="font-size: var(--ss-font-size-xs, 0.75rem);">--ss-font-size-xs (0.75rem)</div>
                <div style="font-size: var(--ss-font-size-sm, 0.875rem);">--ss-font-size-sm (0.875rem)</div>
                <div style="font-size: var(--ss-font-size-base, 1rem);">--ss-font-size-base (1rem)</div>
                <div style="font-size: var(--ss-font-size-lg, 1.125rem);">--ss-font-size-lg (1.125rem)</div>
                <div style="font-size: var(--ss-font-size-xl, 1.25rem);">--ss-font-size-xl (1.25rem)</div>
                <div style="font-size: var(--ss-font-size-2xl, 1.5rem);">--ss-font-size-2xl (1.5rem)</div>
                <div style="font-size: var(--ss-font-size-3xl, 1.875rem);">--ss-font-size-3xl (1.875rem)</div>
            </div>
        </div>
    </section>

    {% set section_title = "Border Radius" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4); display: flex; gap: var(--ss-space-4); flex-wrap: wrap;">
                <div style="width: 80px; height: 80px; background: var(--ss-color-primary, #3b82f6); border-radius: var(--ss-radius-none, 0);" title="radius-none"></div>
                <div style="width: 80px; height: 80px; background: var(--ss-color-primary, #3b82f6); border-radius: var(--ss-radius-sm, 0.125rem);" title="radius-sm"></div>
                <div style="width: 80px; height: 80px; background: var(--ss-color-primary, #3b82f6); border-radius: var(--ss-radius-md, 0.375rem);" title="radius-md"></div>
                <div style="width: 80px; height: 80px; background: var(--ss-color-primary, #3b82f6); border-radius: var(--ss-radius-lg, 0.5rem);" title="radius-lg"></div>
                <div style="width: 80px; height: 80px; background: var(--ss-color-primary, #3b82f6); border-radius: var(--ss-radius-full, 9999px);" title="radius-full"></div>
            </div>
        </div>
    </section>

    {% set section_title = "Shadow Scale" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-6); display: flex; gap: var(--ss-space-6); flex-wrap: wrap; background: var(--ss-color-surface, #f8fafc);">
                <div style="width: 100px; height: 100px; background: white; box-shadow: var(--ss-shadow-sm, 0 1px 2px rgba(0,0,0,0.05)); display: flex; align-items: center; justify-content: center;">sm</div>
                <div style="width: 100px; height: 100px; background: white; box-shadow: var(--ss-shadow-md, 0 4px 6px rgba(0,0,0,0.1)); display: flex; align-items: center; justify-content: center;">md</div>
                <div style="width: 100px; height: 100px; background: white; box-shadow: var(--ss-shadow-lg, 0 10px 15px rgba(0,0,0,0.1)); display: flex; align-items: center; justify-content: center;">lg</div>
                <div style="width: 100px; height: 100px; background: white; box-shadow: var(--ss-shadow-xl, 0 20px 25px rgba(0,0,0,0.15)); display: flex; align-items: center; justify-content: center;">xl</div>
            </div>
        </div>
    </section>

    {% set section_title = "Motion Tokens" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Consistent animation timing and easing.</p>
        <table class="ss-table">
            <thead>
                <tr>
                    <th>Token</th>
                    <th>Value</th>
                    <th>Use Case</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>--ss-duration-fast</code></td>
                    <td>150ms</td>
                    <td>Micro-interactions</td>
                </tr>
                <tr>
                    <td><code>--ss-duration-normal</code></td>
                    <td>300ms</td>
                    <td>Standard transitions</td>
                </tr>
                <tr>
                    <td><code>--ss-duration-slow</code></td>
                    <td>500ms</td>
                    <td>Page transitions</td>
                </tr>
                <tr>
                    <td><code>--ss-ease-default</code></td>
                    <td>cubic-bezier(0.4, 0, 0.2, 1)</td>
                    <td>General purpose</td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

{%- endblock %}
