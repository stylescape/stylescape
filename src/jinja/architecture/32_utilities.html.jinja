{% extends "../base.html.jinja" %}
{% set title = "32-Utilities" %}
{%- block title %}{{ title }} | StyleScape Architecture{%- endblock %}
{%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }} — Utility Classes</h2>
        <p>Single-purpose utility classes for rapid styling adjustments.</p>
    </header>

    {% set section_title = "Spacing Utilities" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <p>Margin and padding utilities following the naming convention <code>.ss-{property}-{size}</code>.</p>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4);">
                <div style="background: var(--ss-color-surface, #f8fafc); padding: var(--ss-space-2);">
                    <span style="background: var(--ss-color-primary, #3b82f6); color: white; padding: 4px 8px; display: inline-block; margin-right: 8px;">.ss-m-2</span>
                    <span style="background: var(--ss-color-primary, #3b82f6); color: white; padding: 4px 8px; display: inline-block; margin-right: 16px;">.ss-m-4</span>
                    <span style="background: var(--ss-color-primary, #3b82f6); color: white; padding: 4px 8px; display: inline-block; margin-right: 24px;">.ss-m-6</span>
                </div>
            </div>
        </div>
        <table class="ss-table">
            <thead>
                <tr>
                    <th>Class Pattern</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr><td><code>.ss-m-{0-8}</code></td><td>Margin all sides</td></tr>
                <tr><td><code>.ss-mt-{0-8}</code></td><td>Margin top</td></tr>
                <tr><td><code>.ss-mr-{0-8}</code></td><td>Margin right</td></tr>
                <tr><td><code>.ss-mb-{0-8}</code></td><td>Margin bottom</td></tr>
                <tr><td><code>.ss-ml-{0-8}</code></td><td>Margin left</td></tr>
                <tr><td><code>.ss-mx-{0-8}</code></td><td>Margin horizontal</td></tr>
                <tr><td><code>.ss-my-{0-8}</code></td><td>Margin vertical</td></tr>
                <tr><td><code>.ss-p-{0-8}</code></td><td>Padding all sides</td></tr>
            </tbody>
        </table>
    </section>

    {% set section_title = "Display Utilities" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <table class="ss-table">
            <thead>
                <tr>
                    <th>Class</th>
                    <th>CSS</th>
                </tr>
            </thead>
            <tbody>
                <tr><td><code>.ss-hidden</code></td><td>display: none</td></tr>
                <tr><td><code>.ss-block</code></td><td>display: block</td></tr>
                <tr><td><code>.ss-f-inline</code></td><td>display: inline</td></tr>
                <tr><td><code>.ss-f-inline-block</code></td><td>display: inline-block</td></tr>
                <tr><td><code>.ss-flex</code></td><td>display: flex</td></tr>
                <tr><td><code>.ss-f-inline-flex</code></td><td>display: inline-flex</td></tr>
                <tr><td><code>.ss-l-grid</code></td><td>display: grid</td></tr>
            </tbody>
        </table>
    </section>

    {% set section_title = "Text Utilities" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <div class="demo__preview">
            <div class="demo__preview__content" style="padding: var(--ss-space-4);">
                <p style="text-align: left; background: var(--ss-color-surface, #f8fafc); padding: var(--ss-space-2); margin-bottom: var(--ss-space-2);">.ss-text-left</p>
                <p style="text-align: center; background: var(--ss-color-surface, #f8fafc); padding: var(--ss-space-2); margin-bottom: var(--ss-space-2);">.ss-text-center</p>
                <p style="text-align: right; background: var(--ss-color-surface, #f8fafc); padding: var(--ss-space-2); margin-bottom: var(--ss-space-2);">.ss-text-right</p>
                <p style="font-weight: 700; margin-bottom: var(--ss-space-2);">.ss-font-bold</p>
                <p style="font-style: italic; margin-bottom: var(--ss-space-2);">.ss-italic</p>
                <p style="text-transform: uppercase; margin-bottom: var(--ss-space-2);">.ss-uppercase</p>
            </div>
        </div>
    </section>

    {% set section_title = "Flexbox Utilities" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <table class="ss-table">
            <thead>
                <tr>
                    <th>Class</th>
                    <th>CSS</th>
                </tr>
            </thead>
            <tbody>
                <tr><td><code>.ss-flex-row</code></td><td>flex-direction: row</td></tr>
                <tr><td><code>.ss-flex-col</code></td><td>flex-direction: column</td></tr>
                <tr><td><code>.ss-justify-start</code></td><td>justify-content: flex-start</td></tr>
                <tr><td><code>.ss-justify-center</code></td><td>justify-content: center</td></tr>
                <tr><td><code>.ss-justify-end</code></td><td>justify-content: flex-end</td></tr>
                <tr><td><code>.ss-justify-between</code></td><td>justify-content: space-between</td></tr>
                <tr><td><code>.ss-items-start</code></td><td>align-items: flex-start</td></tr>
                <tr><td><code>.ss-items-center</code></td><td>align-items: center</td></tr>
                <tr><td><code>.ss-items-end</code></td><td>align-items: flex-end</td></tr>
                <tr><td><code>.ss-gap-{0-8}</code></td><td>gap: var(--ss-space-{n})</td></tr>
            </tbody>
        </table>
    </section>

    {% set section_title = "Visibility & SR" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        <table class="ss-table">
            <thead>
                <tr>
                    <th>Class</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr><td><code>.ss-visible</code></td><td>visibility: visible</td></tr>
                <tr><td><code>.ss-invisible</code></td><td>visibility: hidden</td></tr>
                <tr><td><code>.ss-sr-only</code></td><td>Screen reader only</td></tr>
                <tr><td><code>.ss-not-sr-only</code></td><td>Undo screen reader only</td></tr>
            </tbody>
        </table>
    </section>
</section>

{%- endblock %}
