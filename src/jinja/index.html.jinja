{% extends "base.html.jinja" %}

{% block title %}Welcome to StyleScape{% endblock %}

{% block content %}

<section class="page__hero">
    <div class="hero__container">
        <h1 class="page__title">StyleScape</h1>
        <p class="page__subtitle">A modular design system for creative clarity and composable UI.</p>
    </div>
</section>



<section class="demo__section" data-label="Introduction" data-level="1">
    <header class="demo__section__header">
        <h2>What is StyleScape?</h2>
    </header>
    <div class="demo__subsection">
        <p>StyleScape is a structured yet flexible SCSS-based design system built by Scape Agency. It provides
            consistent design primitives, component mixins, utility classes, and responsive patterns — all curated for
            expressive user interfaces across web and spatial applications.</p>
    </div>
</section>




<section class="demo__section" data-label="Quickstart" data-level="1">
    <header class="demo__section__header">
        <h2>Getting Started</h2>
    </header>
    <div class="demo__subsection">
        <ol>
            <li>Browse the <strong>Atoms</strong>, <strong>Molecules</strong>, and <strong>Layout</strong> patterns.
            </li>
            <li>Use the mixins or utility classes in your SCSS, or copy from the HTML examples.</li>
            <li>Customize your variables in <code>variables.scss</code> to match your brand or theme.</li>
        </ol>
    </div>
</section>

<section class="demo__section"data-label="Philosophy" data-level="1">
    <header class="demo__section__header">
        <h2>Philosophy</h2>
    </header>
    <div class="demo__subsection">
        <blockquote>
            <p><em>"We design systems to scale creative expression, not restrict it."</em></p>
            <footer>— Scape Agency</footer>
        </blockquote>
        <ul>
            <li><strong>Composable:</strong> Every token and mixin is reusable and interoperable.</li>
            <li><strong>Performant:</strong> Minimal output, zero bloat.</li>
            <li><strong>Future-ready:</strong> Designed to integrate with headless CMS, WebGL, VR/AR, and responsive
                layouts.</li>
        </ul>
    </section>


</section>

<section class="demo__section" data-label="Next Steps" data-level="1">
    <header class="demo__section__header">
        <h2>Next Steps</h2>
    </header>
    <div class="demo__subsection">
        <ul>
            <li><a href="atoms.html">Explore Atoms</a></li>
            <li><a href="molecules.html">Explore Molecules</a></li>
            <li><a href="layout.html">Explore Layout Patterns</a></li>
        </ul>
    </div>
</section>

{% endblock %}
