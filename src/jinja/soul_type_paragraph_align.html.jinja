    {% set section_title = "Right Justified Alignment" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <section class="paragraph--justify--right">
            <h5>{{ section_title }}</h5>
            <p>{{ lorem }}</p>
        </section>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview_box_code.html.jinja" %}
    </section>
</section>
{%- endblock content %}
