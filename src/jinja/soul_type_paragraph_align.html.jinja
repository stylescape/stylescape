{% extends "base.html.jinja" %}

{% set title = "Paragraph ALignment" %}

{%- block title %}{{ title }}{%- endblock %}

{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>



<section class="paragraph--normal">
    <h2>.paragraph--normal</h2>
    <p>
        This is a normally styled paragraph, using the default alignment and typography settings defined in your
        `paragraph--normal` mixin.
    </p>
</section>

<section class="paragraph--left">
    <h2>.paragraph--left</h2>
    <p>
        This paragraph is aligned to the left. It's useful for enforcing left alignment in multilingual or
        layout-sensitive contexts.
    </p>
</section>

<section class="paragraph--center">
    <h2>.paragraph--center</h2>
    <p>
        This paragraph is centered. Centered text works well for titles or callouts, but should be used sparingly in
        body content.
    </p>
</section>

<section class="paragraph--right">
    <h2>.paragraph--right</h2>
    <p>
        This paragraph is aligned to the right. Right-aligned text may be used for captions, pull quotes, or RTL
        languages.
    </p>
</section>

<section class="paragraph--justify">
    <h2>.paragraph--justify</h2>
    <p>
        This paragraph is justified, creating clean left and right edges. While justified text can appear more formal,
        it may reduce readability on small screens or short lines.
    </p>
</section>

</section>
{%- endblock content %}
