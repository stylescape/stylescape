{% extends "base.html.jinja" %}
{% block title %}Buttons{% endblock %}

{% block content %}


{% set button_sizes = ['xs', 'sm', 'md', 'lg', 'xl'] %}
{% set button_styles = ['default', 'solid','outline','clear'] %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h3>Buttons</h3>
    </header>

    <section class="demo__subsection">

        {% for size in button_sizes %}
        <div class="button-size-row">
            <h5>{{ size|upper }} Buttons</h5>
            <div class="button-style-grid">
                {% for style in button_styles %}
                <div class="demo-item">
                    <div class="label">{{ style|capitalize }}</div>
                    <button class="button button--{{ size }}{% if style != 'default' %} button--{{ style }}{% endif %}">
                        {{ style|capitalize }}
                    </button>
                </div>
                <div class="demo-item">
                    <div class="label">{{ style|capitalize }} (Disabled)</div>
                    <button class="button button--{{ size }}{% if style != 'default' %} button--{{ style }}{% endif %}"
                        disabled>
                        {{ style|capitalize }}
                    </button>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </section>
</section>

<section class="demo__section">

    <header class="demo__section__header">
        <h3>Button Groups</h3>
    </header>

    <section class="demo__subsection">

        <div class="button_group">
            <button class="button button--sm button--solid">Left</button>
            <button class="button button--sm button--solid">Center</button>
            <button class="button button--sm button--solid">Right</button>
        </div>
        <br>

        <div class="button_group">
            <button class="button button--md button--solid">Left</button>
            <button class="button button--md button--solid">Center</button>
            <button class="button button--md button--solid">Right</button>
        </div>
        <br>
        <div class="button_group--vertical">
            <button class="button button--md button--solid">1</button>
            <button class="button button--md button--solid">2</button>
            <button class="button button--md button--solid">3</button>
        </div>
    </section>
</section>

<section class="demo__section">

    <header class="demo__section__header">
        <h3>Switch Buttons</h3>
    </header>

    <section class="demo__subsection">


        <!-- Rectangular switch -->
        <label class="switch">
            <input type="checkbox">
            <span class="slider"></span>
        </label>

        <!-- Rounded switch -->
        <label class="switch">
            <input type="checkbox">
            <span class="slider round"></span>
        </label>
    </section>
</section>

<section class="demo__section">

    <header class="demo__section__header">
        <h3>Select Buttons</h3>
    </header>

    <section class="demo__subsection">

        <!-- Surround the select box within a "custom-select" DIV element.
    Remember to set the width: -->
        <select class="input">
            <option value="0">Select car:</option>
            <option value="1">Audi</option>
            <option value="2">BMW</option>
            <option value="3">Citroen</option>
            <option value="4">Ford</option>
            <option value="5">Honda</option>
            <option value="6">Jaguar</option>
            <option value="7">Land Rover</option>
            <option value="8">Mercedes</option>
            <option value="9">Mini</option>
            <option value="10">Nissan</option>
            <option value="11">Toyota</option>
            <option value="12">Volvo</option>
        </select>
    </section>
</section>

{% endblock content %}
