{% extends "base.html.jinja" %}
{%- block title %}Buttons{%- endblock %}

{%- block content %}


{% set button_sizes = ['xs', 'sm', 'md', 'lg', 'xl'] %}
{% set button_styles = ['default', 'solid','outline','clear', 'accent'] %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h3>Buttons</h3>
    </header>

    <section class="demo__subsection">
        {% for size in button_sizes %}
        <div class="button-size-row">
            <h5>{{ size|upper }} Buttons</h5>
            <div class="button-style-grid">
                {% for style in button_styles %}
                <div class="demo-item">
                    <div class="label">{{ style|capitalize }}</div>
                    <button class="button {{ size }}{% if style != 'default' %} {{ style }}{% endif %}">
                        {{ style|capitalize }}
                    </button>
                </div>
                <div class="demo-item">
                    <div class="label">{{ style|capitalize }} (Disabled)</div>
                    <button class="button {{ size }}{% if style != 'default' %} {{ style }}{% endif %}"
                        disabled>
                        {{ style|capitalize }}
                    </button>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </section>
</section>

<section class="demo__section">

    <header class="demo__section__header">
        <h3>Button Groups</h3>
    </header>

    <section class="demo__subsection">

        <div class="button_group">
            <button class="button sm solid">Left</button>
            <button class="button sm solid">Center</button>
            <button class="button sm solid">Right</button>
        </div>
        <br>

        <div class="button_group">
            <button class="button md solid">Left</button>
            <button class="button md solid">Center</button>
            <button class="button md solid">Right</button>
        </div>
        <br>
        <div class="button_group--vertical">
            <button class="button md solid">1</button>
            <button class="button md solid">2</button>
            <button class="button md solid">3</button>
        </div>
    </section>
</section>

<section class="demo__section">

    <header class="demo__section__header">
        <h3>Switch Buttons</h3>
    </header>

    <section class="demo__subsection">


        <!-- Rectangular switch -->
        <label class="switch">
            <input type="checkbox">
            <span class="slider"></span>
        </label>

        <!-- Rounded switch -->
        <label class="switch">
            <input type="checkbox">
            <span class="slider round"></span>
        </label>
    </section>
</section>

<section class="demo__section">

    <header class="demo__section__header">
        <h3>Icon + Text</h3>
    </header>

    <section class="demo__subsection">
        <div class="button-style-grid">
            <div class="demo-item">
                <div class="label">Leading icon</div>
                <button class="button md solid">
                    <span aria-hidden="true">🔍</span>
                    <span>Search</span>
                </button>
            </div>
            <div class="demo-item">
                <div class="label">Trailing icon</div>
                <button class="button md outline">
                    <span>Download</span>
                    <span aria-hidden="true">⬇️</span>
                </button>
            </div>
            <div class="demo-item">
                <div class="label">Icon only (round)</div>
                <button class="button sm clear" aria-label="More options">
                    <span aria-hidden="true">⋮</span>
                </button>
            </div>
        </div>
    </section>
</section>

<section class="demo__section">

    <header class="demo__section__header">
        <h3>States</h3>
    </header>

    <section class="demo__subsection">
        <div class="button-style-grid">
            <div class="demo-item">
                <div class="label">Active / pressed</div>
                <button class="button md solid" aria-pressed="true">
                    Active
                </button>
            </div>
            <div class="demo-item">
                <div class="label">Loading</div>
                <button class="button md accent" aria-busy="true">
                    <span class="status_spinner" aria-hidden="true"></span>
                    <span>Loading</span>
                </button>
            </div>
            <div class="demo-item">
                <div class="label">Ghost / clear</div>
                <button class="button md clear">Ghost</button>
            </div>
        </div>
    </section>
</section>

<section class="demo__section">

    <header class="demo__section__header">
        <h3>Select Buttons</h3>
    </header>

    <section class="demo__subsection">

        <!-- Surround the select box within a "custom-select" DIV element.
    Remember to set the width: -->
        <select class="input">
            <option value="0">Select car:</option>
            <option value="1">Audi</option>
            <option value="2">BMW</option>
            <option value="3">Citroen</option>
            <option value="4">Ford</option>
            <option value="5">Honda</option>
            <option value="6">Jaguar</option>
            <option value="7">Land Rover</option>
            <option value="8">Mercedes</option>
            <option value="9">Mini</option>
            <option value="10">Nissan</option>
            <option value="11">Toyota</option>
            <option value="12">Volvo</option>
        </select>
    </section>
</section>

{%- endblock content %}
