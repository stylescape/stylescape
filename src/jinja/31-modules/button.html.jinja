    {# Icon Flipper #} {% set section_title = "Icon Flipper" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div style="display: flex; gap: 16px; flex-wrap: wrap">
            <button
                class="ss-c-flipper"
                style="
                    position: relative;
                    width: 56px;
                    height: 56px;
                    border: none;
                    background: var(--ss-color-success);
                    color: var(--ss-color-on-success);
                    cursor: pointer;
                    overflow: hidden;
                    border-radius: 50%;
                    font-size: 20px;
                    transition:
                        transform 0.3s,
                        box-shadow 0.3s;
                "
                aria-label="Confirm"
            >
                <span class="ss-c-flipper--front" aria-hidden="true">✓</span>
            </button>

            <button
                class="ss-c-flipper"
                style="
                    position: relative;
                    width: 56px;
                    height: 56px;
                    border: none;
                    background: var(--ss-color-error);
                    color: var(--ss-color-on-error);
                    cursor: pointer;
                    overflow: hidden;
                    border-radius: 50%;
                    font-size: 20px;
                    transition:
                        transform 0.3s,
                        box-shadow 0.3s;
                "
                aria-label="Delete"
            >
                <span class="ss-c-flipper--front" aria-hidden="true">✕</span>
