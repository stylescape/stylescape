{# ============================================================================
Switch / Toggle Buttons
============================================================================ #}
<section class="ss-c-demo__section" data-label="Switch Buttons" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Switch / Toggle Buttons</h2>
        <p>Toggle switches for on/off states.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Rectangular Switch</h3>
        {% set code_snippet %}
        <label class="ss-c-switch">
            <input type="checkbox" aria-label="Rectangular switch (off)" />
            <span class="ss-c-slider"></span>
        </label>
        <label class="ss-c-switch">
            <input type="checkbox" checked aria-label="Rectangular switch (on)" />
            <span class="ss-c-slider"></span>
        </label>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Rounded Switch</h3>
        {% set code_snippet %}
        <label class="ss-c-switch">
            <input type="checkbox" aria-label="Rounded switch (off)" />
            <span class="ss-c-slider ss-c-round"></span>
        </label>
        <label class="ss-c-switch">
            <input type="checkbox" checked aria-label="Rounded switch (on)" />
            <span class="ss-c-slider ss-c-round"></span>
        </label>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Switch with Labels</h3>
        {% set code_snippet %}
        <div style="display: flex; align-items: center; gap: 12px">
            <span>Off</span>
            <label class="ss-c-switch">
                <input type="checkbox" aria-label="Toggle setting" />
                <span class="ss-c-slider ss-c-round"></span>
            </label>
            <span>On</span>
        </div>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
