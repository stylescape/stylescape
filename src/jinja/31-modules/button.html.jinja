{% extends "../base.html.jinja" %} {%- block title %}Buttons{%- endblock %} {%- block content %}
{#
============================================================================
Button Variants
============================================================================ #}
<header class="ss-c-demo__section__header">
    <h1>Buttons</h1>
    <p>Button styles for actions in forms, dialogs, and more.</p>
</header>

<section class="ss-c-demo__section" data-label="Button Variants" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Button Variants</h2>
        <p>
            Core button styles for different semantic purposes and visual
            hierarchy.
        </p>
    </header>

    {# Primary Button #}
    <section class="ss-c-demo__subsection">
        <h3>Primary Button</h3>
        <p>
            Use for primary actions and calls-to-action. High visual
            prominence.
        </p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--primary">Primary Action</button>
        <button class="ss-c-button ss-c-button--primary" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Secondary Button #}
    <section class="ss-c-demo__subsection">
        <h3>Secondary Button</h3>
        <p>For secondary actions that complement the primary action.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--secondary">Secondary</button>
        <button class="ss-c-button ss-c-button--secondary" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Outline Button #}
    <section class="ss-c-demo__subsection">
        <h3>Outline Button</h3>
        <p>Bordered button with transparent background for subtle emphasis.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--outline">Outline</button>
        <button class="ss-c-button ss-c-button--outline" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Ghost Button #}
    <section class="ss-c-demo__subsection">
        <h3>Ghost Button</h3>
        <p>
            Minimal button with no border, ideal for toolbars and navigation.
        </p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--ghost">Ghost</button>
        <button class="ss-c-button ss-c-button--ghost" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Link Button #}
    <section class="ss-c-demo__subsection">
        <h3>Link Button</h3>
        <p>Styled as a link but with button semantics.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--link">Link Button</button>
        <button class="ss-c-button ss-c-button--link" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Solid Button #}
    <section class="ss-c-demo__subsection">
        <h3>Solid Button</h3>
        <p>Filled background with inverted text color.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--solid">Solid</button>
        <button class="ss-c-button ss-c-button--solid" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Accent Button #}
    <section class="ss-c-demo__subsection">
        <h3>Accent Button</h3>
        <p>Uses the accent color for special emphasis.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--accent">Accent</button>
        <button class="ss-c-button ss-c-button--accent" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Clear Button #}
    <section class="ss-c-demo__subsection">
        <h3>Clear Button</h3>
        <p>Transparent background with text color only.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--clear">Clear</button>
        <button class="ss-c-button ss-c-button--clear" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>
</section>

