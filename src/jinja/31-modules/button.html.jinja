        <button class="ss-c-button ss-c-button--accent" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Clear Button #}
    <section class="ss-c-demo__subsection">
        <h4>Clear Button</h4>
        <p>Transparent background with text color only.</p>
        {% set code_snippet %}
