{# ============================================================================
Accessibility
============================================================================ #}
<section class="ss-c-demo__section" data-label="Accessibility" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Accessibility</h3>
        <p>Best practices for accessible button implementation.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>ARIA Attributes</h4>
        {% set code_snippet %}
        <!-- Pressed state for toggle buttons -->
        <button class="ss-c-button ss-c-button--primary" aria-pressed="true">
            Toggle (On)
        </button>
        <button class="ss-c-button ss-c-button--outline" aria-pressed="false">
            Toggle (Off)
        </button>

        <!-- Busy state for loading -->
        <button
            class="ss-c-button ss-c-button--primary ss-c-button--loading"
            aria-busy="true"
        >
            Loading...
        </button>

        <!-- Expanded state for dropdowns -->
        <button
            class="ss-c-button ss-c-button--secondary"
            aria-expanded="false"
            aria-haspopup="true"
        >
            Menu ▼
        </button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Focus Visible</h4>
        <p>Tab through these buttons to see the focus indicator.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--primary">Focusable 1</button>
        <button class="ss-c-button ss-c-button--secondary">Focusable 2</button>
        <button class="ss-c-button ss-c-button--outline">Focusable 3</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>
</section>

