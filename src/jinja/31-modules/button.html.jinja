<section class="ss-c-demo__section" data-label="Flipper Buttons" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Flipper Buttons</h2>
        <p>Animated buttons with flip effects on hover and interaction.</p>
    </header>

    {# The shared .ss-c-flipper module is an absolutely positioned arrow
    indicator; reset its positioning and pseudo-element bars so the classes can
    be reused on these standalone flip buttons. #}
    <style>
        [data-label="Flipper Buttons"] button.ss-c-flipper {
            position: relative;
            top: auto;
            left: auto;
            transform: none;
            z-index: auto;
            display: inline-block;
            width: auto;
            height: auto;
        }
        [data-label="Flipper Buttons"] button.ss-c-flipper > .ss-c-flipper--front {
            position: static;
        }
        [data-label="Flipper Buttons"] button.ss-c-flipper::before,
        [data-label="Flipper Buttons"] button.ss-c-flipper::after {
            content: none;
        }
    </style>

    {# Basic Flipper Button #} {% set section_title = "Basic Flipper Button" %}
    <section
