</section>

{# ============================================================================
Button States
============================================================================ #}
<section class="ss-c-demo__section" data-label="Button States" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Button States</h2>
        <p>Interactive states and special button behaviors.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Disabled State</h3>
        <p>
            Buttons can be disabled using the
            <code>disabled</code>
            attribute or
            <code>.button--disabled</code>
            class.
        </p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--primary" disabled>
            Disabled (attr)
        </button>
        <button class="ss-c-button ss-c-button--primary ss-c-button--disabled">
            Disabled (class)
        </button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Loading State</h3>
        <p>
            Shows a spinner and makes the button non-interactive during async
            operations.
        </p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--primary ss-c-button--loading">Loading</button>
        <button class="ss-c-button ss-c-button--secondary ss-c-button--loading">
            Processing
        </button>
        <button class="ss-c-button ss-c-button--accent ss-c-button--loading">Saving</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Full Width / Block</h3>
        <p>Buttons that span the full width of their container.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--primary ss-c-button--block">
            Full Width Primary
        </button>
        <button class="ss-c-button ss-c-button--secondary ss-c-button--block">
            Full Width Secondary
        </button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>
</section>

{# ============================================================================
Buttons with Icons
============================================================================ #}
<section class="ss-c-demo__section" data-label="Icons" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Buttons with Icons</h2>
        <p>Combine text and icons for enhanced visual communication.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Leading Icons</h3>
        <p>Icon appears before the text label.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--primary">
            <span aria-hidden="true">⌕</span>
            <span>Search</span>
        </button>
        <button class="ss-c-button ss-c-button--secondary">
            <span aria-hidden="true">▤</span>
            <span>Open File</span>
        </button>
        <button class="ss-c-button ss-c-button--success">
            <span aria-hidden="true">✓</span>
            <span>Save</span>
        </button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Trailing Icons</h3>
        <p>Icon appears after the text label.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--primary">
            <span>Download</span>
            <span aria-hidden="true">⬇</span>
        </button>
        <button class="ss-c-button ss-c-button--secondary">
            <span>Next</span>
            <span aria-hidden="true">→</span>
        </button>
        <button class="ss-c-button ss-c-button--outline">
            <span>External Link</span>
            <span aria-hidden="true">↗</span>
        </button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Icon Only (with accessible label)</h3>
        <p>
            Use
            <code>aria-label</code>
            for accessibility when using icon-only buttons.
        </p>
        {% set code_snippet %}
        <button
            class="ss-c-button ss-c-button--primary ss-c-button--icon"
            aria-label="Add item"
        >
            +
        </button>
        <button class="ss-c-button ss-c-button--danger ss-c-button--icon" aria-label="Delete">
            ⌫
        </button>
        <button
            class="ss-c-button ss-c-button--ghost ss-c-button--icon"
            aria-label="More options"
        >
            ⋮
        </button>
        <button
            class="ss-c-button ss-c-button--outline ss-c-button--icon"
            aria-label="Refresh"
        >
            ↻
        </button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>
</section>

