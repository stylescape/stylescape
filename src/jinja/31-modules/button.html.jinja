        <h4>Solid Button</h4>
        <p>Filled background with inverted text color.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--solid">Solid</button>
        <button class="ss-c-button ss-c-button--solid" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Accent Button #}
    <section class="ss-c-demo__subsection">
        <h4>Accent Button</h4>
        <p>Uses the accent color for special emphasis.</p>
        {% set code_snippet %}
