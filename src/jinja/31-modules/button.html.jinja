<section class="ss-c-demo__section" data-label="Button Variants" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Button Variants</h3>
        <p>
            Core button styles for different semantic purposes and visual
            hierarchy.
        </p>
    </header>

    {# Primary Button #}
    <section class="ss-c-demo__subsection">
        <h4>Primary Button</h4>
        <p>
            Use for primary actions and calls-to-action. High visual
            prominence.
        </p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--primary">Primary Action</button>
        <button class="ss-c-button ss-c-button--primary" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Secondary Button #}
    <section class="ss-c-demo__subsection">
        <h4>Secondary Button</h4>
        <p>For secondary actions that complement the primary action.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--secondary">Secondary</button>
        <button class="ss-c-button ss-c-button--secondary" disabled>Disabled</button>
        {% endset %} {% include "../includes/preview/ss-c-preview_code.html.jinja"
        %}
    </section>

    {# Outline Button #}
    <section class="ss-c-demo__subsection">
        <h4>Outline Button</h4>
        <p>Bordered button with transparent background for subtle emphasis.</p>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-button--outline">Outline</button>
        <button class="ss-c-button ss-c-button--outline" disabled>Disabled</button>
