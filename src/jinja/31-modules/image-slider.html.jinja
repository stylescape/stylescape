{% extends "../base.html.jinja" %} {% set title = "Image Slider" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
    </header>
    {% set image_url =
    "/img/placeholder/1470x980-photo.svg"
    %} {% set image_url_bright =
    "/img/placeholder/1470x980-photo.svg"
    %} {#
    ----------------------------------------------------------------------------
    Dark Variation
    ----------------------------------------------------------------------------
    #} {% set section_title = "Dark Slider Variation" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div class="ss-c-aspect_ratio--3x2">
            <figure class="ss-c-image-compare" data-ss="image-compare" id="imageCompare-dark">
                <img
                    src="{{ image_url }}"
                    class="ss-c-image-compare__image"
                    alt="After Image"
                    crossorigin="anonymous"
                    data-dark-side="right"
                />
                <img
                    src="{{ image_url_bright }}"
                    class="ss-c-image-compare__overlay"
                    alt="Before Image"
                    crossorigin="anonymous"
                    data-dark-side="left"
                />
                <div class="ss-c-image-compare__handle" id="slider-dark" role="slider" tabindex="0" aria-label="Before/after split" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
                </div>
            </figure>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Light Slider Variation" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div class="ss-c-aspect_ratio--3x2">
            <figure class="ss-c-image-compare" data-ss="image-compare" id="imageCompare-light">
                <img
                    src="{{ image_url_bright }}"
                    class="ss-c-image-compare__image"
                    alt="Before Image"
                    crossorigin="anonymous"
                    data-dark-side="right"
                />
                <img
                    src="{{ image_url }}"
                    class="ss-c-image-compare__overlay"
                    alt="After Image"
                    crossorigin="anonymous"
                    data-dark-side="left"
                />
                <div class="ss-c-image-compare__handle" id="slider-light" role="slider" tabindex="0" aria-label="Before/after split" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
                </div>
            </figure>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Aspect Ratio Variants
    ----------------------------------------------------------------------------
    #} {% for ratio in ["1x1", "3x2", "4x3", "3x4", "2x3", "16x9"] %} {% set
    section_title = "Image Comparison Slider " ~ ratio %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div class="aspect_ratio--{{ ratio }}">
            <figure class="ss-c-image-compare" data-ss="image-compare" id="imageCompare-{{ ratio }}">
                <img
                    src="{{ image_url }}"
                    class="ss-c-image-compare__image"
                    alt="After Image"
                    data-dark-side="right"
                />
                <img
                    src="{{ image_url }}"
                    class="ss-c-image-compare__overlay"
                    alt="Before Image"
                    data-dark-side="left"
                />
                <div class="ss-c-image-compare__handle" id="slider-{{ ratio }}" role="slider" tabindex="0" aria-label="Before/after split" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
                </div>
            </figure>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
    {% endfor %}
</section>
{%- endblock %}
