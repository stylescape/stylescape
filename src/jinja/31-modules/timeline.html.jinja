{% extends "../base.html.jinja" %} {% set title = "Timeline" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

{# The demos below draw their own connector lines inline; hide the default
   .ss-c-timeline::before rail so it doesn't render as a second (light) line. #}
<style>
    .ss-c-demo__subsection .ss-c-timeline::before {
        display: none;
    }
</style>

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            Display chronological events and milestones in vertical or
            horizontal layouts.
        </p>
    </header>

    {# Vertical Timeline #} {% set section_title = "Vertical Timeline" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Classic vertical timeline with alternating sides.</p>
        {% set code_snippet %}
        <div
            class="ss-c-timeline ss-c-timeline--vertical"
            style="position: relative; padding-left: 40px"
        >
            <!-- Timeline line -->
            <div
                style="
                    position: absolute;
                    left: 12px;
                    top: 0;
                    bottom: 0;
                    width: 2px;
                    background: var(--ss-color-border);
                "
            ></div>

            <!-- Timeline item -->
            <div
                class="ss-c-timeline__item"
                style="position: relative; padding-bottom: 32px"
            >
                <div
                    style="
                        position: absolute;
                        left: -34px;
                        width: 16px;
                        height: 16px;
                        background: var(--ss-color-accent);
                        border-radius: 50%;
                        border: 3px solid var(--ss-color-surface);
                        box-shadow: 0 0 0 2px var(--ss-color-accent);
                    "
                ></div>
                <div
                    class="ss-c-timeline__date"
                    style="
                        font-size: 14px;
                        font-weight: 600;
                        color: var(--ss-color-accent);
                        margin-bottom: 8px;
                    "
                >
                    January 2026
                </div>
                <div
                    class="ss-c-timeline__card"
                    style="
                        padding: 20px;
                        background: var(--ss-color-surface-alt);
                        border-radius: var(--ss-radius-lg);
                    "
                >
                    <h3 style="margin: 0 0 8px; font-size: 18px">
                        Launched Quantum Camera Project
                    </h3>
                    <p
                        style="
                            margin: 0;
                            font-size: 14px;
                            opacity: 0.7;
                            line-height: 1.5;
                        "
                    >
                        Exploration of nanoscale pinhole photography using
                        advanced optics and quantum imaging techniques.
                    </p>
                </div>
            </div>

            <!-- Timeline item -->
            <div
                class="ss-c-timeline__item"
                style="position: relative; padding-bottom: 32px"
            >
                <div
                    style="
                        position: absolute;
                        left: -34px;
                        width: 16px;
                        height: 16px;
                        background: var(--ss-color-accent);
                        border-radius: 50%;
                        border: 3px solid var(--ss-color-surface);
                        box-shadow: 0 0 0 2px var(--ss-color-accent);
                    "
                ></div>
                <div
                    class="ss-c-timeline__date"
                    style="
                        font-size: 14px;
                        font-weight: 600;
                        color: var(--ss-color-accent);
                        margin-bottom: 8px;
                    "
                >
                    December 2024
                </div>
                <div
                    class="ss-c-timeline__card"
                    style="
                        padding: 20px;
                        background: var(--ss-color-surface-alt);
                        border-radius: var(--ss-radius-lg);
                    "
                >
                    <h3 style="margin: 0 0 8px; font-size: 18px">
                        Trinkets Exhibition Opened
                    </h3>
                    <p
                        style="
                            margin: 0;
                            font-size: 14px;
                            opacity: 0.7;
                            line-height: 1.5;
                        "
                    >
                        Immersive wearables featured at Design Museum Den
                        Bosch, showcasing interactive fashion technology.
                    </p>
                </div>
            </div>

            <!-- Timeline item -->
            <div
                class="ss-c-timeline__item"
                style="position: relative; padding-bottom: 32px"
            >
                <div
                    style="
                        position: absolute;
                        left: -34px;
                        width: 16px;
                        height: 16px;
                        background: var(--ss-color-accent);
                        border-radius: 50%;
                        border: 3px solid var(--ss-color-surface);
                        box-shadow: 0 0 0 2px var(--ss-color-accent);
                    "
                ></div>
                <div
                    class="ss-c-timeline__date"
                    style="
                        font-size: 14px;
                        font-weight: 600;
                        color: var(--ss-color-accent);
                        margin-bottom: 8px;
                    "
                >
                    October 2024
                </div>
                <div
                    class="ss-c-timeline__card"
                    style="
                        padding: 20px;
                        background: var(--ss-color-surface-alt);
                        border-radius: var(--ss-radius-lg);
                    "
                >
                    <h3 style="margin: 0 0 8px; font-size: 18px">
                        Demosphere at DDW
                    </h3>
                    <p
                        style="
                            margin: 0;
                            font-size: 14px;
                            opacity: 0.7;
                            line-height: 1.5;
                        "
                    >
                        Participatory policy prototyping with ten thematic
                        lenses at Dutch Design Week.
                    </p>
                </div>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Centered Timeline #} {% set section_title = "Centered Timeline" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Timeline with items alternating left and right.</p>
        {% set code_snippet %}
        <div
            class="ss-c-timeline ss-c-timeline--centered"
            style="position: relative; padding: 20px 0"
        >
            <!-- Center line -->
            <div
                style="
                    position: absolute;
                    left: 50%;
                    top: 0;
                    bottom: 0;
                    width: 2px;
                    background: var(--ss-color-border);
                    transform: translateX(-50%);
                "
            ></div>

            <!-- Left item -->
            <div style="display: flex; margin-bottom: 40px">
                <div style="flex: 1; padding-right: 40px; text-align: right">
                    <div
                        style="
                            padding: 20px;
                            background: var(--ss-color-surface);
                            border: 1px solid var(--ss-color-border);
                            border-radius: var(--ss-radius-lg);
                            display: inline-block;
                            text-align: left;
                            max-width: 300px;
                        "
                    >
                        <span
                            style="
                                font-size: 12px;
                                font-weight: 600;
                                color: var(--ss-color-accent);
                            "
                        >
                            2026
                        </span>
                        <h3 style="margin: 8px 0; font-size: 16px">
                            Project Alpha Launch
                        </h3>
                        <p style="margin: 0; font-size: 14px; opacity: 0.7">
                            Successfully launched our flagship product to
                            market.
                        </p>
                    </div>
                </div>
                <div
                    style="
                        position: relative;
                        width: 20px;
                        display: flex;
                        justify-content: center;
                    "
                >
                    <div
                        style="
                            width: 14px;
                            height: 14px;
                            background: var(--ss-color-accent);
                            border-radius: 50%;
                        "
                    ></div>
                </div>
                <div style="flex: 1"></div>
            </div>

            <!-- Right item -->
            <div style="display: flex; margin-bottom: 40px">
                <div style="flex: 1"></div>
                <div
                    style="
                        position: relative;
                        width: 20px;
                        display: flex;
                        justify-content: center;
                    "
                >
                    <div
                        style="
                            width: 14px;
                            height: 14px;
                            background: var(--ss-color-accent);
                            border-radius: 50%;
                        "
                    ></div>
                </div>
                <div style="flex: 1; padding-left: 40px">
                    <div
                        style="
                            padding: 20px;
                            background: var(--ss-color-surface);
                            border: 1px solid var(--ss-color-border);
                            border-radius: var(--ss-radius-lg);
                            display: inline-block;
                            max-width: 300px;
                        "
                    >
                        <span
                            style="
                                font-size: 12px;
                                font-weight: 600;
                                color: var(--ss-color-accent);
                            "
                        >
                            2024
                        </span>
                        <h3 style="margin: 8px 0; font-size: 16px">
                            Series A Funding
                        </h3>
                        <p style="margin: 0; font-size: 14px; opacity: 0.7">
                            Secured $10M in funding to accelerate growth.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Left item -->
            <div style="display: flex; margin-bottom: 40px">
                <div style="flex: 1; padding-right: 40px; text-align: right">
                    <div
                        style="
                            padding: 20px;
                            background: var(--ss-color-surface);
                            border: 1px solid var(--ss-color-border);
                            border-radius: var(--ss-radius-lg);
                            display: inline-block;
                            text-align: left;
                            max-width: 300px;
                        "
                    >
                        <span
                            style="
                                font-size: 12px;
                                font-weight: 600;
                                color: var(--ss-color-accent);
                            "
                        >
                            2023
                        </span>
                        <h3 style="margin: 8px 0; font-size: 16px">
                            Company Founded
                        </h3>
                        <p style="margin: 0; font-size: 14px; opacity: 0.7">
                            Started with a small team and big dreams.
                        </p>
                    </div>
                </div>
                <div
                    style="
                        position: relative;
                        width: 20px;
                        display: flex;
                        justify-content: center;
                    "
                >
                    <div
                        style="
                            width: 14px;
                            height: 14px;
                            background: var(--ss-color-accent);
                            border-radius: 50%;
                        "
                    ></div>
                </div>
                <div style="flex: 1"></div>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Horizontal Timeline #} {% set section_title = "Horizontal Timeline" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Scrollable horizontal timeline for compact displays.</p>
        {% set code_snippet %}
        <div
            class="ss-c-timeline ss-c-timeline--horizontal"
            style="position: relative; overflow-x: auto; padding: 40px 20px"
            tabindex="0"
            role="region"
            aria-label="Project roadmap"
        >
            <div
                style="
                    display: flex;
                    gap: 60px;
                    position: relative;
                    min-width: max-content;
                "
            >
                <!-- Timeline line -->
                <div
                    style="
                        position: absolute;
                        top: 8px;
                        left: 0;
                        right: 0;
                        height: 2px;
                        background: var(--ss-color-border);
                    "
                ></div>

                <!-- Item 1 -->
                <div
                    style="
                        position: relative;
                        text-align: center;
                        width: 150px;
                    "
                >
                    <div
                        style="
                            width: 16px;
                            height: 16px;
                            background: var(--ss-color-accent);
                            border-radius: 50%;
                            margin: 0 auto 16px;
                        "
                    ></div>
                    <div style="font-weight: 600; margin-bottom: 4px">
