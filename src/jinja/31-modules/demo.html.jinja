{% extends "../base.html.jinja" %} {% set title = "Demo" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>Examples for the <code>ss-c-demo</code> module.</p>

    {% set section_title = "Structure" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <section class="ss-c-demo__section" data-label="Section" data-level="1">
            <header class="ss-c-demo__section__header"><h3>Section title</h3></header>
            <section class="ss-c-demo__subsection" data-label="Subsection" data-level="2">
                <h4>Subsection title</h4>
                <p>Subsection content goes here.</p>
            </section>
        </section>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
