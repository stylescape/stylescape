{% extends "../base.html.jinja" %} {% set title = "Indicator" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>Examples for the <code>ss-c-indicator</code> module, including the <code>ss-c-status-dot</code> and <code>ss-c-status-bar</code> parts. A dot only repeats what its text label says, so keep the label and hide the dot from assistive technology.</p>

    {% set section_title = "Badge corner" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <span class="ss-c-indicator">
            <span class="ss-c-indicator__item ss-c-badge ss-c-badge--error">9+</span>
            <button type="button" class="ss-c-button">Inbox</button>
        </span>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Positions" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <span class="ss-c-indicator">
            <span class="ss-c-indicator__item ss-c-indicator__item--top-start ss-c-badge">TS</span>
            <span class="ss-c-indicator__item ss-c-indicator__item--top-end ss-c-badge">TE</span>
            <span class="ss-c-indicator__item ss-c-indicator__item--bottom-start ss-c-badge">BS</span>
            <span class="ss-c-indicator__item ss-c-indicator__item--bottom-end ss-c-badge">BE</span>
            <button type="button" class="ss-c-button" style="min-width: 12em; min-height: 6em">Container</button>
        </span>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
    {% set section_title = "Status dot" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <ul style="display: flex; gap: 1.5rem; list-style: none; padding: 0; flex-wrap: wrap">
            <li><span class="ss-c-status-dot ss-c-status-dot--success" aria-hidden="true"></span> Online</li>
            <li><span class="ss-c-status-dot ss-c-status-dot--warning" aria-hidden="true"></span> Degraded</li>
            <li><span class="ss-c-status-dot ss-c-status-dot--error" aria-hidden="true"></span> Offline</li>
            <li><span class="ss-c-status-dot ss-c-status-dot--info" aria-hidden="true"></span> Syncing</li>
            <li><span class="ss-c-status-dot ss-c-status-dot--muted" aria-hidden="true"></span> Unknown</li>
            <li><span class="ss-c-status-dot ss-c-status-dot--success ss-c-status-dot--pulse" aria-hidden="true"></span> Live</li>
            <li><span class="ss-c-status-dot ss-c-status-dot--sm ss-c-status-dot--success" aria-hidden="true"></span> Small</li>
            <li><span class="ss-c-status-dot ss-c-status-dot--lg ss-c-status-dot--success" aria-hidden="true"></span> Large</li>
        </ul>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Status bar" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <footer class="ss-c-status-bar" aria-label="Connection status">
            <span class="ss-c-status-bar__item" role="status"><span class="ss-c-status-dot ss-c-status-dot--success ss-c-status-dot--pulse" aria-hidden="true"></span>Connected</span>
            <span class="ss-c-status-bar__item">3 peers</span>
            <span class="ss-c-status-bar__item">Latency 38 ms</span>
            <span class="ss-c-status-bar__item ss-c-status-bar__spacer">Ln 12, Col 4</span>
            <span class="ss-c-status-bar__item">UTF-8</span>
        </footer>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
