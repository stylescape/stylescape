{% extends "../base.html.jinja" %} {% set title = "Headline" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>Examples for the <code>ss-c-headline</code> module.</p>

    {% set section_title = "Full" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <header class="ss-c-headline">
            <span class="ss-c-headline__live">LIVE</span>
            <p class="ss-c-headline__kicker">Breaking</p>
            <h3 class="ss-c-headline__text">Major update to the design system shipped today</h3>
            <p class="ss-c-headline__teaser">Stylescape 0.3.11 introduces 18 new modules and a layered cascade.</p>
            <p class="ss-c-headline__sub">
                <span class="ss-c-headline__sub-description">By Editorial</span>
                <span class="ss-c-headline__sub-description">3 min read</span>
            </p>
        </header>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
