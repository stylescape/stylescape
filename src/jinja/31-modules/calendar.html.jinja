{% extends "../base.html.jinja" %} {% set title = "Calendar" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>Examples for the <code>ss-c-calendar</code> module: a month grid as a semantic <code>&lt;table&gt;</code> with a <code>&lt;caption&gt;</code>, weekday headers (<code>abbr</code> gives the full name) and one cell per day. Mark today with <code>aria-current="date"</code> on its date. The module only draws; the app supplies the dates.</p>

    {% set section_title = "Month with events" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <table class="ss-c-calendar">
            <caption class="ss-c-calendar__caption">October 2026</caption>
            <thead><tr><th scope="col" abbr="Monday">Mon</th><th scope="col" abbr="Tuesday">Tue</th><th scope="col" abbr="Wednesday">Wed</th><th scope="col" abbr="Thursday">Thu</th><th scope="col" abbr="Friday">Fri</th><th scope="col" abbr="Saturday">Sat</th><th scope="col" abbr="Sunday">Sun</th></tr></thead>
            <tbody>
                <tr>
                    <td class="ss-c-calendar__day ss-c-calendar__day--outside"><time class="ss-c-calendar__date" datetime="2026-09-28">28</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--outside"><time class="ss-c-calendar__date" datetime="2026-09-29">29</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--outside"><time class="ss-c-calendar__date" datetime="2026-09-30">30</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-01">1</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-02">2</time><ul class="ss-c-calendar__events"><li class="ss-c-calendar__event ss-c-calendar__event--info">Sprint review</li></ul></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--weekend"><time class="ss-c-calendar__date" datetime="2026-10-03">3</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--weekend"><time class="ss-c-calendar__date" datetime="2026-10-04">4</time></td>
                </tr>
                <tr>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-05">5</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-06">6</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-07">7</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-08" aria-current="date">8</time><ul class="ss-c-calendar__events"><li class="ss-c-calendar__event ss-c-calendar__event--success">Release 1.0</li><li class="ss-c-calendar__event">Team lunch</li></ul></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-09">9</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--weekend"><time class="ss-c-calendar__date" datetime="2026-10-10">10</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--weekend"><time class="ss-c-calendar__date" datetime="2026-10-11">11</time></td>
                </tr>
                <tr>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-12">12</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-13">13</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--selected"><time class="ss-c-calendar__date" datetime="2026-10-14">14</time><ul class="ss-c-calendar__events"><li class="ss-c-calendar__event ss-c-calendar__event--warning">Permit deadline</li></ul></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-15">15</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-16">16</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--weekend"><time class="ss-c-calendar__date" datetime="2026-10-17">17</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--weekend"><time class="ss-c-calendar__date" datetime="2026-10-18">18</time></td>
                </tr>
                <tr>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-19">19</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-20">20</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-21">21</time><ul class="ss-c-calendar__events"><li class="ss-c-calendar__event ss-c-calendar__event--error">Server maintenance</li></ul></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-22">22</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-23">23</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--weekend"><time class="ss-c-calendar__date" datetime="2026-10-24">24</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--weekend"><time class="ss-c-calendar__date" datetime="2026-10-25">25</time></td>
                </tr>
                <tr>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-26">26</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-27">27</time><ul class="ss-c-calendar__events"><li class="ss-c-calendar__event">Workshop: BIM</li></ul></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-28">28</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-29">29</time></td>
                    <td class="ss-c-calendar__day"><time class="ss-c-calendar__date" datetime="2026-10-30">30</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--weekend"><time class="ss-c-calendar__date" datetime="2026-10-31">31</time></td>
                    <td class="ss-c-calendar__day ss-c-calendar__day--outside"><time class="ss-c-calendar__date" datetime="2026-11-01">1</time></td>
                </tr>
            </tbody>
        </table>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Compact picker" %}
