                    <td class="ss-c-calendar__day"><button type="button" class="ss-c-calendar__date" aria-pressed="false" aria-label="9 October 2026">9</button></td>
                    <td class="ss-c-calendar__day"><button type="button" class="ss-c-calendar__date" aria-pressed="false" aria-label="10 October 2026">10</button></td>
                    <td class="ss-c-calendar__day"><button type="button" class="ss-c-calendar__date" aria-pressed="false" aria-label="11 October 2026">11</button></td>
