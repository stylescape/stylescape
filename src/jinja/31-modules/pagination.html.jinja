{% extends "../base.html.jinja" %} {%- block title %}Pagination{%- endblock %} {%-
block content %}
<header class="ss-c-demo__section__header">
    <h1>Pagination</h1>
    <p>Page navigation controls for paged content.</p>
</header>
{#
============================================================================
Basic Pagination
============================================================================ #}
<section class="ss-c-demo__section" data-label="Basic Pagination" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Basic Pagination</h2>
        <p>Navigate through pages of content.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Simple Pagination</h3>
        {% set code_snippet %}
        <nav aria-label="Simple pagination example">
            <ul class="ss-c-pagination">
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link" aria-label="Previous">
                        ←
                    </a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">1</a>
                </li>
                <li class="ss-c-pagination__item ss-c-pagination__item--active">
                    <a href="#" class="ss-c-pagination__link" aria-current="page">
                        2
                    </a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">3</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link" aria-label="Next">
                        →
                    </a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>With First/Last</h3>
        {% set code_snippet %}
        <nav aria-label="First and last pagination">
            <ul class="ss-c-pagination">
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link" aria-label="First">
                        ««
                    </a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link" aria-label="Previous">
                        «
                    </a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">1</a>
                </li>
                <li class="ss-c-pagination__item ss-c-pagination__item--active">
                    <a href="#" class="ss-c-pagination__link" aria-current="page">
                        2
                    </a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">3</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link" aria-label="Next">
                        »
                    </a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link" aria-label="Last">
                        »»
                    </a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Pagination States
============================================================================ #}
<section class="ss-c-demo__section" data-label="States" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Pagination States</h2>
        <p>Disabled and active states.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Disabled Items</h3>
        {% set code_snippet %}
        <nav aria-label="Disabled items pagination">
            <ul class="ss-c-pagination">
                <li class="ss-c-pagination__item ss-c-pagination__item--disabled">
                    <a
                        href="#"
                        class="ss-c-pagination__link"
                        tabindex="-1"
                        aria-disabled="true"
                    >
                        Previous
                    </a>
                </li>
                <li class="ss-c-pagination__item ss-c-pagination__item--active">
                    <a href="#" class="ss-c-pagination__link" aria-current="page">
                        1
                    </a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">2</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">3</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">Next</a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Pagination Sizes
============================================================================ #}
<section class="ss-c-demo__section" data-label="Sizes" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Pagination Sizes</h2>
        <p>Different size variations.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Size Variations</h3>
        {% set code_snippet %}
        <nav aria-label="Small pagination">
            <ul class="ss-c-pagination ss-c-pagination--sm">
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">«</a>
                </li>
                <li class="ss-c-pagination__item ss-c-pagination__item--active">
                    <a href="#" class="ss-c-pagination__link">1</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">2</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">»</a>
                </li>
            </ul>
        </nav>

        <nav aria-label="Default pagination" class="ss-c-mt--02">
            <ul class="ss-c-pagination">
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">«</a>
                </li>
                <li class="ss-c-pagination__item ss-c-pagination__item--active">
                    <a href="#" class="ss-c-pagination__link">1</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">2</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">»</a>
                </li>
            </ul>
        </nav>

        <nav aria-label="Large pagination" class="ss-c-mt--02">
            <ul class="ss-c-pagination ss-c-pagination--lg">
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">«</a>
                </li>
                <li class="ss-c-pagination__item ss-c-pagination__item--active">
                    <a href="#" class="ss-c-pagination__link">1</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">2</a>
                </li>
                <li class="ss-c-pagination__item">
                    <a href="#" class="ss-c-pagination__link">»</a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

