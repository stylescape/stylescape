{% extends "../base.html.jinja" %} {% set title = "Scrollspy" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h2>{{ title }}</h2></header>
    <p>Examples for the <code>ss-c-scrollspy</code> module.</p>

    {% set section_title = "Nav + progress" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <nav class="ss-c-scrollspy">
            <ul class="ss-c-scrollspy__nav">
                <li><a href="#sec-a">Section A</a></li>
                <li><a href="#sec-b">Section B</a></li>
                <li><a href="#sec-c">Section C</a></li>
            </ul>
            <div class="ss-c-scrollspy__progress-bar"></div>
            <div class="ss-c-scrollspy__progress-dots"></div>
        </nav>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
