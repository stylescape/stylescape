{% extends "../base.html.jinja" %} {% set title = "Box Size" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    <section class="ss-c-demo__subsection">
        <div class="ss-c-grid--col--12">
            <div class="ss-c-box-preview ss-c-box--size_00">
                00
                <div class="ss-c-box-label">4x baseline</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_01">
                01
                <div class="ss-c-box-label">1x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_02">
                02
                <div class="ss-c-box-label">2x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_03">
                03
                <div class="ss-c-box-label">3x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_04">
                04
                <div class="ss-c-box-label">4x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_05">
                05
                <div class="ss-c-box-label">5x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_06">
                06
                <div class="ss-c-box-label">6x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_07">
                07
                <div class="ss-c-box-label">7x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_08">
                08
                <div class="ss-c-box-label">8x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_09">
                09
                <div class="ss-c-box-label">9x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_10">
                10
                <div class="ss-c-box-label">10x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_11">
                11
                <div class="ss-c-box-label">11x</div>
            </div>
            <div class="ss-c-box-preview ss-c-box--size_12">
                12
                <div class="ss-c-box-label">12x</div>
            </div>
        </div>
    </section>
</section>

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% set section_title = "Demo Code" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div></div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
