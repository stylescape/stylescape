                type="text"
                id="input_text_place"
                class="ss-c-input ss-c-input--base--inline ss-c-input--style--filled"
                placeholder="Place"
            />
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

