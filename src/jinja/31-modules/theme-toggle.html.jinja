{% extends "../base.html.jinja" %} {% set title = "Theme Toggle" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
{% set sun %}<svg class="ss-c-theme-toggle__icon ss-c-theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>{% endset %}
{% set moon %}<svg class="ss-c-theme-toggle__icon ss-c-theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>{% endset %}
{% set auto %}<svg class="ss-c-theme-toggle__icon ss-c-theme-toggle__icon--auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16a8 8 0 0 0 0-16z" fill="currentColor"/></svg>{% endset %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>Examples for the <code>ss-c-theme-toggle</code> module.</p>
    <p>
        A button that switches the page theme (<code>data-theme</code> on
        <code>&lt;html&gt;</code>), driven by <code>ThemeToggler</code>, which
        remembers the choice in localStorage. A two-state button is pressed
        (<code>aria-pressed="true"</code>) while the page is dark, including
        <code>"auto"</code> on a dark system. With <code>data-theme-cycle</code> it
        steps light &rarr; dark &rarr; auto and shows the choice in
        <code>data-theme-state</code>. Before the script runs, the icon follows the
        page's <code>data-theme</code>. Icons are inline SVG or a CSS-drawn
        <code>__glyph</code>; no icon font.
    </p>

    {% set section_title = "Icon button" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <button type="button" class="ss-c-theme-toggle" aria-pressed="false" aria-label="Dark mode">
            {{ sun }}{{ moon }}
        </button>
        <button type="button" class="ss-c-theme-toggle" aria-pressed="true" aria-label="Dark mode">
            {{ sun }}{{ moon }}
        </button>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "With label" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <button type="button" class="ss-c-theme-toggle" aria-pressed="false">
            {{ sun }}{{ moon }} Dark mode
        </button>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "CSS glyph" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        <p>An empty <code>__glyph</code> span draws a sun, moon or half disc in CSS.</p>
        {% set code_snippet %}
        <button type="button" class="ss-c-theme-toggle" aria-pressed="false" aria-label="Dark mode">
            <span class="ss-c-theme-toggle__glyph"></span>
        </button>
        <button type="button" class="ss-c-theme-toggle" aria-pressed="true" aria-label="Dark mode">
            <span class="ss-c-theme-toggle__glyph"></span>
        </button>
        <button type="button" class="ss-c-theme-toggle" data-theme-cycle data-theme-state="auto"
                aria-label="Theme: system">
            <span class="ss-c-theme-toggle__glyph"></span>
        </button>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Light / dark / auto" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        <p>
            <code>data-theme-label-light|dark|auto</code> give the button a name per
            state; <code>ThemeToggler</code> copies the current one to
            <code>aria-label</code>.
        </p>
        {% set code_snippet %}
        <button type="button" class="ss-c-theme-toggle ss-c-theme-toggle--ghost" data-theme-cycle
                data-theme-state="light" aria-label="Theme: light"
                data-theme-label-light="Theme: light"
                data-theme-label-dark="Theme: dark"
                data-theme-label-auto="Theme: system">
            {{ sun }}{{ moon }}{{ auto }}
        </button>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
