{% extends "../base.html.jinja" %} {% set title = "Timestamp" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% set section_title = "Basic Timestamp" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <time class="ss-c-timestamp" datetime="2026-01-21T10:30:00">
            January 21, 2026 at 10:30 AM
        </time>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Elevated Timestamp" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="timestamp-elevate">
            <div class="ss-c-timestamp__container">
                <time
                    class="ss-c-timestamp__time-since"
                    datetime="2026-01-21T08:00:00"
                >
                    3 hours ago
                </time>
                <button
                    class="ss-c-timestamp__expand-button"
                    aria-label="Expand timestamp details"
                ></button>
            </div>
            <div class="ss-c-timestamp__details">
                <time datetime="2026-01-21T08:00:00">
                    January 21, 2026 at 8:00 AM
                </time>
            </div>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Active Timestamp" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="timestamp-elevate">
            <div class="ss-c-timestamp__container">
                <time
                    class="ss-c-timestamp__time-since ss-c-timestamp__time-since--active"
                    datetime="2026-01-21T10:00:00"
                >
                    Just now
                </time>
            </div>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Expanded Timestamp" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="timestamp-elevate timestamp-elevate--expanded">
            <div class="ss-c-timestamp__container">
                <time
                    class="ss-c-timestamp__time-since"
                    datetime="2026-01-20T14:30:00"
                >
                    Yesterday
                </time>
                <button
                    class="ss-c-timestamp__expand-button"
                    aria-label="Collapse timestamp details"
                ></button>
            </div>
            <div class="ss-c-timestamp__details" style="display: block">
                <time datetime="2026-01-20T14:30:00">
                    January 20, 2026 at 2:30 PM
                </time>
            </div>
        </div>
        {% endset %}
        <div class="demo__preview">{{ code_snippet | safe }}</div>
        <div class="demo__code">
            <pre><code class="language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>
</section>

{%- endblock %}
