{% extends "../base.html.jinja" %} {% set title = "Preloader" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
    </header>

    {% set section_title = "Preloader Container" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>
            The preloader container normally covers the full viewport. Below is
            a constrained demo.
        </p>
        {% set code_snippet %}
        <div
            class="ss-c-preloader"
            style="position: relative; width: 100%; height: 200px"
        >
            <!-- Preloader content goes here -->
            <span>Loading...</span>
        </div>
        {% endset %}
        <div class="ss-c-demo__preview">{{ code_snippet | safe }}</div>
        <div class="ss-c-demo__code">
            <pre><code class="ss-c-language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Lines Preloader" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            style="
                position: relative;
                width: 100%;
                height: 200px;
                background: var(--ss-color-surface-alt);
                display: flex;
                justify-content: center;
                align-items: center;
            "
        >
            <div class="ss-c-preloader_lines">
                <div class="ss-c-preloader_line ss-c-preloader_line_1"></div>
                <div class="ss-c-preloader_line ss-c-preloader_line_2"></div>
                <div class="ss-c-preloader_line ss-c-preloader_line_3"></div>
                <div class="ss-c-preloader_line ss-c-preloader_line_4"></div>
                <div class="ss-c-preloader_line ss-c-preloader_line_5"></div>
            </div>
        </div>
        {% endset %}
        <div class="ss-c-demo__preview">{{ code_snippet | safe }}</div>
        <div class="ss-c-demo__code">
            <pre><code class="ss-c-language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Pulse Preloader" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            style="
                position: relative;
                width: 100%;
                height: 200px;
                background: var(--ss-color-surface-alt);
            "
        >
            <div
                class="ss-c-preloader_pulse"
                style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%)"
            ></div>
        </div>
        {% endset %}
        <div class="ss-c-demo__preview">{{ code_snippet | safe }}</div>
        <div class="ss-c-demo__code">
            <pre><code class="ss-c-language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>

    {% set section_title = "Hidden Preloader State" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>
            <code>Preloader</code> adds
            <code>ss-c-preloader--hidden</code> once the page has loaded, which
            fades the preloader out. <code>ss-c-preloader_hidden</code> removes
            it from the layout at once (pass it as <code>hiddenClass</code> or
            <code>data-ss-preloader-hidden-class</code> to use it instead).
        </p>
        {% set code_snippet %}
        <div
            class="ss-c-preloader ss-c-preloader_hidden"
            style="position: relative; width: 100%; height: 100px"
        >
            <span>This preloader is hidden</span>
        </div>
        {% endset %}
        <div class="ss-c-demo__preview">{{ code_snippet | safe }}</div>
        <div class="ss-c-demo__code">
            <pre><code class="ss-c-language-html">{{ code_snippet | e }}</code></pre>
        </div>
    </section>
</section>

{%- endblock %}
