{% extends "../base.html.jinja" %} {% set title = "Navbar" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h2>{{ title }}</h2></header>
    <p>Examples for the <code>ss-c-navbar</code> module.</p>

    {% set section_title = "Default" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <nav class="ss-c-navbar">
            <div class="ss-c-navbar__start">
                <strong>Stylescape</strong>
            </div>
            <div class="ss-c-navbar__center">
                <a href="#">Docs</a>
                <a href="#">Modules</a>
                <a href="#">About</a>
            </div>
            <div class="ss-c-navbar__end">
                <button class="ss-c-button ss-c-button--primary">Sign in</button>
            </div>
        </nav>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
