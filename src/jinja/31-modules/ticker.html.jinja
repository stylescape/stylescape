        <div
            class="ss-c-ticker ss-c-ticker--pausable"
            style="
                overflow: hidden;
                background: var(--ss-color-surface-alt);
                color: var(--ss-color-text);
                padding: 16px 0;
                border-radius: var(--ss-radius-lg);
                cursor: default;
            "
        >
            <div
                class="ss-c-ticker__content"
                style="
                    display: flex;
                    gap: 48px;
                    white-space: nowrap;
                    animation: ticker 25s linear infinite;
                    font-weight: 500;
