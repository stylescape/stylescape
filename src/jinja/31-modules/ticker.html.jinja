{% extends "../base.html.jinja" %} {% set title = "Tickers & Marquees" %} {%-
block title %}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            Animated scrolling text for announcements, news tickers, and brand
            marquees.
        </p>
    </header>

    {# Basic Ticker #} {% set section_title = "Basic Ticker" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Simple horizontal scrolling text.</p>
        {% set code_snippet %}
        <div
            class="ss-c-ticker"
            style="
                overflow: hidden;
                background: var(--ss-color-accent);
                color: var(--ss-color-on-accent);
                padding: 12px 0;
            "
        >
            <div
                class="ss-c-ticker__content"
                style="
                    display: flex;
                    animation: ticker 20s linear infinite;
                    white-space: nowrap;
                "
            >
                <span style="padding: 0 48px">
                    ✺ Welcome to Stylescape — The ultimate design system for
                    modern web development
                </span>
                <span style="padding: 0 48px">
                    ✦ New components added weekly
                </span>
                <span style="padding: 0 48px">
                    ➤ Version 2.0 now available
                </span>
                <span style="padding: 0 48px">
                    ✺ Welcome to Stylescape — The ultimate design system for
                    modern web development
                </span>
                <span style="padding: 0 48px">
                    ✦ New components added weekly
                </span>
                <span style="padding: 0 48px">
                    ➤ Version 2.0 now available
                </span>
            </div>
        </div>

        <style>
            @keyframes ticker {
                0% {
                    transform: translateX(0);
                }
                100% {
                    transform: translateX(-50%);
                }
            }
            .ss-c-ticker:hover .ss-c-ticker__content,
            .ss-c-ticker:focus-within .ss-c-ticker__content {
                animation-play-state: paused;
            }
            @media (prefers-reduced-motion: reduce) {
                .ss-c-ticker__content {
                    animation: none !important;
                }
            }
        </style>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

