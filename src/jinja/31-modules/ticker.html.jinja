        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Ticker scrolling in opposite direction.</p>
        {% set code_snippet %}
        <div
            class="ss-c-ticker ss-c-ticker--reverse"
            style="
                overflow: hidden;
                background: linear-gradient(90deg, #4f46e5, #6d28d9);
                color: white;
                padding: 16px 0;
                border-radius: var(--ss-radius-lg);
            "
        >
            <div
                class="ss-c-ticker__content"
                style="
                    display: flex;
                    gap: 32px;
                    white-space: nowrap;
                    animation: ticker-reverse 20s linear infinite;
                    font-size: 14px;
                    text-transform: uppercase;
                    letter-spacing: 2px;
                "
            >
                <span>★ Special Offer</span>
                <span>★ Free Shipping</span>
                <span>★ 24/7 Support</span>
                <span>★ Money Back Guarantee</span>
                <span>★ Premium Quality</span>
                <span>★ Special Offer</span>
                <span>★ Free Shipping</span>
                <span>★ 24/7 Support</span>
                <span>★ Money Back Guarantee</span>
                <span>★ Premium Quality</span>
            </div>
        </div>

        <style>
            @keyframes ticker-reverse {
                0% {
                    transform: translateX(-50%);
                }
                100% {
                    transform: translateX(0);
                }
            }
        </style>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Pause on Hover #} {% set section_title = "Pause on Hover" %}
