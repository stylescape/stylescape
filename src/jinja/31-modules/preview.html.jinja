    <section class="ss-c-demo__subsection">
        {% set code_snippet="
        <h1>The quick brown fox jumps over the lazy dog.</h1>
        " %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        {% set code_snippet="
        <h1>The quick.</h1>
        " %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock content %}
