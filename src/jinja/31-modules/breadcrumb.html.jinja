                </li>
            </ol>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Breadcrumb with Icons
============================================================================ #}
<section class="ss-c-demo__section" data-label="With Icons" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Breadcrumb with Icons</h2>
        <p>Enhanced breadcrumbs with icon elements.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Home Icon</h3>
        {% set code_snippet %}
        <nav aria-label="Breadcrumb (home icon)">
            <ol class="ss-c-breadcrumb">
                <li class="ss-c-breadcrumb__item">
                    <a href="#" aria-label="Home">
                        <span class="ss-c-breadcrumb__icon">⌂</span>
                    </a>
                </li>
                <li class="ss-c-breadcrumb__item"><a href="#">Products</a></li>
                <li
                    class="ss-c-breadcrumb__item ss-c-breadcrumb__item--active"
                    aria-current="page"
                >
                    Details
                </li>
            </ol>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Icons on All Items</h3>
        {% set code_snippet %}
        <nav aria-label="Breadcrumb (icons on all items)">
            <ol class="ss-c-breadcrumb">
                <li class="ss-c-breadcrumb__item">
                    <a href="#">
                        <span class="ss-c-breadcrumb__icon">⌂</span>
                        <span>Home</span>
                    </a>
                </li>
                <li class="ss-c-breadcrumb__item">
                    <a href="#">
                        <span class="ss-c-breadcrumb__icon">▤</span>
                        <span>Folder</span>
                    </a>
                </li>
                <li
                    class="ss-c-breadcrumb__item ss-c-breadcrumb__item--active"
                    aria-current="page"
                >
                    <span class="ss-c-breadcrumb__icon">▭</span>
                    <span>File</span>
                </li>
            </ol>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Collapsed Breadcrumb
============================================================================ #}
<section class="ss-c-demo__section" data-label="Collapsed" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Collapsed Breadcrumb</h2>
        <p>Truncated breadcrumbs for long navigation paths.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Ellipsis Collapse</h3>
        {% set code_snippet %}
        <nav aria-label="Breadcrumb (ellipsis collapse)">
            <ol class="ss-c-breadcrumb">
                <li class="ss-c-breadcrumb__item"><a href="#">Home</a></li>
                <li class="ss-c-breadcrumb__item ss-c-breadcrumb__item--collapsed">
                    <button
                        class="ss-c-breadcrumb__expand"
                        aria-label="Show hidden items"
                    >
                        ...
                    </button>
                </li>
                <li class="ss-c-breadcrumb__item"><a href="#">Parent</a></li>
                <li
                    class="ss-c-breadcrumb__item ss-c-breadcrumb__item--active"
                    aria-current="page"
                >
                    Current
                </li>
            </ol>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Breadcrumb Sizes
============================================================================ #}
<section class="ss-c-demo__section" data-label="Sizes" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Breadcrumb Sizes</h2>
        <p>Different size variations.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Size Variations</h3>
        {% set code_snippet %}
        <nav aria-label="Breadcrumb (size variations, small)">
            <ol class="ss-c-breadcrumb ss-c-breadcrumb--sm">
                <li class="ss-c-breadcrumb__item"><a href="#">Home</a></li>
                <li
                    class="ss-c-breadcrumb__item ss-c-breadcrumb__item--active"
                    aria-current="page"
                >
                    Small
                </li>
            </ol>
        </nav>

        <nav aria-label="Breadcrumb (size variations, default)">
            <ol class="ss-c-breadcrumb">
                <li class="ss-c-breadcrumb__item"><a href="#">Home</a></li>
                <li
                    class="ss-c-breadcrumb__item ss-c-breadcrumb__item--active"
                    aria-current="page"
                >
                    Default
                </li>
            </ol>
        </nav>

        <nav aria-label="Breadcrumb (size variations, large)">
            <ol class="ss-c-breadcrumb ss-c-breadcrumb--lg">
                <li class="ss-c-breadcrumb__item"><a href="#">Home</a></li>
                <li
                    class="ss-c-breadcrumb__item ss-c-breadcrumb__item--active"
                    aria-current="page"
                >
                    Large
                </li>
            </ol>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
