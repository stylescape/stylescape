{% extends "../base.html.jinja" %} {%- block title %}Breadcrumb{%- endblock %} {%-
block content %} {#
============================================================================
Basic Breadcrumb
============================================================================ #}
<header class="ss-c-demo__section__header">
    <h1>Breadcrumb</h1>
    <p>Secondary navigation that shows the current page location within a hierarchy.</p>
</header>

<section class="ss-c-demo__section" data-label="Basic Breadcrumb" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Basic Breadcrumb</h2>
        <p>
            Navigation trail showing the user's location in the site hierarchy.
        </p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Simple Breadcrumb</h3>
        {% set code_snippet %}
        <nav aria-label="Breadcrumb (simple breadcrumb)">
            <ol class="ss-c-breadcrumb">
                <li class="ss-c-breadcrumb__item"><a href="#">Home</a></li>
                <li class="ss-c-breadcrumb__item"><a href="#">Products</a></li>
                <li
                    class="ss-c-breadcrumb__item ss-c-breadcrumb__item--active"
                    aria-current="page"
                >
                    Category
                </li>
            </ol>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Deep Navigation</h3>
        {% set code_snippet %}
        <nav aria-label="Breadcrumb (deep navigation)">
            <ol class="ss-c-breadcrumb">
                <li class="ss-c-breadcrumb__item"><a href="#">Home</a></li>
                <li class="ss-c-breadcrumb__item"><a href="#">Documentation</a></li>
                <li class="ss-c-breadcrumb__item"><a href="#">Components</a></li>
                <li class="ss-c-breadcrumb__item"><a href="#">Navigation</a></li>
                <li
                    class="ss-c-breadcrumb__item ss-c-breadcrumb__item--active"
                    aria-current="page"
                >
                    Breadcrumb
                </li>
            </ol>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Breadcrumb Separators
============================================================================ #}
