    -----------------------------------------------------------------------------
    Top Ribbon Slots
    -----------------------------------------------------------------------------
    #} {% set section_title = "Ribbon Slots" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
