                            <svg aria-hidden="true" focusable="false" width="16" height="16" style="flex: none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 14A6 6 0 1 1 14 8c0 2.2-1.8 4-4 4s-3-1.3-3-3 1.3-2.5 2.5-2.5"/></svg>
                        </button>
                    </li>
                    <li class="ss-c-ribbon__menu__item">
                        <button type="button" class="ss-c-ribbon__button" aria-label="Menu">
