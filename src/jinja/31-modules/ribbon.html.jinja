    {#
    -----------------------------------------------------------------------------
    Top Ribbon Forms
    -----------------------------------------------------------------------------
    #}

    <section class="ss-c-demo__subsection">
        <h2>Top Ribbon Search</h2>
        {% set code_snippet %}
        <div class="ss-c-ribbon ss-c-ribbon--top">
            <div class="ss-c-ribbon__search">
                <form
                    id="ribbon__search__form--left"
                    class="ss-c-ribbon__search__form"
                    role="search"
                    aria-label="Ribbon search (left)"
                >
                    <button
                        type="submit"
                        id="ribbon__search_button--left"
                        class="ss-c-ribbon__search_button"
                        aria-label="Search"
                        style="flex: none"
                    >
                        <svg aria-hidden="true" focusable="false" width="16" height="16" style="flex: none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>
                    </button>
                    <input
                        type="text"
                        id="ribbon__search__input--left"
                        class="ss-c-ribbon__search__input"
                        aria-label="Search"
                        placeholder="Search..."
                    />
                </form>
            </div>
        </div>
        <br />
        <div class="ss-c-ribbon ss-c-ribbon--top">
            <div class="ss-c-ribbon__slot--horizontal_center">
                <div class="ss-c-ribbon__search">
                    <form
                        id="ribbon__search__form--center"
                        class="ss-c-ribbon__search__form"
                        role="search"
                        aria-label="Ribbon search (center)"
                    >
                        <button
                            type="submit"
                            id="ribbon__search_button--center"
                            class="ss-c-ribbon__search_button"
                            aria-label="Search"
                            style="flex: none"
                        >
                            <svg aria-hidden="true" focusable="false" width="16" height="16" style="flex: none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>
                        </button>
                        <input
                            type="text"
                            id="ribbon__search__input--center"
                            class="ss-c-ribbon__search__input"
                            aria-label="Search"
                            placeholder="Search..."
                        />
                    </form>
                </div>
            </div>
        </div>
        <br />
        <div class="ss-c-ribbon ss-c-ribbon--top">
            <div class="ss-c-ribbon__slot--horizontal_right">
                <div class="ss-c-ribbon__search">
                    <form
                        id="ribbon__search__form--right"
                        class="ss-c-ribbon__search__form"
                        role="search"
                        aria-label="Ribbon search (right)"
