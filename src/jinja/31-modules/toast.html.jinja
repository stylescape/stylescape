{% extends "../base.html.jinja" %} {% set title = "Toasts" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            Short notifications that float in a corner of the viewport. An
            <code>ss-c-toast-region</code> with a <code>data-position</code>
            (<code>top-right</code>, <code>top-left</code>,
            <code>bottom-right</code>, <code>bottom-left</code>) holds the
            toasts; inside <code>ss-l-app</code> the top regions start below
            the app header. Django messages use the same toasts through
            <code>ss-c-messages--toast</code> (see Messages).
        </p>
    </header>

    {% set section_title = "Variants" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        <p>
            Shown in place here; in a page they sit in a region. The modifiers
            follow Django's <code>level_tag</code>: <code>--debug</code> (the
            default look), <code>--info</code>, <code>--success</code>,
            <code>--warning</code> and <code>--error</code>
            (<code>--danger</code> is an alias).
        </p>
        {% set code_snippet %}
        <div class="ss-f-stack ss-f-stack-xs">
            <div class="ss-c-toast">Settings saved.</div>
            <div class="ss-c-toast ss-c-toast--info">3 new comments.</div>
            <div class="ss-c-toast ss-c-toast--success">Profile updated.</div>
            <div class="ss-c-toast ss-c-toast--warning">Connection is slow.</div>
            <div class="ss-c-toast ss-c-toast--error">Upload failed.</div>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Title and close button" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        <p>
            <code>__content</code> takes the free width and holds an optional
            <code>__title</code>; <code>__close</code> on an
            <code>ss-c-close</code> button takes the toast's colour and sits at
            the end.
        </p>
        {% set code_snippet %}
        <div class="ss-f-stack ss-f-stack-xs">
            <div class="ss-c-toast">
                <div class="ss-c-toast__content">
                    <strong class="ss-c-toast__title">New message</strong>
                    You have a new message from the team.
                </div>
                <button type="button" class="ss-c-close ss-c-toast__close" aria-label="Dismiss notification"></button>
            </div>
            <div class="ss-c-toast ss-c-toast--success">
                <div class="ss-c-toast__content">
                    <strong class="ss-c-toast__title">Export ready</strong>
                    report-2026-10.csv has been generated.
                </div>
                <button type="button" class="ss-c-close ss-c-toast__close" aria-label="Dismiss notification"></button>
            </div>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Actions" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div class="ss-f-stack ss-f-stack-xs">
            <div class="ss-c-toast">
                <div class="ss-c-toast__content">
                    Item deleted.
                    <div class="ss-c-toast__actions">
                        <button type="button" class="ss-c-button ss-c-button--sm">Undo</button>
                    </div>
                </div>
                <button type="button" class="ss-c-close ss-c-toast__close" aria-label="Dismiss notification"></button>
            </div>
            <div class="ss-c-toast ss-c-toast--info">
                <div class="ss-c-toast__content">
                    <strong class="ss-c-toast__title">Update available</strong>
                    Version 2.4 is ready to install.
                    <div class="ss-c-toast__actions">
                        <button type="button" class="ss-c-button ss-c-button--sm">Update</button>
                        <button type="button" class="ss-c-button ss-c-button--sm ss-c-button--outline">Later</button>
                    </div>
                </div>
            </div>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Live region" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        <p>
            The region is a polite live region, so screen readers announce
            new toasts. Each one here dismisses itself after five seconds or
            on its close button.
        </p>
        {% set code_snippet %}
        <button type="button" class="ss-c-button" id="toast-demo-trigger">Show a toast</button>

        <div class="ss-c-toast-region" data-position="top-right" id="toast-demo-region" role="status" aria-live="polite"></div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
        {# Demo behaviour, kept out of the snippet. #}
        <script>
            (() => {
                const region = document.getElementById("toast-demo-region");
                let count = 0;
                document.getElementById("toast-demo-trigger").addEventListener("click", () => {
                    count += 1;
                    const toast = document.createElement("div");
                    toast.className = "ss-c-toast ss-c-toast--success";
                    toast.innerHTML =
                        '<div class="ss-c-toast__content">Saved (' + count + ').</div>' +
                        '<button type="button" class="ss-c-close ss-c-toast__close" aria-label="Dismiss notification"></button>';
                    const dismiss = () => toast.remove();
                    toast.querySelector("button").addEventListener("click", dismiss);
                    setTimeout(dismiss, 5000);
                    region.append(toast);
                });
            })();
        </script>
    </section>
</section>

{%- endblock content %}
