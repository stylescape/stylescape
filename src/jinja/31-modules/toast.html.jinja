{% extends "../base.html.jinja" %} {% set title = "Toasts" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            Toast notifications for displaying brief, auto-dismissing messages
            to users.
        </p>
    </header>

    {# Basic Toasts #} {% set section_title = "Basic Toasts" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-toast-container"
            style="
                position: relative;
                display: flex;
                flex-direction: column;
                gap: 12px;
            "
        >
            <div
                class="ss-c-toast show"
                style="
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 12px 16px;
                    background: var(--ss-color-text-primary);
                "
            >
                <div class="ss-c-toast-body">
                    This is a basic toast notification.
                </div>
                <button
                    type="button"
                    class="ss-c-toast-close"
                    aria-label="Dismiss notification"
                    style="
                        background: none;
                        border: none;
                        color: inherit;
                        font-size: 18px;
                        cursor: pointer;
                    "
                >
                    &times;
                </button>
            </div>

            <div
                class="ss-c-toast ss-c-toast--success show"
                style="
                    display: flex;
                    align-items: center;
                    padding: 12px 16px;
                    background: var(--ss-color-success);
                    color: var(--ss-color-on-success);
                "
            >
                <div class="ss-c-toast-body">
                    <strong>Success!</strong>
                    Your changes have been saved.
                </div>
                <button
                    type="button"
                    class="ss-c-toast-close"
                    aria-label="Dismiss notification"
                    style="
                        background: none;
                        border: none;
                        color: inherit;
                        font-size: 18px;
                        cursor: pointer;
                        margin-left: auto;
                    "
                >
                    &times;
                </button>
            </div>

            <div
                class="ss-c-toast ss-c-toast--warning show"
                style="
                    display: flex;
                    align-items: center;
                    padding: 12px 16px;
                    background: var(--ss-color-warning);
                    color: var(--ss-color-on-warning);
                "
            >
                <div class="ss-c-toast-body">
                    <strong>Warning:</strong>
                    Please review your input.
                </div>
                <button
                    type="button"
                    class="ss-c-toast-close"
                    aria-label="Dismiss notification"
                    style="
                        background: none;
                        border: none;
                        color: inherit;
                        font-size: 18px;
                        cursor: pointer;
                        margin-left: auto;
                    "
                >
                    &times;
                </button>
            </div>

            <div
                class="ss-c-toast ss-c-toast--error show"
                style="
                    display: flex;
                    align-items: center;
                    padding: 12px 16px;
                    background: var(--ss-color-error);
                    color: var(--ss-color-on-error);
                "
            >
                <div class="ss-c-toast-body">
                    <strong>Error:</strong>
                    Something went wrong.
                </div>
                <button
                    type="button"
                    class="ss-c-toast-close"
                    aria-label="Dismiss notification"
                    style="
                        background: none;
                        border: none;
                        color: inherit;
                        font-size: 18px;
                        cursor: pointer;
                        margin-left: auto;
                    "
                >
                    &times;
                </button>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Toast with Header #} {% set section_title = "Toast with Header" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-toast-container"
            style="
                position: relative;
                display: flex;
                flex-direction: column;
                gap: 12px;
            "
        >
            <div
                class="ss-c-toast show"
                style="
                    display: block;
                    background: var(--ss-color-text-primary);
                    overflow: hidden;
                "
            >
                <div
                    class="ss-c-toast-header"
                    style="
                        display: flex;
                        align-items: center;
                        padding: 8px 12px;
                        border-bottom: 1px solid var(--ss-color-border);
                    "
                >
                    <strong style="flex: 1">Notification</strong>
                    <small style="opacity: 0.8; white-space: nowrap">Just now</small>
                    <button
                        type="button"
                        class="ss-c-toast-close"
                        aria-label="Dismiss notification"
                        style="
                            background: none;
                            border: none;
                            color: inherit;
                            font-size: 16px;
                            cursor: pointer;
                            margin-left: 8px;
                        "
                    >
                        &times;
                    </button>
                </div>
                <div class="ss-c-toast-body" style="padding: 12px">
                    You have a new message from the team.
                </div>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Toast with Actions #} {% set section_title = "Toast with Actions" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-toast-container"
            style="
                position: relative;
                display: flex;
                flex-direction: column;
                gap: 12px;
            "
        >
            <div
                class="ss-c-toast show"
                style="
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 16px;
                    background: var(--ss-color-text-primary);
                "
            >
                <span>Item deleted.</span>
                <button
                    class="ss-c-button ss-c-button--small ss-c-button--primary"
                    style="margin-left: auto"
                >
                    Undo
                </button>
            </div>

            <div
                class="ss-c-toast show"
                style="
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 16px;
                    background: var(--ss-color-text-primary);
                "
            >
                <span>New update available.</span>
                <div style="display: flex; gap: 8px; margin-left: auto">
                    <button class="ss-c-button ss-c-button--small ss-c-button--primary">
                        Update
                    </button>
                    <button class="ss-c-button ss-c-button--small ss-c-button--secondary">
                        Later
                    </button>
                </div>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
