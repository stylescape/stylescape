{% extends "../base.html.jinja" %} {% set title = "Interactives" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    <section class="ss-c-demo__subsection">
        <section id="interactive">
            <details>
                <summary>Toggle</summary>
                <p>Content</p>
            </details>
            <button onclick="document.getElementById('dlg').showModal()">
                Open Dialog
            </button>
            <dialog id="dlg">
                <p>Hello from Dialog</p>
                <button onclick="this.closest('dialog').close()">Close</button>
            </dialog>
        </section>
    </section>
</section>

<script>
    // Canvas example script
    const canvas = document.getElementById("canvasExample");
    if (canvas) {
        const ctx = canvas.getContext("2d");
        ctx.fillStyle = "#f00";
        ctx.fillRect(10, 10, 80, 80);
    }
</script>
{%- endblock %}
