{% extends "../base.html.jinja" %} {% set title = "Legend" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>Examples for the <code>ss-c-legend</code> module: series keys for charts and maps. Set each swatch's colour with <code>--ss-legend-color</code>. Swatches are decorative; the label carries the meaning.</p>

    {% set section_title = "Swatch shapes" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <ul class="ss-c-legend" aria-label="Legend">
            <li class="ss-c-legend__item"><span class="ss-c-legend__swatch" style="--ss-legend-color: var(--ss-color-accent)" aria-hidden="true"></span>Bar</li>
            <li class="ss-c-legend__item"><span class="ss-c-legend__swatch ss-c-legend__swatch--line" style="--ss-legend-color: var(--ss-color-success)" aria-hidden="true"></span>Line</li>
            <li class="ss-c-legend__item"><span class="ss-c-legend__swatch ss-c-legend__swatch--dashed" style="--ss-legend-color: var(--ss-color-warning)" aria-hidden="true"></span>Forecast</li>
            <li class="ss-c-legend__item"><span class="ss-c-legend__swatch ss-c-legend__swatch--point" style="--ss-legend-color: var(--ss-color-error)" aria-hidden="true"></span>Point</li>
            <li class="ss-c-legend__item"><span class="ss-c-legend__swatch ss-c-legend__swatch--area" style="--ss-legend-color: var(--ss-color-info)" aria-hidden="true"></span>Area</li>
        </ul>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Vertical with values" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="max-width: 16rem">
            <p class="ss-c-legend__title" id="land-use">Land use</p>
            <ul class="ss-c-legend ss-c-legend--vertical" aria-labelledby="land-use">
                <li class="ss-c-legend__item"><span class="ss-c-legend__swatch ss-c-legend__swatch--area" style="--ss-legend-color: var(--ss-color-success)" aria-hidden="true"></span>Green space<span class="ss-c-legend__value">38%</span></li>
                <li class="ss-c-legend__item"><span class="ss-c-legend__swatch ss-c-legend__swatch--area" style="--ss-legend-color: var(--ss-color-warning)" aria-hidden="true"></span>Residential<span class="ss-c-legend__value">27%</span></li>
                <li class="ss-c-legend__item"><span class="ss-c-legend__swatch ss-c-legend__swatch--area" style="--ss-legend-color: var(--ss-color-info)" aria-hidden="true"></span>Water<span class="ss-c-legend__value">21%</span></li>
                <li class="ss-c-legend__item"><span class="ss-c-legend__swatch ss-c-legend__swatch--area" style="--ss-legend-color: var(--ss-color-muted)" aria-hidden="true"></span>Other<span class="ss-c-legend__value">14%</span></li>
            </ul>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Interactive toggles" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <ul class="ss-c-legend" aria-label="Series">
            <li><button type="button" class="ss-c-legend__toggle" aria-pressed="true"><span class="ss-c-legend__swatch ss-c-legend__swatch--line" style="--ss-legend-color: var(--ss-color-accent)" aria-hidden="true"></span>Temperature</button></li>
            <li><button type="button" class="ss-c-legend__toggle" aria-pressed="false"><span class="ss-c-legend__swatch ss-c-legend__swatch--line" style="--ss-legend-color: var(--ss-color-success)" aria-hidden="true"></span>Humidity</button></li>
            <li><button type="button" class="ss-c-legend__toggle" aria-pressed="true"><span class="ss-c-legend__swatch ss-c-legend__swatch--point" style="--ss-legend-color: var(--ss-color-error)" aria-hidden="true"></span>Alerts</button></li>
        </ul>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
