{% extends "../base.html.jinja" %} {% set title = "Stepper" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>
        Examples for the <code>ss-c-stepper</code> module (a number input with
        − and + buttons) and the number and date fields of
        <code>ss-c-input</code>. The input works on its own (typing, arrow
        keys); <code>NumberStepperManager</code> (<code>data-ss="stepper"</code>)
        wires the buttons, fires <code>input</code>/<code>change</code>, and
        marks a button <code>aria-disabled</code> at min or max.
    </p>

    {% set section_title = "Stepper" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <label for="stepper-guests" style="display: block; font-weight: 500; margin-bottom: 6px">Guests</label>
        <div class="ss-c-stepper" data-ss="stepper">
            <button type="button" class="ss-c-stepper__button" data-ss-stepper="down" aria-label="Fewer guests" aria-controls="stepper-guests">−</button>
            <input id="stepper-guests" type="number" class="ss-c-stepper__input" min="1" max="12" value="2">
            <button type="button" class="ss-c-stepper__button" data-ss-stepper="up" aria-label="More guests" aria-controls="stepper-guests">+</button>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Sizes and states" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center">
            <div class="ss-c-stepper ss-c-stepper--sm">
                <button type="button" class="ss-c-stepper__button" aria-label="Decrease (small)">−</button>
                <input type="number" class="ss-c-stepper__input" aria-label="Small stepper" value="4">
                <button type="button" class="ss-c-stepper__button" aria-label="Increase (small)">+</button>
            </div>
            <div class="ss-c-stepper ss-c-stepper--lg">
                <button type="button" class="ss-c-stepper__button" aria-label="Decrease (large)" aria-disabled="true">−</button>
                <input type="number" class="ss-c-stepper__input" aria-label="Large stepper at its minimum" min="0" value="0">
                <button type="button" class="ss-c-stepper__button" aria-label="Increase (large)">+</button>
            </div>
            <div class="ss-c-stepper">
                <button type="button" class="ss-c-stepper__button" aria-label="Decrease (disabled)" disabled>−</button>
                <input type="number" class="ss-c-stepper__input" aria-label="Disabled stepper" value="8" disabled>
                <button type="button" class="ss-c-stepper__button" aria-label="Increase (disabled)" disabled>+</button>
            </div>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Number and date fields" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        <p>Plain <code>ss-c-input</code>: tabular digits, native pickers that follow the light/dark theme.</p>
        {% set code_snippet %}
        <div style="display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr))">
            <label>Quantity <input type="number" class="ss-c-input" min="0" step="1" value="12"></label>
            <label>Start date <input type="date" class="ss-c-input" value="2026-10-08"></label>
            <label>Time <input type="time" class="ss-c-input" value="09:30"></label>
            <label>Appointment <input type="datetime-local" class="ss-c-input" value="2026-10-08T14:00"></label>
            <label>Month <input type="month" class="ss-c-input" value="2026-10"></label>
            <label>Small date <input type="date" class="ss-c-input ss-c-input--sm"></label>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
