{% extends "../base.html.jinja" %} {% set title = "Validation" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h2>{{ title }}</h2></header>
    <p>Examples for the <code>ss-c-validation</code> module.</p>

    {% set section_title = "Success" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <label>Email
            <input type="email" class="ss-c-input" value="hello@example.com">
            <span class="ss-c-validation__success ss-c-validation__success--visible">Looks good.</span>
        </label>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Error" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <label>Email
            <input type="email" class="ss-c-input" value="not-an-email">
            <span class="ss-c-validation__error ss-c-validation__error--visible">Please enter a valid email.</span>
        </label>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
