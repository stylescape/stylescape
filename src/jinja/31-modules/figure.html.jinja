{% extends "../base.html.jinja" %} {% set title = "Figures" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
    </header>

    {#
    ----------------------------------------------------------------------------
    Figure Default
    ----------------------------------------------------------------------------
    #}
    <section class="ss-c-demo__subsection">
        <h2>Figure Default</h2>
        {% set code_snippet %}
        <figure class="ss-c-figure">
            <img
                src="/img/placeholder/600x400.svg"
                alt="Image with title caption"
            />
            <figcaption>
                <span class="ss-c-figure__caption">Figure Title</span><br />
                Standard description below the image.
            </figcaption>
        </figure>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Figure Rounded
    ----------------------------------------------------------------------------
    #}
    <section class="ss-c-demo__subsection">
        <h2>Figure Rounded</h2>
        {% set code_snippet %}
        <figure class="ss-c-figure ss-c-figure--rounded">
            <img
                src="/img/placeholder/600x400.svg"
                alt="Image with title caption"
            />
            <figcaption>
                <span class="ss-c-figure__caption">Figure Title</span><br />
                Standard description below the image.
            </figcaption>
        </figure>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Figure Aspect Ratios
    ----------------------------------------------------------------------------
    #} {% set aspect_ratios = [ "16x9", "2x3", "3x4", "4x3", "3x2", "1x1" ] %}
    {% for ratio in aspect_ratios %}
    <section class="ss-c-demo__subsection">
        <h2>Figure Aspect Ratio {{ ratio }}</h2>
        {% set code_snippet %}
        <figure
            class="ss-c-figure ss-c-figure--rounded ss-c-figure--{{ ratio }}"
            style="width: 20rem"
        >
            <img
                src="/img/placeholder/1280x720.svg"
                alt="{{ ratio }} aspect ratio"
            />
        </figure>
        <p>
            <code>ss-c-figure--{{ ratio }}</code> crops the image to a
            {{ ratio | replace('x', ':') }} box.
        </p>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
    {% endfor %}
</section>
{%- endblock content %}
