{% extends "../base.html.jinja" %} {% set title = "Stack" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>Examples for the <code>ss-c-stack</code> module.</p>

    {% set section_title = "Default" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div class="ss-c-stack">
            <div style="background:var(--ss-color-surface-1, #eee); padding:1em; width:10em; min-height:6em; border:1px solid var(--ss-color-border-strong); text-align:center">Top</div>
            <div style="background:var(--ss-color-surface-2, #ddd); padding:1em; width:10em; min-height:6em; border:1px solid var(--ss-color-border-strong); text-align:center">Middle</div>
            <div style="background:var(--ss-color-surface-3, #ccc); padding:1em; width:10em; min-height:6em; border:1px solid var(--ss-color-border-strong); text-align:center">Bottom</div>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
