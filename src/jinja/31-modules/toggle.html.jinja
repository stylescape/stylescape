{% extends "../base.html.jinja" %} {%- block title %}Toggle & Switch{%- endblock
%} {%- block content %}
<header class="ss-c-demo__section__header">
    <h1>Toggle &amp; Switch</h1>
    <p>Switches, collapsible panels and toggle buttons.</p>
</header>
 {#
============================================================================
Toggle Switch
============================================================================ #}
<section class="ss-c-demo__section" data-label="Toggle Switch" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Toggle Switch</h2>
        <p>Binary on/off switches for boolean settings.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Basic Toggle</h3>
        {% set code_snippet %}
        <label class="ss-c-toggle_switch">
            <input type="checkbox" role="switch" aria-label="Basic toggle (off)" />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>

        <label class="ss-c-toggle_switch">
            <input type="checkbox" role="switch" aria-label="Basic toggle (on)" checked />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Toggle with Label</h3>
        {% set code_snippet %}
        <label class="ss-c-toggle_switch__label">
            <span class="ss-c-toggle_switch__text">Enable notifications</span>
            <span class="ss-c-toggle_switch">
                <input type="checkbox" role="switch" />
                <span class="ss-c-toggle_switch__slider"></span>
            </span>
        </label>

        <label class="ss-c-toggle_switch__label">
            <span class="ss-c-toggle_switch">
                <input type="checkbox" role="switch" checked />
                <span class="ss-c-toggle_switch__slider"></span>
            </span>
            <span class="ss-c-toggle_switch__text">Dark mode enabled</span>
        </label>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Toggle Sizes</h3>
        {% set code_snippet %}
        <label class="ss-c-toggle_switch ss-c-toggle_switch--sm">
            <input type="checkbox" role="switch" aria-label="Small toggle" checked />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        <span class="ss-c-ml--02 ss-c-mr--04">Small</span>

        <label class="ss-c-toggle_switch">
            <input type="checkbox" role="switch" aria-label="Default toggle" checked />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        <span class="ss-c-ml--02 ss-c-mr--04">Default</span>

        <label class="ss-c-toggle_switch ss-c-toggle_switch--lg">
            <input type="checkbox" role="switch" aria-label="Large toggle" checked />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        <span class="ss-c-ml--02">Large</span>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Disabled Toggle</h3>
        {% set code_snippet %}
        <label class="ss-c-toggle_switch">
            <input type="checkbox" role="switch" aria-label="Disabled off" disabled />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        <span class="ss-c-ml--02 ss-c-mr--04">Disabled off</span>

        <label class="ss-c-toggle_switch">
            <input type="checkbox" role="switch" aria-label="Disabled on" checked disabled />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        <span class="ss-c-ml--02">Disabled on</span>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Toggle Panel
============================================================================ #}
<section class="ss-c-demo__section" data-label="Toggle Panel" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Toggle Panel</h2>
        <p>Expandable/collapsible content panels.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Basic Toggle Panel</h3>
        {% set code_snippet %}
        <details class="ss-c-toggle_panel">
            <summary class="ss-c-toggle_panel__header">Click to expand</summary>
            <div class="ss-c-toggle_panel__content">
                <p>
                    This content is hidden until the panel is expanded. Click
                    the header again to collapse.
                </p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Initially Open Panel</h3>
        {% set code_snippet %}
        <details class="ss-c-toggle_panel" open>
            <summary class="ss-c-toggle_panel__header">
                This panel starts open
            </summary>
            <div class="ss-c-toggle_panel__content">
                <p>
                    Use the "open" attribute to have the panel expanded by
                    default.
                </p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Multiple Panels</h3>
        {% set code_snippet %}
        <details class="ss-c-toggle_panel ss-c-mb--02">
            <summary class="ss-c-toggle_panel__header">Section One</summary>
            <div class="ss-c-toggle_panel__content">
                <p>Content for section one.</p>
            </div>
        </details>

        <details class="ss-c-toggle_panel ss-c-mb--02">
            <summary class="ss-c-toggle_panel__header">Section Two</summary>
            <div class="ss-c-toggle_panel__content">
                <p>Content for section two.</p>
            </div>
        </details>

        <details class="ss-c-toggle_panel">
            <summary class="ss-c-toggle_panel__header">Section Three</summary>
            <div class="ss-c-toggle_panel__content">
                <p>Content for section three.</p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Toggle Button
============================================================================ #}
<section class="ss-c-demo__section" data-label="Toggle Button" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Toggle Button</h2>
        <p>Buttons that toggle between active and inactive states.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Basic Toggle Button</h3>
        {% set code_snippet %}
        <button class="ss-c-button ss-c-toggle__button" aria-pressed="false">
            Toggle Off
        </button>

        <button
            class="ss-c-button ss-c-toggle__button ss-c-toggle__button--active"
            aria-pressed="true"
        >
            Toggle On
        </button>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Toggle Button Group</h3>
        {% set code_snippet %}
        <div
            class="ss-c-toggle__button-group"
            role="group"
            aria-label="Text alignment"
        >
            <button
                class="ss-c-button ss-c-toggle__button ss-c-toggle__button--active"
                aria-pressed="true"
            >
                Left
            </button>
            <button class="ss-c-button ss-c-toggle__button" aria-pressed="false">
                Center
            </button>
            <button class="ss-c-button ss-c-toggle__button" aria-pressed="false">
                Right
            </button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Toggle States
============================================================================ #}
<section class="ss-c-demo__section" data-label="Toggle Colors" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Toggle Colors</h2>
        <p>Toggle switches with semantic colors.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Colored Toggles</h3>
        {% set code_snippet %}
        <label class="ss-c-toggle_switch ss-c-toggle_switch--primary">
            <input type="checkbox" role="switch" aria-label="Primary toggle" checked />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        <span class="ss-c-ml--02 ss-c-mr--04">Primary</span>

        <label class="ss-c-toggle_switch ss-c-toggle_switch--success">
            <input type="checkbox" role="switch" aria-label="Success toggle" checked />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        <span class="ss-c-ml--02 ss-c-mr--04">Success</span>

        <label class="ss-c-toggle_switch ss-c-toggle_switch--warning">
            <input type="checkbox" role="switch" aria-label="Warning toggle" checked />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        <span class="ss-c-ml--02 ss-c-mr--04">Warning</span>

        <label class="ss-c-toggle_switch ss-c-toggle_switch--danger">
            <input type="checkbox" role="switch" aria-label="Danger toggle" checked />
            <span class="ss-c-toggle_switch__slider"></span>
        </label>
        <span class="ss-c-ml--02">Danger</span>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
