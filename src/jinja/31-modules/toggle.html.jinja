{% extends "../base.html.jinja" %} {%- block title %}Toggle & Switch{%- endblock
%} {%- block content %} {#
============================================================================
Toggle Switch
============================================================================ #}
<section class="demo__section" data-label="Toggle Switch" data-level="1">
    <header class="demo__section__header">
        <h3>Toggle Switch</h3>
        <p>Binary on/off switches for boolean settings.</p>
    </header>

    <section class="demo__subsection">
        <h4>Basic Toggle</h4>
        {% set code_snippet %}
        <label class="toggle_switch">
            <input type="checkbox" />
            <span class="toggle_switch__slider"></span>
        </label>

        <label class="toggle_switch">
            <input type="checkbox" checked />
            <span class="toggle_switch__slider"></span>
        </label>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Toggle with Label</h4>
        {% set code_snippet %}
        <label class="toggle_switch__label">
            <span class="toggle_switch__text">Enable notifications</span>
            <span class="toggle_switch">
                <input type="checkbox" />
                <span class="toggle_switch__slider"></span>
            </span>
        </label>

        <label class="toggle_switch__label">
            <span class="toggle_switch">
                <input type="checkbox" checked />
                <span class="toggle_switch__slider"></span>
            </span>
            <span class="toggle_switch__text">Dark mode enabled</span>
        </label>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Toggle Sizes</h4>
        {% set code_snippet %}
        <label class="toggle_switch toggle_switch--sm">
            <input type="checkbox" checked />
            <span class="toggle_switch__slider"></span>
        </label>
        <span class="ml--02 mr--04">Small</span>

        <label class="toggle_switch">
            <input type="checkbox" checked />
            <span class="toggle_switch__slider"></span>
        </label>
        <span class="ml--02 mr--04">Default</span>

        <label class="toggle_switch toggle_switch--lg">
            <input type="checkbox" checked />
            <span class="toggle_switch__slider"></span>
        </label>
        <span class="ml--02">Large</span>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Disabled Toggle</h4>
        {% set code_snippet %}
        <label class="toggle_switch">
            <input type="checkbox" disabled />
            <span class="toggle_switch__slider"></span>
        </label>
        <span class="ml--02 mr--04">Disabled off</span>

        <label class="toggle_switch">
            <input type="checkbox" checked disabled />
            <span class="toggle_switch__slider"></span>
        </label>
        <span class="ml--02">Disabled on</span>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Toggle Panel
============================================================================ #}
<section class="demo__section" data-label="Toggle Panel" data-level="1">
    <header class="demo__section__header">
        <h3>Toggle Panel</h3>
        <p>Expandable/collapsible content panels.</p>
    </header>

    <section class="demo__subsection">
        <h4>Basic Toggle Panel</h4>
        {% set code_snippet %}
        <details class="toggle_panel">
            <summary class="toggle_panel__header">Click to expand</summary>
            <div class="toggle_panel__content">
                <p>
                    This content is hidden until the panel is expanded. Click
                    the header again to collapse.
                </p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Initially Open Panel</h4>
        {% set code_snippet %}
        <details class="toggle_panel" open>
            <summary class="toggle_panel__header">
                This panel starts open
            </summary>
            <div class="toggle_panel__content">
                <p>
                    Use the "open" attribute to have the panel expanded by
                    default.
                </p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Multiple Panels</h4>
        {% set code_snippet %}
        <details class="toggle_panel mb--02">
            <summary class="toggle_panel__header">Section One</summary>
            <div class="toggle_panel__content">
                <p>Content for section one.</p>
            </div>
        </details>

        <details class="toggle_panel mb--02">
            <summary class="toggle_panel__header">Section Two</summary>
            <div class="toggle_panel__content">
                <p>Content for section two.</p>
            </div>
        </details>

        <details class="toggle_panel">
            <summary class="toggle_panel__header">Section Three</summary>
            <div class="toggle_panel__content">
                <p>Content for section three.</p>
            </div>
        </details>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Toggle Button
============================================================================ #}
<section class="demo__section" data-label="Toggle Button" data-level="1">
    <header class="demo__section__header">
        <h3>Toggle Button</h3>
        <p>Buttons that toggle between active and inactive states.</p>
    </header>

    <section class="demo__subsection">
        <h4>Basic Toggle Button</h4>
        {% set code_snippet %}
        <button class="ss-c-button toggle_button" aria-pressed="false">
            Toggle Off
        </button>

        <button
            class="ss-c-button toggle_button toggle_button--active"
            aria-pressed="true"
        >
            Toggle On
        </button>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Toggle Button Group</h4>
        {% set code_snippet %}
        <div
            class="toggle_button_group"
            role="group"
            aria-label="Text alignment"
        >
            <button
                class="ss-c-button toggle_button toggle_button--active"
                aria-pressed="true"
            >
                Left
            </button>
            <button class="ss-c-button toggle_button" aria-pressed="false">
                Center
            </button>
            <button class="ss-c-button toggle_button" aria-pressed="false">
                Right
            </button>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Toggle States
============================================================================ #}
<section class="demo__section" data-label="Toggle Colors" data-level="1">
    <header class="demo__section__header">
        <h3>Toggle Colors</h3>
        <p>Toggle switches with semantic colors.</p>
    </header>

    <section class="demo__subsection">
        <h4>Colored Toggles</h4>
        {% set code_snippet %}
        <label class="toggle_switch toggle_switch--primary">
            <input type="checkbox" checked />
            <span class="toggle_switch__slider"></span>
        </label>
        <span class="ml--02 mr--04">Primary</span>

        <label class="toggle_switch toggle_switch--success">
            <input type="checkbox" checked />
            <span class="toggle_switch__slider"></span>
        </label>
        <span class="ml--02 mr--04">Success</span>

        <label class="toggle_switch toggle_switch--warning">
            <input type="checkbox" checked />
            <span class="toggle_switch__slider"></span>
        </label>
        <span class="ml--02 mr--04">Warning</span>

        <label class="toggle_switch toggle_switch--danger">
            <input type="checkbox" checked />
            <span class="toggle_switch__slider"></span>
        </label>
        <span class="ml--02">Danger</span>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
