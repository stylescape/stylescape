{% extends "../base.html.jinja" %} {% set title = "Chips" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>Compact elements for tags, categories, filters, and selections.</p>
    </header>

    {# Basic Chips #} {% set section_title = "Basic Chips" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span class="ss-c-chip">Basic Chip</span>
            <span class="ss-c-chip">Design</span>
            <span class="ss-c-chip">Development</span>
            <span class="ss-c-chip">Marketing</span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Chips with Avatar #} {% set section_title = "Chips with Avatar" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span
                class="ss-c-chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                <img
                    src="/img/placeholder/24x24.svg"
                    alt="User"
                    style="width: 24px; height: 24px; border-radius: 50%"
                />
                John Doe
            </span>
            <span
                class="ss-c-chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                <img
                    src="/img/placeholder/24x24.svg"
                    alt="User"
                    style="width: 24px; height: 24px; border-radius: 50%"
                />
                Jane Smith
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Dismissible Chips #} {% set section_title = "Dismissible Chips" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span
                class="ss-c-chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                JavaScript
                <button
                    class="ss-c-chip__close"
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 14px;
                        color: var(--ss-color-text-muted);
                    "
                >
                    &times;
                </button>
            </span>
            <span
                class="ss-c-chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                TypeScript
                <button
                    class="ss-c-chip__close"
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 14px;
                        color: var(--ss-color-text-muted);
                    "
                >
                    &times;
                </button>
            </span>
            <span
                class="ss-c-chip"
                style="display: inline-flex; align-items: center; gap: 8px"
            >
                Python
                <button
                    class="ss-c-chip__close"
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 14px;
                        color: var(--ss-color-text-muted);
                    "
                >
                    &times;
                </button>
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Colored Chips #} {% set section_title = "Colored Chips" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span class="ss-c-chip ss-c-chip--info">
                Info
            </span>
            <span class="ss-c-chip ss-c-chip--success">
                Success
            </span>
            <span class="ss-c-chip ss-c-chip--warning">
                Warning
            </span>
            <span class="ss-c-chip ss-c-chip--error">
                Error
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Outlined Chips #} {% set section_title = "Outlined Chips" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <span class="ss-c-chip ss-c-chip--outline">
                Outlined
            </span>
            <span class="ss-c-chip ss-c-chip--outline ss-c-chip--info">
                Info
            </span>
            <span class="ss-c-chip ss-c-chip--outline ss-c-chip--success">
                Success
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Chips Input #} {% set section_title = "Chips Input Field" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-chips-input"
            style="
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                padding: 8px 12px;
                border: 1px solid var(--ss-color-border);
                border-radius: var(--ss-radius-lg);
                min-height: 48px;
                align-items: center;
            "
        >
            <span
                class="ss-c-chip"
                style="
                    display: inline-flex;
                    align-items: center;
                    gap: 4px;
                    font-size: 13px;
                "
            >
                Tag 1
                <button
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 12px;
                    "
                >
                    &times;
                </button>
            </span>
            <span
                class="ss-c-chip"
                style="
                    display: inline-flex;
                    align-items: center;
                    gap: 4px;
                    font-size: 13px;
                "
            >
                Tag 2
                <button
                    style="
                        background: none;
                        border: none;
                        cursor: pointer;
                        font-size: 12px;
                    "
                >
                    &times;
                </button>
            </span>
            <input
                type="text"
                placeholder="Add tag..."
                style="
                    border: none;
                    outline: none;
                    flex: 1;
                    min-width: 100px;
                    background: transparent;
                "
            />
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
