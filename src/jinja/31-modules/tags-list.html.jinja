{% extends "../base.html.jinja" %} {% set title = "Tags List" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            Examples for the <code>ss-c-tags-list</code> module: a wrapping
            list of tag links, each styled with
            <code>ss-c-tags-list__item</code>.
        </p>
    </header>

    {% set section_title = "Basic Tags List" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <ul class="ss-c-tags-list" aria-label="Tags">
            <li><a href="#" class="ss-c-tags-list__item">Design</a></li>
            <li><a href="#" class="ss-c-tags-list__item">Development</a></li>
            <li><a href="#" class="ss-c-tags-list__item">CSS</a></li>
        </ul>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Labelled Tags" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <p id="tags-categories"><strong>Categories</strong></p>
        <ul class="ss-c-tags-list" aria-labelledby="tags-categories">
            <li><a href="#" class="ss-c-tags-list__item">JavaScript</a></li>
            <li><a href="#" class="ss-c-tags-list__item">TypeScript</a></li>
            <li><a href="#" class="ss-c-tags-list__item">React</a></li>
        </ul>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Static Tags" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Tags that are not links use a <code>span</code>.</p>
        {% set code_snippet %}
        <p>Filed under:</p>
        <ul class="ss-c-tags-list">
            <li><span class="ss-c-tags-list__item">News</span></li>
            <li><span class="ss-c-tags-list__item">Technology</span></li>
            <li><span class="ss-c-tags-list__item">Updates</span></li>
        </ul>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock %}
