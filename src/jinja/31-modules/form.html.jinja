{% extends "../base.html.jinja" %} {% set title = "Forms" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
    </header>

    {% set section_title = "Login Form" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}

        <form class="ss-c-form--col" method="post" action="/authentication/login/">
            <div class="ss-c-form__field">
                <input
                    type="text"
                    name="username"
                    id="id_username"
                    class="ss-c-form__field__input"
                    minlength="3"
                    maxlength="30"
                    placeholder="Username"
                    required
                    aria-labelledby="id_username_label"
                    aria-describedby="id_username_help id_username_error"
                />
                <label
                    for="id_username"
                    title="Please provide a username."
                    id="id_username_label"
                    class="ss-c-form__field__label"
                >
                    Username
                </label>
                <span id="id_username_help" class="ss-c-form__field__help">
                    Please provide a username.
                </span>
                <span
                    id="id_username_error"
                    class="ss-c-form__field__error"
                    aria-live="polite"
                >
                    Required. 30 characters or fewer. Letters and digits.
                </span>
            </div>

            <div class="ss-c-form__field">
                <div style="position: relative">
                    <input
                        type="password"
                        name="password"
                        id="id_password"
                        class="ss-c-form__field__input"
                        minlength="3"
                        maxlength="30"
                        placeholder="Password"
                        required
                        aria-labelledby="id_password_label"
                        aria-describedby="id_password_help id_password_error"
                    />
                    <button
                        type="button"
                        class="ss-c-toggle-password"
                        data-password-toggle="id_password"
                        aria-pressed="false"
                        aria-label="Show password"
                        style="min-block-size: 1.5rem"
                    >
                        ◉ Show
                    </button>
                </div>
                <label for="id_password" id="id_password_label" class="ss-c-form__field__label">
                    Password
                </label>
                <span id="id_password_help" class="ss-c-form__field__help">
                    Required. 8 characters or more.
                </span>
                <span
                    id="id_password_error"
                    class="ss-c-form__field__error"
                    aria-live="polite"
                >
                    Required. 8 characters or more.
                </span>
            </div>

            <div class="ss-c-form__field">
                <label for="id_remember_me" class="ss-c-form__field__label">Remember Me</label>
                <input
                    type="checkbox"
                    name="remember_me"
                    id="id_remember_me"
                    class=""
                />
                <span id="id_remember_me_help" class="ss-c-form__field__help">
                    Keep me logged in for 30 days.
                </span>
                <span
                    id="id_remember_me_error"
                    class="ss-c-form__field__error"
                    aria-live="polite"
                >
                    Keep me logged in for 30 days.
                </span>
            </div>

            <button type="submit" class="ss-c-button ss-c-button--solid">Login</button>

            <p>
                <span class="ss-c-req">*</span>
                - Required field
            </p>
        </form>

        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section id="forms" class="ss-c-demo__subsection" aria-labelledby="forms_survey">
        <h2 id="forms_survey">Survey Form</h2>
        <form method="post">
            <fieldset>
                <legend>Survey</legend>
                <fieldset>
                    <legend>Radio:</legend>
                    <label>
                        <input type="radio" name="opt" value="yes" />
                        Yes
                    </label>
                    <label>
                        <input type="radio" name="opt" value="no" />
                        No
                    </label>
                </fieldset>
                <p>
                    <label class="ss-c-label" for="survey_name">Name:</label>
                    <input type="text" name="name" id="survey_name" class="ss-c-input" />
                </p>
                <p>
                    Deprecated:
                    <label>
                        <input type="checkbox" name="dep" value="marquee" />
                        Marquee
                    </label>
                    <label>
                        <input
                            type="checkbox"
                            name="test"
                            value="disabled"
                            disabled
                        />
                        Disabled
                    </label>
                </p>
                <p>
                    <label class="ss-c-label" for="survey_fav">Favorite:</label>
                    <select name="fav" id="survey_fav" class="ss-c-select">
                        <optgroup label="Group">
                            <option value="div">div</option>
                            <option value="p">p</option>
                            <option value="article">article</option>
                        </optgroup>
                    </select>
                </p>
                <p>
                    <label>
                        Comments:
                        <textarea
                            name="comments"
                            rows="3"
                            class="ss-c-input"
                        ></textarea>
                    </label>
                </p>
                <p>
                    <label for="survey_progress">Progress:</label>
                    <progress id="survey_progress" value="50" max="100">50%</progress>
                </p>
                <p>
                    <label for="survey_meter">Meter:</label>
                    <meter id="survey_meter" value="0.7">70%</meter>
                </p>
                <p>
                    <label for="survey_range">Range Slider:</label>
                    <input type="range" id="survey_range" />
                </p>
                <p>
                    <button type="submit" class="ss-c-button ss-c-button--solid">Submit</button>
                    <button type="reset" class="ss-c-button">Reset</button>
                </p>
            </fieldset>
        </form>
    </section>

    <section id="form_elements_section" class="ss-c-demo__subsection" aria-labelledby="form_elements">
        <h2 id="form_elements">Fieldsets, Legends, and Form Elements</h2>

        <fieldset>
            <legend>Legend</legend>

            <p>
                Lorem ipsum dolor sit amet, consectetuer adipiscing elit.
                Nullam dignissim convallis est. Quisque aliquam. Donec
                faucibus. Nunc iaculis suscipit dui. Nam sit amet sem. Aliquam
                libero nisi, imperdiet at, tincidunt nec, gravida vehicula,
                nisl. Praesent mattis, massa quis luctus fermentum, turpis mi
                volutpat justo, eu volutpat enim diam eget metus.
            </p>

            <form>
                <h3>Form Element</h3>

                <p>
                    Lorem ipsum dolor sit amet, consectetuer adipiscing elit.
                    Nullam dignissim convallis est. Quisque aliquam. Donec
                    faucibus. Nunc iaculis suscipit dui.
                </p>

                <p>
                    <label for="text_field">Text Field:</label>
                    <br />
                    <input type="text" id="text_field" class="ss-c-input" />
                </p>

                <p>
                    <label for="text_area">Text Area:</label>
                    <br />
                    <textarea id="text_area" class="ss-c-input"></textarea>
                </p>

                <p>
                    <label for="select_element">Select Element:</label>
                    <br />
                    <select name="select_element" id="select_element" class="ss-c-select">
                        <optgroup label="Option Group 1">
                            <option value="1">Option 1</option>
                            <option value="2">Option 2</option>
                            <option value="3">Option 3</option>
                        </optgroup>
                        <optgroup label="Option Group 2">
                            <option value="1">Option 1</option>
                            <option value="2">Option 2</option>
                            <option value="3">Option 3</option>
                        </optgroup>
                    </select>
                </p>

                <fieldset>
                    <legend>Radio Buttons:</legend>
                    <label>
                        <input
                            type="radio"
                            class="ss-c-radio"
                            name="radio_button"
                            value="radio_1"
                        />
                        Radio 1
                    </label>
                    <br />
                    <label>
                        <input
                            type="radio"
                            class="ss-c-radio"
                            name="radio_button"
                            value="radio_2"
                        />
                        Radio 2
                    </label>
                    <br />
                    <label>
                        <input
                            type="radio"
                            class="ss-c-radio"
                            name="radio_button"
                            value="radio_3"
                        />
                        Radio 3
                    </label>
                    <br />
                </fieldset>

                <fieldset>
                    <legend>Checkboxes:</legend>
                    <label>
                        <input
                            type="checkbox"
                            class="ss-c-checkbox"
                            name="checkboxes"
                            value="check_1"
                        />
                        Checkbox 1
                    </label>
                    <br />
                    <label>
                        <input
                            type="checkbox"
                            class="ss-c-checkbox"
                            name="checkboxes"
                            value="check_2"
                        />
                        Checkbox 2
                    </label>
                    <br />
                    <label>
                        <input
                            type="checkbox"
                            class="ss-c-checkbox"
                            name="checkboxes"
                            value="check_3"
                        />
                        Checkbox 3
                    </label>
                    <br />
                </fieldset>

                <p>
                    <label for="password">Password:</label>
                    <br />
                    <input type="password" class="ss-c-input ss-c-password" name="password" id="password" />
                </p>

                <p>
                    <label for="file">File Input:</label>
                    <br />
                    <input type="file" class="ss-c-file" name="file" id="file" />
                </p>

                <p>
                    <input class="ss-c-button" type="reset" value="Clear" />
                    <input class="ss-c-button" type="submit" value="Submit" />
                </p>
            </form>
        </fieldset>
    </section>

</section>
{%- endblock content %}
