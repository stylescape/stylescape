{% extends "../base.html.jinja" %} {% set title = "Icon Font" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }}</h2>
        <p>
            Font-based icons for scalable and customizable interface elements.
        </p>
    </header>

    {# Basic Icon Font #} {% set section_title = "Basic Icon Font" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div
            style="
                display: flex;
                gap: 24px;
                flex-wrap: wrap;
                align-items: center;
            "
        >
            <span
                class="ss-c-icon-font"
                style="
                    font-family: &quot;Material Icons&quot;, sans-serif;
                    font-size: 24px;
                "
            >
                home
            </span>
            <span
                class="ss-c-icon-font"
                style="
                    font-family: &quot;Material Icons&quot;, sans-serif;
                    font-size: 24px;
                "
            >
                search
            </span>
            <span
                class="ss-c-icon-font"
                style="
                    font-family: &quot;Material Icons&quot;, sans-serif;
                    font-size: 24px;
                "
            >
                settings
            </span>
            <span
                class="ss-c-icon-font"
                style="
                    font-family: &quot;Material Icons&quot;, sans-serif;
                    font-size: 24px;
                "
            >
                favorite
            </span>
            <span
                class="ss-c-icon-font"
                style="
                    font-family: &quot;Material Icons&quot;, sans-serif;
                    font-size: 24px;
                "
            >
                mail
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Icon Font Sizes #} {% set section_title = "Icon Font Sizes" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div
            style="display: flex; gap: 32px; flex-wrap: wrap; align-items: end"
        >
            <div style="text-align: center">
                <span style="font-size: 16px; display: block">★</span>
                <span
                    style="
                        font-size: 11px;
                        opacity: 0.6;
                        margin-top: 4px;
                        display: block;
                    "
                >
                    16px
                </span>
            </div>
            <div style="text-align: center">
                <span style="font-size: 24px; display: block">★</span>
                <span
                    style="
                        font-size: 11px;
                        opacity: 0.6;
                        margin-top: 4px;
                        display: block;
                    "
                >
                    24px
                </span>
            </div>
            <div style="text-align: center">
                <span style="font-size: 32px; display: block">★</span>
                <span
                    style="
                        font-size: 11px;
                        opacity: 0.6;
                        margin-top: 4px;
                        display: block;
                    "
                >
                    32px
                </span>
            </div>
            <div style="text-align: center">
                <span style="font-size: 48px; display: block">★</span>
                <span
                    style="
                        font-size: 11px;
                        opacity: 0.6;
                        margin-top: 4px;
                        display: block;
                    "
                >
                    48px
                </span>
            </div>
            <div style="text-align: center">
                <span style="font-size: 64px; display: block">★</span>
                <span
                    style="
                        font-size: 11px;
                        opacity: 0.6;
                        margin-top: 4px;
                        display: block;
                    "
                >
                    64px
                </span>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Colored Icons #} {% set section_title = "Colored Icons" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div
            style="display: flex; gap: 24px; flex-wrap: wrap; font-size: 32px"
        >
            <span style="color: var(--color_fill_primary)">♦</span>
            <span style="color: var(--color_state_success)">✔</span>
            <span style="color: var(--color_state_warning)">⚠</span>
            <span style="color: var(--color_state_error)">✖</span>
            <span style="color: var(--color_state_info)">ℹ</span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Icon with Background #} {% set section_title = "Icon with Background" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div style="display: flex; gap: 16px; flex-wrap: wrap">
            <span
                style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 48px;
                    height: 48px;
                    background: var(--color_fill_primary);
                    color: white;
                    border-radius: 8px;
                    font-size: 24px;
                "
            >
                ⚙
            </span>
            <span
                style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 48px;
                    height: 48px;
                    background: var(--color_state_success);
                    color: white;
                    border-radius: 50%;
                    font-size: 24px;
                "
            >
                ✓
            </span>
            <span
                style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 48px;
                    height: 48px;
                    background: var(--color_fill_secondary);
                    border-radius: 8px;
                    font-size: 24px;
                "
            >
                ♪
            </span>
            <span
                style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 48px;
                    height: 48px;
                    border: 2px solid var(--color_line_secondary);
                    border-radius: 8px;
                    font-size: 24px;
                "
            >
                ⭐
            </span>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Icon in Button #} {% set section_title = "Icon in Button" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div style="display: flex; gap: 12px; flex-wrap: wrap">
            <button
                style="
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 12px 20px;
                    border: none;
                    background: var(--color_fill_primary);
                    color: white;
                    border-radius: 8px;
                    cursor: pointer;
                    font-size: 14px;
                "
            >
                <span>+</span>
                Add Item
            </button>
            <button
                style="
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 12px 20px;
                    border: none;
                    background: var(--color_state_error);
                    color: white;
                    border-radius: 8px;
                    cursor: pointer;
                    font-size: 14px;
                "
            >
                <span>␡</span>
                Delete
            </button>
            <button
                style="
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 12px 20px;
                    border: 1px solid var(--color_line_secondary);
                    background: transparent;
                    border-radius: 8px;
                    cursor: pointer;
                    font-size: 14px;
                "
            >
                <span>⇧</span>
                Export
            </button>
            <button
                style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: 44px;
                    height: 44px;
                    border: none;
                    background: var(--color_fill_secondary);
                    border-radius: 50%;
                    cursor: pointer;
                    font-size: 18px;
                "
            >
                ⚙
            </button>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Icon List #} {% set section_title = "Icon List" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <ul style="list-style: none; padding: 0; margin: 0; max-width: 300px">
            <li
                style="
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 0;
                    border-bottom: 1px solid var(--color_line_secondary);
                "
            >
                <span style="font-size: 20px">▤</span>
                <span>Documents</span>
            </li>
            <li
                style="
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 0;
                    border-bottom: 1px solid var(--color_line_secondary);
                "
            >
                <span style="font-size: 20px">▭</span>
                <span>Images</span>
            </li>
            <li
                style="
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 0;
                    border-bottom: 1px solid var(--color_line_secondary);
                "
            >
                <span style="font-size: 20px">♪</span>
                <span>Music</span>
            </li>
            <li
                style="
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 0;
                "
            >
                <span style="font-size: 20px">▷</span>
                <span>Videos</span>
            </li>
        </ul>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
