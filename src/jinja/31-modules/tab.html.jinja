{% extends "../base.html.jinja" %} {% set title = "Tab" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
    </header>
    <p>
        Examples for the <code>ss-c-tab</code> module. With
        <code>data-ss="tabs"</code>, <code>TabManager</code> shows one panel at a
        time (<code>hidden</code> on the others), keeps
        <code>aria-selected</code>, roving <code>tabindex</code> and
        <code>ss-c-tab__item--active</code> in sync, and moves with the arrow
        keys, Home and End. Pair tabs and panels with
        <code>aria-controls</code>, or with <code>data-ss-tab</code> /
        <code>data-ss-tab-panel</code>; missing roles and ids are filled in.
        Without the script, mark the first tab active and add
        <code>hidden</code> to the other panels yourself.
    </p>

    {% set section_title = "Tabs" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div class="ss-c-tab" data-ss="tabs">
            <div class="ss-c-tab__list" role="tablist" aria-label="Cities">
                <button type="button" class="ss-c-tab__item ss-c-tab__item--active" role="tab" aria-selected="true" aria-controls="city-london" id="tab-london">London</button>
                <button type="button" class="ss-c-tab__item" role="tab" aria-selected="false" aria-controls="city-paris" id="tab-paris" tabindex="-1">Paris</button>
                <button type="button" class="ss-c-tab__item" role="tab" aria-selected="false" aria-controls="city-tokyo" id="tab-tokyo" tabindex="-1">Tokyo</button>
            </div>
            <div class="ss-c-tab__panel" id="city-london" role="tabpanel" aria-labelledby="tab-london" tabindex="0">
                <p>London is the capital city of England.</p>
            </div>
            <div class="ss-c-tab__panel" id="city-paris" role="tabpanel" aria-labelledby="tab-paris" tabindex="0" hidden>
                <p>Paris is the capital of France.</p>
            </div>
            <div class="ss-c-tab__panel" id="city-tokyo" role="tabpanel" aria-labelledby="tab-tokyo" tabindex="0" hidden>
                <p>Tokyo is the capital of Japan.</p>
            </div>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Short form" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div class="ss-c-tab" data-ss="tabs">
            <div class="ss-c-tab__list" aria-label="Settings">
                <button type="button" class="ss-c-tab__item ss-c-tab__item--active" data-ss-tab="general">General</button>
                <button type="button" class="ss-c-tab__item" data-ss-tab="privacy">Privacy</button>
            </div>
            <div class="ss-c-tab__panel" data-ss-tab-panel="general"><p>General settings.</p></div>
            <div class="ss-c-tab__panel" data-ss-tab-panel="privacy" hidden><p>Privacy settings.</p></div>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
