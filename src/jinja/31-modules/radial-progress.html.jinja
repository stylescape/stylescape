{% extends "../base.html.jinja" %} {% set title = "Radial Progress" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h2>{{ title }}</h2></header>
    <p>Examples for the <code>ss-c-radial-progress</code> module.</p>

    {% set section_title = "Values" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="ss-c-radial-progress" style="--ss-radial-value: 10; --ss-radial-size: 5em">10%</div>
        <div class="ss-c-radial-progress" style="--ss-radial-value: 33; --ss-radial-size: 5em">33%</div>
        <div class="ss-c-radial-progress" style="--ss-radial-value: 66; --ss-radial-size: 5em">66%</div>
        <div class="ss-c-radial-progress" style="--ss-radial-value: 90; --ss-radial-size: 5em">90%</div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
