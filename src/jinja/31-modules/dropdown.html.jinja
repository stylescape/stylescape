{% extends "../base.html.jinja" %} {% set title = "Input Dropdown" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
    </header>

    {% set section_title = "Dropdown menu" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>
            The <code>ss-c-dropdown</code> module: a trigger plus a
            <code>__menu</code> of <code>__item</code>s. Add
            <code>is-open</code> to the wrapper to show the menu (shown open
            here).
        </p>
        {% set code_snippet %}
        <div class="ss-c-dropdown is-open" style="margin-block-end: 10rem">
            <button type="button" class="ss-c-button ss-c-button--outline" aria-expanded="true" aria-controls="demo-dropdown-menu">
                Options ▾
            </button>
            <div class="ss-c-dropdown__menu" id="demo-dropdown-menu">
                <a href="#" class="ss-c-dropdown__item">Edit</a>
                <a href="#" class="ss-c-dropdown__item is-active" aria-current="true">Duplicate</a>
                <a href="#" class="ss-c-dropdown__item">Archive</a>
                <span class="ss-c-dropdown__divider" role="separator"></span>
                <a href="#" class="ss-c-dropdown__item">Delete</a>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Dropdown w/o Select" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <div class="ss-c-dropdown--menu">
            <label>
                Option 1
                <input type="checkbox" />
            </label>
            <label>
                Option 2
                <input type="checkbox" />
            </label>
            <label>
                Option 3
                <input type="checkbox" />
            </label>
            <label>
                Option 4
                <input type="checkbox" />
            </label>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Dropdown w/ Select" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <div class="ss-c-select_dropdown" style="margin-block-end: 8rem">
            <div class="ss-c-select_dropdown--header">
                <span id="selected-count">Selected: 0 options</span>
                <span style="position: relative; display: inline-block; width: 2rem; height: 1rem; vertical-align: middle">
                    <button class="active ss-c-flipper--down" type="button" aria-label="Toggle options"></button>
                </span>
            </div>
            <div class="ss-c-select_dropdown--menu">
                <label>
                    <span>Option 1</span>
                    <input type="checkbox" />
                </label>
                <label>
                    <span>Option 2</span>
                    <input type="checkbox" checked />
                </label>
                <label>
                    <span>Option 3</span>
                    <input type="checkbox" />
                </label>
                <label>
                    <span>Option 4</span>
                    <input type="checkbox" checked />
                </label>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% set section_title = "Demo Code" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div class="ss-c-dropdown" style="margin-block-end: 6rem">
            <button onclick="myFunction()" class="ss-c-dropbutton">Dropdown</button>
            <div id="myDropdown" class="ss-c-dropdown-content">
                <a href="#">Link 1</a>
                <a href="#">Link 2</a>
                <a href="#">Link 3</a>
            </div>
        </div>

        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <script>
        /* When the user clicks on the button,
    toggle between hiding and showing the dropdown content */
        function myFunction() {
            document.getElementById("myDropdown").classList.toggle("show");
        }

        // Close the dropdown menu if the user clicks outside of it
        window.onclick = function (event) {
            if (!event.target.matches(".ss-c-dropbutton")) {
                var dropdowns =
                    document.getElementsByClassName("ss-c-dropdown-content");
                var i;
                for (i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains("show")) {
                        openDropdown.classList.remove("show");
                    }
                }
            }
        };
    </script>

    {% set section_title = "Menu button (DropdownManager)" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        <p>
            <code>data-ss="dropdown-menu"</code> makes the first button (or
            <code>[aria-haspopup]</code>) toggle the menu: <code>is-open</code>
            on the root, <code>aria-expanded</code> on the trigger, Escape and a
            click outside close it, arrow keys move through the items. A native
            <code>&lt;details class="ss-c-dropdown"&gt;</code> also works and gets
            the same closing behaviour.
        </p>
        {% set code_snippet %}
        <div class="ss-c-dropdown" data-ss="dropdown-menu">
            <button type="button" class="ss-c-button ss-c-button--outline" aria-haspopup="true">Sort</button>
            <ul class="ss-c-dropdown__menu">
                <li><a class="ss-c-dropdown__item" href="#name">Name</a></li>
                <li><a class="ss-c-dropdown__item" href="#date">Date</a></li>
                <li><a class="ss-c-dropdown__item" href="#size">Size</a></li>
            </ul>
        </div>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
