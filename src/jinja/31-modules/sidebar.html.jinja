{% extends "../base.html.jinja" %} {% set title = "Sidebars" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>Navigation and content sidebars for application layouts.</p>
    </header>

    {# Basic Sidebar #} {% set section_title = "Basic Sidebar" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Simple navigation sidebar with links.</p>
        {% set code_snippet %}
        <div style="display: flex; flex-wrap: wrap; gap: 24px">
            <aside
                class="ss-c-sidebar"
                aria-label="Basic sidebar"
                style="
                    display: flex;
                    flex-direction: column;
                    width: 250px;
                    background: var(--ss-color-surface-alt);
                    border-radius: var(--ss-radius-lg);
                    padding: 20px;
                    flex-shrink: 0;
                "
            >
                <div
                    class="ss-c-sidebar__header"
                    style="
                        padding-bottom: 16px;
                        border-bottom: 1px solid var(--ss-color-border);
                        margin-bottom: 16px;
                    "
                >
                    <h3 style="margin: 0; font-size: 16px; font-weight: 600">
                        Navigation
                    </h3>
                </div>
                <nav class="ss-c-sidebar__nav" aria-label="Basic sidebar navigation">
                    <ul
                        style="
                            list-style: none;
                            padding: 0;
                            margin: 0;
                            display: flex;
                            flex-direction: column;
                            gap: 4px;
                        "
                    >
                        <li>
                            <a
                                href="#"
                                style="
                                    display: block;
                                    padding: 10px 12px;
                                    background: var(--ss-color-accent);
                                    color: var(--ss-color-on-accent);
                                    border-radius: var(--ss-radius-lg);
                                    text-decoration: none;
                                "
                            >
                                Dashboard
                            </a>
                        </li>
                        <li>
                            <a
                                href="#"
                                style="
                                    display: block;
                                    padding: 10px 12px;
                                    border-radius: var(--ss-radius-lg);
                                    text-decoration: none;
                                    color: inherit;
                                "
                            >
                                Projects
                            </a>
                        </li>
                        <li>
                            <a
                                href="#"
                                style="
                                    display: block;
                                    padding: 10px 12px;
                                    border-radius: var(--ss-radius-lg);
                                    text-decoration: none;
                                    color: inherit;
                                "
                            >
                                Messages
                            </a>
                        </li>
                        <li>
                            <a
                                href="#"
                                style="
                                    display: block;
                                    padding: 10px 12px;
                                    border-radius: var(--ss-radius-lg);
                                    text-decoration: none;
                                    color: inherit;
                                "
                            >
                                Settings
                            </a>
                        </li>
                    </ul>
                </nav>
            </aside>
            <div
                style="
                    flex: 1 1 240px;
                    padding: 20px;
                    background: var(--ss-color-surface);
                    border: 1px solid var(--ss-color-border);
                    border-radius: var(--ss-radius-lg);
                "
            >
                <p style="margin: 0; opacity: 0.6">Main content area</p>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

