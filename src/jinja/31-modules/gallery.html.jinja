{% extends "../base.html.jinja" %} {% set title = "Gallery" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            Image gallery layouts for displaying collections of visual content.
        </p>
    </header>

    {# Basic Grid Gallery #} {% set section_title = "Basic Grid Gallery" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-gallery ss-c-gallery--grid"
            style="
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 12px;
            "
        >
            <div
                class="ss-c-gallery--item"
                style="
                    aspect-ratio: 1;
                    background: linear-gradient(135deg, #667eea, #764ba2);
                    border-radius: var(--ss-radius-lg);
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    aspect-ratio: 1;
                    background: linear-gradient(135deg, #f093fb, #f5576c);
                    border-radius: var(--ss-radius-lg);
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    aspect-ratio: 1;
                    background: linear-gradient(135deg, #4facfe, #00f2fe);
                    border-radius: var(--ss-radius-lg);
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    aspect-ratio: 1;
                    background: linear-gradient(135deg, #43e97b, #38f9d7);
                    border-radius: var(--ss-radius-lg);
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    aspect-ratio: 1;
                    background: linear-gradient(135deg, #fa709a, #fee140);
                    border-radius: var(--ss-radius-lg);
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    aspect-ratio: 1;
                    background: linear-gradient(135deg, #a8edea, #fed6e3);
                    border-radius: var(--ss-radius-lg);
                "
            ></div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Masonry Gallery #} {% set section_title = "Masonry Gallery" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-gallery ss-c-gallery--masonry"
            style="columns: 3; column-gap: 12px"
        >
            <div
                class="ss-c-gallery--item"
                style="
                    break-inside: avoid;
                    margin-bottom: 12px;
                    background: linear-gradient(135deg, #667eea, #764ba2);
                    border-radius: var(--ss-radius-lg);
                    height: 200px;
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    break-inside: avoid;
                    margin-bottom: 12px;
                    background: linear-gradient(135deg, #f093fb, #f5576c);
                    border-radius: var(--ss-radius-lg);
                    height: 150px;
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    break-inside: avoid;
                    margin-bottom: 12px;
                    background: linear-gradient(135deg, #4facfe, #00f2fe);
                    border-radius: var(--ss-radius-lg);
                    height: 280px;
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    break-inside: avoid;
                    margin-bottom: 12px;
                    background: linear-gradient(135deg, #43e97b, #38f9d7);
                    border-radius: var(--ss-radius-lg);
                    height: 180px;
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    break-inside: avoid;
                    margin-bottom: 12px;
                    background: linear-gradient(135deg, #fa709a, #fee140);
                    border-radius: var(--ss-radius-lg);
                    height: 220px;
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    break-inside: avoid;
                    margin-bottom: 12px;
                    background: linear-gradient(135deg, #a8edea, #fed6e3);
                    border-radius: var(--ss-radius-lg);
                    height: 160px;
                "
            ></div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Gallery with Captions #} {% set section_title = "Gallery with Captions"
    %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-gallery ss-c-gallery--captioned"
            style="
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 20px;
            "
        >
            <figure class="ss-c-gallery--item" style="margin: 0">
                <div
                    style="
                        aspect-ratio: 4/3;
                        background: linear-gradient(135deg, #667eea, #764ba2);
                        border-radius: var(--ss-radius-lg) var(--ss-radius-lg) 0 0;
                    "
                ></div>
                <figcaption
                    style="
                        padding: 12px;
                        background: var(--ss-color-surface-alt);
                        border-radius: 0 0 var(--ss-radius-lg) var(--ss-radius-lg);
                    "
                >
                    <h3 style="margin: 0 0 4px; font-size: 14px">
                        Mountain Sunset
                    </h3>
                    <p style="margin: 0; font-size: 12px; opacity: 0.7">
                        Beautiful evening light
                    </p>
                </figcaption>
            </figure>
            <figure class="ss-c-gallery--item" style="margin: 0">
                <div
                    style="
                        aspect-ratio: 4/3;
                        background: linear-gradient(135deg, #4facfe, #00f2fe);
                        border-radius: var(--ss-radius-lg) var(--ss-radius-lg) 0 0;
                    "
                ></div>
                <figcaption
                    style="
                        padding: 12px;
                        background: var(--ss-color-surface-alt);
                        border-radius: 0 0 var(--ss-radius-lg) var(--ss-radius-lg);
                    "
                >
                    <h3 style="margin: 0 0 4px; font-size: 14px">
                        Ocean Waves
                    </h3>
                    <p style="margin: 0; font-size: 12px; opacity: 0.7">
                        Coastal photography
                    </p>
                </figcaption>
            </figure>
            <figure class="ss-c-gallery--item" style="margin: 0">
                <div
                    style="
                        aspect-ratio: 4/3;
                        background: linear-gradient(135deg, #43e97b, #38f9d7);
                        border-radius: var(--ss-radius-lg) var(--ss-radius-lg) 0 0;
                    "
                ></div>
                <figcaption
                    style="
                        padding: 12px;
                        background: var(--ss-color-surface-alt);
                        border-radius: 0 0 var(--ss-radius-lg) var(--ss-radius-lg);
                    "
                >
                    <h3 style="margin: 0 0 4px; font-size: 14px">
                        Forest Trail
                    </h3>
                    <p style="margin: 0; font-size: 12px; opacity: 0.7">
                        Nature walk series
                    </p>
                </figcaption>
            </figure>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Gallery with Overlay #} {% set section_title = "Gallery with Hover
    Overlay" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-gallery ss-c-gallery--overlay"
            style="
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
                gap: 16px;
            "
        >
            <div
                class="ss-c-gallery--item"
                style="
                    position: relative;
                    aspect-ratio: 1;
                    border-radius: var(--ss-radius-lg);
                    overflow: hidden;
                    cursor: pointer;
                "
            >
                <div
                    style="
                        width: 100%;
                        height: 100%;
                        background: linear-gradient(135deg, #667eea, #764ba2);
                    "
                ></div>
                <div
                    class="ss-c-gallery--overlay"
                    style="
                        position: absolute;
                        inset: 0;
                        background: rgba(0, 0, 0, 0.6);
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        opacity: 0;
                        transition: opacity 0.3s;
                        color: white;
                    "
                >
                    <span style="font-size: 24px; margin-bottom: 8px">◉</span>
                    <span style="font-size: 14px">View Image</span>
                </div>
            </div>
            <div
                class="ss-c-gallery--item"
                style="
                    position: relative;
                    aspect-ratio: 1;
                    border-radius: var(--ss-radius-lg);
                    overflow: hidden;
                    cursor: pointer;
                "
            >
                <div
                    style="
                        width: 100%;
                        height: 100%;
                        background: linear-gradient(135deg, #f093fb, #f5576c);
                    "
                ></div>
                <div
                    class="ss-c-gallery--overlay"
                    style="
                        position: absolute;
                        inset: 0;
                        background: rgba(0, 0, 0, 0.6);
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        opacity: 0;
                        transition: opacity 0.3s;
                        color: white;
                    "
                >
                    <span style="font-size: 24px; margin-bottom: 8px">◉</span>
                    <span style="font-size: 14px">View Image</span>
                </div>
            </div>
            <div
                class="ss-c-gallery--item"
                style="
                    position: relative;
                    aspect-ratio: 1;
                    border-radius: var(--ss-radius-lg);
                    overflow: hidden;
                    cursor: pointer;
                "
            >
                <div
                    style="
                        width: 100%;
                        height: 100%;
                        background: linear-gradient(135deg, #4facfe, #00f2fe);
                    "
                ></div>
                <div
                    class="ss-c-gallery--overlay"
                    style="
                        position: absolute;
                        inset: 0;
                        background: rgba(0, 0, 0, 0.6);
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        opacity: 0;
                        transition: opacity 0.3s;
                        color: white;
                    "
                >
                    <span style="font-size: 24px; margin-bottom: 8px">◉</span>
                    <span style="font-size: 14px">View Image</span>
                </div>
            </div>
        </div>
        <p style="margin-top: 12px; font-size: 13px; opacity: 0.7">
            Hover over images to see the overlay effect.
        </p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Featured Gallery #} {% set section_title = "Featured Gallery Layout" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-gallery ss-c-gallery--featured"
            style="
                display: grid;
                grid-template-columns: 2fr 1fr;
                grid-template-rows: 1fr 1fr;
                gap: 12px;
                height: 400px;
            "
        >
            <div
                class="ss-c-gallery--item ss-c-featured"
                style="
                    grid-row: span 2;
                    background: linear-gradient(135deg, #667eea, #764ba2);
                    border-radius: var(--ss-radius-lg);
                    display: flex;
                    align-items: end;
                    padding: 20px;
                "
            >
                <div style="color: white">
                    <h3 style="margin: 0 0 8px; color: inherit">Featured Image</h3>
                    <p style="margin: 0; opacity: 0.8; font-size: 14px">
                        Main gallery highlight
                    </p>
                </div>
            </div>
            <div
                class="ss-c-gallery--item"
                style="
                    background: linear-gradient(135deg, #f093fb, #f5576c);
                    border-radius: var(--ss-radius-lg);
                "
            ></div>
            <div
                class="ss-c-gallery--item"
                style="
                    background: linear-gradient(135deg, #4facfe, #00f2fe);
                    border-radius: var(--ss-radius-lg);
                "
            ></div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
