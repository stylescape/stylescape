{% extends "../base.html.jinja" %} {% set title = "Badge" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
    </header>

    <p>Documentation and examples for badges.</p>

    {% set section_title = "Default Badge" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <p>
            I am a
            <span class="ss-c-badge">Default</span>
            Badge.
        </p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Square Badges" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <p>
            <span class="ss-c-badge ss-c-badge--square">Default</span>
            <span class="ss-c-badge ss-c-badge--accent ss-c-badge--square">Accent</span>
            <span class="ss-c-badge ss-c-badge--info ss-c-badge--square">Info</span>
            <span class="ss-c-badge ss-c-badge--success ss-c-badge--square">Success</span>
            <span class="ss-c-badge ss-c-badge--warning ss-c-badge--square">Warning</span>
            <span class="ss-c-badge ss-c-badge--error ss-c-badge--square">Error</span>
        </p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Rounded Badges" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <p>
            <span class="ss-c-badge">Default</span>
            <span class="ss-c-badge ss-c-badge--accent">Accent</span>
            <span class="ss-c-badge ss-c-badge--info">Info</span>
            <span class="ss-c-badge ss-c-badge--success">Success</span>
            <span class="ss-c-badge ss-c-badge--warning">Warning</span>
            <span class="ss-c-badge ss-c-badge--error">Error</span>
        </p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Pill Badges" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <p>
            <span class="ss-c-badge ss-c-badge--pill">Default</span>
            <span class="ss-c-badge ss-c-badge--accent ss-c-badge--pill">Accent</span>
            <span class="ss-c-badge ss-c-badge--info ss-c-badge--pill">Info</span>
            <span class="ss-c-badge ss-c-badge--success ss-c-badge--pill">Success</span>
            <span class="ss-c-badge ss-c-badge--warning ss-c-badge--pill">Warning</span>
            <span class="ss-c-badge ss-c-badge--error ss-c-badge--pill">Error</span>
        </p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Badge Sizes" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <p><span class="ss-c-badge">Paragraph</span></p>
        <h1><span class="ss-c-badge">Header 1</span></h1>
        <h2><span class="ss-c-badge">Header 2</span></h2>
        <h3><span class="ss-c-badge">Header 3</span></h3>
        <h4><span class="ss-c-badge">Header 4</span></h4>
        <h5><span class="ss-c-badge">Header 5</span></h5>
        <h6><span class="ss-c-badge">Header 6</span></h6>
        <span class="ss-c-badge ss-c-badge--xs">Extra Small</span>
        <span class="ss-c-badge ss-c-badge--sm">Small</span>
        <span class="ss-c-badge">Medium</span>
        <span class="ss-c-badge ss-c-badge--lg">Large</span>
        <span class="ss-c-badge ss-c-badge--xl">Extra Large</span>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
