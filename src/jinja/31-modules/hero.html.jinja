{% extends "../base.html.jinja" %} {% set title = "Hero Sections" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            Full-width hero sections for impactful landing pages and headers.
        </p>
    </header>

    {# Basic Hero #} {% set section_title = "Basic Hero" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Simple centered hero with heading and call-to-action.</p>
        {% set code_snippet %}
        <section
            class="ss-c-hero"
            style="
                min-height: 400px;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 60px 24px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                border-radius: var(--ss-radius-xl);
            "
        >
            <div class="ss-c-hero__content" style="max-width: 600px">
                <h3
                    style="color: inherit; margin: 0 0 16px; font-size: clamp(30px, 7vw, 48px); font-weight: 700"
                >
                    Welcome to Stylescape
                </h3>
                <p style="margin: 0 0 32px; font-size: 18px; opacity: 0.9">
                    Build beautiful, responsive interfaces with our design
                    system.
                </p>
                <div
                    class="ss-c-hero__actions"
                    style="display: flex; gap: 16px; justify-content: center"
                >
                    <button
                        style="
                            padding: 14px 32px;
                            background: white;
                            color: #4c51bf;
                            border: none;
                            border-radius: var(--ss-radius-lg);
                            font-weight: 600;
                            cursor: pointer;
                        "
                    >
                        Get Started
                    </button>
                    <button
                        style="
                            padding: 14px 32px;
                            background: transparent;
                            color: white;
                            border: 2px solid white;
                            border-radius: var(--ss-radius-lg);
                            font-weight: 600;
                            cursor: pointer;
                        "
                    >
                        Learn More
                    </button>
                </div>
            </div>
        </section>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Hero with Image #} {% set section_title = "Hero with Image" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Split layout hero with content and featured image.</p>
        {% set code_snippet %}
        <section
            class="ss-c-hero ss-c-hero--split"
            style="
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                min-height: 500px;
                background: var(--ss-color-surface-alt);
                border-radius: var(--ss-radius-xl);
                overflow: hidden;
            "
        >
            <div
                class="ss-c-hero__content"
                style="
                    padding: clamp(24px, 6vw, 60px) clamp(16px, 5vw, 48px);
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                "
            >
                <span
                    style="
                        display: inline-block;
                        padding: 6px 12px;
                        background: var(--ss-color-accent);
                        color: var(--ss-color-on-accent);
                        border-radius: var(--ss-radius-2xl);
                        font-size: 12px;
                        font-weight: 600;
                        width: fit-content;
                        margin-bottom: 20px;
                    "
                >
                    NEW RELEASE
                </span>
                <h3
                    style="
                        color: inherit; margin: 0 0 16px;
                        font-size: clamp(28px, 6vw, 42px);
                        font-weight: 700;
                        line-height: 1.2;
                    "
                >
                    Create stunning designs effortlessly
                </h3>
                <p
                    style="
                        margin: 0 0 32px;
                        font-size: 16px;
                        opacity: 0.8;
                        line-height: 1.6;
                    "
                >
                    Stylescape provides all the components you need to build
                    professional websites. From atoms to organisms, everything
                    is customizable.
                </p>
                <div class="ss-c-hero__actions" style="display: flex; gap: 12px">
                    <button
                        style="
                            padding: 14px 28px;
                            background: var(--ss-color-accent);
                            color: var(--ss-color-on-accent);
                            border: none;
                            border-radius: var(--ss-radius-lg);
                            font-weight: 600;
                            cursor: pointer;
                        "
                    >
                        Start Free Trial
                    </button>
                    <button
                        style="
                            padding: 14px 28px;
                            background: var(--ss-color-surface);
                            color: var(--ss-color-text);
                            border: 1px solid var(--ss-color-border);
                            border-radius: var(--ss-radius-lg);
                            font-weight: 500;
                            cursor: pointer;
                            display: flex;
                            align-items: center;
                            gap: 8px;
                        "
                    >
                        <span>▶</span>
                        Watch Demo
                    </button>
                </div>
            </div>
            <div
                class="ss-c-hero__image"
                style="
                    background: linear-gradient(
                        135deg,
                        #f093fb 0%,
                        #f5576c 100%
                    );
                    display: flex;
                    align-items: center;
                    justify-content: center;
                "
            >
                <div
                    style="
                        width: 200px;
                        height: 200px;
                        background: rgba(255, 255, 255, 0.2);
                        border-radius: var(--ss-radius-2xl);
                    "
                ></div>
            </div>
        </section>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Hero with Background Image #} {% set section_title = "Hero with
    Background" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Full-bleed background image with overlay.</p>
        {% set code_snippet %}
        <section
            class="ss-c-hero ss-c-hero--bg"
            style="
                position: relative;
                min-height: 500px;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 60px 24px;
                border-radius: var(--ss-radius-xl);
                overflow: hidden;
            "
        >
            <!-- Background image layer -->
            <div
                class="ss-c-hero__bg"
                style="
                    position: absolute;
                    inset: 0;
                    background: url(&quot;/img/placeholder/1200x600.svg)
                        center/cover;
                    z-index: 0;
                "
            ></div>
            <!-- Overlay -->
            <div
                class="ss-c-hero__overlay"
                style="
                    position: absolute;
                    inset: 0;
                    background: rgba(0, 0, 0, 0.6);
                    z-index: 1;
                "
            ></div>
            <!-- Content -->
            <div
                class="ss-c-hero__content"
                style="
                    position: relative;
                    z-index: 2;
                    max-width: 700px;
                    color: white;
                "
            >
                <h3
                    style="color: inherit; margin: 0 0 20px; font-size: clamp(30px, 7vw, 52px); font-weight: 700"
                >
                    Explore the Possibilities
                </h3>
                <p style="margin: 0 0 32px; font-size: 18px; opacity: 0.9">
                    Discover how our platform can transform your workflow and
                    boost productivity.
                </p>
                <button
                    style="
                        padding: 16px 40px;
                        background: white;
                        color: #1a1a2e;
                        border: none;
                        border-radius: var(--ss-radius-lg);
                        font-weight: 600;
                        font-size: 16px;
                        cursor: pointer;
                    "
                >
                    Get Started Today
                </button>
            </div>
        </section>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Hero with Stats #} {% set section_title = "Hero with Stats" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Hero section featuring key statistics.</p>
        {% set code_snippet %}
        <section
            class="ss-c-hero ss-c-hero--stats"
            style="
                padding: clamp(32px, 8vw, 80px) clamp(16px, 5vw, 48px);
                background: linear-gradient(
                    to right,
                    #0f0c29,
                    #302b63,
                    #24243e
                );
                color: white;
                border-radius: var(--ss-radius-xl);
            "
        >
            <div style="max-width: 1000px; margin: 0 auto; text-align: center">
                <h3
                    style="color: inherit; margin: 0 0 16px; font-size: clamp(28px, 6vw, 44px); font-weight: 700"
                >
                    Trusted by Developers Worldwide
                </h3>
                <p style="margin: 0 0 48px; font-size: 18px; opacity: 0.8">
                    Join thousands of teams building better products with
                    Stylescape.
                </p>

                <div
                    class="ss-c-hero__stats"
                    style="
                        display: grid;
                        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
                        gap: 32px;
                    "
                >
                    <div
                        class="ss-c-stat"
                        style="display: flex; flex-direction: column; align-items: center"
                    >
                        <div
                            style="
                                font-size: clamp(30px, 7vw, 48px);
                                font-weight: 700;
                                margin-bottom: 8px;
                            "
                        >
                            10K+
                        </div>
                        <div
                            style="
                                font-size: 14px;
                                opacity: 0.7;
                                text-transform: uppercase;
                                letter-spacing: 1px;
                            "
                        >
                            Downloads
                        </div>
                    </div>
                    <div
                        class="ss-c-stat"
                        style="display: flex; flex-direction: column; align-items: center"
                    >
                        <div
                            style="
                                font-size: clamp(30px, 7vw, 48px);
                                font-weight: 700;
                                margin-bottom: 8px;
                            "
                        >
                            500+
                        </div>
                        <div
                            style="
                                font-size: 14px;
                                opacity: 0.7;
                                text-transform: uppercase;
                                letter-spacing: 1px;
                            "
                        >
                            Components
                        </div>
                    </div>
                    <div
                        class="ss-c-stat"
                        style="display: flex; flex-direction: column; align-items: center"
                    >
                        <div
                            style="
                                font-size: clamp(30px, 7vw, 48px);
                                font-weight: 700;
                                margin-bottom: 8px;
                            "
                        >
                            99%
                        </div>
                        <div
                            style="
                                font-size: 14px;
                                opacity: 0.7;
                                text-transform: uppercase;
                                letter-spacing: 1px;
                            "
                        >
                            Satisfaction
                        </div>
                    </div>
                    <div
                        class="ss-c-stat"
                        style="display: flex; flex-direction: column; align-items: center"
                    >
                        <div
                            style="
                                font-size: clamp(30px, 7vw, 48px);
                                font-weight: 700;
                                margin-bottom: 8px;
                            "
                        >
                            24/7
                        </div>
                        <div
                            style="
                                font-size: 14px;
                                opacity: 0.7;
                                text-transform: uppercase;
                                letter-spacing: 1px;
                            "
                        >
                            Support
                        </div>
                    </div>
                </div>
            </div>
        </section>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Minimal Hero #} {% set section_title = "Minimal Hero" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Clean, typography-focused hero section.</p>
        {% set code_snippet %}
        <section
            class="ss-c-hero ss-c-hero--minimal"
            style="
                padding: clamp(40px, 10vw, 100px) clamp(16px, 5vw, 48px);
                text-align: center;
                background: var(--ss-color-surface);
                color: var(--ss-color-text);
                border: 1px solid var(--ss-color-border);
                border-radius: var(--ss-radius-xl);
            "
        >
            <div style="max-width: 800px; margin: 0 auto">
                <h3
                    style="
                        color: inherit; margin: 0 0 24px;
                        font-size: clamp(32px, 8vw, 56px);
                        font-weight: 800;
                        line-height: 1.1;
                        letter-spacing: -2px;
                    "
                >
                    Design systems
                    <br />
                    made simple.
                </h3>
                <p
                    style="
                        margin: 0 0 40px;
                        font-size: 20px;
                        opacity: 0.6;
                        line-height: 1.6;
                    "
                >
                    Everything you need to build consistent, beautiful
                    interfaces.
                </p>
                <div
                    class="ss-c-hero__form"
                    style="
                        display: flex;
                        gap: 12px;
                        justify-content: center;
                        flex-wrap: wrap;
                        max-width: 400px;
                        margin: 0 auto;
                    "
                >
                    <input
                        type="email"
                        class="ss-c-input"
                        placeholder="Enter your email"
                        aria-label="Email address"
                        style="flex: 1; min-width: 0"
                    />
                    <button class="ss-c-button ss-c-button--primary"

                    >
                        Get Access
                    </button>
                </div>
            </div>
        </section>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Video Hero #} {% set section_title = "Video Background Hero" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Hero with looping video background.</p>
        {% set code_snippet %}
        <section
            class="ss-c-hero ss-c-hero--video"
            style="
                position: relative;
                min-height: 500px;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 60px 24px;
                border-radius: var(--ss-radius-xl);
                overflow: hidden;
                background: #1a1a2e;
            "
        >
            <!-- Video placeholder (simulated) -->
            <div
                class="ss-c-hero__video"
                style="
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(
                        45deg,
                        #1a1a2e 25%,
                        #302b63 50%,
                        #1a1a2e 75%
                    );
                    background-size: 400% 400%;
                    animation: gradientMove 8s ease infinite;
                    z-index: 0;
                "
            ></div>
            <!-- Overlay -->
            <div
                class="ss-c-hero__overlay"
                style="
                    position: absolute;
                    inset: 0;
                    background: rgba(0, 0, 0, 0.4);
                    z-index: 1;
                "
            ></div>
            <!-- Content -->
            <div
                class="ss-c-hero__content"
                style="
                    position: relative;
                    z-index: 2;
                    max-width: 600px;
                    color: white;
                "
            >
                <h3
                    style="color: inherit; margin: 0 0 20px; font-size: clamp(30px, 7vw, 48px); font-weight: 700"
                >
                    Immersive Experiences
                </h3>
                <p style="margin: 0 0 32px; font-size: 18px; opacity: 0.9">
                    Create captivating video backgrounds that engage your
                    audience.
                </p>
                <button
                    style="
                        padding: 16px 32px;
                        background: rgba(255, 255, 255, 0.2);
                        color: white;
                        border: 2px solid white;
                        border-radius: var(--ss-radius-lg);
                        font-weight: 600;
                        cursor: pointer;
                        backdrop-filter: blur(4px);
                    "
                >
                    Watch Showreel
                </button>
            </div>
        </section>

        <style>
            @keyframes gradientMove {
                0% {
                    background-position: 0% 50%;
                }
                50% {
                    background-position: 100% 50%;
                }
                100% {
                    background-position: 0% 50%;
                }
            }
        </style>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
