{% extends "../base.html.jinja" %} {% set title = "Modals" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}
<style>
    /* Demo only: the interactive examples stay hidden until opened. */
    .ss-c-modal[id]:not(.show) {
        display: none;
    }
    .ss-c-modal[id] .ss-c-modal__overlay {
        position: absolute;
        inset: 0;
        background: rgb(0 0 0 / 0.5);
    }
    .ss-c-modal[id] .ss-c-modal__container {
        position: relative;
        width: 100%;
        max-width: 480px;
        padding: 16px 24px;
        background: var(--ss-color-background);
        color: var(--ss-color-text);
        border-radius: var(--ss-radius-lg);
    }
    .ss-c-modal[id] .ss-c-modal__header,
    .ss-c-modal[id] .ss-c-modal__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    /* Static previews: lay the modal out as a plain card, not a fixed flex overlay. */
    .ss-c-modal:not([id]) {
        z-index: auto;
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;
        padding: 0;
    }
    .ss-c-modal[id] .ss-c-modal__close {
        min-width: 32px;
        min-height: 32px;
    }
</style>
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            Modal dialogs for displaying content that requires user
            interaction.
        </p>
    </header>

    {# Basic Modal #} {% set section_title = "Basic Modal" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <button
            class="ss-c-button"
            onclick="document.getElementById('modal-basic').classList.add('show')"
        >
            Open Modal
        </button>

        <div id="modal-basic" class="ss-c-modal" role="dialog" aria-modal="true" aria-labelledby="modal-basic-title">
            <div
                class="ss-c-modal__overlay"
                onclick="this.parentElement.classList.remove('show')"
            ></div>
            <div class="ss-c-modal__container">
                <header class="ss-c-modal__header">
                    <h3 class="ss-c-modal__title" id="modal-basic-title">Modal Title</h3>
                    <button
                        type="button"
                        class="ss-c-modal__close"
                        aria-label="Close"
                        onclick="this.closest('.ss-c-modal').classList.remove('show')"
                    >
                        <span aria-hidden="true">&times;</span>
                    </button>
                </header>
                <div class="ss-c-modal__body">
                    <p>
                        This is the modal body content. You can place any
                        content here.
                    </p>
                </div>
                <footer class="ss-c-modal__footer">
                    <button
                        class="ss-c-button ss-c-button--secondary"
                        onclick="this.closest('.ss-c-modal').classList.remove('show')"
                    >
                        Cancel
                    </button>
                    <button class="ss-c-button ss-c-button--primary">Confirm</button>
                </footer>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Modal Sizes #} {% set section_title = "Modal Sizes" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: flex; gap: 16px; flex-wrap: wrap">
            <button
                class="ss-c-button"
                onclick="document.getElementById('modal-sm').classList.add('show')"
            >
                Small
            </button>
            <button
                class="ss-c-button"
                onclick="document.getElementById('modal-lg').classList.add('show')"
            >
                Large
            </button>
        </div>

        <div id="modal-sm" class="ss-c-modal ss-c-modal--small" role="dialog" aria-modal="true" aria-labelledby="modal-sm-title">
            <div
                class="ss-c-modal__overlay"
                onclick="this.parentElement.classList.remove('show')"
            ></div>
            <div class="ss-c-modal__container">
                <header class="ss-c-modal__header">
                    <h3 class="ss-c-modal__title" id="modal-sm-title">Small Modal</h3>
                    <button
                        type="button"
                        class="ss-c-modal__close"
                        aria-label="Close"
                        onclick="this.closest('.ss-c-modal').classList.remove('show')"
                    >
                        <span aria-hidden="true">&times;</span>
                    </button>
                </header>
                <div class="ss-c-modal__body">
                    <p>Compact modal for quick confirmations.</p>
                </div>
            </div>
        </div>

        <div id="modal-lg" class="ss-c-modal ss-c-modal--large" role="dialog" aria-modal="true" aria-labelledby="modal-lg-title">
            <div
                class="ss-c-modal__overlay"
                onclick="this.parentElement.classList.remove('show')"
            ></div>
            <div class="ss-c-modal__container">
                <header class="ss-c-modal__header">
                    <h3 class="ss-c-modal__title" id="modal-lg-title">Large Modal</h3>
                    <button
                        type="button"
                        class="ss-c-modal__close"
                        aria-label="Close"
                        onclick="this.closest('.ss-c-modal').classList.remove('show')"
                    >
                        <span aria-hidden="true">&times;</span>
                    </button>
                </header>
                <div class="ss-c-modal__body">
                    <p>Spacious modal for detailed content or forms.</p>
                </div>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Confirmation Modal #} {% set section_title = "Confirmation Modal" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <button
            class="ss-c-button ss-c-button--danger"
            onclick="document.getElementById('modal-confirm').classList.add('show')"
        >
            Delete Item
        </button>

        <div id="modal-confirm" class="ss-c-modal" role="dialog" aria-modal="true" aria-labelledby="modal-confirm-title">
            <div
                class="ss-c-modal__overlay"
                onclick="this.parentElement.classList.remove('show')"
            ></div>
            <div class="ss-c-modal__container">
                <header class="ss-c-modal__header">
                    <h3 class="ss-c-modal__title" id="modal-confirm-title">Confirm Deletion</h3>
                </header>
                <div class="ss-c-modal__body">
                    <p>
                        Are you sure you want to delete this item? This action
                        cannot be undone.
                    </p>
                </div>
                <footer class="ss-c-modal__footer">
                    <button
                        class="ss-c-button ss-c-button--secondary"
                        onclick="this.closest('.ss-c-modal').classList.remove('show')"
                    >
                        Cancel
                    </button>
                    <button class="ss-c-button ss-c-button--danger">Delete</button>
                </footer>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">

    {# Basic Modal Structure #} {% set section_title = "Basic Modal Structure"
    %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-modal-preview"
            style="
                position: relative;
                min-height: 400px;
                background: var(--ss-color-surface-alt);
                border-radius: var(--ss-radius-lg);
                display: flex;
                align-items: center;
                justify-content: center;
            "
        >
            <!-- Modal Backdrop -->
            <div
                class="ss-c-modal--backdrop"
                style="
                    position: absolute;
                    inset: 0;
                    background: rgba(0, 0, 0, 0.5);
                    border-radius: var(--ss-radius-lg);
                "
            ></div>
            <!-- Modal Content -->
            <div
                class="ss-c-modal"
                style="
                    position: relative;
                    width: 90%;
                    max-width: 480px;
                    background: var(--ss-color-surface);
                    color: var(--ss-color-text);
                    border-radius: var(--ss-radius-lg);
                    box-shadow: var(--ss-a-shadow-xl);
                "
            >
                <div
                    class="ss-c-modal--header"
                    style="
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        padding: 20px 24px;
                        border-bottom: 1px solid var(--ss-color-border);
                    "
                >
                    <h3 style="margin: 0; font-size: 18px">Modal Title</h3>
                    <button
                        type="button"
                        class="ss-c-modal--close"
                        aria-label="Close"
                        style="
                            width: 32px;
                            height: 32px;
                            border: none;
                            background: var(--ss-color-surface-alt);
                            border-radius: var(--ss-radius-md);
                            cursor: pointer;
                            font-size: 16px;
                        "
                    >
                        <span aria-hidden="true">✕</span>
                    </button>
                </div>
                <div class="ss-c-modal--body" style="padding: 24px">
                    <p style="margin: 0; line-height: 1.6">
                        This is the modal body content. You can add any content
                        here including forms, images, or other components.
                    </p>
                </div>
                <div
                    class="ss-c-modal--footer"
                    style="
                        display: flex;
                        justify-content: flex-end;
                        gap: 12px;
                        padding: 16px 24px;
                        border-top: 1px solid var(--ss-color-border);
                        background: var(--ss-color-surface-alt);
                        border-radius: 0 0 var(--ss-radius-lg) var(--ss-radius-lg);
                    "
                >
                    <button
                        style="
                            padding: 10px 20px;
                            border: 1px solid var(--ss-color-border);
                            background: var(--ss-color-surface);
                            color: var(--ss-color-text);
                            border-radius: var(--ss-radius-md);
                            cursor: pointer;
                        "
                    >
                        Cancel
                    </button>
                    <button
                        style="
                            padding: 10px 20px;
                            border: none;
                            background: var(--ss-color-accent);
                            color: var(--ss-color-on-accent);
                            border-radius: var(--ss-radius-md);
                            cursor: pointer;
                        "
                    >
                        Confirm
                    </button>
                </div>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Modal Sizes #} {% set section_title = "Static Modal Sizes" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: flex; flex-direction: column; gap: 20px">
            <!-- Small Modal -->
            <div
                class="ss-c-modal ss-c-modal--small"
                style="
                    position: relative;
                    max-width: 320px;
                    background: var(--ss-color-surface);
                    color: var(--ss-color-text);
                    border-radius: var(--ss-radius-lg);
                    box-shadow: var(--ss-a-shadow-lg);
                "
            >
                <div style="padding: 20px; text-align: center">
                    <div style="font-size: 48px; margin-bottom: 12px">✓</div>
                    <h3 style="margin: 0 0 8px">Success!</h3>
                    <p style="margin: 0 0 16px; font-size: 14px; opacity: 0.7">
                        Your changes have been saved.
                    </p>
                    <button
                        style="
                            padding: 10px 24px;
                            border: none;
                            background: var(--ss-color-success);
                            color: var(--ss-color-on-success);
                            border-radius: var(--ss-radius-md);
                            cursor: pointer;
                        "
                    >
                        OK
                    </button>
                </div>
            </div>
            <!-- Large Modal -->
            <div
                class="ss-c-modal ss-c-modal--large"
                style="
                    position: relative;
                    max-width: 700px;
                    background: var(--ss-color-surface);
                    color: var(--ss-color-text);
                    border-radius: var(--ss-radius-lg);
                    box-shadow: var(--ss-a-shadow-lg);
                "
            >
                <div
                    class="ss-c-modal--header"
                    style="
                        padding: 20px 24px;
                        border-bottom: 1px solid var(--ss-color-border);
                    "
                >
                    <h3 style="margin: 0">Large Modal</h3>
                </div>
                <div class="ss-c-modal--body" style="padding: 24px">
                    <p>
                        This is a larger modal suitable for complex content
                        like forms, tables, or detailed information.
                    </p>
                    <div
                        style="
                            display: grid;
                            grid-template-columns: repeat(2, 1fr);
                            gap: 16px;
                            margin-top: 16px;
                        "
                    >
                        <div
                            style="
                                padding: 16px;
                                background: var(--ss-color-surface-alt);
                                border-radius: var(--ss-radius-lg);
                            "
                        >
                            Column 1 content
                        </div>
                        <div
                            style="
                                padding: 16px;
                                background: var(--ss-color-surface-alt);
                                border-radius: var(--ss-radius-lg);
                            "
                        >
                            Column 2 content
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Fullscreen Modal #} {% set section_title = "Fullscreen Modal" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-modal-preview"
            style="
                position: relative;
                min-height: 350px;
                background: #1a1a2e;
                border-radius: var(--ss-radius-lg);
                overflow: hidden;
            "
        >
            <div
                class="ss-c-modal ss-c-modal--fullscreen"
                style="
                    position: absolute;
                    inset: 0;
                    background: var(--ss-color-surface);
                    color: var(--ss-color-text);
                    display: flex;
                    flex-direction: column;
                "
            >
                <div
                    class="ss-c-modal--header"
                    style="
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        padding: 16px 24px;
                        border-bottom: 1px solid var(--ss-color-border);
                    "
                >
                    <h3 style="margin: 0; font-size: 16px">
                        Fullscreen Modal
                    </h3>
                    <button
                        style="
                            padding: 8px 16px;
                            border: none;
                            background: var(--ss-color-surface-alt);
                            border-radius: var(--ss-radius-md);
                            cursor: pointer;
                        "
                    >
                        Close ✕
                    </button>
                </div>
                <div
                    class="ss-c-modal--body"
                    style="flex: 1; padding: 24px; overflow-y: auto"
                >
                    <p>
                        This modal takes up the full viewport. Perfect for
                        immersive experiences, image galleries, or complex
                        workflows.
                    </p>
                    <div
                        style="
                            display: grid;
                            grid-template-columns: repeat(3, 1fr);
                            gap: 12px;
                            margin-top: 16px;
                        "
                    >
                        <div
                            style="
                                aspect-ratio: 1;
                                background: linear-gradient(
                                    135deg,
                                    #667eea,
                                    #764ba2
                                );
                                border-radius: var(--ss-radius-lg);
                            "
                        ></div>
                        <div
                            style="
                                aspect-ratio: 1;
                                background: linear-gradient(
                                    135deg,
                                    #f093fb,
                                    #f5576c
                                );
                                border-radius: var(--ss-radius-lg);
                            "
                        ></div>
                        <div
                            style="
                                aspect-ratio: 1;
                                background: linear-gradient(
                                    135deg,
                                    #4facfe,
                                    #00f2fe
                                );
                                border-radius: var(--ss-radius-lg);
                            "
                        ></div>
                    </div>
                </div>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Form Modal #} {% set section_title = "Form Modal" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-modal"
            style="
                position: relative;
                max-width: 450px;
                background: var(--ss-color-surface);
                color: var(--ss-color-text);
                border-radius: var(--ss-radius-lg);
                box-shadow: var(--ss-a-shadow-lg);
            "
        >
            <div class="ss-c-modal--header" style="padding: 24px 24px 0">
                <h3 style="margin: 0 0 8px">Create Account</h3>
                <p style="margin: 0; font-size: 14px; opacity: 0.7">
                    Fill in your details to get started
                </p>
            </div>
            <form class="ss-c-modal--body" style="padding: 24px">
                <div style="margin-bottom: 16px">
                    <label
                        style="
                            display: block;
                            margin-bottom: 6px;
                            font-size: 14px;
                            font-weight: 500;
                        "
                    >
                        Full Name
                    </label>
                    <input
                        type="text"
                        placeholder="John Doe"
                        style="
                            width: 100%;
                            padding: 12px;
                            border: 1px solid var(--ss-color-border);
                            border-radius: var(--ss-radius-lg);
                            font-size: 14px;
                            box-sizing: border-box;
                        "
                    />
                </div>
                <div style="margin-bottom: 16px">
                    <label
                        style="
                            display: block;
                            margin-bottom: 6px;
                            font-size: 14px;
                            font-weight: 500;
                        "
                    >
                        Email
                    </label>
                    <input
                        type="email"
                        placeholder="john@example.com"
                        style="
                            width: 100%;
                            padding: 12px;
                            border: 1px solid var(--ss-color-border);
                            border-radius: var(--ss-radius-lg);
                            font-size: 14px;
                            box-sizing: border-box;
                        "
                    />
                </div>
                <div style="margin-bottom: 20px">
                    <label
                        style="
                            display: block;
                            margin-bottom: 6px;
                            font-size: 14px;
                            font-weight: 500;
                        "
                    >
                        Password
                    </label>
                    <input
                        type="password"
                        placeholder="••••••••"
                        style="
                            width: 100%;
                            padding: 12px;
                            border: 1px solid var(--ss-color-border);
                            border-radius: var(--ss-radius-lg);
                            font-size: 14px;
                            box-sizing: border-box;
                        "
                    />
                </div>
                <button
                    type="submit"
                    style="
                        width: 100%;
                        padding: 14px;
                        border: none;
                        background: var(--ss-color-accent);
                        color: var(--ss-color-on-accent);
                        border-radius: var(--ss-radius-lg);
                        cursor: pointer;
                        font-size: 15px;
                        font-weight: 500;
                    "
                >
                    Create Account
                </button>
            </form>
            <div
                class="ss-c-modal--footer"
                style="
                    padding: 16px 24px;
                    text-align: center;
                    border-top: 1px solid var(--ss-color-border);
                "
            >
                <p style="margin: 0; font-size: 14px; opacity: 0.7">
                    Already have an account?
                    <a href="#" style="color: var(--ss-color-accent)">
                        Sign in
                    </a>
                </p>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
