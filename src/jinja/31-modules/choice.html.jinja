{% extends "../base.html.jinja" %} {% set title = "Choice" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h2>{{ title }}</h2></header>
    <p>Examples for the <code>ss-c-choice</code> module.</p>
    <p>Label row pairing a checkbox or radio with its text.</p>

    {% set section_title = "Checkbox" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <label class="ss-c-choice">
            <input type="checkbox" class="ss-c-checkbox" /> Remember me
        </label>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Radio" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <label class="ss-c-choice">
            <input type="radio" name="demo-choice" class="ss-c-radio" checked /> Daily
        </label>
        <label class="ss-c-choice">
            <input type="radio" name="demo-choice" class="ss-c-radio" /> Weekly
        </label>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
