{% extends "../base.html.jinja" %} {% set title = "List Group" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>Examples for the <code>ss-c-list-group</code> module.</p>

    {% set section_title = "Default" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <ul class="ss-c-list-group">
            <li class="ss-c-list-group__item">An item</li>
            <li class="ss-c-list-group__item ss-c-list-group__item--active">An active item</li>
            <li class="ss-c-list-group__item">A third item</li>
            <li class="ss-c-list-group__item ss-c-list-group__item--disabled">A disabled item</li>
        </ul>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Variants" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <ul class="ss-c-list-group">
            <li class="ss-c-list-group__item ss-c-list-group__item--primary">Primary</li>
            <li class="ss-c-list-group__item ss-c-list-group__item--success">Success</li>
            <li class="ss-c-list-group__item ss-c-list-group__item--warning">Warning</li>
            <li class="ss-c-list-group__item ss-c-list-group__item--danger">Danger</li>
            <li class="ss-c-list-group__item ss-c-list-group__item--info">Info</li>
        </ul>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Flush" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <ul class="ss-c-list-group ss-c-list-group--flush">
            <li class="ss-c-list-group__item">No outer borders</li>
            <li class="ss-c-list-group__item">Just inner separators</li>
        </ul>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Numbered" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <ol class="ss-c-list-group ss-c-list-group--numbered">
            <li class="ss-c-list-group__item">First</li>
            <li class="ss-c-list-group__item">Second</li>
            <li class="ss-c-list-group__item">Third</li>
        </ol>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Horizontal" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <ul class="ss-c-list-group ss-c-list-group--horizontal">
            <li class="ss-c-list-group__item">Draft</li>
            <li class="ss-c-list-group__item ss-c-list-group__item--active">Review</li>
            <li class="ss-c-list-group__item">Published</li>
        </ul>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Custom markers" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        <p><code>data-marker</code> on an item draws its text as the marker.</p>
        {% set code_snippet %}
        <ul class="ss-c-list-group">
            <li class="ss-c-list-group__item" data-marker="✓">Completed task</li>
            <li class="ss-c-list-group__item" data-marker="→">In progress</li>
            <li class="ss-c-list-group__item" data-marker="○">Pending task</li>
        </ul>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
