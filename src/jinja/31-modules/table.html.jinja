{% extends "../base.html.jinja" %} {% set title = "Tables" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
    </header>

    {% set table_content %}
    <caption>This is a table caption, made with caption</caption>
    <colgroup></colgroup>
    <thead>
        <tr>
            <th>Table Header 1</th>
            <th>Table Header 2</th>
            <th>Table Header 3</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <td>Table Footer 1</td>
            <td>Table Footer 2</td>
            <td>Table Footer 3</td>
        </tr>
    </tfoot>
    <tbody>
        <tr>
            <td>TD 1.1</td>
            <td>TD 1.2</td>
            <td>TD 1.3</td>
        </tr>
        <tr>
            <td>TD 2.1</td>
            <td>TD 2.2</td>
            <td>TD 2.3</td>
        </tr>
        <tr>
            <td>TD 3.1</td>
            <td>TD 3.2</td>
            <td>TD 3.3</td>
        </tr>
    </tbody>
    {% endset %} {#
    ----------------------------------------------------------------------------
    Table Default
    ----------------------------------------------------------------------------
    #} {% set section_title = "Default Table" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <table class="ss-c-table">{{ table_content | safe }}</table>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Bordered, Striped & Hover" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <table class="ss-c-table ss-c-table--bordered ss-c-table--striped ss-c-table--hover">{{ table_content | safe }}</table>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Table Lined All
    ----------------------------------------------------------------------------
    #} {% set section_title = "Table Lined All" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <table class="ss-c-table--lined--all">{{ table_content | safe }}</table>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Table Lined Horizontal
    ----------------------------------------------------------------------------
    #} {% set section_title = "Table Lined Horizontal" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <table class="ss-c-table--lined--horizontal">
            {{ table_content | safe }}
        </table>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Table Lined Vertical
    ----------------------------------------------------------------------------
    #} {% set section_title = "Table Lined Vertical" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <table class="ss-c-table--lined--vertical">
            {{ table_content | safe }}
        </table>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Table Striped Horizontal
    ----------------------------------------------------------------------------
    #} {% set section_title = "Table Striped Horizontal" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <table class="ss-c-table--striped--horizontal">
            {{ table_content | safe }}
        </table>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Table Striped Vertical
    ----------------------------------------------------------------------------
    #} {% set section_title = "Table Striped Vertical" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <table class="ss-c-table--striped--vertical">
            {{ table_content | safe }}
        </table>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Table Size SM
    ----------------------------------------------------------------------------
    #} {% set section_title = "Table Size SM" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <table class="ss-c-table--striped--vertical ss-c-table--size--sm">
            {{ table_content | safe }}
        </table>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Table Collapsible
    ----------------------------------------------------------------------------
    #} {% set section_title = "Table Collapsible" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <div class="ss-c-collapsible_table">
            <div class="ss-c-collapsible_table--header">
                <span class="ss-c-collapsible_table--title">
                    Expandable Table Title
                </span>
                <button
                    class="active ss-c-flipper--down"
                    type="button"
                    aria-label="Toggle table"
                ></button>
            </div>

            <div class="ss-c-collapsible_table--content ss-c-collapse">
                <table class="ss-c-table--lined--horizontal">
                    {{ table_content | safe }}
                </table>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {#
    ----------------------------------------------------------------------------
    Data Table
    ----------------------------------------------------------------------------
    #} {% set section_title = "Data Table" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>

        {% set code_snippet %}
        <div class="ss-c-data_table">
            <div class="ss-c-data_table--header">
                <span class="ss-c-data_table--title">Data Table Title</span>
                <form role="search" class="ss-c-data_table--form" aria-label="Table search">
                    <button
                        class="ss-c-data_table--button"
                        type="submit"
                        aria-label="Search"
                    >
                        <svg aria-hidden="true" focusable="false" width="16" height="16" style="flex: none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>
                    </button>
                    <input
                        type="text"
                        class="ss-c-data_table--input"
                        placeholder="Search..."
                        aria-label="Search table"
                    />
                </form>
            </div>

            <table class="ss-c-table--lined--horizontal">
                {{ table_content | safe }}
            </table>

            <div class="ss-c-data_table--pagination">
                <ul class="ss-c-pagination ss-c-pagination--left">
                    <li><a href="#">Prev</a></li>
                    <li class="active"><a href="#">1</a></li>
                    <li><a href="#">2</a></li>
                    <li><a href="#">3</a></li>
                    <li><a href="#">Next</a></li>
                </ul>
            </div>
        </div>

        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Sortable header" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <table class="ss-c-table ss-c-table--hover" data-ss="table-sort">
            <caption>Repositories (select a column header to sort)</caption>
            <thead>
                <tr>
                    <th scope="col" aria-sort="ascending"><button class="ss-c-table__sort" type="button">Name</button></th>
                    <th scope="col" class="ss-c-table__cell--numeric" data-ss-sort-type="number"><button class="ss-c-table__sort" type="button">Size</button></th>
                    <th scope="col"><button class="ss-c-table__sort" type="button">Updated</button></th>
                    <th scope="col">Owner</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>sturnia-plot</td><td class="ss-c-table__cell--numeric" data-sort-value="18400">18.4 MB</td><td data-sort-value="2026-10-07">7 Oct</td><td>Starling</td></tr>
                <tr><td>sturnus-area</td><td class="ss-c-table__cell--numeric" data-sort-value="5200">5.2 MB</td><td data-sort-value="2026-09-30">30 Sep</td><td>Starling</td></tr>
                <tr><td>stylescape</td><td class="ss-c-table__cell--numeric" data-sort-value="41000">41.0 MB</td><td data-sort-value="2026-10-08">8 Oct</td><td>Scape Press</td></tr>
            </tbody>
        </table>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {%- endblock content %}
</section>
