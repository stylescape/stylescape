{% extends "../base.html.jinja" %} {% set title = "Blog Post" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>Article and blog post layouts for content presentation.</p>
    </header>



    {# Blog Post Basic #} {% set section_title = "Blog Post Basic" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <article class="ss-c-blogpost" style="max-width: 800px">
            <header class="ss-c-blogpost--header">
                <span
                    class="ss-c-chip"
                    style="
                        display: inline-block;
                        padding: 4px 12px;
                        background: var(--ss-color-surface-muted);
                        color: var(--ss-color-text);
                        border-radius: var(--ss-radius-xl);
                        font-size: 12px;
                        margin-bottom: 16px;
                    "
                >
                    Technology
                </span>
                <h3 style="margin: 0 0 12px">
                    Getting Started with CSS Custom Properties
                </h3>
                <div
                    class="ss-c-blogpost--meta"
                    style="
                        display: flex;
                        gap: 16px;
                        color: var(--ss-color-text-muted);
                        font-size: 14px;
                    "
                >
                    <span>By Jane Doe</span>
                    <span>•</span>
                    <time datetime="2024-01-15">January 15, 2024</time>
                    <span>•</span>
                    <span>5 min read</span>
                </div>
            </header>
            <div
                class="ss-c-blogpost--body"
                style="margin-top: 24px; line-height: 1.7"
            >
                <p>
                    Custom properties (sometimes referred to as CSS variables)
                    are entities defined by CSS authors that contain specific
                    values to be reused throughout a document.
                </p>
                <p>
                    They are set using custom property notation and are
                    accessed using the var() function.
                </p>
            </div>
        </article>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Blog Post with Featured Image #} {% set section_title = "Blog Post with
    Featured Image" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <article class="ss-c-blogpost" style="max-width: 800px">
            <figure
                class="ss-c-blogpost--featured-image"
                style="margin: 0 0 24px; border-radius: var(--ss-radius-lg); overflow: hidden"
            >
                <img
                    src="/img/placeholder/800x400.svg"
                    alt="Featured image"
                    style="width: 100%; display: block"
                />
                <figcaption
                    style="
                        padding: 12px;
                        background: var(--ss-color-surface-muted);
                        font-size: 14px;
                        color: var(--ss-color-text-muted);
                    "
                >
                    Photo by John Smith on Unsplash
                </figcaption>
            </figure>
            <header class="ss-c-blogpost--header">
                <h3 style="margin: 0 0 12px">
                    Building Modern Web Applications
                </h3>
                <div
                    class="ss-c-blogpost--meta"
                    style="
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        font-size: 14px;
                    "
                >
                    <img
                        src="/img/placeholder/40x40.svg"
                        alt="Author"
                        style="width: 40px; height: 40px; border-radius: 50%"
                    />
                    <div>
                        <div style="font-weight: 600">Alex Johnson</div>
                        <time datetime="2024-01-10" style="color: var(--ss-color-text-muted);">
                            January 10, 2024
                        </time>
                    </div>
                </div>
            </header>
            <div
                class="ss-c-blogpost--body"
                style="margin-top: 24px; line-height: 1.7"
            >
                <p>
                    Modern web development has evolved significantly over the
                    past decade. From simple static pages to complex
                    single-page applications, the landscape continues to
                    change.
                </p>
            </div>
        </article>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Blog Post Card List #} {% set section_title = "Blog Post Card List" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: grid; gap: 24px; max-width: 800px">
            <article
                class="ss-c-blogpost ss-c-card"
                style="display: flex; gap: 20px; padding: 20px"
            >
                <img
                    src="/img/placeholder/200x150.svg"
                    alt="Thumbnail"
                    style="
                        width: 200px;
                        height: 150px;
                        object-fit: cover;
                        border-radius: var(--ss-radius-lg);
                    "
                />
                <div style="flex: 1">
                    <span
                        style="
                            font-size: 12px;
                            text-transform: uppercase;
                            color: var(--ss-color-text-muted);
                        "
                    >
                        Design
                    </span>
                    <h3 style="margin: 8px 0">
                        Introduction to Design Systems
                    </h3>
                    <p style="color: var(--ss-color-text-muted); font-size: 14px; margin: 0 0 12px">
                        Learn how to build scalable and consistent design
                        systems...
                    </p>
                    <div style="font-size: 13px; color: var(--ss-color-text-muted);">
                        March 5, 2024 · 8 min read
                    </div>
                </div>
            </article>
            <article
                class="ss-c-blogpost ss-c-card"
                style="display: flex; gap: 20px; padding: 20px"
            >
                <img
                    src="/img/placeholder/200x150.svg"
                    alt="Thumbnail"
                    style="
                        width: 200px;
                        height: 150px;
                        object-fit: cover;
                        border-radius: var(--ss-radius-lg);
                    "
                />
                <div style="flex: 1">
                    <span
                        style="
                            font-size: 12px;
                            text-transform: uppercase;
                            color: var(--ss-color-text-muted);
                        "
                    >
                        Development
                    </span>
                    <h3 style="margin: 8px 0">React Hooks Deep Dive</h3>
                    <p style="color: var(--ss-color-text-muted); font-size: 14px; margin: 0 0 12px">
                        Understanding the power of React hooks for state
                        management...
                    </p>
                    <div style="font-size: 13px; color: var(--ss-color-text-muted);">
                        February 28, 2024 · 12 min read
                    </div>
                </div>
            </article>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Blog Post Footer #} {% set section_title = "Blog Post Footer" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <footer
            class="ss-c-blogpost--footer"
            style="
                max-width: 800px;
                padding-top: 24px;
                border-top: 1px solid var(--ss-color-border);
            "
        >
            <div
                style="
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    flex-wrap: wrap;
                    gap: 16px;
                "
            >
                <div class="ss-c-blogpost--tags" style="display: flex; gap: 8px">
                    <span
                        class="ss-c-chip"
                        style="
                            padding: 6px 14px;
                            background: var(--ss-color-surface-muted);
                            color: var(--ss-color-text);
                            border-radius: var(--ss-radius-2xl);
                            font-size: 13px;
                        "
                    >
                        #css
                    </span>
                    <span
                        class="ss-c-chip"
                        style="
                            padding: 6px 14px;
                            background: var(--ss-color-surface-muted);
                            color: var(--ss-color-text);
                            border-radius: var(--ss-radius-2xl);
                            font-size: 13px;
                        "
                    >
                        #webdev
                    </span>
                    <span
                        class="ss-c-chip"
                        style="
                            padding: 6px 14px;
                            background: var(--ss-color-surface-muted);
                            color: var(--ss-color-text);
                            border-radius: var(--ss-radius-2xl);
                            font-size: 13px;
                        "
                    >
                        #frontend
                    </span>
                </div>
                <div
                    class="ss-c-blogpost--share"
                    style="display: flex; gap: 12px; align-items: center"
                >
                    <span style="font-size: 14px; color: var(--ss-color-text-muted);">Share:</span>
                    <button
                        style="
                            padding: 8px 12px;
                            border: none;
                            background: #1478c2;
                            color: white;
                            border-radius: var(--ss-radius-md);
                            cursor: pointer;
                        "
                    >
                        Twitter
                    </button>
                    <button
                        style="
                            padding: 8px 12px;
                            border: none;
                            background: #0077b5;
                            color: white;
                            border-radius: var(--ss-radius-md);
                            cursor: pointer;
                        "
                    >
                        LinkedIn
                    </button>
                </div>
            </div>
            <div
                class="ss-c-blogpost--author-bio"
                style="
                    margin-top: 24px;
                    padding: 20px;
                    background: var(--ss-color-surface-muted);
                    border-radius: var(--ss-radius-lg);
                    display: flex;
                    gap: 16px;
                "
            >
                <img
                    src="/img/placeholder/80x80.svg"
                    alt="Author"
                    style="width: 80px; height: 80px; border-radius: 50%"
                />
                <div>
                    <h3 style="margin: 0 0 8px">About the Author</h3>
                    <p
                        style="
                            margin: 0;
                            color: var(--ss-color-text-muted);
                            font-size: 14px;
                            line-height: 1.6;
                        "
                    >
                        Jane is a senior developer with 10+ years of experience
                        in web technologies. She writes about CSS, JavaScript,
                        and web accessibility.
                    </p>
                </div>
            </div>
        </footer>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
