{% extends "../base.html.jinja" %} {% set title = "File Input" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h1>{{ title }}</h1></header>
    <p>Examples for the <code>ss-c-file-input</code> module.</p>

    {% set section_title = "Default" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <input type="file" class="ss-c-file-input" aria-label="Upload file">
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Sizes" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <input type="file" class="ss-c-file-input ss-c-file-input--xs" aria-label="Upload file (extra small)">
        <input type="file" class="ss-c-file-input ss-c-file-input--sm" aria-label="Upload file (small)">
        <input type="file" class="ss-c-file-input ss-c-file-input--lg" aria-label="Upload file (large)">
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Variants" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <input type="file" class="ss-c-file-input ss-c-file-input--primary" aria-label="Upload file (primary)">
        <input type="file" class="ss-c-file-input ss-c-file-input--success" aria-label="Upload file (success)">
        <input type="file" class="ss-c-file-input ss-c-file-input--error" aria-label="Upload file (error)">
        <input type="file" class="ss-c-file-input ss-c-file-input--bordered" aria-label="Upload file (bordered)">
        <input type="file" class="ss-c-file-input ss-c-file-input--ghost" aria-label="Upload file (ghost)">
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
