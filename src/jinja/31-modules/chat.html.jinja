{% extends "../base.html.jinja" %} {% set title = "Chat" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}
{% set user = "Donald D" %}
{% set user2 = "John Bravo" %}
{% set user3 = "Joey Tribbiani" %}
{% set user4 = "Red ranger" %}
{% set user5 = "blue ranger" %}
{% set user6 = "green ranger" %}
{% set user7 = "diamond ranger" %}

<header class="ss-c-demo__section__header">
  <h1>{{ title }}</h1>
  <p>Chat bubbles, message input, avatar indicators and floating action buttons.</p>
</header>



<section class="ss-c-bodychat_1">
  <div class="ss-c-theme_chat_left_1">
    <p class="ss-c-chat-message_left">Hello! How can I help you today?</p>
    <p class="ss-c-chat_time_1">10:00 AM</p>
    <p class="ss-c-chat_name_1">{{ user }}</p>
  </div>

  <div class="ss-c-theme_chat_right_1">
    <p class="ss-c-chat-message">Hi! I have a quick question about my order.</p>
    <p class="ss-c-chat_time_1">10:01 AM</p>
    <p class="ss-c-chat_name_2">{{ user2 }}</p>
  </div>

  <div class="ss-c-theme_chat_left_1">
    <p class="ss-c-chat-message_left">Sure, what seems to be the issue?</p>
    <p class="ss-c-chat_time_1">10:02 AM</p>
    <p class="ss-c-chat_name_1">{{ user }}</p>
  </div>

  <div class="ss-c-theme_chat_right_1">
    <p class="ss-c-chat-message">I haven’t received a confirmation email yet.</p>
    <p class="ss-c-chat_time_1">10:03 AM</p>
    <p class="ss-c-chat_name_2">{{ user2 }}</p>
  </div>

  <input type="text" class="ss-c-chat-input_delta" placeholder="Type your message here..." aria-label="Message" />
</section>

<section class="ss-c-themechat_2">
  <div class="ss-c-theme_chat_left_2">
    <p class="ss-c-chat-message_left">Hello! How can I help you today?</p>
    <p class="ss-c-chat_time_3">02:00 AM</p>
    <p class="ss-c-chat_name_3">Donald</p>
  </div>

  <div class="ss-c-theme_chat_right_2">
    <p class="ss-c-chat-message">Hi! I have a quick question about my order.</p>
    <p class="ss-c-chat_time_4">03:01 AM</p>
    <p class="ss-c-chat_name_4">Mark</p>
  </div>

  <div class="ss-c-theme_chat_left_2">
    <p class="ss-c-chat-message_left">Sure, what seems to be the issue?</p>
    <p class="ss-c-chat_time_3">03:02 AM</p>
    <p class="ss-c-chat_name_3">Donald</p>
  </div>

  <div class="ss-c-theme_chat_right_2">
    <p class="ss-c-chat-message">I haven’t received a confirmation email yet.</p>
    <p class="ss-c-chat_time_4">03:03 AM</p>
    <p class="ss-c-chat_name_4">Mark</p>
  </div>

  <input type="text" class="ss-c-chat-input_alpha" placeholder="Type your message here..." aria-label="Message" />
</section>



<section class="ss-c-themechat_3">

{% set myList = [
  {
    'name': user7,
    'message': "Hello! How can I help you today?"
  },
  {
    'name': user5,
    'message': "What have you done?"
  },
  {
    'name': user6,
    'message': "Wat did he do this time?"
  },
  {
    'name': user4,
    'message': "Now it was me! Dont blame him for my mistake"
  },
  {
    'name': user7,
    'message': "Blesphemy!!"
  },
  {
    'name': user5,
    'message': "If I had any idea, you think I would tell you?"
    }
] %}
{% set times = ["04:03 AM", "04:06 AM", "04:09 AM", "04:12 AM", "04:15 AM", "04:18 AM"] %}
{% set count = 0 %}
{% for chat in myList %}
  {% set count = count + 1 %}
  <div class="ss-c-theme_chat {% if count % 2 == 0 %}left{% else %}right{% endif %}" data-chat-message="{{ count }}">
    <p class="ss-c-chat_message">{{ chat.message }}</p>
    <p class="ss-c-chat_time">{{ times[loop.index0] }}</p>
    <p class="ss-c-chat_name">{{ chat.name }}</p>
  </div>
{% endfor %}
</section>

<section class="ss-c-themechat_4">
{% set myList2 = [
  {
    'name': user7,
    'message': "Hello! How can I help you today?"
  },
  {
    'name': user5,
    'message': "What have you done?"
  },
  {
    'name': user6,
    'message': "Wat did he do this time?"
  },
  {
    'name': user4,
    'message': "Now it was me! Dont blame him for my mistake"
  },
  {
    'name': user7,
    'message': "Blesphemy!!"
  },
  {
    'name': user5,
    'message': "If I had any idea, you think I would tell you?"
  }
] %}
{% set times2 = ["06:05 PM", "06:10 PM", "06:15 PM", "06:20 PM", "06:25 PM", "06:30 PM"] %}
{% set count2 = 0 %}
{% for chat in myList2 %}
  {% set count2 = count2 + 1 %}
  <div class="ss-c-theme_chat_4 {% if count2 % 2 == 0 %}left{% else %}right{% endif %}" data-chat-message="{{ count2 }}">
    <p class="ss-c-chat_message">{{ chat.message }}</p>
    <p class="ss-c-chat_time">{{ times2[loop.index0] }}</p>
    <p class="ss-c-chat_name">{{ chat.name }}</p>
  </div>
{% endfor %}
<input type="text" class="ss-c-chat-input_alpha" placeholder="Type your message here..." aria-label="Message" />
</section>


{% set section_title = "Working Section" %}
{% set section_items = ["Item 1", "Item 2", "Item 3"] %}
<section class="ss-c-workingsection">
  <header class="ss-c-workingsection_header">
    <h2 class="ss-c-workingsection_title">{{ section_title }}</h2>
  </header>
  <ol class="ss-c-workingsection_list">
    {% for item in section_items %}
    <li>{{ item }}</li>
    {% endfor %}
  </ol>
</section>



{% set avatar_section_title = "Avatar Indicators" %}
<section class="ss-c-avatar_indicators_body">
  <header class="ss-c-avatar_indicators_header">
    <h2 class="ss-c-avatar_indicators_title">{{ avatar_section_title }}</h2>
  </header>
  <div class="ss-c-avatar_indicators_example">
    <div class="ss-c-placeholder_indicator"></div>
  </div>
  <div class="ss-c-avatarsbody">
    <div class="ss-c-avatar_indicator ss-c-online"></div>
    <div class="ss-c-avatar_indicator ss-c-offline"></div>
    <div class="ss-c-avatar_indicator ss-c-busy"></div>
    <div class="ss-c-avatar_indicator ss-c-away"></div>
  </div>
</section>

{% set swap_icon_title = "Swap icons" %}
<section class="ss-c-swap_icons_body">
<header class="ss-c-swaps_icon_header">
    <h2 class="ss-c-swaps_icon_title">{{ swap_icon_title }}</h2>
</header>


<label class="ss-c-swap ss-c-swap--rotate">
  <input type="checkbox" aria-label="Mark as synced" />
  <span class="ss-c-swap__off" aria-hidden="true">⟳</span>
  <span class="ss-c-swap__on" aria-hidden="true">✓</span>
</label>
</section>



{% set speed_dial_robin_title = "Speed Dial" %}
<section class="ss-c-speed_dial_robin">
  <header class="ss-c-speed_dial_robin_header">
    <h2 class="ss-c-speed_dial_robin_title">{{ speed_dial_robin_title }}</h2>
  </header>
  <div style="display: grid; place-items: center; padding-block: 8rem">
    <div class="ss-c-fab ss-c-fab--radial" data-ss="fab">
      <button class="ss-c-fab__toggle" type="button" aria-label="Open actions" aria-expanded="false" aria-controls="chat-fab-actions">
        <span class="ss-c-fab__icon ss-c-fab__icon--open" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </span>
        <span class="ss-c-fab__icon ss-c-fab__icon--close" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </span>
      </button>
      <div class="ss-c-fab__actions" id="chat-fab-actions" role="group" aria-label="Quick actions">
        <button class="ss-c-fab__action" type="button" aria-label="New message">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </button>
        <button class="ss-c-fab__action" type="button" aria-label="Attach file">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4l6 16H6z" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </button>
        <button class="ss-c-fab__action" type="button" aria-label="Mute">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
        <button class="ss-c-fab__action" type="button" aria-label="Pin">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
        <button class="ss-c-fab__action" type="button" aria-label="Archive">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </button>
      </div>
    </div>
  </div>

</section>
<section class="ss-c-fab_corner" style="padding-block-start: 14rem">
<div class="ss-c-fab" data-ss="fab">
  <button class="ss-c-fab__toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="chat-dial-actions">
    <span class="ss-c-fab__icon ss-c-fab__icon--open" aria-hidden="true">M</span>
    <span class="ss-c-fab__icon ss-c-fab__icon--close" aria-hidden="true">×</span>
  </button>
  <div class="ss-c-fab__actions" id="chat-dial-actions" role="group" aria-label="Actions">
    <button class="ss-c-fab__action" type="button" aria-label="Action A">A</button>
    <button class="ss-c-fab__action" type="button" aria-label="Action B">B</button>
    <button class="ss-c-fab__action" type="button" aria-label="Action C">C</button>
    <button class="ss-c-fab__action" type="button" aria-label="Action D">D</button>
  </div>
</div>
</section>


{% endblock content %}


