  }
] %}
{% set times2 = ["06:05 PM", "06:10 PM", "06:15 PM", "06:20 PM", "06:25 PM", "06:30 PM"] %}
{% set count2 = 0 %}
{% for chat in myList2 %}
  {% set count2 = count2 + 1 %}
  <div class="ss-c-theme_chat_4 {% if count2 % 2 == 0 %}left{% else %}right{% endif %}" data-chat-message="{{ count2 }}">
