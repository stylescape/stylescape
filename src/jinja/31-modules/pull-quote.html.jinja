{% extends "../base.html.jinja" %} {% set title = "Pull Quote" %} {%- block title %}{{ title }}{%- endblock %} {%- block content %}
<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header"><h2>{{ title }}</h2></header>
    <p>Examples for the <code>ss-c-pull-quote</code> module.</p>

    {% set section_title = "Default" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <blockquote class="ss-c-pull-quote">
            <p class="ss-c-pull-quote__text">Design systems are products that serve products.</p>
            <footer class="ss-c-pull-quote__attribution">&mdash; Nathan Curtis</footer>
        </blockquote>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Elevated" %}
    <section class="ss-c-demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <blockquote class="ss-c-pull-quote ss-c-pull-quote--elevated">
            <p class="ss-c-pull-quote__text">Constraints liberate, freedom imprisons.</p>
            <footer class="ss-c-pull-quote__attribution">&mdash; Anonymous</footer>
        </blockquote>
        {% endset %} {% set language="HTML" %}
        {%- include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>
{%- endblock %}
