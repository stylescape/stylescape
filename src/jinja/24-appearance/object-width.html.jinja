{% extends "../base.html.jinja" %} {%- block title %}Width Utilities{%- endblock
%} {%- block content %} {#
============================================================================
Percentage Widths
============================================================================ #}
<section class="ss-c-demo__section" data-label="Percentage Widths" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Percentage Widths</h3>
        <p>Width utilities based on percentage values.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Common Percentages</h4>
        {% set code_snippet %}
        <div class="ss-c-w--100 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">100% width</div>
        <div class="ss-c-w--75 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">75% width</div>
        <div class="ss-c-w--50 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">50% width</div>
        <div class="ss-c-w--25 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">25% width</div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Auto Width</h4>
        {% set code_snippet %}
        <div class="ss-c-w--auto ss-c-bg--fill_02 ss-c-p--02 ss-c-d--inline-block">
            Auto width (fits content)
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Viewport Widths
============================================================================ #}
<section class="ss-c-demo__section" data-label="Viewport Widths" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Viewport Widths</h3>
        <p>Width utilities based on viewport dimensions.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Viewport Width Units</h4>
        {% set code_snippet %}
        <div class="ss-c-w--100vw ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            100vw - Full viewport width
        </div>
        <div class="ss-c-w--50vw ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            50vw - Half viewport width
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Fixed Widths
============================================================================ #}
<section class="ss-c-demo__section" data-label="Fixed Widths" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Fixed Widths</h3>
        <p>Width utilities with fixed pixel values.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Pixel Widths</h4>
        {% set code_snippet %}
        <div class="ss-c-w--64 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">64px</div>
        <div class="ss-c-w--128 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">128px</div>
        <div class="ss-c-w--256 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">256px</div>
        <div class="ss-c-w--512 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">512px</div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Min/Max Widths
============================================================================ #}
<section class="ss-c-demo__section" data-label="Min/Max Widths" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Min/Max Widths</h3>
        <p>Constrain element widths with minimum and maximum values.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Maximum Width</h4>
        {% set code_snippet %}
        <div class="ss-c-max-w--sm ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            Max width small (320px)
        </div>
        <div class="ss-c-max-w--md ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            Max width medium (640px)
        </div>
        <div class="ss-c-max-w--lg ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            Max width large (960px)
        </div>
        <div class="ss-c-max-w--full ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            Max width full (100%)
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Minimum Width</h4>
        {% set code_snippet %}
        <div class="ss-c-d--inline-block ss-c-min-w--100 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            Min 100px
        </div>
        <div class="ss-c-d--inline-block ss-c-min-w--200 ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            Min 200px
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Fit Content
============================================================================ #}
<section class="ss-c-demo__section" data-label="Fit Content" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Fit Content</h3>
        <p>Width that fits the content with constraints.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Fit Content Width</h4>
        {% set code_snippet %}
        <div class="ss-c-w--fit ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">Width fits content</div>
        <div class="ss-c-w--min ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            Minimum content width
        </div>
        <div class="ss-c-w--max ss-c-bg--fill_02 ss-c-p--02 ss-c-mb--02">
            Maximum content width
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
