{# ============================================================================
SCSS Mixin Reference
============================================================================ #}
<section class="ss-c-demo__section" data-label="SCSS Reference" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>SCSS Mixin Reference</h3>
        <p>Available mixins for use in custom SCSS.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Shape Variant Mixins</h4>
        {% set code_snippet %} // Token-based shape variants @include
        object--corner(squared); // border-radius: 0 @include
        object--corner(rounded); // border-radius: q(2) @include
        object--corner(pill); // border-radius: 50vh // Or use specific variant
        mixins @include object--corner--squared; @include
        object--corner--rounded; @include object--corner--pill; {% endset %} {%
        set language="SCSS" %} {% set show_preview=false %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Percentage Mixins</h4>
        {% set code_snippet %} @include object--corner--0; // border-radius: 0
        @include object--corner--50; // border-radius: 50% (circle) @include
        object--corner--100; // border-radius: 100% {% endset %} {% set
        language="SCSS" %} {% set show_preview=false %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Edge-Specific Mixins</h4>
        {% set code_snippet %} // Apply to edges (default: q(2)) @include
        object--corner--top($radius); // top-left + top-right @include
        object--corner--bottom($radius); // bottom-left + bottom-right @include
        object--corner--start($radius); // top-left + bottom-left @include
        object--corner--end($radius); // top-right + bottom-right {% endset %}
        {% set language="SCSS" %} {% set show_preview=false %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Individual Corner Mixins</h4>
        {% set code_snippet %} // Apply to single corners (default: q(2))
        @include object--corner--top-start($radius); // top-left @include
        object--corner--top-end($radius); // top-right @include
        object--corner--bottom-start($radius); // bottom-left @include
        object--corner--bottom-end($radius); // bottom-right {% endset %} {%
        set language="SCSS" %} {% set show_preview=false %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Custom Corners Mixin</h4>
        {% set code_snippet %} // Full control over each corner @include
        object--corner--custom( $top-left: q(4), $top-right: q(2),
        $bottom-right: q(4), $bottom-left: q(2) ); {% endset %} {% set
        language="SCSS" %} {% set show_preview=false %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Generic Radius Mixin</h4>
        {% set code_snippet %} // Apply any radius value with validation
        @include object--corner--radius(q(4)); @include
        object--corner--radius(16px); @include object--corner--radius(1em 2em);
        // horizontal / vertical {% endset %} {% set language="SCSS" %} {% set
        show_preview=false %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock %}
