{% extends "../base.html.jinja" %} {%- block title %}Corner Utilities{%- endblock
%} {%- block head %}
<style>
    /* Fill tokens sit very close to the preview surface in both themes;
       outline the demo boxes so their size/shape stays visible. */
    .ss-c-preview--vertical .ss-c-bg--fill_01,
    .ss-c-preview--vertical .ss-c-bg--fill_02 {
        outline: 1px solid var(--ss-color-border);
        outline-offset: -1px;
    }
</style>
{%- endblock %} {%- block content %}
<header class="ss-c-demo__section__header">
    <h1>Corner Utilities</h1>
    <p>Corner radius utilities: shape variants, percentages, edges and individual corners.</p>
</header>

{#
============================================================================
Shape Variants
============================================================================ #}
<section class="ss-c-demo__section" data-label="Shape Variants" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Shape Variants</h2>
        <p>Apply predefined border-radius shapes using utility classes.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Squared, Rounded &amp; Pill</h3>
        {% set code_snippet %}
        <div class="ss-c-flex--row ss-c-gap--04">
            <div
                class="ss-c-object--corner--squared ss-c-bg--fill_02 ss-c-p--04"
                style="
                width: 120px;
                height: 80px;
                border: 1px solid var(--ss-color-border);
                display: flex;
                align-items: center;
                justify-content: center;
            "
            >
                Squared
            </div>
            <div
                class="ss-c-object--corner--rounded ss-c-bg--fill_02 ss-c-p--04"
                style="
                width: 120px;
                height: 80px;
                border: 1px solid var(--ss-color-border);
                display: flex;
                align-items: center;
                justify-content: center;
            "
            >
                Rounded
            </div>
            <div
                class="ss-c-object--corner--pill ss-c-bg--fill_02 ss-c-p--04"
                style="
                width: 120px;
                height: 80px;
                border: 1px solid var(--ss-color-border);
                display: flex;
                align-items: center;
                justify-content: center;
            "
            >
                Pill
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Percentage Corners
============================================================================ #}
<section class="ss-c-demo__section" data-label="Percentage Corners" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Percentage Corners</h2>
        <p>Apply percentage-based border-radius for circular shapes.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Circle &amp; Ellipse Shapes</h3>
        {% set code_snippet %}
        <div class="ss-c-flex--row ss-c-gap--04 ss-c-align--center">
            <div
                class="ss-c-object--corner--0 ss-c-bg--fill_02 ss-c-p--04"
                style="width: 80px; height: 80px; border: 1px solid var(--ss-color-border)"
            >
                0%
            </div>
            <div
                class="ss-c-object--corner--50 ss-c-bg--fill_02 ss-c-p--04"
                style="width: 80px; height: 80px; border: 1px solid var(--ss-color-border)"
            >
                50%
            </div>
            <div
                class="ss-c-object--corner--100 ss-c-bg--fill_02 ss-c-p--04"
                style="width: 80px; height: 80px; border: 1px solid var(--ss-color-border)"
            >
                100%
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Edge-Specific Corners
============================================================================ #}
<section
    class="ss-c-demo__section"
    data-label="Edge-Specific Corners"
    data-level="1"
>
    <header class="ss-c-demo__section__header">
        <h2>Edge-Specific Corners</h2>
        <p>
            Apply border-radius to specific edges of an element (top, bottom,
            start, end).
        </p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Top Edge</h3>
        {% set code_snippet %}
        <div
            class="ss-c-object--corner--top ss-c-bg--fill_02 ss-c-p--04 ss-c-mb--04"
            style="width: 200px; border: 1px solid var(--ss-color-border)"
        >
            Rounded top corners only
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Bottom Edge</h3>
        {% set code_snippet %}
        <div
            class="ss-c-object--corner--bottom ss-c-bg--fill_02 ss-c-p--04 ss-c-mb--04"
            style="width: 200px; border: 1px solid var(--ss-color-border)"
        >
            Rounded bottom corners only
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Start Edge (Left)</h3>
        {% set code_snippet %}
        <div
            class="ss-c-object--corner--start ss-c-bg--fill_02 ss-c-p--04 ss-c-mb--04"
            style="width: 200px; border: 1px solid var(--ss-color-border)"
        >
            Rounded start (left) corners
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>End Edge (Right)</h3>
        {% set code_snippet %}
        <div
            class="ss-c-object--corner--end ss-c-bg--fill_02 ss-c-p--04 ss-c-mb--04"
            style="width: 200px; border: 1px solid var(--ss-color-border)"
        >
            Rounded end (right) corners
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Individual Corners
============================================================================ #}
<section class="ss-c-demo__section" data-label="Individual Corners" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Individual Corners</h2>
        <p>Apply border-radius to a single corner of an element.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Single Corner Variants</h3>
        {% set code_snippet %}
        <div class="ss-c-flex--row ss-c-gap--04 ss-c-flex--wrap">
            <div
                class="ss-c-object--corner--top-start ss-c-bg--fill_02 ss-c-p--04"
                style="
                width: 120px;
                height: 80px;
                border: 1px solid var(--ss-color-border);
                display: flex;
                align-items: center;
                justify-content: center;
            "
            >
                Top Start
            </div>
            <div
                class="ss-c-object--corner--top-end ss-c-bg--fill_02 ss-c-p--04"
                style="
                width: 120px;
                height: 80px;
                border: 1px solid var(--ss-color-border);
                display: flex;
                align-items: center;
                justify-content: center;
            "
            >
                Top End
            </div>
            <div
                class="ss-c-object--corner--bottom-start ss-c-bg--fill_02 ss-c-p--04"
                style="
                width: 120px;
                height: 80px;
                border: 1px solid var(--ss-color-border);
                display: flex;
                align-items: center;
                justify-content: center;
            "
            >
                Bottom Start
            </div>
            <div
                class="ss-c-object--corner--bottom-end ss-c-bg--fill_02 ss-c-p--04"
                style="
                width: 120px;
                height: 80px;
                border: 1px solid var(--ss-color-border);
                display: flex;
                align-items: center;
                justify-content: center;
            "
            >
                Bottom End
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Custom Combinations
============================================================================ #}
<section class="ss-c-demo__section" data-label="Custom Combinations" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Custom Combinations</h2>
        <p>Combine corner utilities to create unique shapes.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Diagonal Corners</h3>
        {% set code_snippet %}
        <div class="ss-c-flex--row ss-c-gap--04">
            <div
                class="ss-c-object--corner--top-start ss-c-object--corner--bottom-end ss-c-bg--fill_02 ss-c-p--04"
                style="
                width: 120px;
                height: 80px;
                border: 1px solid var(--ss-color-border);
                display: flex;
                align-items: center;
                justify-content: center;
            "
            >
                Diagonal ↘
            </div>
            <div
                class="ss-c-object--corner--top-end ss-c-object--corner--bottom-start ss-c-bg--fill_02 ss-c-p--04"
                style="
                width: 120px;
                height: 80px;
                border: 1px solid var(--ss-color-border);
                display: flex;
                align-items: center;
                justify-content: center;
            "
            >
                Diagonal ↙
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Card Header Pattern</h3>
        {% set code_snippet %}
        <div style="width: 280px">
            <div class="ss-c-object--corner--top ss-c-bg--primary ss-c-p--04" style="color: var(--ss-color-background)">
                Card Header
            </div>
            <div class="ss-c-bg--fill_01 ss-c-p--04 ss-c-border--01">
                Card content with squared bottom corners.
            </div>
            <div class="ss-c-object--corner--bottom ss-c-bg--fill_02 ss-c-p--04 ss-c-border--01">
                Card Footer
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Segmented Group Pattern</h3>
        <p>
            Rounding only the outer corners of a row of flush segments. (Buttons
            and form controls are square by design and keep radius 0.)
        </p>
        {% set code_snippet %}
        <div class="ss-c-flex--row">
            <div class="ss-c-object--corner--start ss-c-bg--fill_02 ss-c-p--04" style="border: 1px solid var(--ss-color-border-strong)">First</div>
            <div class="ss-c-object--corner--0 ss-c-bg--fill_02 ss-c-p--04" style="border: 1px solid var(--ss-color-border-strong); border-inline-width: 0">Middle</div>
            <div class="ss-c-object--corner--end ss-c-bg--fill_02 ss-c-p--04" style="border: 1px solid var(--ss-color-border-strong)">Last</div>
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Class Reference
============================================================================ #}
<section class="ss-c-demo__section" data-label="Class Reference" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Class Reference</h2>
        <p>
            Every corner class and the radius token it applies. Edge and corner
            classes use the default container radius
            (<code>--ss-radius-md</code>).
        </p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Shape &amp; Percentage Classes</h3>
        {% set code_snippet = [
            ".ss-c-object--corner--squared  /* border-radius: 0 */",
            ".ss-c-object--corner--0        /* border-radius: 0 */",
            ".ss-c-object--corner--50       /* border-radius: var(--ss-radius-sm) */",
            ".ss-c-object--corner--rounded  /* border-radius: var(--ss-radius-lg) */",
            ".ss-c-object--corner--100      /* border-radius: var(--ss-radius-full) */",
            ".ss-c-object--corner--pill     /* border-radius: var(--ss-radius-full) */"
        ] | join("\n") %} {% set language="CSS" %} {% set show_preview=false %}
        {% include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Edge &amp; Corner Classes</h3>
        {% set code_snippet = [
            ".ss-c-object--corner--top           /* top-left + top-right */",
            ".ss-c-object--corner--bottom        /* bottom-left + bottom-right */",
            ".ss-c-object--corner--start         /* top-left + bottom-left */",
            ".ss-c-object--corner--end           /* top-right + bottom-right */",
            ".ss-c-object--corner--top-start     /* top-left */",
            ".ss-c-object--corner--top-end       /* top-right */",
            ".ss-c-object--corner--bottom-start  /* bottom-left */",
            ".ss-c-object--corner--bottom-end    /* bottom-right */"
        ] | join("\n") %} {% set language="CSS" %} {% set show_preview=false %}
        {% include "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock %}
