{% extends "../base.html.jinja" %} {% set title = "Object | Padding" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {# -----------------------------------------------------------------------
    #} {# Padding All #} {#
    ----------------------------------------------------------------------- #}
    {% set section_title = "Padding All" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set sizes = ["xs","sm","md","lg","xl"] %} {% set code_snippet %}
        <div class="">
            {% for s in sizes %}
            <div class="ss-c-demo__box padding--{{ ss-c-s }}">
                <code>.padding--{{ s }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# -----------------------------------------------------------------------
    #} {# Padding Sides #} {#
    ----------------------------------------------------------------------- #}
    {% set section_title = "Padding Sides" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set sides = ["top","right","bottom","left"] %} {% set code_snippet
        %}
        <div class="">
            {% for side in sides %}
            <div class="ss-c-demo__box padding--md_{{ ss-c-side }}">
                <code>.padding--md_{{ side }}</code>
            </div>
            <div class="ss-c-demo__box padding--xl_{{ ss-c-side }}">
                <code>.padding--xl_{{ side }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# -----------------------------------------------------------------------
    #} {# Padding Axes #} {#
    ----------------------------------------------------------------------- #}
    {% set section_title = "Padding Axes" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set axes = ["vertical","horizontal"] %} {% set code_snippet %}
        <div class="">
            {% for axis in axes %}
            <div class="ss-c-demo__box padding--sm_{{ ss-c-axis }}">
                <code>.padding--sm_{{ axis }}</code>
            </div>
            <div class="ss-c-demo__box padding--md_{{ ss-c-axis }}">
                <code>.padding--md_{{ axis }}</code>
            </div>
            <div class="ss-c-demo__box padding--xl_{{ ss-c-axis }}">
                <code>.padding--xl_{{ axis }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# -----------------------------------------------------------------------
    #} {# Mixed Examples (quick sanity check) #} {#
    ----------------------------------------------------------------------- #}
    {% set section_title = "Mixed Examples" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {% set code_snippet %}
        <div class="ss-c-demo__stack">
            <div class="ss-c-demo__box ss-c-padding--md">
                <code>.padding--md</code>
            </div>
            <div class="ss-c-demo__box ss-c-padding--md_vertical">
                <code>.padding--md_vertical</code>
            </div>
            <div class="ss-c-demo__box ss-c-padding--sm_horizontal">
                <code>.padding--sm_horizontal</code>
            </div>
            <div class="ss-c-demo__box ss-c-padding--lg_left">
                <code>.padding--lg_left</code>
            </div>
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# -----------------------------------------------------------------------
    #} {# Numeric Padding (1–1000) #} {#
    ----------------------------------------------------------------------- #}
    {% set section_title = "Numeric Padding (q: 1–1000)" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>

        {# sample set to keep preview compact; adjust as needed #} {% set nums
        = [1, 4, 8, 12, 16, 24, 32, 48, 64] %} {# All #} {% set sub_title =
        "All Sides" %}
        <h4>{{ sub_title }}</h4>
        {% set code_snippet %}
        <div class="">
            {% for n in nums %}
            <div class="ss-c-demo__box padding--{{ ss-c-n }}">
                <code>.padding--{{ n }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %} {# Sides #} {% set
        sub_title = "Sides" %}
        <h4>{{ sub_title }}</h4>
        {% set code_snippet %}
        <div class="">
            {% for side in ["top","right","bottom","left"] %}
            <div class="ss-c-demo__box padding--24_{{ ss-c-side }}">
                <code>.padding--24_{{ side }}</code>
            </div>
            <div class="ss-c-demo__box padding--48_{{ ss-c-side }}">
                <code>.padding--48_{{ side }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %} {# Axes #} {% set
        sub_title = "Axes" %}
        <h4>{{ sub_title }}</h4>
        {% set code_snippet %}
        <div class="">
            {% for axis in ["vertical","horizontal"] %}
            <div class="ss-c-demo__box padding--12_{{ ss-c-axis }}">
                <code>.padding--12_{{ axis }}</code>
            </div>
            <div class="ss-c-demo__box padding--32_{{ ss-c-axis }}">
                <code>.padding--32_{{ axis }}</code>
            </div>
            <div class="ss-c-demo__box padding--64_{{ ss-c-axis }}">
                <code>.padding--64_{{ axis }}</code>
            </div>
            {% endfor %}
        </div>
        {% endset %} {% set language = "HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
