{% extends "../base.html.jinja" %} {%- block title %}Border Utilities{%- endblock
%} {%- block content %} {#
============================================================================
Border Styles
============================================================================ #}
<section class="ss-c-demo__section" data-label="Border Styles" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Border Styles</h3>
        <p>Different border line styles.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Style Variations</h4>
        {% set code_snippet %}
        <div class="ss-c-border--solid ss-c-p--04 ss-c-mb--02">Solid border</div>
        <div class="ss-c-border--dashed ss-c-p--04 ss-c-mb--02">Dashed border</div>
        <div class="ss-c-border--dotted ss-c-p--04 ss-c-mb--02">Dotted border</div>
        <div class="ss-c-border--double ss-c-p--04 ss-c-mb--02">Double border</div>
        <div class="ss-c-border--none ss-c-p--04 ss-c-mb--02 ss-c-bg--fill_02">No border</div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Border Widths
============================================================================ #}
<section class="ss-c-demo__section" data-label="Border Widths" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Border Widths</h3>
        <p>Control border thickness with width utilities.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Width Variations</h4>
        {% set code_snippet %}
        <div class="ss-c-border--solid ss-c-border--w--01 ss-c-p--04 ss-c-mb--02">
            Border width 1px
        </div>
        <div class="ss-c-border--solid ss-c-border--w--02 ss-c-p--04 ss-c-mb--02">
            Border width 2px
        </div>
        <div class="ss-c-border--solid ss-c-border--w--03 ss-c-p--04 ss-c-mb--02">
            Border width 3px
        </div>
        <div class="ss-c-border--solid ss-c-border--w--04 ss-c-p--04 ss-c-mb--02">
            Border width 4px
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Border Sides
============================================================================ #}
<section class="ss-c-demo__section" data-label="Border Sides" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Border Sides</h3>
        <p>Apply borders to specific sides of an element.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Individual Sides</h4>
        {% set code_snippet %}
        <div class="ss-c-border--top ss-c-p--04 ss-c-mb--02">Border top only</div>
        <div class="ss-c-border--right ss-c-p--04 ss-c-mb--02">Border right only</div>
        <div class="ss-c-border--bottom ss-c-p--04 ss-c-mb--02">Border bottom only</div>
        <div class="ss-c-border--left ss-c-p--04 ss-c-mb--02">Border left only</div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Axis Borders</h4>
        {% set code_snippet %}
        <div class="ss-c-border--x ss-c-p--04 ss-c-mb--02">
            Border left and right (x-axis)
        </div>
        <div class="ss-c-border--y ss-c-p--04 ss-c-mb--02">
            Border top and bottom (y-axis)
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Border Radius
============================================================================ #}
<section class="ss-c-demo__section" data-label="Border Radius" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Border Radius</h3>
        <p>Round the corners of elements.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Radius Sizes</h4>
        {% set code_snippet %}
        <div class="ss-c-border--solid ss-c-rounded--00 ss-c-p--04 ss-c-mb--02 ss-c-d--inline-block">
            No radius (sharp)
        </div>
        <div class="ss-c-border--solid ss-c-rounded--01 ss-c-p--04 ss-c-mb--02 ss-c-d--inline-block">
            Small radius
        </div>
        <div class="ss-c-border--solid ss-c-rounded--02 ss-c-p--04 ss-c-mb--02 ss-c-d--inline-block">
            Medium radius
        </div>
        <div class="ss-c-border--solid ss-c-rounded--03 ss-c-p--04 ss-c-mb--02 ss-c-d--inline-block">
            Large radius
        </div>
        <div class="ss-c-border--solid ss-c-rounded--full ss-c-p--04 ss-c-mb--02 ss-c-d--inline-block">
            Full radius (pill)
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Corner-Specific Radius</h4>
        {% set code_snippet %}
        <div class="ss-c-border--solid ss-c-rounded--top ss-c-p--04 ss-c-mb--02">
            Rounded top corners
        </div>
        <div class="ss-c-border--solid ss-c-rounded--bottom ss-c-p--04 ss-c-mb--02">
            Rounded bottom corners
        </div>
        <div class="ss-c-border--solid ss-c-rounded--left ss-c-p--04 ss-c-mb--02">
            Rounded left corners
        </div>
        <div class="ss-c-border--solid ss-c-rounded--right ss-c-p--04 ss-c-mb--02">
            Rounded right corners
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Circle</h4>
        {% set code_snippet %}
        <div
            class="ss-c-border--solid ss-c-rounded--circle ss-c-w--64 ss-c-h--64 ss-c-d--flex ss-c-align-items--center ss-c-justify-content--center"
        >
            Circle
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Border Colors
============================================================================ #}
<section class="ss-c-demo__section" data-label="Border Colors" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Border Colors</h3>
        <p>Apply semantic and custom colors to borders.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Semantic Colors</h4>
        {% set code_snippet %}
        <div class="ss-c-border--solid ss-c-border--primary ss-c-p--04 ss-c-mb--02">
            Primary border color
        </div>
        <div class="ss-c-border--solid ss-c-border--secondary ss-c-p--04 ss-c-mb--02">
            Secondary border color
        </div>
        <div class="ss-c-border--solid ss-c-border--success ss-c-p--04 ss-c-mb--02">
            Success border color
        </div>
        <div class="ss-c-border--solid ss-c-border--warning ss-c-p--04 ss-c-mb--02">
            Warning border color
        </div>
        <div class="ss-c-border--solid ss-c-border--danger ss-c-p--04 ss-c-mb--02">
            Danger border color
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
