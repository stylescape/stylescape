{% extends "../base.html.jinja" %} {%- block title %}Shadow Utilities{%- endblock
%} {%- block content %} {#
============================================================================
Box Shadows
============================================================================ #}
<section class="ss-c-demo__section" data-label="Box Shadows" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Box Shadows</h3>
        <p>Add depth to elements with box shadow utilities.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Shadow Sizes</h4>
        {% set code_snippet %}
        <div class="ss-c-shadow--none ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">No shadow</div>
        <div class="ss-c-shadow--sm ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">Small shadow</div>
        <div class="ss-c-shadow--md ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">Medium shadow</div>
        <div class="ss-c-shadow--lg ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">Large shadow</div>
        <div class="ss-c-shadow--xl ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">
            Extra large shadow
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Elevation Shadows
============================================================================ #}
<section class="ss-c-demo__section" data-label="Elevation" data-level="1">
    <header class="ss-c-demo__section__header">
