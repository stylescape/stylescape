        <p>Material design style elevation levels.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Elevation Levels</h4>
        {% set code_snippet %}
        <div class="ss-c-elevation--01 ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">
            Elevation 1 (cards)
        </div>
        <div class="ss-c-elevation--02 ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">
            Elevation 2 (raised cards)
        </div>
        <div class="ss-c-elevation--03 ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">
            Elevation 3 (drawers)
        </div>
        <div class="ss-c-elevation--04 ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">
            Elevation 4 (dialogs)
        </div>
        <div class="ss-c-elevation--05 ss-c-bg--fill_01 ss-c-p--04 ss-c-mb--04">
            Elevation 5 (modals)
        </div>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

