{% extends "base.html.jinja" %}
{%- block title %}Breadcrumb{%- endblock %}
{%- block content %}

{# ============================================================================
   Basic Breadcrumb
   ============================================================================ #}
<section class="demo__section" data-label="Basic Breadcrumb" data-level="1">
    <header class="demo__section__header">
        <h3>Basic Breadcrumb</h3>
        <p>Navigation trail showing the user's location in the site hierarchy.</p>
    </header>

    <section class="demo__subsection">
        <h4>Simple Breadcrumb</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item"><a href="#">Products</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Category</li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Deep Navigation</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item"><a href="#">Documentation</a></li>
        <li class="breadcrumb__item"><a href="#">Components</a></li>
        <li class="breadcrumb__item"><a href="#">Navigation</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Breadcrumb</li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Breadcrumb Separators
   ============================================================================ #}
<section class="demo__section" data-label="Separators" data-level="1">
    <header class="demo__section__header">
        <h3>Breadcrumb Separators</h3>
        <p>Different separator styles between breadcrumb items.</p>
    </header>

    <section class="demo__subsection">
        <h4>Slash Separator (Default)</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb breadcrumb--slash">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item"><a href="#">Section</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Page</li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Arrow Separator</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb breadcrumb--arrow">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item"><a href="#">Section</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Page</li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Chevron Separator</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb breadcrumb--chevron">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item"><a href="#">Section</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Page</li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Dot Separator</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb breadcrumb--dot">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item"><a href="#">Section</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Page</li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Breadcrumb with Icons
   ============================================================================ #}
<section class="demo__section" data-label="With Icons" data-level="1">
    <header class="demo__section__header">
        <h3>Breadcrumb with Icons</h3>
        <p>Enhanced breadcrumbs with icon elements.</p>
    </header>

    <section class="demo__subsection">
        <h4>Home Icon</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb__item">
            <a href="#" aria-label="Home">
                <span class="breadcrumb__icon">🏠</span>
            </a>
        </li>
        <li class="breadcrumb__item"><a href="#">Products</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Details</li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Icons on All Items</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb__item">
            <a href="#">
                <span class="breadcrumb__icon">🏠</span>
                <span>Home</span>
            </a>
        </li>
        <li class="breadcrumb__item">
            <a href="#">
                <span class="breadcrumb__icon">📁</span>
                <span>Folder</span>
            </a>
        </li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">
            <span class="breadcrumb__icon">📄</span>
            <span>File</span>
        </li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Collapsed Breadcrumb
   ============================================================================ #}
<section class="demo__section" data-label="Collapsed" data-level="1">
    <header class="demo__section__header">
        <h3>Collapsed Breadcrumb</h3>
        <p>Truncated breadcrumbs for long navigation paths.</p>
    </header>

    <section class="demo__subsection">
        <h4>Ellipsis Collapse</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--collapsed">
            <button class="breadcrumb__expand" aria-label="Show hidden items">...</button>
        </li>
        <li class="breadcrumb__item"><a href="#">Parent</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Current</li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Breadcrumb Sizes
   ============================================================================ #}
<section class="demo__section" data-label="Sizes" data-level="1">
    <header class="demo__section__header">
        <h3>Breadcrumb Sizes</h3>
        <p>Different size variations.</p>
    </header>

    <section class="demo__subsection">
        <h4>Size Variations</h4>
        {% set code_snippet %}
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb breadcrumb--sm">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Small</li>
    </ol>
</nav>

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Default</li>
    </ol>
</nav>

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb breadcrumb--lg">
        <li class="breadcrumb__item"><a href="#">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Large</li>
    </ol>
</nav>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
