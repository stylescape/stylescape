{% extends "../base.html.jinja" %} {%- block title %}Paragraph Headings{%-
endblock %} {%- block content %} {#
============================================================================
Heading Hierarchy
============================================================================ #}
<section class="demo__section" data-label="Heading Hierarchy" data-level="1">
    <header class="demo__section__header">
        <h3>Heading Hierarchy</h3>
        <p>
            HTML provides six levels of headings (h1-h6) for document structure
            and semantic hierarchy.
        </p>
    </header>

    <section class="demo__subsection">
        <h4>All Heading Levels</h4>
        <p>
            Each heading level represents a different level of importance and
            hierarchy.
        </p>
        {% set code_snippet %}
        <h1>Heading Level 1</h1>
        <h2>Heading Level 2</h2>
        <h3>Heading Level 3</h3>
        <h4>Heading Level 4</h4>
        <h5>Heading Level 5</h5>
        <h6>Heading Level 6</h6>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Heading Group (hgroup)</h4>
        <p>
            Use hgroup to semantically group a heading with related content
            like subtitles.
        </p>
        {% set code_snippet %}
        <hgroup>
            <h1>Main Title</h1>
            <p>Supporting tagline or subtitle</p>
        </hgroup>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Headings with Paragraphs
============================================================================ #}
<section
    class="demo__section"
    data-label="Headings with Content"
    data-level="1"
>
    <header class="demo__section__header">
        <h3>Headings with Content</h3>
        <p>
            Headings paired with body text demonstrate visual hierarchy in real
            content.
        </p>
    </header>

    <section class="demo__subsection">
        <h4>Article Structure</h4>
        {% set code_snippet %}
        <article>
            <h1>Article Title (H1)</h1>
            <p>
                This is the introduction paragraph. Lorem ipsum dolor sit amet,
                consectetur adipiscing elit.
            </p>

            <h2>Section Heading (H2)</h2>
            <p>
                This section covers the main topic. Quisque aliquam libero
                nisi, imperdiet at tincidunt nec.
            </p>

            <h3>Subsection Heading (H3)</h3>
            <p>
                Diving deeper into the topic. Praesent mattis massa quis luctus
                fermentum.
            </p>

            <h4>Detail Heading (H4)</h4>
            <p>
                Specific details and information. Maecenas ornare tortor sed
                tellus eget sapien.
            </p>
        </article>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Headings with Subtitles
============================================================================ #}
<section
    class="demo__section"
    data-label="Headings with Subtitles"
    data-level="1"
>
    <header class="demo__section__header">
        <h3>Headings with Subtitles</h3>
        <p>Add supporting text to headings using the subtitle class.</p>
    </header>

    <section class="demo__subsection">
        <h4>Subtitle Examples</h4>
        {% set code_snippet %}
        <h1>
            Primary Header
            <small class="subtitle">Supporting subtitle</small>
        </h1>
        <h2>
            Secondary Header
            <small class="subtitle">Additional context</small>
        </h2>
        <h3>
            Tertiary Header
            <small class="subtitle">Brief description</small>
        </h3>
        <h4>
            Quaternary Header
            <small class="subtitle">Extra details</small>
        </h4>
        <h5>
            Quinary Header
            <small class="subtitle">Minor note</small>
        </h5>
        <h6>
            Senary Header
            <small class="subtitle">Smallest level</small>
        </h6>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Semantic Heading Names
============================================================================ #}
<section class="demo__section" data-label="Semantic Names" data-level="1">
    <header class="demo__section__header">
        <h3>Semantic Heading Names</h3>
        <p>The official names for each heading level in document hierarchy.</p>
    </header>

    <section class="demo__subsection">
        <h4>Heading Level Names</h4>
        {% set code_snippet %}
        <h1>Primary (H1) — Page title, one per page</h1>
        <h2>Secondary (H2) — Major sections</h2>
        <h3>Tertiary (H3) — Subsections</h3>
        <h4>Quaternary (H4) — Sub-subsections</h4>
        <h5>Quinary (H5) — Fine details</h5>
        <h6>Senary (H6) — Rarely used, deepest level</h6>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
