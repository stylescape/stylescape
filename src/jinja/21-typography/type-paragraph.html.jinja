{% extends "../base.html.jinja" %} {%- block title %}Paragraphs{%- endblock %} {%-
block content %} {#
============================================================================
Basic Paragraphs
============================================================================ #}
<section class="ss-c-demo__section" data-label="Basic Paragraphs" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Basic Paragraphs</h3>
        <p>Standard paragraph elements for body text content.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Single Paragraph</h4>
        {% set code_snippet %}
        <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis
            tincidunt diam sed tellus vehicula, non ultrices ligula egestas.
            Integer vitae dictum nisi, at efficitur nisi. Sed lorem leo,
            malesuada et nunc ut, vulputate vehicula orci.
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Multiple Paragraphs</h4>
        {% set code_snippet %}
        <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis
            tincidunt diam sed tellus vehicula, non ultrices ligula egestas.
            Integer vitae dictum nisi, at efficitur nisi.
        </p>
        <p>
            Etiam ultrices auctor dolor quis ultricies. Fusce nec laoreet est.
            Aenean ut tortor auctor leo ultrices mattis vitae sit amet diam.
            Morbi in commodo libero.
        </p>
        <p>
            Vestibulum at eros nec ligula dictum dignissim. Vestibulum sodales
            tortor ut nisl bibendum, at fringilla mi egestas. Proin elementum
            nibh urna, a dictum diam tincidunt et.
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Inline Text Elements
============================================================================ #}
<section class="ss-c-demo__section" data-label="Inline Elements" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Inline Text Elements</h3>
        <p>Special inline elements that can be used within paragraphs.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Superscript & Subscript</h4>
        {% set code_snippet %}
        <p>
            Water is H
            <sub>2</sub>
            O and the equation is E = mc
            <sup>2</sup>
            .
        </p>
        <p>
            The 1
            <sup>st</sup>
            of January, 2
            <sup>nd</sup>
            of February, 3
            <sup>rd</sup>
            of March.
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Citations & Abbreviations</h4>
        {% set code_snippet %}
        <p>
            According to
            <cite>The Design of Everyday Things</cite>
            by Don Norman, good design is invisible. The
            <abbr title="User Experience">UX</abbr>
            should be seamless.
        </p>
        <p>
            The
            <abbr title="Cascading Style Sheets">CSS</abbr>
            specification is maintained by the
            <abbr title="World Wide Web Consortium">W3C</abbr>
            .
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Mark & Highlight</h4>
        {% set code_snippet %}
        <p>
            You can
            <mark>highlight important text</mark>
            within a paragraph to draw attention to key information.
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Text Formatting
============================================================================ #}
<section class="ss-c-demo__section" data-label="Text Formatting" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Text Formatting</h3>
        <p>Emphasis, strong text, and other formatting options.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Emphasis & Strong</h4>
        {% set code_snippet %}
        <p>
            Use
            <em>emphasis</em>
            for stress emphasis and
            <strong>strong</strong>
            for important content. You can also
            <em><strong>combine both</strong></em>
            .
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Small Text</h4>
        {% set code_snippet %}
        <p>
            Regular text
            <small>
                with small text for side comments, disclaimers, or legal text
            </small>
            .
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Strikethrough & Insert</h4>
        {% set code_snippet %}
        <p>
            The price is
            <del>$99</del>
            <ins>$79</ins>
            (20% off!).
        </p>
        <p>
            <s>This information is no longer accurate.</s>
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Code & Keyboard
============================================================================ #}
<section class="ss-c-demo__section" data-label="Code & Keyboard" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Code & Keyboard</h3>
        <p>Inline code and keyboard shortcut styling.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Inline Code</h4>
        {% set code_snippet %}
        <p>
            Use the
            <code>console.log()</code>
            function to debug JavaScript. Variables like
            <code>const</code>
            and
            <code>let</code>
            are block-scoped.
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Keyboard Shortcuts</h4>
        {% set code_snippet %}
        <p>
            Press
            <kbd>Cmd</kbd>
            +
            <kbd>S</kbd>
            to save on Mac, or
            <kbd>Ctrl</kbd>
            +
            <kbd>S</kbd>
            on Windows.
        </p>
        <p>
            Use
            <kbd>Cmd</kbd>
            +
            <kbd>Shift</kbd>
            +
            <kbd>P</kbd>
            to open the command palette.
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Sample Output</h4>
        {% set code_snippet %}
        <p>
            The command returned:
            <samp>Operation completed successfully.</samp>
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Lead & Drop Cap
============================================================================ #}
<section class="ss-c-demo__section" data-label="Special Styles" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Special Paragraph Styles</h3>
        <p>Special paragraph treatments for articles and editorial content.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Lead Paragraph</h4>
        {% set code_snippet %}
        <p class="lead">
            This is a lead paragraph with larger text that introduces an
            article or section. It helps draw readers into the content.
        </p>
        <p>
            Regular paragraphs follow with standard text size. Lorem ipsum
            dolor sit amet, consectetur adipiscing elit.
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Drop Cap</h4>
        {% set code_snippet %}
        <p class="ss-c-dropcap">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis
            tincidunt diam sed tellus vehicula, non ultrices ligula egestas.
            Integer vitae dictum nisi, at efficitur nisi. Sed lorem leo,
            malesuada et nunc ut.
        </p>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
