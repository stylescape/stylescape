        %} {%- include "includes/preview/ss-c-preview_font.html.jinja" %} {% set
        label = ".ss-t-char-smallcaps" %} {% set class =
        "ss-t-char-smallcaps" %} {%- include
        "includes/preview/ss-c-preview_font.html.jinja" %} {% set label =
        ".ss-t-char-smallcaps" %} {% set class =
        "ss-t-char-smallcaps" %} {%- include
        "includes/preview/ss-c-preview_font.html.jinja" %} {% set label =
        ".ss-t-char-uppercase" %} {% set class = "ss-t-char-uppercase" %} {%-
        include "includes/preview/ss-c-preview_font.html.jinja" %} {% set label
        = ".ss-t-char-uppercase" %} {% set class = "ss-t-char-uppercase"
        %} {%- include "includes/preview/ss-c-preview_font.html.jinja" %} {% set
