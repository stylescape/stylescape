{% extends "../base.html.jinja" %} {%- block title %}Lists{%- endblock %} {%-
block content %} {#
============================================================================
Unordered Lists
============================================================================ #}
<section class="ss-c-demo__section" data-label="Unordered Lists" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Unordered Lists</h3>
        <p>Bullet point lists for unordered content.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Basic Unordered List</h4>
        {% set code_snippet %}
        <ul>
            <li>First item</li>
            <li>Second item</li>
            <li>Third item</li>
            <li>Fourth item</li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Nested Unordered List</h4>
        {% set code_snippet %}
        <ul>
            <li>Coffee</li>
            <li>
                Tea
                <ul>
                    <li>
                        Black tea
                        <ul>
                            <li>Earl Grey</li>
                            <li>English Breakfast</li>
                        </ul>
                    </li>
                    <li>Green tea</li>
                    <li>Herbal tea</li>
                </ul>
            </li>
            <li>Milk</li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Ordered Lists
============================================================================ #}
<section class="ss-c-demo__section" data-label="Ordered Lists" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Ordered Lists</h3>
        <p>Numbered lists for sequential content.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Basic Ordered List</h4>
        {% set code_snippet %}
        <ol>
            <li>First step</li>
            <li>Second step</li>
            <li>Third step</li>
            <li>Fourth step</li>
        </ol>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Starting Number</h4>
        {% set code_snippet %}
        <ol start="5">
            <li>This is item five</li>
            <li>This is item six</li>
            <li>This is item seven</li>
        </ol>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Reversed Order</h4>
        {% set code_snippet %}
        <ol reversed>
            <li>Third place</li>
            <li>Second place</li>
            <li>First place</li>
        </ol>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Nested Ordered List</h4>
        {% set code_snippet %}
        <ol>
            <li>
                Chapter One
                <ol>
                    <li>Section 1.1</li>
                    <li>
                        Section 1.2
                        <ol>
                            <li>Subsection 1.2.1</li>
                            <li>Subsection 1.2.2</li>
                        </ol>
                    </li>
                </ol>
            </li>
            <li>Chapter Two</li>
            <li>Chapter Three</li>
        </ol>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Definition Lists
============================================================================ #}
<section class="ss-c-demo__section" data-label="Definition Lists" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Definition Lists</h3>
        <p>Term and definition pairs for glossaries and descriptions.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Basic Definition List</h4>
        {% set code_snippet %}
        <dl>
            <dt>HTML</dt>
            <dd>
                HyperText Markup Language - the standard markup language for
                web pages.
            </dd>

            <dt>CSS</dt>
            <dd>
                Cascading Style Sheets - a style sheet language for describing
                presentation.
            </dd>

            <dt>JavaScript</dt>
            <dd>A programming language that enables interactive web pages.</dd>
        </dl>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Multiple Definitions</h4>
        {% set code_snippet %}
        <dl>
            <dt>Recursion</dt>
            <dd>See recursion.</dd>
            <dd>
                A method where the solution depends on solutions to smaller
                instances of the same problem.
            </dd>

            <dt>Term</dt>
            <dt>Word</dt>
            <dd>
                A word or expression with a specific meaning in a particular
                context.
            </dd>
        </dl>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Mixed Lists
============================================================================ #}
<section class="ss-c-demo__section" data-label="Mixed Lists" data-level="1">
    <header class="ss-c-demo__section__header">
        <h3>Mixed Lists</h3>
        <p>Combining different list types.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h4>Unordered with Ordered Nested</h4>
        {% set code_snippet %}
        <ul>
            <li>
                Unordered item
                <ol>
                    <li>Ordered sub-item one</li>
                    <li>Ordered sub-item two</li>
                </ol>
            </li>
            <li>Another unordered item</li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h4>Ordered with Unordered Nested</h4>
        {% set code_snippet %}
        <ol>
            <li>
                First main item
                <ul>
                    <li>Supporting point</li>
                    <li>Another supporting point</li>
                </ul>
            </li>
            <li>Second main item</li>
        </ol>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
