{% extends "../base.html.jinja" %} {% set title = "Fonts" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% set preview_text="The quick brown fox jumps over the lazy dog.
    0123456789" %} {% set section_title = "Font Overview" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div>
            <p class="ss-font-sans">
                {{ preview_text|default('The quick brown fox jumps over the
                lazy dog. 0123456789') }}
            </p>
            <p class="ss-font-serif">
                {{ preview_text|default('The quick brown fox jumps over the
                lazy dog. 0123456789') }}
            </p>
            <p class="ss-font-slab">
                {{ preview_text|default('The quick brown fox jumps over the
                lazy dog. 0123456789') }}
            </p>
            <p class="ss-font-mono">
                {{ preview_text|default('The quick brown fox jumps over the
                lazy dog. 0123456789') }}
            </p>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Font Variants" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <div class="preview__font__controls">
            <label for="preview__font--input">Preview text:</label>
            <input
                id="preview__font--input"
                type="text"
                placeholder="{{preview_text}}"
            />
        </div>
    </section>

    {% set fonts = [
        { label: ".ss-font-sans",  class: "ss-font-sans"  },
        { label: ".ss-font-serif", class: "ss-font-serif" },
        { label: ".ss-font-slab",  class: "ss-font-slab"  },
        { label: ".ss-font-mono",  class: "ss-font-mono"  }
    ] %} {% for font in fonts %} {% set label = font.label %} {% set class =
    font.class %}
    <div class="ss-c-demo__subsection">
        {%- include "includes/preview/ss-c-preview_font.html.jinja" %}
    </div>
    {% endfor %}
</section>

{%- endblock %}
