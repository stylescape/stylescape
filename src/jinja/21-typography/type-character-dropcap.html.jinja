{% extends "../base.html.jinja" %} {% set title = "Dropcap Characters" %} {%-
block title %}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>
            Large initial letters for paragraph beginnings. Put
            <code>ss-c-dropcap</code> on the first paragraph; the component
            styles its <code>::first-letter</code>, so the text stays one word
            for screen readers and search.
        </p>
    </header>

    {% set section_title = "Basic Dropcap" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <p class="ss-c-dropcap">
            Once upon a time, in a land far away, there lived a designer who
            loved typography. They spent their days crafting beautiful
            letterforms and experimenting with various typographic techniques.
        </p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Dropcap Styles" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p>Add a modifier: <code>ss-c-dropcap--boxed</code>, <code>--circle</code> or <code>--outlined</code>.</p>
        {% set code_snippet %}
        <div style="display: grid; gap: 32px">
        <div>
            <p class="ss-c-dropcap ss-c-dropcap--boxed">
                Typography sets the tone of a page before a single word is read. A boxed initial anchors the opening paragraph and gives the eye a clear place to start.
            </p>
        </div>
        <div>
            <p class="ss-c-dropcap ss-c-dropcap--circle">
                A circular initial softens the opening of an article. It suits editorial layouts where the page already uses rounded shapes elsewhere.
            </p>
        </div>
        <div>
            <p class="ss-c-dropcap ss-c-dropcap--outlined">
                In an outlined initial only the contour of the letter is drawn, which keeps a large capital light on a busy page.
            </p>
        </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {% set section_title = "Decorative Dropcaps" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        <p><code>ss-c-dropcap--gradient</code> uses the accent and info colours; <code>--serif</code> sets the initial in the serif italic.</p>
        {% set code_snippet %}
        <div style="display: grid; gap: 32px">
        <div>
            <p class="ss-c-dropcap ss-c-dropcap--gradient">
                Gradient initials pick up the accent and info colours of the theme, so they follow light and dark mode without extra rules.
            </p>
        </div>
        <div>
            <p class="ss-c-dropcap ss-c-dropcap--serif">
                Serif italic initials recall book typography and pair well with a sans-serif body text set in a single column.
            </p>
        </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock %}
