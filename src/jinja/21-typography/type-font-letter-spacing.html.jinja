{% extends "../base.html.jinja" %} {% set title = "Fonts" %} {%- block title %}{{
title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% for i in range(1, 13) %} {% if i < 10 %} {% set padded='0' ~ i %} {%
    else %} {% set padded=i|string %} {% endif %} {% set
    label=".font--letter_spacing_" ~ padded %} {% set
    class="font--letter_spacing_" ~ padded %}
    <div class="ss-c-demo__subsection">
        {%- include "includes/preview/ss-c-preview_font.html.jinja" %}
    </div>
    {% endfor %}
</section>

<section class="ss-c-demo__section">
    <header class="ss-c-demo__section__header">
        <h3>Utility Font letter_spacing Classes</h3>
    </header>

    {% set fonts = [ { label: ".font--xs", class: "font--xs" }, { label:
    ".font--sm", class: "font--sm" }, { label: ".font--md", class: "font--md"
    }, { label: ".font--lg", class: "font--lg" }, { label: ".font--xl", class:
    "font--xl" } ] %} {% for font in fonts %} {% set label = font.label %} {%
    set class = font.class %}
    <div class="ss-c-demo__subsection">
        {%- include "includes/preview/ss-c-preview_font.html.jinja" %}
    </div>
    {% endfor %}
</section>

{%- endblock %}
