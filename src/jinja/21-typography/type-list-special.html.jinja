{% extends "../base.html.jinja" %} {%- block title %}Special Lists{%- endblock %}
{%- block content %}
<header class="ss-c-demo__section__header">
    <h1>Special Lists</h1>
    <p>List style types, unstyled lists, custom markers, checklists and dividers.</p>
</header>

{#
============================================================================
List Style Types
============================================================================ #}
<section class="ss-c-demo__section" data-label="List Style Types" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>List Style Types</h2>
        <p>Different bullet and numbering styles for lists.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Disc, Circle, Square</h3>
        {% set code_snippet %}
        <ul style="list-style-type: disc">
            <li>Disc style (default)</li>
            <li>Another item</li>
        </ul>
        <ul style="list-style-type: circle">
            <li>Circle style</li>
            <li>Another item</li>
        </ul>
        <ul style="list-style-type: square">
            <li>Square style</li>
            <li>Another item</li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Numbered Variations</h3>
        {% set code_snippet %}
        <ol style="list-style-type: decimal">
            <li>Decimal (1, 2, 3)</li>
            <li>Second item</li>
        </ol>
        <ol style="list-style-type: decimal-leading-zero">
            <li>Decimal leading zero (01, 02, 03)</li>
            <li>Second item</li>
        </ol>
        <ol style="list-style-type: lower-roman">
            <li>Lower roman (i, ii, iii)</li>
            <li>Second item</li>
        </ol>
        <ol style="list-style-type: upper-roman">
            <li>Upper roman (I, II, III)</li>
            <li>Second item</li>
        </ol>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Alphabetic Variations</h3>
        {% set code_snippet %}
        <ol style="list-style-type: lower-alpha">
            <li>Lower alpha (a, b, c)</li>
            <li>Second item</li>
        </ol>
        <ol style="list-style-type: upper-alpha">
            <li>Upper alpha (A, B, C)</li>
            <li>Second item</li>
        </ol>
        <ol style="list-style-type: lower-greek">
            <li>Lower greek (α, β, γ)</li>
            <li>Second item</li>
        </ol>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Unstyled Lists
============================================================================ #}
<section class="ss-c-demo__section" data-label="Unstyled Lists" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Unstyled Lists</h2>
        <p>Lists without default browser styling.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>No List Style</h3>
        {% set code_snippet %}
        <ul class="ss-c-list-group">
            <li>First item without bullet</li>
            <li>Second item without bullet</li>
            <li>Third item without bullet</li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Inline List</h3>
        {% set code_snippet %}
        <ul class="ss-c-list-group ss-c-list-group--horizontal">
            <li class="ss-c-list-group__item">Home</li>
            <li class="ss-c-list-group__item">About</li>
            <li class="ss-c-list-group__item">Services</li>
            <li class="ss-c-list-group__item">Contact</li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Custom Markers
============================================================================ #}
<section class="ss-c-demo__section" data-label="Custom Markers" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Custom Markers</h2>
        <p>Lists with custom bullet characters using CSS.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Emoji Markers</h3>
        {% set code_snippet %}
        <ul class="ss-c-list-group">
            <li data-marker="✓">Completed task</li>
            <li data-marker="→">In progress</li>
            <li data-marker="○">Pending task</li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    <section class="ss-c-demo__subsection">
        <h3>Icon Markers</h3>
        {% set code_snippet %}
        <ul class="ss-c-list-group">
            <li>
                <span class="ss-c-icon">★</span>
                Featured item
            </li>
            <li>
                <span class="ss-c-icon">♦</span>
                Diamond item
            </li>
            <li>
                <span class="ss-c-icon">●</span>
                Circle item
            </li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Checklist
============================================================================ #}
<section class="ss-c-demo__section" data-label="Checklist" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Checklist</h2>
        <p>Interactive checkbox lists for tasks and to-dos.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>Basic Checklist</h3>
        {% set code_snippet %}
        <ul class="ss-c-checklist">
            <li>
                <label>
                    <input type="checkbox" checked />
                    Buy groceries
                </label>
            </li>
            <li>
                <label>
                    <input type="checkbox" />
                    Clean the house
                </label>
            </li>
            <li>
                <label>
                    <input type="checkbox" />
                    Call mom
                </label>
            </li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Horizontal Rules in Lists
============================================================================ #}
<section class="ss-c-demo__section" data-label="Divided Lists" data-level="1">
    <header class="ss-c-demo__section__header">
        <h2>Divided Lists</h2>
        <p>Lists with separators between items.</p>
    </header>

    <section class="ss-c-demo__subsection">
        <h3>List with Dividers</h3>
        {% set code_snippet %}
        <ul class="ss-c-list-group ss-c-list-group--flush">
            <li class="ss-c-list-group__item">First item with separator below</li>
            <li class="ss-c-list-group__item">Second item with separator below</li>
            <li class="ss-c-list-group__item">Third item with separator below</li>
            <li class="ss-c-list-group__item">Last item without separator</li>
        </ul>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>


{% set section_title = "Custom Markers" %}
<section
    class="ss-c-demo__subsection"
    data-label="{{ section_title }}"
    data-level="2"
>
    <h2>{{ section_title }}</h2>
    {% set code_snippet %}
    <ul style="list-style: none; padding-left: 0">
        <li style="padding-left: 1.5em; text-indent: -1.5em">
            <span style="color: var(--ss-color-accent)">■</span>
            Accent square marker
        </li>
        <li style="padding-left: 1.5em; text-indent: -1.5em">
            <span style="color: var(--ss-color-accent)">→</span>
            Arrow marker for action items
        </li>
        <li style="padding-left: 1.5em; text-indent: -1.5em">
            <span style="color: var(--ss-color-success)">✓</span>
            Check marker for completed items
        </li>
        <li style="padding-left: 1.5em; text-indent: -1.5em">
            <span style="color: var(--ss-color-error)">✕</span>
            Cross marker for removed items
        </li>
    </ul>
    <ol style="list-style: none; padding-left: 0">
        <li style="position: relative; padding-left: 2em">
            <span
                style="
                    position: absolute;
                    left: 0;
                    font-weight: 700;
                    color: var(--ss-color-accent);
                "
                >01</span
            >
            Numbered with leading-zero markers
        </li>
        <li style="position: relative; padding-left: 2em">
            <span
                style="
                    position: absolute;
                    left: 0;
                    font-weight: 700;
                    color: var(--ss-color-accent);
                "
                >02</span
            >
            Editorial numbering in accent
        </li>
    </ol>
    {% endset %} {% set language="HTML" %} {%- include
    "includes/preview/ss-c-preview_code.html.jinja" %}
</section>

{%- endblock content %}
