{% extends "../base.html.jinja" %} {% set title = "Mark Characters" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="{{ title }}" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>{{ title }}</h1>
        <p>Highlighted and marked text for emphasis and search results.</p>
    </header>

    {# Basic Mark #} {% set section_title = "Basic Mark" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <p>
            The
            <mark>mark element</mark>
            is used to highlight text that is relevant to the current context,
            such as search results or important passages.
        </p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Mark Variations #} {% set section_title = "Mark Variations" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div style="display: flex; flex-direction: column; gap: 16px">
            <p>
                Default:
                <mark>highlighted text</mark>
            </p>
            <p>
                Yellow:
                <mark
                    style="
                        background: var(--ss-color-warning-bg);
                        color: var(--ss-color-warning-foreground);
                        padding: 2px 6px;
                        border-radius: var(--ss-radius-sm);
                    "
                >
                    important note
                </mark>
            </p>
            <p>
                Success:
                <mark
                    style="
                        background: var(--ss-color-success-bg);
                        color: var(--ss-color-success-foreground);
                        padding: 2px 6px;
                        border-radius: var(--ss-radius-sm);
                    "
                >
                    approved
                </mark>
            </p>
            <p>
                Error:
                <mark
                    style="
                        background: var(--ss-color-error-bg);
                        color: var(--ss-color-error-foreground);
                        padding: 2px 6px;
                        border-radius: var(--ss-radius-sm);
                    "
                >
                    critical
                </mark>
            </p>
            <p>
                Info:
                <mark
                    style="
                        background: var(--ss-color-info-bg);
                        color: var(--ss-color-info-foreground);
                        padding: 2px 6px;
                        border-radius: var(--ss-radius-sm);
                    "
                >
                    reference
                </mark>
            </p>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>

    {# Search Highlighting #} {% set section_title = "Search Result
    Highlighting" %}
    <section
        class="ss-c-demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h2>{{ section_title }}</h2>
        {% set code_snippet %}
        <div
            class="ss-c-search-results"
            style="
                padding: 16px;
                background: var(--ss-color-surface-alt);
                border-radius: var(--ss-radius-md);
            "
        >
            <p style="margin: 0 0 12px; font-size: 14px; opacity: 0.7">
                3 results for "typography"
            </p>
            <div
                style="
                    padding: 12px;
                    background: var(--ss-color-surface);
                    border-radius: var(--ss-radius-md);
                    margin-bottom: 8px;
                "
            >
                <h3 style="margin: 0 0 4px">
                    Introduction to
                    <mark
                        style="
                            background: var(--ss-color-highlight);
                            color: var(--ss-color-highlight-foreground);
                            padding: 1px 4px;
                            border-radius: var(--ss-radius-sm);
                        "
                    >
                        Typography
                    </mark>
                </h3>
                <p style="margin: 0; font-size: 14px; opacity: 0.8">
                    Learn the fundamentals of
                    <mark
                        style="
                            background: var(--ss-color-highlight);
                            color: var(--ss-color-highlight-foreground);
                            padding: 1px 4px;
                            border-radius: var(--ss-radius-sm);
                        "
                    >
                        typography
                    </mark>
                    and how it affects...
                </p>
            </div>
            <div style="padding: 12px; background: var(--ss-color-surface); border-radius: var(--ss-radius-md)">
                <h3 style="margin: 0 0 4px">
                    Advanced
                    <mark
                        style="
                            background: var(--ss-color-highlight);
                            color: var(--ss-color-highlight-foreground);
                            padding: 1px 4px;
                            border-radius: var(--ss-radius-sm);
                        "
                    >
                        Typography
                    </mark>
                    Techniques
                </h3>
                <p style="margin: 0; font-size: 14px; opacity: 0.8">
                    Explore advanced
                    <mark
                        style="
                            background: var(--ss-color-highlight);
                            color: var(--ss-color-highlight-foreground);
                            padding: 1px 4px;
                            border-radius: var(--ss-radius-sm);
                        "
                    >
                        typography
                    </mark>
                    methods for...
                </p>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/ss-c-preview_code.html.jinja" %}
    </section>
</section>

{%- endblock %}
