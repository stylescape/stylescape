    -----------------------------------------------------------------------------
    Top Ribbon Slots
    -----------------------------------------------------------------------------
    #} {% set section_title = "Ribbon Slots" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h4>{{ section_title }}</h4>
        {% set code_snippet %}
        <div class="ribbon ribbon--top">
            <div class="ribbon__slot--horizontal_left">Top Ribbon</div>
        </div>
        <br />
        <div class="ribbon ribbon--top">
            <div class="ribbon__slot--horizontal_center">Top Ribbon</div>
        </div>
        <br />
        <div class="ribbon ribbon--top">
            <div class="ribbon__slot--horizontal_right">Top Ribbon</div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

