    {#
    -----------------------------------------------------------------------------
    Top Ribbon Forms
    -----------------------------------------------------------------------------
    #}

    <section class="demo__subsection">
        <h4>Top Ribbon Slots</h4>
        {% set code_snippet %}
        <div class="ribbon ribbon--top">
            <div class="ribbon__search">
                <form
                    id="ribbon__search__form"
                    class="ribbon__search__form"
                    role="search"
                >
                    <button
                        type="submit"
                        id="ribbon__search_button"
                        class="ribbon__search_button"
                    >
                        <i class="i i_ui_search"></i>
                    </button>
                    <input
                        type="text"
                        id="ribbon__search__input"
                        class="ribbon__search__input"
                        placeholder="Search..."
                    />
                </form>
            </div>
        </div>
        <br />
        <div class="ribbon ribbon--top">
            <div class="ribbon__slot--horizontal_center">
