{% extends "base.html.jinja" %} {% set title = "Input Toggle" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {% set section_title = "Demo Code" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div class="toggle_panel">
            <div class="toggle_panel__heading">
                <h4 class="toggle_panel__title">
                    Notifications
                    <span class="toggle_panel__title--float">⮟</span>
                </h4>
                <i class="toggle_panel__heading__icon">★</i>
            </div>
            <div class="toggle_panel__body">
                <label class="switch">
                    <input type="checkbox" checked />
                    <span class="slider round"></span>
                </label>
                <span class="label">Email + push</span>
            </div>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection" data-label="Panels" data-level="2">
        <h3>Panels</h3>

        <div class="toggle_panel">
            <div class="toggle_panel__heading">
                <h4 class="toggle_panel__title">
                    Default Panel
                    <span class="toggle_panel__title--float">⮟</span>
                </h4>
                <i class="toggle_panel__heading__icon">★</i>
            </div>
            <div class="toggle_panel__body">
                <p>
                    Use toggle panels to group settings or filters. This block
                    shows the default styling.
                </p>
            </div>
        </div>

        <div class="toggle_panel toggle_panel__gap">
            <div class="toggle_panel__heading">
                <h4 class="toggle_panel__title">
                    Open State
                    <span class="toggle_panel__title--float">▲</span>
                </h4>
                <i class="toggle_panel__heading__icon">⚡</i>
            </div>
            <div class="toggle_panel__body">
                <p>
                    Render with content visible to illustrate spacing and
                    typography when expanded.
                </p>
                <ul class="list">
                    <li>
                        Spacing set by
                        <code>toggle_panel__body</code>
                    </li>
                    <li>
                        Heading uses
                        <code>toggle_panel__heading</code>
                    </li>
                </ul>
            </div>
        </div>

        <div class="toggle_panel toggle_panel__gap">
            <div class="toggle_panel__heading">
                <h4 class="toggle_panel__title">
                    Compact w/ Icon
                    <span class="toggle_panel__title--float">⮟</span>
                </h4>
                <i class="toggle_panel__heading__icon">✓</i>
            </div>
            <div class="toggle_panel__body">
                <p class="label">Ideal for stacked accordions.</p>
            </div>
        </div>
    </section>

    <section class="demo__subsection" data-label="Switches" data-level="2">
        <h3>Switches</h3>
        <div class="demo__group">
            <label class="label" for="switch-default">Default</label>
            <label class="switch">
                <input id="switch-default" type="checkbox" checked />
                <span class="slider"></span>
            </label>
        </div>

        <div class="demo__group">
            <label class="label" for="switch-round">Round</label>
            <label class="switch">
                <input id="switch-round" type="checkbox" checked />
                <span class="slider round"></span>
            </label>
        </div>

        <div class="demo__group">
            <label class="label" for="switch-off">Off state</label>
            <label class="switch">
                <input id="switch-off" type="checkbox" />
                <span class="slider"></span>
            </label>
        </div>

        <div class="demo__group">
            <label class="label" for="switch-disabled">Disabled</label>
            <label class="switch">
                <input id="switch-disabled" type="checkbox" disabled />
                <span class="slider round"></span>
            </label>
            <span class="label">Use to show disabled styling.</span>
        </div>
    </section>
</section>
{%- endblock %}
