{% extends "base.html.jinja" %}

{% block title %}Layering System Demo | unit.gl{% endblock %}

{% block header %}
<h1>Layering System Demo</h1>
<p>Demonstrates the z-index stack defined in <code>$layer-map</code>. Use the buttons below to toggle each layer.</p>
{% endblock %}

{% block styles %}
{{ super() }}
<style>
  .layer-demo {
    position: relative;
    height: 400px;
    border: 1px solid #ddd;
    margin-bottom: 2rem;
    background: #f7f7f7;
    overflow: hidden;
  }

  .layer-box {
    position: absolute;
    width: 200px;
    height: 200px;
    padding: 1rem;
    color: white;
    font-weight: bold;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    cursor: pointer;
    transition: transform 0.2s, opacity 0.2s;
  }

  .layer-controls {
    margin-bottom: 1rem;
  }

  .layer-controls button {
    margin-right: 0.5rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    border: 1px solid #ccc;
    background: white;
    cursor: pointer;
    border-radius: 4px;
  }

  .hidden {
    opacity: 0 !important;
    pointer-events: none;
  }

  .z-guides         { z-index: 9998; background: rgba(0, 200, 255, 0.8); top: 20px; left: 20px; }
  .z-modal          { z-index: 7000; background: rgba(255, 0, 0, 0.8); top: 60px; left: 60px; }
  .z-interface      { z-index: 4000; background: rgba(0, 200, 100, 0.8); top: 100px; left: 100px; }
  .z-content        { z-index: 2000; background: rgba(100, 100, 255, 0.8); top: 140px; left: 140px; }
  .z-canvas         { z-index: -1000; background: rgba(0, 0, 0, 0.2); top: 180px; left: 180px; }
</style>
{% endblock %}

{% block content %}

<div class="layer-controls">
  {% set layers = ["guides", "modal", "interface", "content", "canvas"] %}
  {% for layer in layers %}
    <button onclick="toggleLayer('{{ layer }}')">Toggle {{ layer }}</button>
  {% endfor %}
</div>

<div class="layer-demo">
  {% for layer in layers %}
    <div class="layer-box z-{{ layer }}" id="layer-{{ layer }}">
      {{ layer }}<br><small>z({{ layer }})</small>
    </div>
  {% endfor %}
</div>

<script>
  function toggleLayer(id) {
    const el = document.getElementById('layer-' + id);
    el.classList.toggle('hidden');
  }
</script>

{% endblock %}
