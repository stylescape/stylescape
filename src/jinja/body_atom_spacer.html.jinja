{% extends "base.html.jinja" %}
{%- block title %}Spacer{%- endblock %}
{%- block content %}

{# ============================================================================
   Vertical Spacers
   ============================================================================ #}
<section class="demo__section" data-label="Vertical Spacers" data-level="1">
    <header class="demo__section__header">
        <h3>Vertical Spacers</h3>
        <p>Create vertical spacing between elements.</p>
    </header>

    <section class="demo__subsection">
        <h4>Spacer Sizes</h4>
        {% set code_snippet %}
<div class="bg--fill_02 p--02">Content above</div>
<div class="spacer_vertical spacer--01"></div>
<div class="bg--fill_02 p--02">Small spacer (4px)</div>
<div class="spacer_vertical spacer--02"></div>
<div class="bg--fill_02 p--02">Medium spacer (8px)</div>
<div class="spacer_vertical spacer--04"></div>
<div class="bg--fill_02 p--02">Large spacer (16px)</div>
<div class="spacer_vertical spacer--08"></div>
<div class="bg--fill_02 p--02">Extra large spacer (32px)</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Visible Spacer (for demonstration)</h4>
        {% set code_snippet %}
<div class="bg--fill_02 p--02">Content above</div>
<div class="spacer_vertical spacer--04 bg--accent_01"></div>
<div class="bg--fill_02 p--02">Content below (spacer is visible with background)</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Horizontal Spacers
   ============================================================================ #}
<section class="demo__section" data-label="Horizontal Spacers" data-level="1">
    <header class="demo__section__header">
        <h3>Horizontal Spacers</h3>
        <p>Create horizontal spacing between inline elements.</p>
    </header>

    <section class="demo__subsection">
        <h4>Inline Spacers</h4>
        {% set code_snippet %}
<div class="d--flex align-items--center">
    <span class="bg--fill_02 p--02">Left</span>
    <span class="spacer_horizontal spacer--02"></span>
    <span class="bg--fill_02 p--02">Small gap</span>
    <span class="spacer_horizontal spacer--04"></span>
    <span class="bg--fill_02 p--02">Medium gap</span>
    <span class="spacer_horizontal spacer--08"></span>
    <span class="bg--fill_02 p--02">Large gap</span>
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Flexible Spacers
   ============================================================================ #}
<section class="demo__section" data-label="Flexible Spacers" data-level="1">
    <header class="demo__section__header">
        <h3>Flexible Spacers</h3>
        <p>Spacers that grow to fill available space.</p>
    </header>

    <section class="demo__subsection">
        <h4>Flex Spacer</h4>
        {% set code_snippet %}
<div class="d--flex">
    <span class="bg--fill_02 p--02">Left aligned</span>
    <span class="spacer--flex"></span>
    <span class="bg--fill_02 p--02">Right aligned</span>
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Multiple Flex Spacers</h4>
        {% set code_snippet %}
<div class="d--flex">
    <span class="bg--fill_02 p--02">Left</span>
    <span class="spacer--flex"></span>
    <span class="bg--fill_02 p--02">Center</span>
    <span class="spacer--flex"></span>
    <span class="bg--fill_02 p--02">Right</span>
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Divider Spacers
   ============================================================================ #}
<section class="demo__section" data-label="Divider Spacers" data-level="1">
    <header class="demo__section__header">
        <h3>Divider Spacers</h3>
        <p>Spacers combined with visual dividers.</p>
    </header>

    <section class="demo__subsection">
        <h4>Spacer with Divider</h4>
        {% set code_snippet %}
<div class="bg--fill_02 p--02">Section one content</div>
<div class="spacer_divider spacer--04">
    <hr class="divider" />
</div>
<div class="bg--fill_02 p--02">Section two content</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Responsive Spacers
   ============================================================================ #}
<section class="demo__section" data-label="Responsive Spacers" data-level="1">
    <header class="demo__section__header">
        <h3>Responsive Spacers</h3>
        <p>Spacers that adjust based on viewport size.</p>
    </header>

    <section class="demo__subsection">
        <h4>Responsive Vertical Spacer</h4>
        {% set code_snippet %}
<div class="bg--fill_02 p--02">Content above</div>
<div class="spacer_vertical spacer--02 spacer--md-04 spacer--lg-08"></div>
<div class="bg--fill_02 p--02">Content below (spacer grows at larger breakpoints)</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
