{% extends "base.html.jinja" %} {% set title = "Code Characters" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
        <p>Monospace code formatting for inline and block code snippets.</p>
    </header>

    {# Inline Code #} {% set section_title = "Inline Code" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <p>
            Use the
            <code
                style="
                    background: var(--color_fill_secondary);
                    padding: 2px 6px;
                    border-radius: 4px;
                    font-family: monospace;
                    font-size: 0.9em;
                "
            >
                console.log()
            </code>
            function to debug your JavaScript code.
        </p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Code Block #} {% set section_title = "Code Block" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <pre
            style="
                background: #1e1e1e;
                color: #d4d4d4;
                padding: 20px;
                border-radius: 8px;
                overflow-x: auto;
                font-family:
                    &quot;Fira Code&quot;, &quot;Monaco&quot;, monospace;
                font-size: 14px;
                line-height: 1.6;
            "
        ><code>function greet(name) {
    return `Hello, ${name}!`;
}

const message = greet('World');
console.log(message);</code></pre>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Syntax Highlighted Code #} {% set section_title = "Syntax Highlighted
    Code" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <pre
            style="
                background: #282c34;
                padding: 20px;
                border-radius: 8px;
                overflow-x: auto;
                font-family: monospace;
                font-size: 14px;
                line-height: 1.6;
            "
        ><code><span style="color: #c678dd;">const</span> <span style="color: #e06c75;">Button</span> <span style="color: #56b6c2;">=</span> <span style="color: #c678dd;">(</span><span style="color: #e5c07b;">{ children, onClick }</span><span style="color: #c678dd;">)</span> <span style="color: #c678dd;">=></span> <span style="color: #c678dd;">(</span>
  <span style="color: #e06c75;">&lt;button</span>
    <span style="color: #d19a66;">className</span><span style="color: #56b6c2;">=</span><span style="color: #98c379;">"button button-primary"</span>
    <span style="color: #d19a66;">onClick</span><span style="color: #56b6c2;">=</span><span style="color: #c678dd;">{</span><span style="color: #e5c07b;">onClick</span><span style="color: #c678dd;">}</span>
  <span style="color: #e06c75;">&gt;</span>
    <span style="color: #c678dd;">{</span><span style="color: #e5c07b;">children</span><span style="color: #c678dd;">}</span>
  <span style="color: #e06c75;">&lt;/button&gt;</span>
<span style="color: #c678dd;">)</span><span style="color: #abb2bf;">;</span></code></pre>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Code with Line Numbers #} {% set section_title = "Code with Line
    Numbers" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div
            style="
                display: flex;
                background: #1e1e1e;
                border-radius: 8px;
                overflow: hidden;
                font-family: monospace;
                font-size: 14px;
            "
        >
            <div
                style="
                    padding: 20px 12px;
                    background: #252526;
                    color: #858585;
                    text-align: right;
                    user-select: none;
                    line-height: 1.6;
                "
            >
                1
                <br />
                2
                <br />
                3
                <br />
                4
                <br />
                5
            </div>
            <pre
                style="
                    margin: 0;
                    padding: 20px;
                    color: #d4d4d4;
                    overflow-x: auto;
                    flex: 1;
                    line-height: 1.6;
                "
            ><code>.container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}</code></pre>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Keyboard Input #} {% set section_title = "Keyboard Input (kbd)" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <p style="line-height: 2">
            Press
            <kbd
                style="
                    background: var(--color_fill_secondary);
                    border: 1px solid var(--color_line_secondary);
                    border-radius: 4px;
                    padding: 4px 8px;
                    font-family: monospace;
                    font-size: 0.9em;
                    box-shadow: 0 2px 0 var(--color_line_secondary);
                "
            >
                Ctrl
            </kbd>
            +
            <kbd
                style="
                    background: var(--color_fill_secondary);
                    border: 1px solid var(--color_line_secondary);
                    border-radius: 4px;
                    padding: 4px 8px;
                    font-family: monospace;
                    font-size: 0.9em;
                    box-shadow: 0 2px 0 var(--color_line_secondary);
                "
            >
                S
            </kbd>
            to save your work.
        </p>
        <p style="line-height: 2">
            Use
            <kbd
                style="
                    background: var(--color_fill_secondary);
                    border: 1px solid var(--color_line_secondary);
                    border-radius: 4px;
                    padding: 4px 8px;
                    font-family: monospace;
                    font-size: 0.9em;
                    box-shadow: 0 2px 0 var(--color_line_secondary);
                "
            >
                ⌘
            </kbd>
            +
            <kbd
                style="
                    background: var(--color_fill_secondary);
                    border: 1px solid var(--color_line_secondary);
                    border-radius: 4px;
                    padding: 4px 8px;
                    font-family: monospace;
                    font-size: 0.9em;
                    box-shadow: 0 2px 0 var(--color_line_secondary);
                "
            >
                Shift
            </kbd>
            +
            <kbd
                style="
                    background: var(--color_fill_secondary);
                    border: 1px solid var(--color_line_secondary);
                    border-radius: 4px;
                    padding: 4px 8px;
                    font-family: monospace;
                    font-size: 0.9em;
                    box-shadow: 0 2px 0 var(--color_line_secondary);
                "
            >
                P
            </kbd>
            to open command palette.
        </p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {# Sample Output #} {% set section_title = "Sample Output (samp)" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <div
            style="
                padding: 16px;
                background: #0d1117;
                border-radius: 8px;
                font-family: monospace;
                color: #c9d1d9;
            "
        >
            <p style="margin: 0 0 8px; color: #8b949e">$ npm run build</p>
            <samp style="white-space: pre-line; line-height: 1.5">
                > stylescape@1.0.0 build > vite build ✓ 142 modules
                transformed. dist/index.html 2.15 kB dist/assets/index.js
                124.56 kB
                <span style="color: #3fb950">✓ Built in 2.34s</span>
            </samp>
        </div>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock %}
