{% extends "base.html.jinja" %} {%- block title %}Pagination{%- endblock %} {%-
block content %} {#
============================================================================
Basic Pagination
============================================================================ #}
<section class="demo__section" data-label="Basic Pagination" data-level="1">
    <header class="demo__section__header">
        <h3>Basic Pagination</h3>
        <p>Navigate through pages of content.</p>
    </header>

    <section class="demo__subsection">
        <h4>Simple Pagination</h4>
        {% set code_snippet %}
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="pagination__item">
                    <a href="#" class="pagination__link" aria-label="Previous">
                        ←
                    </a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">1</a>
                </li>
                <li class="pagination__item pagination__item--active">
                    <a href="#" class="pagination__link" aria-current="page">
                        2
                    </a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">3</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link" aria-label="Next">
                        →
                    </a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>With First/Last</h4>
        {% set code_snippet %}
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="pagination__item">
                    <a href="#" class="pagination__link" aria-label="First">
                        ««
                    </a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link" aria-label="Previous">
                        «
                    </a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">1</a>
                </li>
                <li class="pagination__item pagination__item--active">
                    <a href="#" class="pagination__link" aria-current="page">
                        2
                    </a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">3</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link" aria-label="Next">
                        »
                    </a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link" aria-label="Last">
                        »»
                    </a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Pagination States
============================================================================ #}
<section class="demo__section" data-label="States" data-level="1">
    <header class="demo__section__header">
        <h3>Pagination States</h3>
        <p>Disabled and active states.</p>
    </header>

    <section class="demo__subsection">
        <h4>Disabled Items</h4>
        {% set code_snippet %}
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="pagination__item pagination__item--disabled">
                    <a
                        href="#"
                        class="pagination__link"
                        tabindex="-1"
                        aria-disabled="true"
                    >
                        Previous
                    </a>
                </li>
                <li class="pagination__item pagination__item--active">
                    <a href="#" class="pagination__link" aria-current="page">
                        1
                    </a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">2</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">3</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">Next</a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Pagination Sizes
============================================================================ #}
<section class="demo__section" data-label="Sizes" data-level="1">
    <header class="demo__section__header">
        <h3>Pagination Sizes</h3>
        <p>Different size variations.</p>
    </header>

    <section class="demo__subsection">
        <h4>Size Variations</h4>
        {% set code_snippet %}
        <nav aria-label="Small pagination">
            <ul class="pagination pagination--sm">
                <li class="pagination__item">
                    <a href="#" class="pagination__link">«</a>
                </li>
                <li class="pagination__item pagination__item--active">
                    <a href="#" class="pagination__link">1</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">2</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">»</a>
                </li>
            </ul>
        </nav>

        <nav aria-label="Default pagination" class="mt--02">
            <ul class="pagination">
                <li class="pagination__item">
                    <a href="#" class="pagination__link">«</a>
                </li>
                <li class="pagination__item pagination__item--active">
                    <a href="#" class="pagination__link">1</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">2</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">»</a>
                </li>
            </ul>
        </nav>

        <nav aria-label="Large pagination" class="mt--02">
            <ul class="pagination pagination--lg">
                <li class="pagination__item">
                    <a href="#" class="pagination__link">«</a>
                </li>
                <li class="pagination__item pagination__item--active">
                    <a href="#" class="pagination__link">1</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">2</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">»</a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

