{% extends "base.html.jinja" %}

{% set title = "Pagination" %}

{%- block title %}{{ title }}{%- endblock %}

{%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    {# ----------------------------------------------------------------------------
    Pagination
    ---------------------------------------------------------------------------- #}

    {% set section_title = "Pagination" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <ul class="pagination">
            <li><a href="#">&laquo;</a></li>
            <li><a href="#">1</a></li>
            <li class="active"><a href="#">2</a></li>
            <li><a href="#">3</a></li>
            <li><a href="#">4</a></li>
            <li><a href="#">&raquo;</a></li>
        </ul>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Disabled & Right-Aligned Pagination" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <ul class="pagination pagination--right">
            <li class="disabled"><a href="#">&laquo;</a></li>
            <li><a href="#">1</a></li>
            <li class="active"><a href="#">2</a></li>
            <li><a href="#">3</a></li>
            <li><a href="#">&raquo;</a></li>
        </ul>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Pagination Alignment" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
        <ul class="pagination pagination--left">
            <li><a href="#">Prev</a></li>
            <li><a href="#">10</a></li>
            <li class="active"><a href="#">11</a></li>
            <li><a href="#">12</a></li>
            <li><a href="#">Next</a></li>
        </ul>
        <ul class="pagination pagination--center">
            <li><a href="#">Prev</a></li>
            <li><a href="#">10</a></li>
            <li class="active"><a href="#">11</a></li>
            <li><a href="#">12</a></li>
            <li><a href="#">Next</a></li>
        </ul>
        <ul class="pagination pagination--right">
            <li><a href="#">Prev</a></li>
            <li><a href="#">10</a></li>
            <li class="active"><a href="#">11</a></li>
            <li><a href="#">12</a></li>
            <li><a href="#">Next</a></li>
        </ul>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Pagination Alt" %}
    <section class="demo__subsection" data-label="{{ section_title }}" data-level="2">
        <h3>{{ section_title }}</h3>
        {% set code_snippet %}
<div class="pagination">
    <a href="#">&laquo;</a>
    <a href="#">1</a>
    <a class="active" href="#">2</a>
    <a href="#">3</a>
    <a href="#">4</a>
    <a href="#">5</a>
    <a href="#">6</a>
    <a href="#">&raquo;</a>
</div>
        {% endset %}
        {% set language="HTML" %}
        {%- include "includes/preview_box_code.html.jinja" %}
    </section>


</section>

{%- endblock %}
