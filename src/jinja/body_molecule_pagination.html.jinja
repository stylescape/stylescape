{# ============================================================================
Ellipsis Pagination
============================================================================ #}
<section class="demo__section" data-label="Ellipsis" data-level="1">
    <header class="demo__section__header">
        <h3>Ellipsis Pagination</h3>
        <p>Truncated pagination for many pages.</p>
    </header>

    <section class="demo__subsection">
        <h4>With Ellipsis</h4>
        {% set code_snippet %}
        <nav aria-label="Ellipsis pagination">
            <ul class="pagination">
                <li class="pagination__item">
                    <a href="#" class="pagination__link">«</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">1</a>
                </li>
                <li class="pagination__item pagination__item--ellipsis">
                    <span>…</span>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">4</a>
                </li>
                <li class="pagination__item pagination__item--active">
                    <a href="#" class="pagination__link">5</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">6</a>
                </li>
                <li class="pagination__item pagination__item--ellipsis">
                    <span>…</span>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">20</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">»</a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
Previous/Next Only
============================================================================ #}
<section class="demo__section" data-label="Simple Navigation" data-level="1">
    <header class="demo__section__header">
        <h3>Simple Navigation</h3>
        <p>Previous/Next only pagination.</p>
    </header>

    <section class="demo__subsection">
        <h4>Prev/Next with Labels</h4>
        {% set code_snippet %}
        <nav aria-label="Simple pagination">
            <ul class="pagination pagination--simple">
                <li class="pagination__item">
                    <a href="#" class="pagination__link">
                        <span>← Previous</span>
                    </a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">
                        <span>Next →</span>
                    </a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Page Info</h4>
        {% set code_snippet %}
        <nav aria-label="Pagination with info" class="pagination__wrapper">
            <span class="pagination__info">Page 5 of 20</span>
            <ul class="pagination">
                <li class="pagination__item">
                    <a href="#" class="pagination__link">Previous</a>
                </li>
                <li class="pagination__item">
                    <a href="#" class="pagination__link">Next</a>
                </li>
            </ul>
        </nav>
        {% endset %} {% set language="HTML" %} {% include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
