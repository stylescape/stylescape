{% extends "../base.html.jinja" %} {%- block title %}Layering System
Demo{%- endblock %} {%- block content %}

<section class="ss-c-demo__section" data-label="Layering System" data-level="1">
    <header class="ss-c-demo__section__header">
        <h1>Layering System</h1>
        <p>
            Demonstrates the z-index stack defined in
            <code>$layer-map</code>. Use the buttons below to toggle each
            layer.
        </p>
    </header>

    <style>
        .ss-c-layer-demo {
            position: relative;
            height: 400px;
            border: 1px solid var(--ss-color-border);
            margin-bottom: 32px;
            background: var(--ss-color-surface-muted);
            overflow: hidden;
        }

        .ss-c-layer-box {
            position: absolute;
            /* Each layer is offset by its index (--i) so the stack fans out. */
            top: calc(var(--layer-start, 20px) + var(--i) * var(--layer-step-y, 40px));
            left: calc(var(--layer-start, 20px) + var(--i) * var(--layer-step-x, 80px));
            width: var(--layer-size, 200px);
            height: var(--layer-size, 200px);
            padding: 8px;
            color: var(--ss-color-on-accent);
            font-weight: bold;
            display: flex;
            flex-direction: column;
            /* Labels sit in the bottom-right corner: the only part of each box
               that is not covered by the layer above it. */
            align-items: flex-end;
            justify-content: flex-end;
            text-align: end;
            opacity: 1;
            cursor: pointer;
            border: 1px solid var(--ss-color-border);
            transition:
                transform var(--ss-duration-200) var(--ss-ease-in-out, ease),
                opacity var(--ss-duration-200) var(--ss-ease-in-out, ease);
        }

        .ss-c-layer-controls {
            margin-bottom: 16px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        /* On phones the stack fans out mostly downwards with smaller boxes, so
           every layer (and its bottom-right label) stays visible. */
        @media (max-width: 40rem) {
            .ss-c-layer-demo {
                height: 340px;
                --layer-size: 120px;
                --layer-step-x: 24px;
                --layer-step-y: 44px;
                --layer-start: 8px;
            }
        }

        .ss-c-layer-box.hidden {
            opacity: 0 !important;
            pointer-events: none;
        }

        /* Layer colours use the semantic tokens with their matching on-* text
           colour so labels stay readable in both themes. */
        .z-guides {
            z-index: 9998;
            background: var(--ss-color-accent);
            --i: 0;
        }
        .z-modal {
            z-index: 7000;
            background: var(--ss-color-error);
            color: var(--ss-color-on-error);
            --i: 1;
        }
        .z-interface {
            z-index: 4000;
            background: var(--ss-color-success);
            color: var(--ss-color-on-success);
            --i: 2;
        }
        .z-content {
            z-index: 2000;
            background: var(--ss-color-warning);
            color: var(--ss-color-on-warning);
            --i: 3;
        }
        .z-canvas {
            z-index: 0;
            background: var(--ss-color-muted);
            --i: 4;
        }
    </style>

    <div class="ss-c-layer-controls">
        {% set layers = ["guides", "modal", "interface", "content", "canvas"]
        %} {% for layer in layers %}
        <button class="ss-c-button ss-c-button--outline" aria-pressed="true" aria-controls="layer-{{ layer }}" onclick="toggleLayer(this, '{{ layer }}')">
            Toggle {{ layer }}
        </button>
        {% endfor %}
    </div>

    <div class="ss-c-layer-demo">
        {% for layer in layers %}
        <div class="ss-c-layer-box z-{{ layer }}" id="layer-{{ layer }}">
            {{ layer }}
            <br />
            <small>z({{ layer }})</small>
        </div>
        {% endfor %}
    </div>

    <script>
        function toggleLayer(button, id) {
            const el = document.getElementById("layer-" + id);
            const hidden = el.classList.toggle("hidden");
            button.setAttribute("aria-pressed", String(!hidden));
        }
    </script>
</section>

{%- endblock %}
