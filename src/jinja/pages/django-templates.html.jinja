{% extends "../base.html.jinja" %}
{%- block title %}Django templates{%- endblock %}
{%- block content %}
<section class="ss-c-demo__section" data-label="Django templates" data-level="1">
    <header class="ss-c-demo__section__header"><h1>Django templates</h1></header>
    <p>
        Jinja2 templates for Django and sturnus apps ship in
        <code>src/templates/stylescape/</code> (outside this demo folder): a base page on
        the <code>ss-l-app</code> shell; list, detail, form and confirm-delete pages;
        macros for form fields, forms, formsets, pagination, breadcrumbs, tables, the
        page header and messages; and the auth pages. Below is their output for a
        paginated list and an invalid form, rendered by Python Jinja2 with real Django
        forms and a Django <code>Paginator</code>, inside a contained shell.
    </p>

    <section class="ss-c-demo__subsection" data-label="List page" data-level="2">
        <h2>List page</h2>
        <p><code>stylescape/pages/list.html.jinja</code> with <code>columns</code>, <code>page_obj</code> and two messages.</p>
        <div style="block-size: 40rem; border: 1px solid var(--ss-color-border)">
<div class="ss-l-app ss-l-app--contained">
            <header class="ss-l-app__header">
                <a class="ss-c-brand" href="/">Stylescape Demo</a>
                <span class="ss-l-app__spacer"></span>
            </header>
            <div class="ss-l-app__main">
                <div class="ss-l-container ss-l-region ss-l-region-md">
                    <header class="ss-c-title-bar">
                        <div class="ss-c-title-bar__text">
                            <div class="ss-c-title-bar__eyebrow"><nav aria-label="Breadcrumb">
        <ol class="ss-c-breadcrumb">
            <li class="ss-c-breadcrumb__item"><a class="ss-c-breadcrumb__link" href="/">Home</a></li>
            <li class="ss-c-breadcrumb__item"><a class="ss-c-breadcrumb__link" href="/projects/">Projects</a></li>
            <li class="ss-c-breadcrumb__item ss-c-breadcrumb__item--active" aria-current="page">Harbour quay renewal</li>
        </ol>
    </nav></div>
                            <h1 class="ss-c-title-bar__title">Projects</h1>
                        </div>
                        <div class="ss-c-title-bar__actions"><a class="ss-c-button ss-c-button--primary" href="/projects/new/">New project</a></div>
                    </header>
    <ul class="ss-c-messages" aria-label="Messages">
        <li class="ss-c-alert ss-c-alert--success">The project “Harbour quay renewal” was saved.</li>
        <li class="ss-c-alert ss-c-alert--error"><span role="alert">Budget could not be parsed.</span></li>
    </ul>
    <div class="ss-c-table-wrapper">
        <table class="ss-c-table ss-c-table--hover">
            <thead>
                <tr>
                    <th scope="col" class="ss-u-text-start">Project</th>
                    <th scope="col" class="ss-u-text-start">Status</th>
                    <th scope="col" class="ss-u-text-start">Owner</th>
                    <th scope="col" class="ss-u-text-end">Budget</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row" class="ss-u-text-start"><a href="/projects/1/">Harbour quay renewal</a></th>
                    <td>Active</td>
                    <td>Anna de Vries</td>
                    <td class="ss-u-text-end">€ 1.2 m</td>
                </tr>
                <tr>
                    <th scope="row" class="ss-u-text-start"><a href="/projects/2/">Ferry terminal</a></th>
                    <td>Paused</td>
                    <td>Bram Jansen</td>
                    <td class="ss-u-text-end">€ 640 k</td>
                </tr>
                <tr>
                    <th scope="row" class="ss-u-text-start"><a href="/projects/3/">Dune path lighting</a></th>
                    <td>Active</td>
                    <td>Chris Bakker</td>
                    <td class="ss-u-text-end">€ 85 k</td>
                </tr>
                <tr>
                    <th scope="row" class="ss-u-text-start"><a href="/projects/4/">Lock gate sensors</a></th>
                    <td>Active</td>
                    <td>Dewi Visser</td>
                    <td class="ss-u-text-end">€ 210 k</td>
                </tr>
                <tr>
                    <th scope="row" class="ss-u-text-start"><a href="/projects/5/">Pier 4 decking</a></th>
                    <td>Paused</td>
                    <td>Eva Smit</td>
                    <td class="ss-u-text-end">€ 120 k</td>
                </tr>
                <tr>
                    <th scope="row" class="ss-u-text-start"><a href="/projects/6/">Bike parking</a></th>
                    <td>Active</td>
                    <td>Femke de Boer</td>
                    <td class="ss-u-text-end">€ 40 k</td>
