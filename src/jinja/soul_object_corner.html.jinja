{% extends "base.html.jinja" %}
{%- block title %}Corner Utilities{%- endblock %}
{%- block content %}

{# ============================================================================
   Shape Variants
   ============================================================================ #}
<section class="demo__section" data-label="Shape Variants" data-level="1">
    <header class="demo__section__header">
        <h3>Shape Variants</h3>
        <p>Apply predefined border-radius shapes using utility classes.</p>
    </header>

    <section class="demo__subsection">
        <h4>Squared, Rounded &amp; Pill</h4>
        {% set code_snippet %}
<div class="flex--row gap--04">
    <div class="object--corner--squared bg--fill_02 p--04" style="width: 120px; height: 80px;">
        Squared
    </div>
    <div class="object--corner--rounded bg--fill_02 p--04" style="width: 120px; height: 80px;">
        Rounded
    </div>
    <div class="object--corner--pill bg--fill_02 p--04" style="width: 120px; height: 80px;">
        Pill
    </div>
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Percentage Corners
   ============================================================================ #}
<section class="demo__section" data-label="Percentage Corners" data-level="1">
    <header class="demo__section__header">
        <h3>Percentage Corners</h3>
        <p>Apply percentage-based border-radius for circular shapes.</p>
    </header>

    <section class="demo__subsection">
        <h4>Circle &amp; Ellipse Shapes</h4>
        {% set code_snippet %}
<div class="flex--row gap--04 align--center">
    <div class="object--corner--0 bg--fill_02 p--04" style="width: 80px; height: 80px;">
        0%
    </div>
    <div class="object--corner--50 bg--fill_02 p--04" style="width: 80px; height: 80px;">
        50%
    </div>
    <div class="object--corner--100 bg--fill_02 p--04" style="width: 80px; height: 80px;">
        100%
    </div>
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

