<div class="object--corner--bottom bg--fill_02 p--04 mb--04" style="width: 200px;">
    Rounded bottom corners only
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
