        {% set code_snippet %}
<div class="object--corner--start bg--fill_02 p--04 mb--04" style="width: 200px;">
    Rounded start (left) corners
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

