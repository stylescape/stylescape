{# ============================================================================
   Individual Corners
   ============================================================================ #}
<section class="demo__section" data-label="Individual Corners" data-level="1">
    <header class="demo__section__header">
        <h3>Individual Corners</h3>
        <p>Apply border-radius to a single corner of an element.</p>
    </header>

    <section class="demo__subsection">
        <h4>Single Corner Variants</h4>
        {% set code_snippet %}
<div class="flex--row gap--04 flex--wrap">
    <div class="object--corner--top-start bg--fill_02 p--04" style="width: 120px; height: 80px;">
        Top Start
    </div>
    <div class="object--corner--top-end bg--fill_02 p--04" style="width: 120px; height: 80px;">
        Top End
    </div>
    <div class="object--corner--bottom-start bg--fill_02 p--04" style="width: 120px; height: 80px;">
        Bottom Start
    </div>
    <div class="object--corner--bottom-end bg--fill_02 p--04" style="width: 120px; height: 80px;">
        Bottom End
    </div>
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   Custom Combinations
   ============================================================================ #}
<section class="demo__section" data-label="Custom Combinations" data-level="1">
    <header class="demo__section__header">
        <h3>Custom Combinations</h3>
        <p>Combine corner utilities to create unique shapes.</p>
    </header>

    <section class="demo__subsection">
        <h4>Diagonal Corners</h4>
        {% set code_snippet %}
<div class="flex--row gap--04">
    <div class="object--corner--top-start object--corner--bottom-end bg--fill_02 p--04" style="width: 120px; height: 80px;">
        Diagonal ↘
    </div>
    <div class="object--corner--top-end object--corner--bottom-start bg--fill_02 p--04" style="width: 120px; height: 80px;">
        Diagonal ↙
    </div>
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Card Header Pattern</h4>
        {% set code_snippet %}
<div style="width: 280px;">
    <div class="object--corner--top bg--primary color--white p--04">
        Card Header
    </div>
    <div class="bg--fill_01 p--04 border--01">
        Card content with squared bottom corners.
    </div>
    <div class="object--corner--bottom bg--fill_02 p--04">
        Card Footer
    </div>
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Button Group Pattern</h4>
        {% set code_snippet %}
<div class="flex--row">
    <button class="button object--corner--start">First</button>
    <button class="button object--corner--0">Middle</button>
    <button class="button object--corner--end">Last</button>
</div>
        {% endset %}
        {% set language="HTML" %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{# ============================================================================
   SCSS Mixin Reference
   ============================================================================ #}
<section class="demo__section" data-label="SCSS Reference" data-level="1">
    <header class="demo__section__header">
        <h3>SCSS Mixin Reference</h3>
        <p>Available mixins for use in custom SCSS.</p>
    </header>

    <section class="demo__subsection">
        <h4>Shape Variant Mixins</h4>
        {% set code_snippet %}
// Token-based shape variants
@include object--corner(squared);  // border-radius: 0
@include object--corner(rounded);  // border-radius: q(2)
@include object--corner(pill);     // border-radius: 50vh

// Or use specific variant mixins
@include object--corner--squared;
@include object--corner--rounded;
@include object--corner--pill;
        {% endset %}
        {% set language="SCSS" %}
        {% set show_preview=false %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Percentage Mixins</h4>
        {% set code_snippet %}
@include object--corner--0;    // border-radius: 0
@include object--corner--50;   // border-radius: 50% (circle)
@include object--corner--100;  // border-radius: 100%
        {% endset %}
        {% set language="SCSS" %}
        {% set show_preview=false %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Edge-Specific Mixins</h4>
        {% set code_snippet %}
// Apply to edges (default: q(2))
@include object--corner--top($radius);      // top-left + top-right
@include object--corner--bottom($radius);   // bottom-left + bottom-right
@include object--corner--start($radius);    // top-left + bottom-left
@include object--corner--end($radius);      // top-right + bottom-right
        {% endset %}
        {% set language="SCSS" %}
        {% set show_preview=false %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Individual Corner Mixins</h4>
        {% set code_snippet %}
// Apply to single corners (default: q(2))
@include object--corner--top-start($radius);     // top-left
@include object--corner--top-end($radius);       // top-right
@include object--corner--bottom-start($radius);  // bottom-left
@include object--corner--bottom-end($radius);    // bottom-right
        {% endset %}
        {% set language="SCSS" %}
        {% set show_preview=false %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Custom Corners Mixin</h4>
        {% set code_snippet %}
// Full control over each corner
@include object--corner--custom(
    $top-left: q(4),
    $top-right: q(2),
    $bottom-right: q(4),
    $bottom-left: q(2)
);
        {% endset %}
        {% set language="SCSS" %}
        {% set show_preview=false %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>

    <section class="demo__subsection">
        <h4>Generic Radius Mixin</h4>
        {% set code_snippet %}
// Apply any radius value with validation
@include object--corner--radius(q(4));
@include object--corner--radius(16px);
@include object--corner--radius(1em 2em);  // horizontal / vertical
        {% endset %}
        {% set language="SCSS" %}
        {% set show_preview=false %}
        {% include "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock %}
