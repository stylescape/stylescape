    {% set label = ".character_unset" %}
    {% set class = "character_unset" %}
    <div class="demo__subsection">
        {% include "includes/preview_box_font.html.jinja" %}
    </div>

</section>


<section class="demo__section">

    <header class="demo__section__header">
        <h3>Case Character Styles</h3>
    </header>

    {% set label = ".character_smallcaps" %}
    {% set class = "character_smallcaps" %}
