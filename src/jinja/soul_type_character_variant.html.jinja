        {% include "includes/preview_box_font.html.jinja" %}
    </div>

    {% set label = ".character_code" %}
    {% set class = "character_code" %}
    <div class="demo__subsection">
        {% include "includes/preview_box_font.html.jinja" %}
    </div>

    {% set label = ".character_initial" %}
    {% set class = "character_initial" %}
