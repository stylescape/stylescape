{% extends "base.html.jinja" %} {% set title = "Horizontal Rules" %} {%- block
title %}{{ title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    <section class="demo__subsection">
        <p>
            Horizontal rules (
            <code>&lt;hr&gt;</code>
            ) are used to create thematic breaks between content sections. They
            provide visual separation and help organize page content into
            logical groups.
        </p>
    </section>

    {% set section_title = "Default HR" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>
            The default
            <code>&lt;hr&gt;</code>
            element is styled automatically without any classes.
        </p>
        {% set code_snippet %}
        <p>Content above the horizontal rule.</p>
        <hr />
        <p>Content below the horizontal rule.</p>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "HR with Base Class" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>
            Explicitly apply the base HR styling with the
            <code>.hr--base</code>
            class.
        </p>
        {% set code_snippet %}
        <hr class="hr--base" />
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Thick HR" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>A thicker horizontal rule for stronger visual emphasis.</p>
        {% set code_snippet %}
        <hr class="hr--thick" />
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Dotted HR" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>A dotted horizontal rule for a lighter visual separation.</p>
        {% set code_snippet %}
        <hr class="hr--dotted" />
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Dashed HR" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>A dashed horizontal rule style.</p>
        {% set code_snippet %}
        <hr class="hr--dashed" />
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Double HR" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>A double-line horizontal rule for decorative purposes.</p>
        {% set code_snippet %}
        <hr class="hr--double" />
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Faded HR" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>A subtle, faded horizontal rule for minimal visual separation.</p>
        {% set code_snippet %}
        <hr class="hr--faded" />
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Divider Classes" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>Generic divider classes with various spacing options.</p>
        {% set code_snippet %}
        <p>Content with small divider below:</p>
        <hr class="divider divider--sm" />

        <p>Content with medium divider below:</p>
        <hr class="divider divider--md" />

        <p>Content with large divider below:</p>
        <hr class="divider divider--lg" />
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "HR in Context" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>Horizontal rules used to separate content sections.</p>
        {% set code_snippet %}
        <article>
            <h4>Section One</h4>
            <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
                eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>

            <hr />

            <h4>Section Two</h4>
            <p>
                Ut enim ad minim veniam, quis nostrud exercitation ullamco
                laboris nisi ut aliquip ex ea commodo consequat.
            </p>

            <hr class="hr--dotted" />

            <h4>Section Three</h4>
            <p>
                Duis aute irure dolor in reprehenderit in voluptate velit esse
                cillum dolore eu fugiat nulla pariatur.
            </p>
        </article>
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>

    {% set section_title = "Style Comparison" %}
    <section
        class="demo__subsection"
        data-label="{{ section_title }}"
        data-level="2"
    >
        <h3>{{ section_title }}</h3>
        <p>All horizontal rule styles compared side by side.</p>
        {% set code_snippet %}
        <p><strong>Default:</strong></p>
        <hr />

        <p><strong>Thick:</strong></p>
        <hr class="hr--thick" />

        <p><strong>Dotted:</strong></p>
        <hr class="hr--dotted" />

        <p><strong>Dashed:</strong></p>
        <hr class="hr--dashed" />

        <p><strong>Double:</strong></p>
        <hr class="hr--double" />

        <p><strong>Faded:</strong></p>
        <hr class="hr--faded" />
        {% endset %} {% set language="HTML" %} {%- include
        "includes/preview/preview_box_code.html.jinja" %}
    </section>
</section>

{%- endblock content %}
