<aside class="ss-c-sidebar ss-c-sidebar--left" id="" role="navigation">
    <nav
        id="sidebar_left_navigation"
        class="ss-c-ribbon--left ss-c-ribbon--inverted"
        aria-label="Sidebar Left Navigation"
    >
        <!-- Add navigation links here -->
        <div class="ss-c-ribbon__slot--vertical_top gap--02">
          <div class="ss-c-tooltip ss-c-tooltip--right" tooltip-data="Portal Home">
            <button class="ss-c-ribbon__button">
              <a href="/en/portal/">
                <i class="i i_ui_home_plain"></i>
              </a>
            </button>
        </div>
    </nav>

    <nav
        id="sidebar_left_menu"
        class="ss-c-sidebar__menu"
        aria-label="Sidebar Left Content Navigation"
    >

        <section
            id="sidebar_left_content"
            class="ss-c-sidebar__content ss-c-rail"
            role="region"
        >
            <h2 id="sidebar-left-label" class="visually-hidden">
                Left Sidebar Content
            </h2>
            {%- block rail_left_content %} {%- include
            "includes/layout/_sidebar_left_index.html.jinja" %} {%- endblock %}
        </section>
    </nav>

    <div class="ss-c-sidebar__control" role="group" aria-label="Sidebar Toggle">
        <button
            class="ss-c-flipper--left"
            id="sidebar_left_switch"
            aria-pressed="false"
            aria-label="Toggle Left Sidebar"
        ></button>
    </div>
</aside>
