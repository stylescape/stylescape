<header class="ss-c-ribbon--top">
    <div class="ss-c-ribbon__slot--horizontal_left">
        <div id="ribbon__title" class="ss-c-ribbon__slot--left ss-c-ribbon__title">
            <a href="/" class="ss-c-ribbon__title__text">
                <span class="ss-c-ribbon__title__logo" aria-hidden="true">+</span>
                STYLESCAPE
            </a>
        </div>
    </div>

    <div class="ss-c-ribbon__slot--horizontal_right">
        {# `ss-c-ribbon__nav`, not `__menu`: the parity shim hides every
        `.ss-c-ribbon__menu` to mirror another site's CSS. #}
        <ul id="ribbon__menu" class="ss-c-ribbon__nav" aria-label="Display options">
            <li class="ss-c-ribbon__menu__item">
                <label class="ss-c-ribbon__button" for="themeToggle">
                    <input type="checkbox" id="themeToggle" />
                    Dark mode
                </label>
            </li>
            <li class="ss-c-ribbon__menu__item">
                <button
                    type="button"
                    class="ss-c-ribbon__button"
                    data-toggle="baseline"
                    aria-pressed="false"
                    aria-label="Baseline grid"
                    title="Baseline grid"
                >
                    <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
                        <path d="M1 3h14M1 6.5h14M1 10h14M1 13.5h14" stroke="currentColor" stroke-width="1.25" fill="none" />
                    </svg>
                </button>
            </li>
            <li class="ss-c-ribbon__menu__item">
                <button
                    type="button"
                    class="ss-c-ribbon__button"
                    data-toggle="graph"
                    aria-pressed="false"
                    aria-label="Graph paper grid"
                    title="Graph paper grid"
                >
                    <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
                        <path d="M1 1h14v14H1zM5.67 1v14M10.33 1v14M1 5.67h14M1 10.33h14" stroke="currentColor" stroke-width="1.25" fill="none" />
                    </svg>
                </button>
            </li>
        </ul>
    </div>
</header>
