{#
-----------------------------------------------------------------------------
Font Preview Box Component
-----------------------------------------------------------------------------
#}

<section class="ss-c-demo__section">
    <header class="ss-c-demo__section__header">
        <h4>{{ title or 'Grid Clean ' ~ cols ~ '×' ~ rows }} Grid</h4>
    </header>
    <code>.ss-u-grid-cols-{{ cols }} (no gap)</code>

    <section class="ss-c-demo__subsection">
        <div class="ss-u-grid ss-u-grid-cols-{{ ss-c-cols }} ss-c-demo-grid-placeholder">
            {% for row in range(1, rows + 1) %} {% for col in range(1, cols +
            1) %}
            <div>{{ alphabet[col-1] | default('C') }}{{ row }}</div>
            {% endfor %} {% endfor %}
        </div>
    </section>
</section>
