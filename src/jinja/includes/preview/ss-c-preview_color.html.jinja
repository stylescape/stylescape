{#
-----------------------------------------------------------------------------
Font Preview Box Component
-----------------------------------------------------------------------------
#} {#
Deterministic id: the n-th snippet on the page (counter from base.html.jinja),
falling back to the snippet length for templates that do not extend base.
#} {% if _ss_snippet_ids is defined %}{% set snippet_id = "code-snippet-" +
_ss_snippet_ids.push(1) %}{% else %}{% set snippet_id = "code-snippet-" +
(code_snippet | default('') | length) %}{% endif %} {% set
lang = language | lower | default("html") %}

<div class="ss-c-preview--vertical">
    <div class="ss-c-preview__live">{{ code_snippet | safe }}</div>
    {# aria-live: announces the button's "Copied!" state (ClipboardHelper). #}
    <div class="ss-c-preview__info" aria-live="polite">
        <small>{{ language | default("HTML") }}</small>
        <button
            type="button"
            class="ss-c-preview__copy-button"
            onclick="ClipboardHelper.copyById('{{ snippet_id }}')"
        >
            Copy
        </button>
    </div>
    <div class="ss-c-preview__code">
        <pre
            class="ss-c-line-numbers"
        ><code id="{{ snippet_id }}" class="language-{{ lang }}">{{ code_snippet | default('') | trim | escape }}</code></pre>
    </div>
</div>
