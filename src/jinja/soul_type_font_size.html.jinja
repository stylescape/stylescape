{% extends "base.html.jinja" %}

{% set title = "Fonts" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">

    <header class="demo__section__header">
        <h3>{{ title }}</h3>
    </header>




    <section class="demo__subsection">
        <h4>Semantic Font Size Classes</h4>

        {% for i in range(1, 13) %}
            {% if i < 10 %}
                {% set padded='0' ~ i %}
            {% else %}
                {% set padded=i|string %}
            {% endif %}

            {% set label=".font--size_" ~ padded %}
            {% set class="font--size_" ~ padded %}
            {% include "includes/preview_box_font.html.jinja" %}
        {% endfor %}
     </section>
</section>



<section class="demo__section">

    <header class="demo__section__header">
        <h4>Utility Font Size Classes</h4>
    </header>

            {% set fonts = [
            { label: ".font--xs", class: "font--xs" },
            { label: ".font--sm", class: "font--sm" },
            { label: ".font--md", class: "font--md" },
            { label: ".font--lg", class: "font--lg" },
            { label: ".font--xl", class: "font--xl" }

            ] %}

            {% for font in fonts %}
            {% set label = font.label %}
            {% set class = font.class %}
            <div class="demo__subsection">
                {% include "includes/preview_box_font.html.jinja" %}
            </div>
            {% endfor %}

        </section>


        {% endblock %}
