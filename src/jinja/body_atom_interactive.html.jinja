{% extends "base.html.jinja" %}
{% block title %}Spinner Atom Demo{% endblock %}

{% block content %}
<section class="demo__section">

    <header class="demo__section__header">
        <h3>Interactive Elements</h3>
    </header>

    <section class="demo__subsection">


        <section id="interactive">
            <details>
                <summary>Toggle</summary>
                <p>Content</p>
            </details>
            <button onclick="document.getElementById('dlg').showModal()">Open Dialog</button>
            <dialog id="dlg">
                <p>Hello from Dialog</p>
                <button onclick="this.closest('dialog').close()">Close</button>
            </dialog>
        </section>

    </section>
</section>

<script>
    // Canvas example script
    const canvas = document.getElementById('canvasExample');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#f00'; ctx.fillRect(10, 10, 80, 80);
    }
</script>
{% endblock %}
