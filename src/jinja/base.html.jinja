<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8" />
    <title>{% block title %}Stylescape{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/stylescape.css" />
    <script type="module" src="/js/stylescape.js"></script>
    <style>
        * {
            font-variant-numeric: lining-nums tabular-nums;
            font-feature-settings: "lnum", "tnum";
        }
    </style>
    {% block head %}{% endblock %}
</head>

<body class="">

    <div class="layout__grid--screen">

        <div class="layout__area--top">
            {%- block ribbon_top -%}
            <header class="ribbon--top" id="" role="navigation">
                {%- include "includes/_ribbon_top.html.jinja" -%}
            </header>
            {%- endblock ribbon_top -%}
        </div>

        <div class="layout__area--middle_left">
            <aside class="ribbon--left" id="" role="navigation">
                <nav class="layout__nav">
                    <ul class="layout__nav__list">
                        <li class="layout__nav__list__item">
                            <a href="/" class="layout__nav__list__item__text">Home</a>
                        </li>
                        <li class="layout__nav__list__item">
                            <a href="/about" class="layout__nav__list__item__text">About</a>
                        </li>
                        <li class="layout__nav__list__item">
                            <a href="/contact" class="layout__nav__list__item__text">Contact</a>
                        </li>
                    </ul>
                </nav>
            </aside>
        </div>

        <div class="layout__area--middle_center">
            {# <main class="main" role="main">
                {% block content %}{% endblock %}
            </main> #}
            <div class="layout__middle_center--nested collapse-left collapse-right" id="middleCenter">

                <!-- Left Aside Toggle -->
                <div class="aside_left_switch" id="leftSwitch">
                    <button class="aside_left_switch_button">
                        <span class="top_bar"></span>
                        <span class="bot_bar"></span>
                    </button>
                </div>

                <!-- Left Aside -->
                <aside class="layout__aside--left">
                    <!-- Left content -->
                    Aside Left Menu
                </aside>

                <!-- Main Content -->
                <main class="layout__main">
                    <!-- Your content here -->
                    {% block content %}{% endblock %}
                </main>

                <!-- Right Aside -->
                <aside class="layout__aside--right">
                    <!-- Right content -->
                    Aside Right Menu
                </aside>

                <!-- Right Aside Toggle -->
                <div class="aside_right_switch" id="rightSwitch">
                    <button class="aside_right_switch_button">
                        <span class="top_bar"></span>
                        <span class="bot_bar"></span>
                    </button>
                </div>

            </div>
        </div>

        <div class="layout__area--middle_right">
            <aside class="ribbon--right ribbon--inverted" id="" role="navigation">
                <nav class="layout__nav">
                    <ul class="layout__nav__list">
                        <li class="layout__nav__list__item">
                            <a href="/settings" class="layout__nav__list__item__text">Settings</a>
                        </li>
                        <li class="layout__nav__list__item">
                            <a href="/help" class="layout__nav__list__item__text">Help</a>
                        </li>
                    </ul>
                </nav>
            </aside>
        </div>

        <div class="layout__area--bottom">
            <footer class="ribbon--bottom ribbon--inverted" role="contentinfo">
                {% block footer %}<p>&copy; 2025 SC∆PE AGENCY</p>{% endblock %}
            </footer>
        </div>


    </div>

    <div class="guide--layer guide--graph_centered" data-grid="graph"></div>
    <div class="guide--layer guide--baseline" data-grid="baseline"></div>

    <script>
        document.getElementById("font-preview-input").addEventListener("input", function () {
            const value = this.value.trim();
            document.querySelectorAll(".font-preview-box").forEach((box) => {
                const textEl = box.querySelector(".text");
                textEl.textContent = value || box.dataset.default;
            });
        });
    </script>
    <script>
        function toggleTheme() {
            const html = document.documentElement;
            html.dataset.theme = html.dataset.theme === "dark" ? "light" : "dark";
        }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const middleCenter = document.getElementById('middleCenter');
            const leftSwitch = document.getElementById('leftSwitch');
            const rightSwitch = document.getElementById('rightSwitch');

            leftSwitch.addEventListener('click', () => {
                middleCenter.classList.toggle('collapse-left');
                leftSwitch.classList.toggle('active');
            });

            rightSwitch.addEventListener('click', () => {
                middleCenter.classList.toggle('collapse-right');
                rightSwitch.classList.toggle('active');
            });
        });
    </script>
</body>

</html>
