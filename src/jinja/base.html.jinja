<!DOCTYPE html>
<html lang="en" data-theme="light">
    {% set rail_left = true %} {% set rail_right = true %}

    <head>
        <meta charset="UTF-8" />
        <title>{%- block title %}Stylescape{%- endblock %}</title>
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <link rel="stylesheet" href="/css/stylescape.css" />
        {#
        <script type="module" src="/js/stylescape.js"></script>
        #}

        <style>
            * {
                font-variant-numeric: lining-nums tabular-nums;
                font-feature-settings: "lnum", "tnum";
            }
        </style>
        {%- block head %}{%- endblock %}
    </head>

    <body class="">
        <div class="ss-page-sidebar-both">
            <header class="ss-page__header">
                {%- block ribbon_top -%} {%- include
                "includes/layout/_ribbon_top.html.jinja" -%} {%- endblock
                ribbon_top -%}
            </header>

            <div class="ss-page__body">
                <aside class="ss-page__sidebar ss-page__sidebar--left">
                    {%- include "includes/layout/_sidebar_left.html.jinja" %}
                </aside>

                <main id="main_content" class="ss-page__main ss-c-rail" role="main">
                    {%- block content %}{%- endblock %}
                </main>

                <aside class="ss-page__sidebar ss-page__sidebar--right ss-c-rail">
                    {%- include "includes/layout/_sidebar_right.html.jinja" %}
                </aside>
            </div>

            <footer class="ss-page__footer">
                {%- block ticker_bottom -%} {%- include
                "includes/layout/_ticker_bottom.html.jinja" -%} {%- endblock
                ticker_bottom -%} {%- block ribbon_bottom -%} {%- include
                "includes/layout/_ribbon_bottom.html.jinja" -%} {%- endblock
                ribbon_bottom -%}
            </footer>
        </div>

        <aside class="">
            {%- include "includes/utilities/_utility_guides.html.jinja" %}
        </aside>

        <script type="module">
            import { initializeStylescape } from "/js/index.js";
            initializeStylescape();
        </script>
    </body>
</html>
