<!DOCTYPE html>
<html lang="en" data-theme="light">

{% set rail_left = true %}
{% set rail_right = true %}


<head>
    <meta charset="UTF-8" />
    <title>{% block title %}Stylescape{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/stylescape.css" />
    <script type="module" src="/js/stylescape.js"></script>

    <style>
        * {
            font-variant-numeric: lining-nums tabular-nums;
            font-feature-settings: "lnum", "tnum";
        }
    </style>
    {% block head %}{% endblock %}
</head>

<body class="">

    <div class="frame_main">

        <div class="frame_main__area--top">
            {%- block ribbon_top -%}
            {%- include "includes/_ribbon_top.html.jinja" -%}
            {%- endblock ribbon_top -%}
        </div>

        <div class="frame_main__area--middle_left ">

            <aside class="sidebar--left" id="" role="navigation">

                <nav class="ribbon--left ribbon--inverted" id="" role="navigation">
                </nav>

                <menu class="sidebar__menu" id="sidebar_left_menu" role="navigation">
                    <section class="rail" >
                    {% block rail_left_content %}
                    {% include "includes/_aside_left_index.html.jinja" %}
                    {% endblock %}
                    </section>
                </menu>

                <div class="sidebar__left_switch" id="sidebar_left_switch">
                    <button class="sidebar__left_switch_button">
                        <span class="top_bar"></span>
                        <span class="bot_bar"></span>
                    </button>
                </div>

            </aside>

        </div>

        <div class="frame_main__area--middle_center">
            <main class="rail" role="main">
            {# <main class="main rail" role="main"> #}
                {# <div class="main_content"> #}
                    {% block content %}{% endblock %}
                {# </div> #}
            </main>
        </div>

        <div class="frame_main__area--middle_right rail">
        <aside class="rail" id="" role="navigation">
            {% block rail_right_content %}
            Aside Left Menu
            {% include "includes/_aside_left_index.html.jinja" %}
            {% endblock%}
        </aside>

        </div>

        <div class="frame_main__area--bottom">
            {%- block ribbon_bottom -%}
            {%- include "includes/_ribbon_bottom.html.jinja" -%}
            {%- endblock ribbon_bottom -%}
        </div>

    </div>

    <aside class="">
        {% include "includes/_utility_guides.html.jinja" %}
    </aside>

</body>
<script>
    function filterSections(query) {
        const q = query.toLowerCase();
        document.querySelectorAll(".demo__section, .demo__subsection").forEach(section => {
            section.style.display = section.textContent.toLowerCase().includes(q) ? "block" : "none";
        });
    }
</script>

</html>
