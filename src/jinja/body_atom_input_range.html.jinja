{% extends "base.html.jinja" %} {% set title = "Input Range" %} {%- block title
%}{{ title }}{%- endblock %} {%- block content %}

<section class="demo__section" data-label="{{ title }}" data-level="1">
    <header class="demo__section__header">
        <h2>{{ title }}</h2>
    </header>

    <section class="demo__subsection">
        <div class="demo__group">
            <label class="label" for="slider-default">Default Slider</label>
            <input
                id="slider-default"
                class="input--range"
                type="range"
                value="50"
                min="0"
                max="100"
            />
        </div>

        <div class="demo__group">
            <label class="label" for="slider-success">
                Custom: Success Color
            </label>
            <input
                id="slider-success"
                class="input--range"
                type="range"
                value="30"
                min="0"
                max="100"
                style="
                    --fill-color: var(--color_accent_primary);
                    --track-color: var(--color_fill_primary);
                "
            />
        </div>

        <div class="demo__group">
            <label class="label" for="slider-thin">
                Custom: Thin Track & Small Thumb
            </label>
            <input
                id="slider-thin"
                class="input--range"
                type="range"
                value="70"
                min="0"
                max="100"
                style="
                    --thumb-size: 0.85em;
                    --track-height: 0.2em;
                    --track-gap: calc(
                        (var(--thumb-size) - var(--track-height)) / 2
                    );
                "
            />
        </div>

        <div class="demo__group">
            <label class="label" for="slider-disabled">Disabled Slider</label>
            <input
                id="slider-disabled"
                class="input--range"
                type="range"
                value="40"
                min="0"
                max="100"
                disabled
            />
        </div>

        <div class="demo__group">
            <label class="label" for="slider-touch">Touch Friendly</label>
            <input
                id="slider-touch"
                class="input--range"
                type="range"
                value="20"
                min="0"
                max="100"
                style="
                    --thumb-size: 1.6em;
                    --track-height: 0.35em;
                    --track-gap: calc(
                        (var(--thumb-size) - var(--track-height)) / 2
                    );
                "
            />
        </div>

        <div class="demo__group">
            <label class="label" for="slider-stepped">
                Stepped (marks every 10)
            </label>
            <input
                id="slider-stepped"
                class="input--range"
                type="range"
                value="60"
                min="0"
                max="100"
                step="10"
                list="slider-stepped-marks"
                style="
                    --fill-color: var(--color_text_primary);
                    --track-color: var(--color_fill_primary);
                "
            />
            <datalist id="slider-stepped-marks">
                <option value="0"></option>
                <option value="20"></option>
                <option value="40"></option>
                <option value="60"></option>
                <option value="80"></option>
                <option value="100"></option>
            </datalist>
        </div>

        <div class="demo__group">
            <label class="label" for="slider-balanced">
                Balanced Range (-50 to 50)
            </label>
            <input
                id="slider-balanced"
                class="input--range"
                type="range"
                value="0"
                min="-50"
                max="50"
                step="5"
                style="
                    --fill-color: var(--color_text_primary);
                    --track-color: var(--color_fill_primary);
                "
            />
            <div class="label">Min -50 · Max 50 · Step 5</div>
        </div>
    </section>
</section>
{%- endblock %}
