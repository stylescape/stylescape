<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8" />
    <title>Ribbon Layout Demo</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/stylescape.css" />
    <script type="module" src="/js/stylescape.js"></script>
    <style>
        * {
            font-variant-numeric: lining-nums tabular-nums;
            font-feature-settings: "lnum", "tnum";
        }
    </style>
</head>

<body class="">

    <div class="layout__grid--screen">

        <div class="layout__area--top"><header class="ribbon--top" id="" role="navigation"><div class="ribbon__slot--horizontal_left">

    <h1 id="ribbon__title" class="ribbon__slot--left ribbon__title" role="heading" aria-level="1">
        <div class="ribbon__title__logo">
            <a href="/" class="">
                <span class="i-text">+</span></a>
        </div>
        <div class="ribbon__title__text">
            <a href="/" class="">
                STYLESCAPE
            </a>
        </div>
    </h1>

</div>

<div class="ribbon__slot--horizontal_center">

    <nav id="ribbon__nav" class="ribbon__nav" role="navigation">
        <button aria-label="Toggle navigation" aria-expanded="false" type="button" data-view-component="true"
            id="ribbon__nav_button" class="menu_button ribbon__nav_button">
            <svg aria-hidden="true" height="24" viewBox="0 0 16 16" version="1.1" width="24" data-view-component="true"
                class="octicon octicon-three-bars">
                <path fill-rule="evenodd"
                    d="M1 2.75A.75.75 0 011.75 2h12.5a.75.75 0 110 1.5H1.75A.75.75 0 011 2.75zm0 5A.75.75 0 011.75 7h12.5a.75.75 0 110 1.5H1.75A.75.75 0 011 7.75zM1.75 12a.75.75 0 100 1.5h12.5a.75.75 0 100-1.5H1.75z">
                </path>
            </svg>
        </button>
        <ul id="ribbon__nav__list" class="ribbon__nav__list">
            <li class="ribbon__nav__list__item">
                <a href="/" class="ribbon__nav__list__item__text">
                    Studio
                </a>
            </li>
            <li class="ribbon__nav__list__item">
                <a href="/" class="ribbon__nav__list__item__text">
                    Stories
                </a>
            </li>
            <li class="ribbon__nav__list__item">
                <a href="/" class="ribbon__nav__list__item__text">
                    Services
                </a>
            </li>
            <details class="ribbon_menu_button">
                <summary class="ribbon__button">
                    <i class="i i_people_person_lg"></i>
                </summary>

                <ul class="ribbon_panel">

                    <figure class="ribbon_panel_header">

                        <figcaption>
                            <h3 class="ribbon_panel_header">
                                Kerem
                            </h3>
                        </figcaption>
                    </figure>

                    <hr class="ribbon_panel_line">

                    <h4 class="ribbon_panel_section_header">
                        Account
                    </h4>

                    <ul class="ribbon_panel_section">
                        <li class="ribbon_panel_section_item">
                            <a href="/accounts/profileprofile/kerem/">
                                Profile
                            </a>
                        </li>
                    </ul>

                    <hr class="ribbon_panel_line">

                    <ul class="ribbon_panel_section">
                        <li class="ribbon_panel_section_item">
                            <a href="/accounts/logout">
                                Sign out
                            </a>
                        </li>
                    </ul>

                </ul>

            </details>
        </ul>
    </nav>



</div>


<div class="ribbon__slot--horizontal_right">



    <div class="ribbon__search">
        <form id="ribbon__search__form" class="ribbon__search__form" role="search">
            <button type="submit" id="ribbon__search_button" class="ribbon__search_button">
                <i class="i i_ui_search"></i>
            </button>
            <input type="text" id="ribbon__search__input" class="ribbon__search__input" placeholder="Search...">
        </form>
    </div>


    <menu id="ribbon__menu" class="ribbon__menu" role="menubar">

        <li class="ribbon__menu__item">
            <button class="ribbon__button" onclick="copy()">

                <a href="">
                    <i class="i i_symbol_swirl_left_02"></i>
                </a>

            </button>
        </li>
        <li class="ribbon__menu__item">

            <label class="theme-switch">
                <input type="checkbox" id="themeToggle" />
                <span class="slider"></span>
            </label>
        </li>

        <li class="ribbon__menu__item">
            <button class="ribbon__button" data-toggle="baseline">
                <span class="i">☰</span>

            </button>
        </li>
        <li class="ribbon__menu__item">
            <button class="ribbon__button" data-toggle="graph">
                <span class="i">⊞</span>
            </button>
        </li>
        <li class="ribbon__menu__item">
            <button class="ribbon__button" data-toggle="margin">
                <span class="i">⌘</span>
            </button>
        </li>

        <li class="ribbon__menu__item">
            <details class="ribbon_menu_button">
                <summary class="ribbon__button">
                    <i class="i i_people_person_lg"></i>
                </summary>

                <ul class="ribbon_panel">

                    <figure class="ribbon_panel_header">

                        <figcaption>
                            <h3 class="ribbon_panel_header">
                                Kerem
                            </h3>
                        </figcaption>
                    </figure>

                    <hr class="ribbon_panel_line">

                    <h4 class="ribbon_panel_section_header">
                        Account
                    </h4>

                    <ul class="ribbon_panel_section">
                        <li class="ribbon_panel_section_item">
                            <a href="/accounts/profileprofile/kerem/">
                                Profile
                            </a>
                        </li>
                    </ul>

                    <hr class="ribbon_panel_line">

                    <ul class="ribbon_panel_section">
                        <li class="ribbon_panel_section_item">
                            <a href="/accounts/logout">
                                Sign out
                            </a>
                        </li>
                    </ul>

                </ul>

            </details>
        </li>
    </menu>

</div>
</header></div>

        <div class="layout__area--middle_left">
            <aside class="ribbon--left" id="" role="navigation">
                <nav class="layout__nav">
                    <ul class="layout__nav__list">
                        <li class="layout__nav__list__item">
                            <a href="/" class="layout__nav__list__item__text">Home</a>
                        </li>
                        <li class="layout__nav__list__item">
                            <a href="/about" class="layout__nav__list__item__text">About</a>
                        </li>
                        <li class="layout__nav__list__item">
                            <a href="/contact" class="layout__nav__list__item__text">Contact</a>
                        </li>
                    </ul>
                </nav>
            </aside>
        </div>

        <div class="layout__area--middle_center ">
            <main class="main main_content" role="main">
<style>
    .ribbon_container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: q(8);
    }
</style>
<div class="layout__grid--screen">

    <section class="ribbon_container ribbon_container--top ">
        <div class="ribbon ribbon--top">Top Ribbon</div>
    </section>

    <section class="ribbon_container ribbon_container--bottom ">
        <div class="ribbon ribbon--bottom">Bottom Ribbon</div>
    </section>

    <section class="ribbon_container ribbon_container--left ">
        <div class="ribbon ribbon--left">Left Ribbon</div>
    </section>

    <section class="ribbon_container ribbon_container--right ">
        <div class="ribbon ribbon--right">Right Ribbon</div>
    </section>


</div>
            </main>
        </div>

        <div class="layout__area--middle_right">
            <aside class="ribbon--right ribbon--inverted" id="" role="navigation">
                <nav class="layout__nav">
                    <ul class="layout__nav__list">
                        <li class="layout__nav__list__item">
                            <a href="/settings" class="layout__nav__list__item__text">Settings</a>
                        </li>
                        <li class="layout__nav__list__item">
                            <a href="/help" class="layout__nav__list__item__text">Help</a>
                        </li>
                    </ul>
                </nav>
            </aside>
        </div>

        <div class="layout__area--bottom">
            <footer class="ribbon--bottom ribbon--inverted" role="contentinfo">
                <div class="ribbon__slot--horizontal_center">

                    <small>&copy; 2025 SC∆PE AGENCY</small>
                </div>
            </footer>
        </div>


    </div>

    <div class="guide--layer guide--graph_centered" data-grid="graph"></div>
    <div class="guide--layer guide--baseline" data-grid="baseline"></div>


</body>

</html>
